        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gryonixNexus koristi Bluetooth za premještanje poslužitelja između vaših uređaja kad nisu na istoj Wi-Fi mreži."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gryonixNexus Bluetooth-t használ a szerverek áthelyezéséhez az eszközei között, ha nem ugyanazon a Wi-Fi-n vannak."
