    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gryonixNexus използва Bluetooth, за да прехвърля сървъри между вашите устройства, когато не са в една Wi-Fi мрежа."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gryonixNexus používá Bluetooth k přesunu serverů mezi vašimi zařízeními, když nejsou ve stejné Wi-Fi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gryonixNexus bruger Bluetooth til at flytte servere mellem dine enheder, når de ikke er på samme Wi-Fi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gryonixNexus nutzt Bluetooth, um Server zwischen deinen Geräten zu übertragen, wenn sie nicht im selben WLAN sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το gryonixNexus χρησιμοποιεί Bluetooth για να μεταφέρει διακομιστές μεταξύ των συσκευών σας όταν δεν είναι στο ίδιο Wi-Fi."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gryonixNexus uses Bluetooth to move servers between your devices when they are not on the same Wi-Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gryonixNexus usa Bluetooth para mover servidores entre tus dispositivos cuando no están en la misma Wi-Fi."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gryonixNexus kasutab Bluetoothi, et viia servereid sinu seadmete vahel, kui need pole samas Wi-Fi-võrgus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gryonixNexus käyttää Bluetoothia siirtääkseen palvelimia laitteidesi välillä, kun ne eivät ole samassa Wi-Fi-verkossa."
