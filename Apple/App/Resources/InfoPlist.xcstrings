    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gryonixNexus се свързва чрез SSH със сървъри в локалната ви мрежа, за да ги инсталира и управлява."
