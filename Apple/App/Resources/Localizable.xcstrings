    "%@: the app is not allowed to update the agent on this machine yet. Run its setup script once more; after that the app updates it by itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: приложението няма разрешение да актуализира агента на този компютър. Стартирайте скрипта за инсталация още веднъж; след това приложението ще го актуализира само."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: aplikace ještě není povolena aktualizovat agenta na tomto počítači. Spusťte instalační skript ještě jednou; poté aplikace jej aktualizuje sama."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
