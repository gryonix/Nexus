    "Another machine this deployment runs services on. The connection is checked before it is added." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine weitere Maschine, auf der dieses Deployment Dienste ausführt. Die Verbindung wird vor dem Hinzufügen geprüft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra máquina en la que este despliegue ejecuta servicios. La conexión se comprueba antes de añadirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre machine sur laquelle ce déploiement exécute des services. La connexion est vérifiée avant l’ajout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’altra macchina su cui questo deployment esegue servizi. La connessione viene verificata prima di aggiungerla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデプロイがサービスを実行するもう一台のマシン。追加する前に接続を確認します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ещё одна машина, на которой это развёртывание держит сервисы. Соединение проверяется до добавления."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще одна машина, на якій це розгортання тримає сервіси. З’єднання перевіряється до додавання."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此部署运行服务的另一台机器。添加前会检查连接。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toinen kone, jolla tämä käyttöönotto ajaa palveluita. Yhteys tarkistetaan ennen sen lisäämistä."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Друга машина, на която това разгръщане изпълнява услуги. Връзката се проверява преди добавяне."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drugi stroj na kojem ovo postavljanje izvodi usluge. Veza se provjerava prije dodavanja."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drug stroj, na katerem ta postavitev izvaja storitve. Povezava se preveri pred dodajanjem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden maskine, denne udrulning kører tjenester på. Forbindelsen tjekkes, før den tilføjes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een andere machine waarop deze implementatie diensten draait. De verbinding wordt gecontroleerd voordat deze wordt toegevoegd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annan maskin den här driftsättningen kör tjänster på. Anslutningen kontrolleras innan den läggs till."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy másik gép, amelyen ez a telepítés szolgáltatásokat futtat. A kapcsolat ellenőrzésre kerül hozzáadás előtt."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O altă mașină pe care această implementare rulează servicii. Conexiunea este verificată înainte de a fi adăugată."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teine masin, millel see paigaldus teenuseid käitab. Ühendust kontrollitakse enne lisamist."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra máquina onde esta implantação corre serviços. A ligação é verificada antes de ser adicionada."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolejna maszyna, na której to wdrożenie uruchamia usługi. Połączenie jest sprawdzane przed dodaniem."
          }
