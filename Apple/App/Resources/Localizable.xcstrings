    "No machine answers on the public address and runs services, so the entry cannot be pointed at another machine." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никоя машина не отговаря на публичния адрес и едновременно с това не изпълнява услуги, затова входът не може да бъде насочен към друга машина."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádný stroj neodpovídá na veřejné adrese a zároveň neprovozuje služby, takže vstup nelze přesměrovat na jiný stroj."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen maskine svarer på den offentlige adresse og kører samtidig tjenester, så indgangen kan ikke pege på en anden maskine."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Maschine antwortet auf der öffentlichen Adresse und führt zugleich Dienste aus, daher kann der Eingang nicht auf eine andere Maschine gerichtet werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κανένα μηχάνημα δεν απαντά στη δημόσια διεύθυνση και ταυτόχρονα εκτελεί υπηρεσίες, επομένως η είσοδος δεν μπορεί να κατευθυνθεί σε άλλο μηχάνημα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna máquina responde en la dirección pública y ejecuta servicios, así que la entrada no se puede dirigir a otra máquina."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ükski masin ei vasta avalikul aadressil ja käita samal ajal teenuseid, seega ei saa sissepääsu teisele masinale suunata."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikään kone ei vastaa julkisessa osoitteessa ja aja samalla palveluita, joten sisäänpääsyä ei voi ohjata toiselle koneelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune machine ne répond sur l'adresse publique tout en exécutant des services ; l'entrée ne peut donc pas être dirigée vers une autre machine."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níl aon mheaisín ann a fhreagraíonn ar an seoladh poiblí agus a rithfidh seirbhísí, mar sin ní féidir an iontráil a threorú chuig meaisín eile."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nijedan stroj ne odgovara na javnoj adresi i ujedno izvodi usluge, pa se ulaz ne može usmjeriti na drugi stroj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyetlen gép sem válaszol a nyilvános címen és futtat egyben szolgáltatásokat, ezért a belépést nem lehet másik gépre irányítani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna macchina risponde sull'indirizzo pubblico ed esegue servizi, quindi l'ingresso non può essere puntato su un'altra macchina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開アドレスで応答しつつサービスも実行しているマシンがないため、入口を別のマシンに向けることはできません。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nė viena mašina neatsako viešuoju adresu ir kartu nevykdo paslaugų, todėl įėjimo negalima nukreipti į kitą mašiną."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neviena mašīna neatbild publiskajā adresē un reizē nedarbina pakalpojumus, tāpēc ieeju nevar novirzīt uz citu mašīnu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebda magna ma twieġeb fuq l-indirizz pubbliku u fl-istess ħin tħaddem servizzi, għalhekk id-dħul ma jistax jiġi indirizzat lejn magna oħra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen enkele machine antwoordt op het openbare adres en draait tegelijk diensten, dus de ingang kan niet naar een andere machine wijzen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żadna maszyna nie odpowiada pod publicznym adresem i jednocześnie nie uruchamia usług, więc wejścia nie można skierować na inną maszynę."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma máquina responde no endereço público e executa serviços, por isso a entrada não pode ser apontada para outra máquina."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicio mașină nu răspunde la adresa publică și nu rulează servicii, așa că intrarea nu poate fi îndreptată spre altă mașină."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни одна машина не отвечает на публичном адресе и одновременно не выполняет сервисы, поэтому вход нельзя перенаправить на другую машину."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žiadny stroj neodpovedá na verejnej adrese a zároveň neprevádzkuje služby, takže vstup nemožno presmerovať na iný stroj."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noben stroj se ne odziva na javnem naslovu in hkrati izvaja storitve, zato vhoda ni mogoče usmeriti na drug stroj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen maskin svarar på den publika adressen och kör samtidigt tjänster, så ingången kan inte riktas mot en annan maskin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жодна машина не відповідає на публічній адресі й водночас не виконує сервіси, тому вхід не можна перенаправити на іншу машину."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有任何机器既在公网地址上应答又运行服务，因此无法让入口指向另一台机器。"
          }
        }
      }
    },
