    "Your own name for each protocol on the island and the Lock Screen, up to eight characters. Empty keeps the standard one." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше име за всеки протокол на острова и заключения екран, до осем знака. Празно оставя стандартното."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastní název každého protokolu na ostrůvku a zamčené obrazovce, nejvýše osm znaků. Prázdné ponechá standardní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit eget navn til hver protokol på øen og låseskærmen, op til otte tegn. Tomt beholder standardnavnet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigener Name für jedes Protokoll auf der Insel und dem Sperrbildschirm, bis zu acht Zeichen. Leer lässt den Standardnamen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δικό σας όνομα για κάθε πρωτόκολλο στο νησί και στην οθόνη κλειδώματος, έως οκτώ χαρακτήρες. Κενό κρατά το τυπικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your own name for each protocol on the island and the Lock Screen, up to eight characters. Empty keeps the standard one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu propio nombre para cada protocolo en la isla y la pantalla de bloqueo, hasta ocho caracteres. Vacío mantiene el estándar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga protokolli oma nimi saarel ja lukustuskuval, kuni kaheksa märki. Tühi jätab tavalise nime."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oma nimi jokaiselle protokollalle saarekkeessa ja lukitusnäytöllä, enintään kahdeksan merkkiä. Tyhjä pitää vakionimen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre propre nom pour chaque protocole sur l’îlot et l’écran verrouillé, huit caractères au plus. Vide garde le nom standard."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’ainm féin do gach prótacal ar an oileán agus ar an Scáileán Glasála, suas le hocht gcarachtar. Coinníonn folamh an t-ainm caighdeánach."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastiti naziv svakog protokola na otoku i zaključanom zaslonu, do osam znakova. Prazno zadržava standardni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saját név minden protokollhoz a szigeten és a zárolási képernyőn, legfeljebb nyolc karakter. Üresen a szabványos marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nome tuo per ogni protocollo sull’isola e sulla schermata di blocco, fino a otto caratteri. Vuoto mantiene quello standard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイランドとロック画面に表示する各プロトコルの名前（8文字まで）。空欄なら標準の名前のままです。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Savas kiekvieno protokolo pavadinimas saloje ir užrakinimo ekrane, iki aštuonių simbolių. Tuščias palieka standartinį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Savs nosaukums katram protokolam salā un bloķēšanas ekrānā, līdz astoņām rakstzīmēm. Tukšs atstāj standarta nosaukumu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isem tiegħek għal kull protokoll fuq il-gżira u l-iskrin imsakkar, sa tmien karattri. Vojt iżomm dak standard."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je eigen naam voor elk protocol op het eiland en het toegangsscherm, tot acht tekens. Leeg houdt de standaardnaam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Własna nazwa każdego protokołu na wyspie i ekranie blokady, do ośmiu znaków. Puste pole zostawia standardową."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu próprio nome para cada protocolo na ilha e no ecrã bloqueado, até oito caracteres. Vazio mantém o padrão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numele tău pentru fiecare protocol pe insulă și pe ecranul de blocare, până la opt caractere. Gol păstrează numele standard."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Своё название каждого протокола на острове и экране блокировки, до восьми символов. Пустое поле оставляет стандартное."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastný názov každého protokolu na ostrovčeku a zamknutej obrazovke, najviac osem znakov. Prázdne ponechá štandardný."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lastno ime za vsak protokol na otoku in zaklenjenem zaslonu, do osem znakov. Prazno ohrani privzeto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eget namn för varje protokoll på ön och låsskärmen, upp till åtta tecken. Tomt behåller standardnamnet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Власна назва кожного протоколу на острові та екрані блокування, до восьми символів. Порожнє поле залишає стандартну."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在灵动岛和锁定屏幕上为每个协议设置自己的名称，最多八个字符。留空则保留标准名称。"
          }
        }
      }
    },
