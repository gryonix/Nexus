    "%@ has no password: the app locked it when it set up this server, so no password can unlock sudo for it. Install the agent while signed in as root or as an account with sudo." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ няма парола: приложението я заключи при настройката на сървъра, затова никоя парола не може да отключи sudo. Инсталирайте агента, влезли като root или с акаунт със sudo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nemá heslo: aplikace ho při nastavení serveru zamkla, takže žádné heslo pro něj sudo neodemkne. Nainstalujte agenta přihlášeni jako root nebo účet se sudo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har ingen adgangskode: appen låste den ved opsætningen af serveren, så ingen adgangskode kan låse sudo op. Installer agenten logget ind som root eller en konto med sudo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat kein Passwort: Die App hat es beim Einrichten dieses Servers gesperrt, daher kann kein Passwort sudo dafür freischalten. Installiere den Agenten angemeldet als root oder als Konto mit sudo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο %@ δεν έχει κωδικό: η εφαρμογή τον κλείδωσε κατά τη ρύθμιση του διακομιστή, οπότε κανένας κωδικός δεν ξεκλειδώνει το sudo. Εγκαταστήστε τον πράκτορα συνδεδεμένοι ως root ή με λογαριασμό με sudo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no tiene contraseña: la app la bloqueó al configurar este servidor, así que ninguna contraseña puede desbloquear sudo para esa cuenta. Instala el agente con la sesión iniciada como root o con una cuenta con sudo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontol %@ pole parooli: rakendus lukustas selle serveri seadistamisel, seega ükski parool ei ava sellele sudo’t. Paigaldage agent root’i või sudo-õigustega kontoga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilillä %@ ei ole salasanaa: sovellus lukitsi sen palvelinta määrittäessään, joten mikään salasana ei avaa sille sudoa. Asenna agentti kirjautuneena rootina tai sudo-oikeuksisella tilillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas de mot de passe : l’app l’a verrouillé lors de la configuration de ce serveur, aucun mot de passe ne peut donc lui ouvrir sudo. Installez l’agent en étant connecté en root ou avec un compte ayant sudo."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níl pasfhocal ag %@: chuir an aip faoi ghlas é nuair a shocraigh sí an freastalaí, mar sin ní féidir le pasfhocal ar bith sudo a dhíghlasáil. Suiteáil an gníomhaire agus tú logáilte isteach mar root nó le cuntas a bhfuil sudo aige."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nema lozinku: aplikacija ju je zaključala pri postavljanju poslužitelja, pa nijedna lozinka ne otključava sudo. Instalirajte agenta prijavljeni kao root ili račun sa sudo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fióknak nincs jelszava: az alkalmazás a szerver beállításakor zárolta, így semmilyen jelszó nem nyitja meg a sudót. Telepítse az ügynököt rootként vagy sudo-jogú fiókkal bejelentkezve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha una password: l’app l’ha bloccata configurando questo server, quindi nessuna password può sbloccare sudo. Installa l’agente accedendo come root o con un account con sudo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ にはパスワードがありません。このサーバーの設定時にアプリがロックしたため、どのパスワードでも sudo は使えません。root または sudo 権限のあるアカウントでサインインしてエージェントをインストールしてください。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ neturi slaptažodžio: programa jį užrakino nustatydama serverį, todėl joks slaptažodis neatrakins sudo. Įdiekite agentą prisijungę kaip root arba paskyra su sudo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nav paroles: lietotne to bloķēja, iestatot šo serveri, tāpēc neviena parole neatbloķēs sudo. Instalējiet aģentu, pierakstoties kā root vai kontā ar sudo."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ m’għandux password: l-app sakkratha meta waqqfet dan is-server, għalhekk l-ebda password ma tista’ tiftaħ sudo. Installa l-aġent billi tidħol bħala root jew b’kont li għandu sudo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft geen wachtwoord: de app heeft het vergrendeld bij het inrichten van deze server, dus geen wachtwoord kan sudo ontgrendelen. Installeer de agent terwijl je bent ingelogd als root of met een account met sudo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie ma hasła: aplikacja zablokowała je przy konfiguracji serwera, więc żadne hasło nie odblokuje sudo. Zainstaluj agenta, logując się jako root lub kontem z sudo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não tem palavra-passe: a app bloqueou-a ao configurar este servidor, por isso nenhuma palavra-passe desbloqueia o sudo. Instale o agente com sessão iniciada como root ou numa conta com sudo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nu are parolă: aplicația a blocat-o la configurarea serverului, deci nicio parolă nu poate debloca sudo. Instalați agentul autentificat ca root sau cu un cont cu sudo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У %@ нет пароля: приложение заблокировало его при настройке этого сервера, поэтому никакой пароль не откроет для неё sudo. Установите агента, войдя под root или под учётной записью с правами sudo."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nemá heslo: aplikácia ho pri nastavení servera zamkla, takže žiadne heslo preň sudo neodomkne. Nainštalujte agenta prihlásení ako root alebo účet so sudo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nima gesla: aplikacija ga je zaklenila ob nastavitvi strežnika, zato nobeno geslo ne odklene sudo. Namestite agenta, prijavljeni kot root ali z računom s sudo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har inget lösenord: appen låste det när servern konfigurerades, så inget lösenord kan låsa upp sudo. Installera agenten inloggad som root eller med ett konto med sudo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У %@ немає пароля: застосунок заблокував його під час налаштування цього сервера, тож жоден пароль не відкриє для нього sudo. Встановіть агента, увійшовши як root або під обліковим записом із правами sudo."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有密码：应用在设置此服务器时锁定了它，因此任何密码都无法为它开启 sudo。请以 root 或具有 sudo 权限的账户登录后安装代理。"
          }
        }
      }
    },
