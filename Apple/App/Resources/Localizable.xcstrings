    "%@ and every message in it are deleted from the server. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ und alle darin enthaltenen Nachrichten werden vom Server gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ y todos sus mensajes se eliminan del servidor. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ et tous les messages qu’elle contient sont supprimés du serveur. C’est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e tutti i messaggi che contiene vengono eliminati dal server. L’operazione non è reversibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ とその中のすべてのメールがサーバーから削除されます。元に戻せません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ и все письма в нём удаляются с сервера. Отменить это нельзя."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ і всі листи в ній видаляються із сервера. Скасувати це неможливо."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 及其中的所有邮件都将从服务器删除。此操作无法撤销。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ja jokainen sen viesti poistetaan palvelimelta. Tätä ei voi perua."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ и всяко съобщение в него се изтриват от сървъра. Това не може да бъде отменено."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ i svaka poruka u njemu brišu se s poslužitelja. Ovo se ne može poništiti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in vsako sporočilo v njem sta izbrisana s strežnika. Tega ni mogoče razveljaviti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ og alle beskeder i den slettes fra serveren. Dette kan ikke fortrydes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en elk bericht erin worden van de server verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ och alla meddelanden i den tas bort från servern. Detta kan inte ångras."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ i każda wiadomość w nim są usuwane z serwera. Tego nie można cofnąć."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a všechny zprávy v něm se ze serveru odstraní. To nelze vzít zpět."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a všetky správy v ňom sa zo servera odstránia. Toto nemožno vrátiť späť."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ και κάθε μήνυμα σε αυτό διαγράφονται από τον διακομιστή. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ és minden benne lévő üzenet törlődik a szerverről. Ez nem vonható vissza."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ și fiecare mesaj din el sunt șterse de pe server. Această acțiune nu poate fi anulată."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e todas as mensagens nele são eliminados do servidor. Isto não pode ser desfeito."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ja kõik selles olevad sõnumid kustutatakse serverist. Seda ei saa tagasi võtta."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scriostar %@ agus gach teachtaireacht ann ón bhfreastalaí. Ní féidir é seo a chur ar ais."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ u kull messaġġ fih jitħassru mis-server. Dan ma jistax jitħassar lura."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ un visi tajā esošie ziņojumi tiek dzēsti no servera. To nevar atsaukt."
