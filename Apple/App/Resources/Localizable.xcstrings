          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyldig til %@. Den vises kun nu — serveren udleverer den ikke igen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldig tot %@. Wordt alleen nu getoond — de server geeft het niet nogmaals terug."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giltig till %@. Den visas bara nu — servern lämnar inte ut den igen."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrijedi do %@. Prikazuje se samo sada — poslužitelj ga više ne vraća."
          }
        },
        "sl" : {
