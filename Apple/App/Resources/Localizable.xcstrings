          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szacowany z części maszyny i obciążenia procesora: brak czujnika zasilania."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimado a partir das peças da máquina e carga do processador: não tem sensor de potência."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
