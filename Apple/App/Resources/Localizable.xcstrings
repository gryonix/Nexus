    "Some of these hand out configurations from their own panel by choice; the rest have no agent installed for the app to go through." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige davon geben Konfigurationen absichtlich über ihr eigenes Panel aus; bei den übrigen ist kein Agent installiert, über den die App gehen könnte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos de ellos entregan las configuraciones desde su propio panel por elección; el resto no tiene instalado un agente por el que la aplicación pueda pasar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains distribuent les configurations depuis leur propre panneau par choix ; les autres n’ont pas d’agent installé par lequel l’app pourrait passer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni distribuiscono le configurazioni dal proprio pannello per scelta; gli altri non hanno un agent installato attraverso cui l’app possa passare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部は意図的に自身のパネルから構成を配布しています。残りは、アプリが経由できるエージェントが導入されていません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часть из них раздаёт конфигурации из собственной панели по выбору владельца; у остальных не установлен агент, через которого могло бы ходить приложение."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Частина з них роздає конфігурації зі своєї панелі за вибором власника; в інших не встановлено агента, через якого міг би ходити застосунок."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中一些是有意从自己的面板分发配置；其余的则没有安装应用可以经由的 agent。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osa näistä jakaa konfiguraatioita omasta paneelistaan valinnasta; lopuilla ei ole agenttia asennettuna, jonka kautta sovellus voisi mennä."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Някои от тях раздават конфигурации от собствения си панел по избор; останалите нямат инсталиран агент, през който приложението да мине."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neki od njih izdaju konfiguracije iz vlastitog panela po izboru; ostali nemaju instaliranog agenta kroz kojeg bi aplikacija prošla."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nekateri od njih po izbiri izdajajo konfiguracije iz lastnega panela; ostali nimajo nameščenega agenta, skozi katerega bi šla aplikacija."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle af disse uddeler konfigurationer fra deres eget panel med vilje; resten har ingen agent installeret, som appen kan gå igennem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige hiervan geven configuraties uit vanuit hun eigen paneel, bewust; de rest heeft geen agent geïnstalleerd waar de app doorheen kan gaan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vissa av dessa delar medvetet ut konfigurationer från sin egen panel; resten saknar en installerad agent som appen kan gå via."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns destes distribuem configurações a partir do seu próprio painel, por opção; os restantes não têm agente instalado para a app usar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unele dintre acestea oferă configurații din propriul panou, prin alegere; restul nu au niciun agent instalat prin care aplicația să treacă."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektóre z nich celowo wydają konfiguracje z własnego panelu; pozostałe nie mają zainstalowanego agenta, przez którego aplikacja mogłaby przejść."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některé z nich záměrně vydávají konfigurace z vlastního panelu; ostatní nemají nainstalovaného agenta, přes kterého by aplikace mohla jít."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektoré z nich zámerne vydávajú konfigurácie z vlastného panela; ostatné nemajú nainštalovaného agenta, cez ktorého by aplikácia mohla ísť."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mõned neist jagavad seadistusi oma paneelist teadlikult; ülejäänutel pole agenti paigaldatud, mille kaudu rakendus saaks toimida."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek közül némelyik saját választásából a saját paneljéről osztja ki a konfigurációkat; a többieken nincs telepítve ügynök, amelyen keresztül az alkalmazás áthaladhatna."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dažas no tām izsniedz konfigurācijas no sava paneļa pēc izvēles; pārējām nav instalēts aģents, caur kuru lietotne varētu darboties."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μερικά από αυτά διανέμουν ρυθμίσεις από το δικό τους πάνελ εξ επιλογής· τα υπόλοιπα δεν έχουν εγκατεστημένο agent για να περάσει η εφαρμογή."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eisíonn cuid díobh seo cumraíochtaí óna bpainéal féin de rogha; níl aon ghníomhaire suiteáilte ag an gcuid eile le go rachadh an aip tríd."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xi wħud minn dawn jagħtu konfigurazzjonijiet mill-panel tagħhom stess bl-għażla; il-bqija m'għandhomx aġent installat biex l-app tgħaddi minnhom."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai kurie iš jų sąmoningai išduoda konfigūracijas iš savo paties skydelio; likusiems nėra įdiegto agento, per kurį programėlė galėtų veikti."
          }
        }
      }
    },
