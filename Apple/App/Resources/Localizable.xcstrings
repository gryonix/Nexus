        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engine beží na stroji doma, kde prácu zvládne grafická karta; tento server iba prenáša."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μηχανή τρέχει στο μηχάνημα του σπιτιού, όπου μια κάρτα γραφικών μπορεί να κάνει τη δουλειά· αυτός ο διακομιστής απλώς αναμεταδίδει."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A motor az otthoni gépen fut, ahol egy videokártya el tudja végezni a munkát; ez a szerver csak továbbít."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motorul merge pe mașina de acasă, unde o placă grafică poate face treaba; acest server doar retransmite."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mootor käib kodus asuval masinal, kus videokaart saab tööd teha; see server ainult vahendab."
