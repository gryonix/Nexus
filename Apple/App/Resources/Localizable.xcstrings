          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versio %@. Tarkistaa uudemman gryonixNexuksen ja asentaa sen allekirjoituksen varmistamisen jälkeen."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версия %@. Проверява за по-нов gryonixNexus и го инсталира след проверка на подписа му."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versiunea %@. Verifică existența unui gryonixNexus mai nou și îl instalează după verificarea semnăturii lui."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %@. Tjekker for en nyere gryonixNexus og installerer den, efter dens signatur er verificeret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versie %@. Controleert op een nieuwere gryonixNexus en installeert deze na verificatie van de handtekening."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %@. Söker efter en nyare gryonixNexus och installerar den efter att ha verifierat dess signatur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
