        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN se na pár minut zastaví. Zařízení si ponechají konfigurace a znovu se připojí sama."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN holder pause i et par minutter. Enhederne beholder deres konfigurationer og genopretter selv forbindelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das VPN pausiert einige Minuten. Geräte behalten ihre Konfigurationen und verbinden sich von selbst neu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το VPN σταματά για λίγα λεπτά. Οι συσκευές κρατούν τις ρυθμίσεις τους και επανασυνδέονται μόνες τους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VPN se detiene unos minutos. Los dispositivos conservan sus configuraciones y se reconectan solos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN peatub mõneks minutiks. Seadmed säilitavad oma seadistused ja ühenduvad ise uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN pysähtyy muutamaksi minuutiksi. Laitteet säilyttävät määrityksensä ja yhdistävät itse uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le VPN s'interrompt quelques minutes. Les appareils gardent leurs configurations et se reconnectent seuls."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopann an VPN ar feadh cúpla nóiméad. Coinníonn gléasanna a gcumraíochtaí agus athcheanglaíonn siad féin."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN se zaustavlja na nekoliko minuta. Uređaji zadržavaju konfiguracije i sami se ponovno spajaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A VPN néhány percre leáll. Az eszközök megtartják a beállításaikat, és maguktól újracsatlakoznak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VPN si ferma per qualche minuto. I dispositivi mantengono le configurazioni e si ricollegano da soli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN は数分間止まります。デバイスの設定はそのままで、自動で再接続します。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN kelioms minutėms sustoja. Įrenginiai išlaiko konfigūracijas ir patys vėl prisijungia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN uz dažām minūtēm apstājas. Ierīces saglabā konfigurācijas un pašas atkal pieslēdzas."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-VPN jieqaf għal ftit minuti. L-apparati jżommu l-konfigurazzjonijiet tagħhom u jerġgħu jaqbdu waħedhom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De VPN pauzeert een paar minuten. Apparaten houden hun configuraties en verbinden vanzelf opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN zatrzyma się na kilka minut. Urządzenia zachowają konfiguracje i same połączą się ponownie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A VPN para durante alguns minutos. Os dispositivos mantêm as configurações e voltam a ligar-se sozinhos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN-ul se oprește câteva minute. Dispozitivele își păstrează configurațiile și se reconectează singure."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN остановится на несколько минут. Конфигурации устройств не изменятся, они переподключатся сами."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN sa na pár minút zastaví. Zariadenia si ponechajú konfigurácie a znova sa pripoja samy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN se za nekaj minut ustavi. Naprave ohranijo konfiguracije in se same znova povežejo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN pausar några minuter. Enheterna behåller sina konfigurationer och ansluter igen av sig själva."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN зупиниться на кілька хвилин. Конфігурації пристроїв не зміняться, вони перепідключаться самі."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN 会暂停几分钟。设备保留各自的配置，并会自动重新连接。"
          }
        }
      }
    },
