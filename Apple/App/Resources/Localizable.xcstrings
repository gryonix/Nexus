          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzija %@. Automatska ažuriranja nisu postavljena u ovoj verziji izgradnje — ne sadrži izvor ažuriranja ni ključ za potpisivanje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Različica %@. Samodejne posodobitve v tej gradnji niso nastavljene — ne vsebuje vira posodobitev ali ključa za podpisovanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verzió. Ebben a buildben nincsenek beállítva automatikus frissítések — nem tartalmaz frissítési forrást vagy aláíró kulcsot."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verze %@. V této sestavě nejsou nastaveny automatické aktualizace — neobsahuje zdroj aktualizací ani podpisový klíč."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wersja %@. Automatyczne aktualizacje nie są skonfigurowane w tej wersji — nie zawiera źródła aktualizacji ani klucza podpisującego."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versão %@. As atualizações automáticas não estão configuradas nesta compilação — não transporta fonte de atualização nem chave de assinatura."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έκδοση %@. Οι αυτόματες ενημερώσεις δεν έχουν ρυθμιστεί σε αυτή την έκδοση — δεν φέρει πηγή ενημέρωσης ή κλειδί υπογραφής."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versioon %@. Automaatvärskendused pole selles versioonis seadistatud — see ei kanna värskenduse allikat ega allkirjastamisvõtit."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzia %@. V tejto zostave nie sú nastavené automatické aktualizácie — neobsahuje zdroj aktualizácií ani podpisový kľúč."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versija %@. Šajā versijā nav iestatīti automātiskie atjauninājumi — tai nav atjauninājumu avota vai parakstīšanas atslēgas."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leagan %@. Níl nuashonruithe uathoibríocha socraithe sa leagan seo — ní iompraíonn sé foinse nuashonraithe ná eochair shínithe."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versija %@. Šioje versijoje automatiniai atnaujinimai nesukonfigūruoti — ji neneša nei atnaujinimo šaltinio, nei pasirašymo rakto."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verżjoni %@. L-aġġornamenti awtomatiċi mhumiex imwaqqfa f'din il-build — ma ġġorr l-ebda sors ta' aġġornament jew ċavetta ta' firma."
          }
        }
      }
    },
    "No tunnel yet. Open a device on one of your servers and choose “Use on this device”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch kein Tunnel. Öffnen Sie ein Gerät auf einem Ihrer Server und wählen Sie „Auf diesem Gerät verwenden“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay ningún túnel. Abra un dispositivo en uno de sus servidores y elija «Usar en este dispositivo»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun tunnel pour l’instant. Ouvrez un appareil sur l’un de vos serveurs et choisissez « Utiliser sur cet appareil »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun tunnel per ora. Apri un dispositivo su uno dei tuoi server e scegli «Usa su questo dispositivo»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだトンネルがありません。いずれかのサーバーでデバイスを開き、「この端末で使う」を選んでください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Туннеля пока нет. Откройте устройство на одном из своих серверов и выберите «Использовать на этом устройстве»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тунелю ще немає. Відкрийте пристрій на одному зі своїх серверів і виберіть «Використати на цьому пристрої»."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有隧道。在你的某台服务器上打开一个设备，然后选择「在本设备上使用」。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei vielä tunnelia. Avaa laite jollain palvelimistasi ja valitse “Käytä tällä laitteella”."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все още няма тунел. Отворете устройство на един от сървърите си и изберете „Използвай на това устройство“."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încă niciun tunel. Deschide un dispozitiv de pe unul dintre serverele tale și alege „Use on this device”."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen tunnel endnu. Åbn en enhed på en af dine servere, og vælg “Brug på denne enhed”."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen tunnel. Open een apparaat op een van je servers en kies “Gebruik op dit apparaat”."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen tunnel än. Öppna en enhet på en av dina servrar och välj “Använd på den här enheten”."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još nema tunela. Otvorite uređaj na jednom od svojih poslužitelja i odaberite “Koristi na ovom uređaju”."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Še ni tunela. Odprite napravo na enem od svojih strežnikov in izberite »Uporabi na tej napravi«."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincs alagút. Nyisson meg egy eszközt az egyik szerverén, és válassza a „Használat ezen az eszközön” lehetőséget."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím žádný tunel. Otevřete zařízení na jednom ze svých serverů a zvolte „Použít na tomto zařízení“."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeszcze brak tunelu. Otwórz urządzenie na jednym ze swoich serwerów i wybierz „Użyj na tym urządzeniu”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda sem túnel. Abra um dispositivo num dos seus servidores e escolha “Usar neste dispositivo”."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καμία σήραγγα ακόμη. Ανοίξτε μια συσκευή σε έναν από τους διακομιστές σας και επιλέξτε «Χρήση σε αυτή τη συσκευή»."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnelit veel pole. Ava seade ühel oma serveritest ja vali „Kasuta selles seadmes”."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatiaľ žiadny tunel. Otvorte zariadenie na jednom zo svojich serverov a zvoľte „Použiť na tomto zariadení“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vēl nav tuneļa. Atveriet ierīci kādā no jūsu serveriem un izvēlieties “Izmantot šajā ierīcē”."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níl aon tollán fós. Oscail gléas ar cheann de d'fhreastalaithe agus roghnaigh “Úsáid ar an ngléas seo”."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunelio dar nėra. Atverkite įrenginį viename iš savo serverių ir pasirinkite „Naudoti šiame įrenginyje“."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-ebda tunnel għad. Iftaħ apparat fuq wieħed mis-servers tiegħek u agħżel “Use on this device”."
          }
        }
      }
    },
