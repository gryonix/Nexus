          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Играчите се нуждаят от същите модове в собствената си игра, за да се присъединят."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igrači trebaju iste modove u vlastitoj igri da bi se pridružili."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igralci potrebujejo iste mode v svoji igri, da se lahko pridružijo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spillere skal have de samme mods i deres eget spil for at deltage."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelers hebben dezelfde mods in hun eigen spel nodig om mee te doen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelare behöver samma mods i sitt eget spel för att kunna gå med."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mängijad vajavad liitumiseks samu mode oma mängus."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teastaíonn na mods céanna ó imreoirí ina gcluiche féin le páirt a ghlacadh."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-plejers għandhom bżonn l-istess mods fil-logħba tagħhom biex jingħaqdu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os jogadores precisam dos mesmos mods no seu próprio jogo para participar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι παίκτες χρειάζονται τα ίδια mods στο δικό τους παιχνίδι για να συμμετάσχουν."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A játékosoknak ugyanazokra a modokra van szükségük a saját játékukban a csatlakozáshoz."
          }
        },
        "ro" : {
          "stringUnit" : {
