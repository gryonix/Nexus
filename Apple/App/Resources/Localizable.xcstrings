    "A database was found that cannot be dumped separately, so a consistent archive needs the stack stopped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde eine Datenbank gefunden, die sich nicht separat exportieren lässt. Für ein konsistentes Archiv muss der Stack daher angehalten werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se encontró una base de datos que no se puede volcar por separado, así que un archivo coherente requiere detener la pila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une base de données qui ne peut pas être exportée séparément a été trouvée : une archive cohérente nécessite donc l’arrêt de la pile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È stato trovato un database che non può essere esportato separatamente, quindi un archivio coerente richiede l’arresto dello stack."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個別にダンプできないデータベースが見つかったため、整合性のあるアーカイブにはスタックの停止が必要です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдена база данных, которую нельзя выгрузить отдельно, поэтому для согласованного архива стек нужно остановить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знайдено базу даних, яку не можна вивантажити окремо, тому для узгодженого архіву стек треба зупинити."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发现了无法单独导出的数据库，因此要获得一致的归档需要停止该堆栈。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löytyi tietokanta, jota ei voi vedostaa erikseen, joten yhtenäinen arkisto vaatii pinon pysäyttämisen."
          }
        },
        "bg" : {
