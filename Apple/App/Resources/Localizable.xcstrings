        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーがこれより小さい場合は Forgejo を選んでください。同じ Git ホスティングをごくわずかなメモリで動かせます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если сервер меньше — выберите Forgejo: тот же git-хостинг при доле этой памяти."
