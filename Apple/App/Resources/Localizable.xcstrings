          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimic nu a fost instalat pe acea mașină — rularea s-a oprit înainte de a crea ceva."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ništa nije instalirano na tom stroju — izvršavanje se zaustavilo prije nego što je nešto stvorilo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
