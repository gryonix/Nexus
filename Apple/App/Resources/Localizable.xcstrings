    "No free SSD or NVMe besides the system disk." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Освен системния диск няма свободен SSD или NVMe."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kromě systémového disku není volný SSD ani NVMe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen ledig SSD eller NVMe ud over systemdisken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Außer dem Systemlaufwerk gibt es keine freie SSD oder NVMe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει ελεύθερος SSD ή NVMe εκτός από τον δίσκο συστήματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay SSD ni NVMe libre aparte del disco del sistema."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peale süsteemiketta pole vaba SSD-d ega NVMe-d."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
