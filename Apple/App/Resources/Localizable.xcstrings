    "Makes this server's services reachable from your devices by their usual names, even where those names do not resolve publicly. The addresses stay private to the mesh." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht die Dienste dieses Servers von Ihren Geräten unter ihren gewohnten Namen erreichbar, auch wo diese Namen öffentlich nicht auflösen. Die Adressen bleiben im Mesh privat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace que los servicios de este servidor sean accesibles desde tus dispositivos con sus nombres habituales, incluso donde esos nombres no se resuelven públicamente. Las direcciones siguen siendo privadas de la malla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rend les services de ce serveur accessibles depuis vos appareils sous leurs noms habituels, même là où ces noms ne se résolvent pas publiquement. Les adresses restent privées au maillage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rende i servizi di questo server raggiungibili dai tuoi dispositivi con i nomi consueti, anche dove quei nomi non si risolvono pubblicamente. Gli indirizzi restano privati della rete mesh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーのサービスに、公開DNSで解決できない場所でも、いつもの名前でデバイスから到達できるようにします。アドレスはメッシュ内に留まります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делает сервисы этого сервера доступными с ваших устройств по привычным именам — даже там, где эти имена публично не резолвятся. Адреса остаются приватными для mesh-сети."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Робить сервіси цього сервера доступними з ваших пристроїв за звичними іменами — навіть там, де ці імена публічно не резолвяться. Адреси лишаються приватними для mesh-мережі."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让本服务器的服务可以从你的设备用一贯的名称访问，即使这些名称在公网无法解析。地址仅存在于网状网络内。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekee tämän palvelimen palvelut tavoitettaviksi laitteiltasi niiden tavallisilla nimillä, myös siellä missä nimet eivät ratkea julkisesti. Osoitteet pysyvät yksityisinä verkon sisällä."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прави услугите на този сървър достижими от устройствата ви по обичайните им имена, дори там, където тези имена не се разрешават публично. Адресите остават частни за мрежата."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt de diensten van deze server bereikbaar vanaf je apparaten onder hun gebruikelijke namen, ook waar die namen publiekelijk niet oplosbaar zijn. De adressen blijven privé binnen het mesh."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør denne servers tjenester tilgængelige fra dine enheder under deres sædvanlige navne, selv hvor de navne ikke opløses offentligt. Adresserne forbliver private i meshet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör den här serverns tjänster nåbara från dina enheter under sina vanliga namn, även där de namnen inte går att slå upp offentligt. Adresserna förblir privata inom meshet."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čini usluge ovog poslužitelja dostupnima s vaših uređaja pod njihovim uobičajenim imenima, čak i tamo gdje se ta imena javno ne razrješavaju. Adrese ostaju privatne za mrežu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naredi storitve tega strežnika dosegljive z vaših naprav pod njihovimi običajnimi imeni, tudi kjer se ta imena javno ne razrešujejo. Naslovi ostanejo zasebni za mrežo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face serviciile acestui server accesibile de pe dispozitivele tale sub numele lor obișnuite, chiar și acolo unde acele nume nu se rezolvă public. Adresele rămân private în rețeaua mesh."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elérhetővé teszi ennek a szervernek a szolgáltatásait az eszközeidről a szokásos neveiken, még ott is, ahol ezek a nevek nem oldódnak fel nyilvánosan. A címek privátak maradnak a hálózaton belül."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawia, że usługi tego serwera są osiągalne z Twoich urządzeń pod ich zwykłymi nazwami, nawet tam, gdzie te nazwy nie rozwiązują się publicznie. Adresy pozostają prywatne w obrębie sieci mesh."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožňuje, aby byly služby tohoto serveru dostupné z vašich zařízení pod jejich obvyklými názvy, i tam, kde se tyto názvy veřejně nepřekládají. Adresy zůstávají soukromé v rámci sítě mesh."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muudab selle serveri teenused sinu seadmetest kättesaadavaks nende tavaliste nimede järgi, isegi seal, kus need nimed avalikult ei lahene. Aadressid jäävad mesh-võrgu piires privaatseks."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprístupní služby tohto servera z vašich zariadení pod ich obvyklými názvami, aj tam, kde sa tieto názvy verejne nedajú preložiť. Adresy zostávajú súkromné iba v rámci siete mesh."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάνει τις υπηρεσίες αυτού του διακομιστή προσβάσιμες από τις συσκευές σας με τα συνηθισμένα τους ονόματα, ακόμη κι εκεί όπου αυτά τα ονόματα δεν επιλύονται δημόσια. Οι διευθύνσεις παραμένουν ιδιωτικές στο mesh."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna os serviços deste servidor acessíveis a partir dos seus dispositivos pelos seus nomes habituais, mesmo onde esses nomes não são resolvidos publicamente. Os endereços mantêm-se privados dentro da malha."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padara šī servera pakalpojumus sasniedzamus no jūsu ierīcēm ar to ierastajiem nosaukumiem, pat ja šie nosaukumi publiski neatrisinās. Adreses paliek privātas tīklā (mesh)."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fágann sé seirbhísí an fhreastalaí seo insroichte ó do ghléasanna faoina ngnáthainmneacha, fiú áit nach réitíonn na hainmneacha sin go poiblí. Fanann na seoltaí príobháideach don mheirgeach."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jagħmel is-servizzi ta' dan is-server aċċessibbli mill-apparati tiegħek bl-ismijiet tas-soltu tagħhom, anke fejn dawk l-ismijiet ma jsolvux pubblikament. L-indirizzi jibqgħu privati għall-mesh."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padaro šio serverio paslaugas pasiekiamas iš jūsų įrenginių jų įprastais vardais, net ten, kur tie vardai viešai neišsprendžiami. Adresai lieka privatūs šiam tinklui (mesh)."
          }
        }
      }
    },
