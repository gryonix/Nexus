    "Players need the same mods in their own game to join." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spieler brauchen dieselben Mods in ihrem eigenen Spiel, um beizutreten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los jugadores necesitan los mismos mods en su propio juego para entrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les joueurs doivent avoir les mêmes mods dans leur propre jeu pour se connecter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giocatori devono avere le stesse mod nel proprio gioco per entrare."
