    },
    "This device is added to the list the first time it opens this screen. Removing one only forgets it — it does not revoke its SSH access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät wird beim ersten Öffnen dieses Bildschirms in die Liste aufgenommen. Ein Gerät zu entfernen vergisst es nur — sein SSH-Zugang bleibt bestehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo se añade a la lista la primera vez que abre esta pantalla. Quitar uno solo lo olvida: no revoca su acceso SSH."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil est ajouté à la liste la première fois qu'il ouvre cet écran. En retirer un ne fait que l'oublier — cela ne révoque pas son accès SSH."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo viene aggiunto all'elenco la prima volta che apre questa schermata. Rimuoverne uno lo dimentica soltanto: non revoca il suo accesso SSH."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末は、この画面を最初に開いたときに一覧へ追加されます。削除しても記録から消えるだけで、SSH アクセスは取り消されません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство попадает в список при первом открытии этого экрана. Удаление лишь забывает устройство — SSH-доступ у него остаётся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей пристрій потрапляє до списку під час першого відкриття цього екрана. Видалення лише забуває пристрій — SSH-доступ у нього залишається."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本设备会在首次打开此界面时加入列表。移除某台设备只是不再记录它，并不会撤销其 SSH 访问权限。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä laite lisätään listaan ensimmäisellä kerralla, kun se avaa tämän näytön. Yhden poistaminen vain unohtaa sen — se ei peruuta sen SSH-pääsyä."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това устройство се добавя в списъка при първото отваряне на този екран. Премахването само го забравя — не отнема неговия SSH достъп."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest dispozitiv este adăugat la listă prima dată când deschide acest ecran. Eliminarea unuia doar îl uită — nu îi revocă accesul SSH."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj uređaj dodaje se na popis prvi put kad otvori ovaj zaslon. Uklanjanje samo ga zaboravlja — ne oduzima mu SSH pristup."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed føjes til listen, første gang den åbner denne skærm. At fjerne en glemmer den blot — det tilbagekalder ikke dens SSH-adgang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat wordt aan de lijst toegevoegd de eerste keer dat het dit scherm opent. Een apparaat verwijderen vergeet het alleen — het trekt de SSH-toegang niet in."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enheten läggs till i listan första gången den öppnar den här skärmen. Att ta bort en glömmer bara bort den — det återkallar inte dess SSH-åtkomst."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta naprava se doda na seznam, ko prvič odpre ta zaslon. Odstranitev jo samo pozabi — ne prekliče njenega dostopa SSH."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az eszköz akkor kerül fel a listára, amikor először megnyitja ezt a képernyőt. Egynek az eltávolítása csak elfelejti — nem vonja vissza az SSH hozzáférését."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zařízení se přidá do seznamu při prvním otevření této obrazovky. Odebrání ho jen zapomene — neodebere jeho přístup přes SSH."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie jest dodawane do listy przy pierwszym otwarciu tego ekranu. Usunięcie tylko o nim zapomina — nie odbiera dostępu SSH."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo é adicionado à lista na primeira vez que abre este ecrã. Remover um apenas o esquece — não revoga o seu acesso SSH."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή προστίθεται στη λίστα την πρώτη φορά που ανοίγει αυτή την οθόνη. Η αφαίρεση μιας απλώς τη ξεχνά — δεν ανακαλεί την πρόσβασή της SSH."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See seade lisatakse loendisse esimest korda, kui see selle ekraani avab. Eemaldamine ainult unustab selle — see ei tühista selle SSH-juurdepääsu."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zariadenie sa pridá do zoznamu pri prvom otvorení tejto obrazovky. Odstránením jedného ho iba zabudnete — neodoberá to jeho SSH prístup."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šī ierīce tiek pievienota sarakstam, pirmo reizi atverot šo ekrānu. Noņemot to, tā tiek tikai aizmirsta — tas neatceļ tās SSH piekļuvi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuirtear an gléas seo leis an liosta an chéad uair a osclaíonn sé an scáileán seo. Ní dhéanann baint ceann amháin ach dearmad a dhéanamh air — ní chúlghairtear a rochtain SSH."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis įrenginys pridedamas į sąrašą pirmą kartą atvėrus šį ekraną. Pašalinus jį, jis tik pamirštamas — jo SSH prieiga neatšaukiama."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dan l-apparat jiżdied mal-lista l-ewwel darba li jiftaħ dan l-iskrin. It-tneħħija ta' wieħed biss tinsieh — ma tirrevokax l-aċċess SSH tiegħu."
          }
        }
      }
    },
