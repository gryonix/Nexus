    "A swap file lets a small server run what needs more memory, only slower. It stays after a restart." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлът за swap позволява на малък сървър да изпълнява това, което иска повече памет, само по-бавно. Остава и след рестарт."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swapový soubor umožní malému serveru spustit to, co potřebuje víc paměti, jen pomaleji. Zůstane i po restartu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En swapfil lader en lille server køre det, der kræver mere hukommelse, bare langsommere. Den bliver efter en genstart."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Swap-Datei lässt einen kleinen Server laufen, was mehr Speicher braucht – nur langsamer. Sie bleibt nach einem Neustart erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα αρχείο swap επιτρέπει σε έναν μικρό διακομιστή να τρέχει ό,τι χρειάζεται περισσότερη μνήμη, απλώς πιο αργά. Παραμένει μετά από επανεκκίνηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo de swap permite a un servidor pequeño ejecutar lo que necesita más memoria, solo que más lento. Se conserva tras reiniciar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap-fail laseb väikesel serveril käitada seda, mis vajab rohkem mälu, lihtsalt aeglasemalt. See jääb alles ka pärast taaskäivitust."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap-tiedosto antaa pienen palvelimen ajaa sen, mikä tarvitsee enemmän muistia, vain hitaammin. Se säilyy uudelleenkäynnistyksen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier de swap permet à un petit serveur de faire tourner ce qui demande plus de mémoire, simplement plus lentement. Il reste après un redémarrage."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligeann comhad swap d'fhreastalaí beag rud a rith a bhfuil níos mó cuimhne de dhíth air, ach níos moille. Fanann sé tar éis atosú."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap datoteka omogućuje malom poslužitelju da pokrene ono što treba više memorije, samo sporije. Ostaje i nakon ponovnog pokretanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy swapfájllal egy kis szerver is futtathatja azt, aminek több memória kell, csak lassabban. Újraindítás után is megmarad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file di swap consente a un server piccolo di eseguire ciò che richiede più memoria, solo più lentamente. Resta dopo un riavvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スワップファイルがあると、小さなサーバーでもより多くのメモリが必要なものを動かせます（遅くはなります）。再起動後も残ります。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap failas leidžia mažam serveriui paleisti tai, kam reikia daugiau atminties, tik lėčiau. Jis lieka ir po perkrovimo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap fails ļauj mazam serverim darbināt to, kam vajag vairāk atmiņas, tikai lēnāk. Tas paliek arī pēc restartēšanas."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fajl tas-swap iħalli server żgħir iħaddem dak li jeħtieġ aktar memorja, iżda aktar bil-mod. Jibqa' wara restart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met een swapbestand kan een kleine server draaien wat meer geheugen nodig heeft, alleen trager. Het blijft na een herstart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik swap pozwala małemu serwerowi uruchomić to, co wymaga więcej pamięci, tylko wolniej. Zostaje po ponownym uruchomieniu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ficheiro de swap permite a um servidor pequeno correr o que precisa de mais memória, só que mais devagar. Mantém-se após reiniciar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fișier swap permite unui server mic să ruleze ce are nevoie de mai multă memorie, doar mai lent. Rămâne și după repornire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл подкачки позволяет маленькому серверу запускать то, чему нужно больше памяти, — только медленнее. Он остаётся после перезагрузки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swapový súbor umožní malému serveru spustiť to, čo potrebuje viac pamäte, len pomalšie. Zostane aj po reštarte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoteka swap omogoči majhnemu strežniku zagon tistega, kar potrebuje več pomnilnika, le počasneje. Ostane tudi po ponovnem zagonu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En swapfil låter en liten server köra det som behöver mer minne, bara långsammare. Den finns kvar efter en omstart."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл підкачки дає змогу малому серверу запускати те, чому потрібно більше пам'яті, — лише повільніше. Він лишається після перезавантаження."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交换文件让小服务器也能运行需要更多内存的程序，只是更慢。重启后依然保留。"
          }
        }
      }
    },
