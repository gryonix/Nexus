    "Serves plain DNS only — right for a machine on your own network, which your router points at. Devices elsewhere need AdGuard Home instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt nur klassisches DNS bereit — richtig für eine Maschine im eigenen Netzwerk, auf die der Router zeigt. Für Geräte anderswo eignet sich AdGuard Home."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sirve solo DNS clásico: adecuado para una máquina de su propia red, a la que apunta su router. Los dispositivos de fuera necesitan AdGuard Home."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne sert que du DNS classique — adapté à une machine de votre réseau, vers laquelle pointe votre routeur. Pour les appareils ailleurs, il faut AdGuard Home."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve solo DNS classico: adatto a una macchina della tua rete, verso cui punta il router. Per i dispositivi altrove serve AdGuard Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常の DNS だけを提供します — ルーターが指す自宅ネットワーク内のマシンに向いています。外にある端末には AdGuard Home が必要です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отдаёт только обычный DNS — подходит для машины в вашей сети, на которую смотрит роутер. Устройствам вне сети нужен AdGuard Home."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Віддає лише звичайний DNS — підходить для машини у вашій мережі, на яку дивиться роутер. Пристроям поза мережею потрібен AdGuard Home."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只提供普通 DNS——适合放在你自己网络里、由路由器指向的机器。网络之外的设备需要用 AdGuard Home。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarjoaa vain tavallista DNS:ää — sopii koneelle omassa verkossasi, johon reitittimesi osoittaa. Laitteet muualla tarvitsevat AdGuard Homen sen sijaan."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обслужва само обикновен DNS — подходящо за машина във вашата собствена мрежа, към която сочи рутерът ви. Устройства другаде се нуждаят от AdGuard Home вместо това."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servește doar DNS simplu — potrivit pentru o mașină din propria ta rețea, către care routerul tău indică. Dispozitivele din altă parte au nevoie în schimb de AdGuard Home."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biedt alleen gewone DNS aan — geschikt voor een machine op je eigen netwerk, waar je router naar wijst. Apparaten elders hebben in plaats daarvan AdGuard Home nodig."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server kun almindelig DNS — rigtigt til en maskine på dit eget netværk, som din router peger på. Enheder andre steder har brug for AdGuard Home i stedet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverar bara vanlig DNS — rätt för en maskin på ditt eget nätverk, som din router pekar på. Enheter på andra håll behöver AdGuard Home i stället."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužuje samo obični DNS — prikladno za stroj u vašoj vlastitoj mreži, na koji usmjerava vaš usmjerivač. Uređaji drugdje umjesto toga trebaju AdGuard Home."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streže samo navaden DNS — primerno za stroj v vašem lastnem omrežju, na katerega kaže vaš usmerjevalnik. Naprave drugje namesto tega potrebujejo AdGuard Home."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskytuje iba obyčajné DNS — vhodné pre stroj vo vašej vlastnej sieti, na ktorý smeruje váš router. Zariadenia inde potrebujú namiesto toho AdGuard Home."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak sima DNS-t szolgáltat — megfelelő a saját hálózatán lévő gépnek, amelyre az útválasztója mutat. A máshol lévő eszközöknek helyette AdGuard Home-ra van szükségük."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskytuje jen obyčejné DNS — vhodné pro stroj ve vaší vlastní síti, na který ukazuje váš router. Zařízení jinde potřebují místo toho AdGuard Home."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakub ainult tavalist DNS-i — sobib masinale su enda võrgus, kuhu su ruuter osutab. Mujal olevad seadmed vajavad selle asemel AdGuard Home'i."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsługuje tylko zwykły DNS — odpowiednie dla maszyny w Twojej własnej sieci, na którą wskazuje Twój router. Urządzenia gdzie indziej potrzebują zamiast tego AdGuard Home."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εξυπηρετεί μόνο απλό DNS — κατάλληλο για μηχάνημα στο δικό σας δίκτυο, στο οποίο δείχνει ο δρομολογητής σας. Συσκευές αλλού χρειάζονται το AdGuard Home αντ’ αυτού."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve apenas DNS simples — adequado para uma máquina na sua própria rede, para a qual o seu router aponta. Dispositivos noutros locais precisam antes do AdGuard Home."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní fhreastalaíonn sé ach ar DNS gan iarmhairtí — ceart do mheaisín ar do líonra féin, a bhfuil do ródaire ag díriú air. Teastaíonn AdGuard Home ina ionad ó ghléasanna in áiteanna eile."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sniedz tikai vienkāršu DNS — piemērots mašīnai jūsu pašu tīklā, uz kuru norāda jūsu maršrutētājs. Ierīcēm citur tā vietā nepieciešams AdGuard Home."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teikia tik paprastą DNS — tinka mašinai jūsų pačių tinkle, į kurią nukreiptas jūsų maršrutizatorius. Įrenginiams kitur reikia AdGuard Home."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isservi biss DNS sempliċi — tajjeb għal magna fuq in-network tiegħek stess, li r-router tiegħek jindika lejha. Apparati band'oħra jeħtieġu AdGuard Home minflok."
          }
        }
      }
    },
    "Service data and backups stay on disk, so a later reinstall can pick them up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Daten und Backups des Dienstes bleiben auf der Festplatte, sodass eine spätere Neuinstallation sie wieder aufgreifen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos y las copias de seguridad del servicio permanecen en el disco, de modo que una reinstalación posterior podrá recuperarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données et sauvegardes du service restent sur le disque, afin qu'une réinstallation ultérieure puisse les récupérer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati e i backup del servizio restano sul disco, così una reinstallazione successiva potrà recuperarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービスのデータとバックアップはディスクに残るため、後で再インストールすれば引き継げます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные сервиса и резервные копии остаются на диске, поэтому последующая переустановка сможет их подхватить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дані сервісу та резервні копії залишаються на диску, тому подальше перевстановлення зможе їх підхопити."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务的数据和备份仍保留在磁盘上，因此以后重新安装时可以继续使用它们。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelun data ja varmuuskopiot jäävät levylle, joten myöhempi uudelleenasennus voi ottaa ne käyttöön."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данните на услугата и резервните копия остават на диска, за да могат по-късна преинсталация да ги поеме."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele serviciului și backup-urile rămân pe disc, astfel încât o reinstalare ulterioară le poate prelua."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dienstgegevens en back-ups blijven op de schijf staan, zodat een latere herinstallatie ze weer kan oppikken."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjenestedata og sikkerhedskopier forbliver på disken, så en senere geninstallation kan tage dem op igen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjänstdata och säkerhetskopior finns kvar på disken, så en senare ominstallation kan fånga upp dem igen."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podaci usluge i sigurnosne kopije ostaju na disku, tako da ih kasnija ponovna instalacija može preuzeti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podatki storitve in varnostne kopije ostanejo na disku, tako da jih poznejša ponovna namestitev lahko prevzame."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dáta služby a zálohy zostávajú na disku, takže neskoršia preinštalácia ich môže znova použiť."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szolgáltatás adatai és biztonsági mentései a lemezen maradnak, így egy későbbi újratelepítés felveheti őket."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data a zálohy služby zůstávají na disku, takže je pozdější přeinstalace může použít."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teenuse andmed ja varukoopiad jäävad kettale, nii et hilisem uuestipaigaldus saab need üles võtta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane usługi i kopie zapasowe pozostają na dysku, więc późniejsza ponowna instalacja może z nich skorzystać."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δεδομένα και τα αντίγραφα ασφαλείας της υπηρεσίας παραμένουν στον δίσκο, ώστε μια μεταγενέστερη επανεγκατάσταση να μπορεί να τα παραλάβει."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados do serviço e as cópias de segurança permanecem em disco, para que uma reinstalação posterior os possa recuperar."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanann sonraí seirbhíse agus cúltacaí ar an diosca, ionas gur féidir le hathshuiteáil níos déanaí iad a phiocadh suas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakalpojuma dati un dublējumi paliek diskā, lai vēlāka atkārtota instalācija tos varētu izmantot."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paslaugos duomenys ir atsarginės kopijos lieka diske, todėl vėlesnis diegimas iš naujo gali jais pasinaudoti."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Id-data tas-servizz u l-backups jibqgħu fuq id-disk, biex installazzjoni mill-ġdid aktar tard tkun tista' terġa' tużahom."
          }
        }
      }
    },
    "Service logs need macOS 15 or newer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dienstprotokolle erfordern macOS 15 oder neuer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros del servicio requieren macOS 15 o posterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les journaux de service nécessitent macOS 15 ou plus récent."
          }
        },
        "it" : {
