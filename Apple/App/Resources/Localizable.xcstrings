    "Every device can use its own DNS. A choice here changes only devices added after it." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всяко устройство може да има собствен DNS. Изборът тук променя само устройствата, добавени след него."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé zařízení může mít vlastní DNS. Volba zde mění jen zařízení přidaná potom."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver enhed kan have sin egen DNS. Et valg her ændrer kun enheder, der tilføjes bagefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Gerät kann sein eigenes DNS nutzen. Eine Auswahl hier gilt nur für danach hinzugefügte Geräte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε συσκευή μπορεί να έχει δικό της DNS. Η επιλογή εδώ αλλάζει μόνο τις συσκευές που προστίθενται μετά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada dispositivo puede usar su propio DNS. Lo que elijas aquí solo cambia los dispositivos que añadas después."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igal seadmel võib olla oma DNS. Siinne valik muudab ainult pärast seda lisatud seadmeid."
