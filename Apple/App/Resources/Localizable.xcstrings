    "Arrays found on the disks are brought back as they are — assembled and mounted, never formatted. Their disks are not offered for a new array." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полетата намерени на дисковете се върнат както са — събрани и монтирани, никога не форматирани. Техните дискове не се предлагат за ново поле."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pole nalezená na discích jsou obnovena takové, jaké jsou — sestavena a připojena, nikdy ne formátována. Jejich disky nejsou nabídnuty pro nové pole."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrays fundet på diskene genopbygges som de er — monteret og monteret, aldrig formateret. Deres diske bliver ikke tilbudt til et nyt array."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf den Platten gefundene Arrays werden so übernommen, wie sie sind — zusammengesetzt und eingehängt, nie formatiert. Ihre Platten stehen für kein neues Array zur Wahl."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι πίνακες που βρίσκονται στους δίσκους επανέρχονται όπως είναι — συναρμολογημένοι και τοποθετημένοι, ποτέ δεν μορφοποιούνται. Οι δίσκοι τους δεν προσφέρονται για έναν νέο πίνακα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los arrays encontrados en los discos se recuperan tal cual — ensamblados y montados, nunca formateados. Sus discos no se ofrecen para un nuevo array."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Massiivid, mis asuvad ketastel, taastatakse sellisena, nagu nad on — kokku pandud ja paigaldatud, mitte kunagi vormindatud. Nende kettad ei pakuta uuele massiivile."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taulukot, jotka löytyvät levyiltä, palautetaan sellaisena kuin ne ovat — koottu ja liitetty, ei koskaan alustettuja. Niiden levyjä ei tarjota uudelle taulukolle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les ensembles trouvés sur les disques sont ramenés tels quels — assemblés et montés, jamais formatés. Leurs disques ne sont pas offerts pour un nouvel ensemble."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sraitheanna aimsithe ar na dioscaí tugtar ar ais ar a bhealach — tógtha agus feistithe, ní riamh formáidithe. Ní thairgtear a gcuid dioscaí do shraith nua."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nizovi pronađeni na diskovima se vraćaju kakvi jesu — sastavljen i priključen, nikada oblikovan. Njegovi diskovi se ne nude za novi niz."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lemezeken talált tömbök visszakerülnek olyanokra, amilyenek — összeállítva és csatlakoztatva, soha nem formázva. Lemezei nem kerülnek felajánlásra új tömbhöz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli array trovati sui dischi vengono ripristinati così come sono — assemblati e montati, mai formattati. I loro dischi non vengono offerti per un nuovo array."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスク上に見つかったアレイは、組み立てと開始を行いますが、フォーマットはしません。それらのディスクは新しいアレイに提供されません。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masyvai rasti diske yra grąžinti tokie, kokie jie yra — surinkti ir primontuoti, niekada neformatuoti. Jų diskos nėra siūlomos naujam masyvui."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masīvi, kas atrodas diskos, tiek atgūti tādi, kādi viņi ir — samontēti un piestiprināti, nekad neformatēti. Viņu diski netiek piedāvāti jaunam masīvam."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrayer misjuba fuq id-disketti huma ġibu lura bħala mhux — miġbura u ppjantata, qatt mhux formattata. Id-disketti tagħhom ma jintgħarfu għal array ġdid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrays gevonden op de schijven worden teruggebracht zoals ze zijn — samengesteld en gemonteerd, nooit geformatteerd. Hun schijven worden niet aangeboden voor een nieuwe array."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tablice znalezione na dyskach są przywracane takie jakie są — zmontowane i zamontowane, nigdy nie sformatowane. Ich dyski nie są oferowane dla nowej macierzy."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arrays encontrados nos discos são devolvidos como estão — montados e ativados, nunca formatados. Seus discos não são oferecidos para um novo array."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matricele găsite pe discuri sunt readuse ca fiind — asamblate și montate, niciodată formatate. Discurile lor nu sunt oferite pentru o matrice nouă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найденные на дисках массивы подключаются как есть — собираются и монтируются, никогда не форматируются. Их диски не предлагаются для нового массива."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polia nájdené na diskoch sa vrátia také, aké sú — zostavené a priradené, nikdy neformátované. Ich disky sa neponúkajú pre nové pole."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polja, najdena na diskih, se vrnejo kot so — montirana in pritrjena, nikoli niso formatirana. Njihovi diski se ne ponujajo za novo polje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrays som finns på diskarna återställs som de är — monterad och monterad, aldrig formaterad. Deras diskar erbjuds inte för en ny array."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Масиви, знайдені на дисках, відновлюються як є — зібрані та змонтовані, ніколи не відформатовані. Їхні диски не пропонуються для нового масиву."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘上找到的阵列会被恢复原样——组装并挂载，从不格式化。它们的磁盘不会提供给新阵列。"
          }
        }
      }
    },
    "As added" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie hinzugefügt"
