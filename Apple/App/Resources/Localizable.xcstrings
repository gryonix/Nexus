    "The path survives a reboot only under /dev/serial/by-id — a plain /dev/ttyUSB0 can point at a different stick after the next start." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur unter /dev/serial/by-id übersteht der Pfad einen Neustart — ein schlichtes /dev/ttyUSB0 kann nach dem nächsten Start auf einen anderen Stick zeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ruta sobrevive a un reinicio solo bajo /dev/serial/by-id: un /dev/ttyUSB0 a secas puede apuntar a otro adaptador tras el siguiente arranque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chemin ne survit à un redémarrage que sous /dev/serial/by-id — un simple /dev/ttyUSB0 peut désigner une autre clé au prochain démarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il percorso sopravvive a un riavvio solo sotto /dev/serial/by-id: un semplice /dev/ttyUSB0 può puntare a un'altra chiavetta al prossimo avvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再起動後も変わらないのは /dev/serial/by-id の下のパスだけです。単なる /dev/ttyUSB0 は次回の起動で別のスティックを指すことがあります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Путь переживает перезагрузку только под /dev/serial/by-id — обычный /dev/ttyUSB0 после следующего старта может указывать на другой стик."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шлях переживає перезавантаження лише під /dev/serial/by-id — звичайний /dev/ttyUSB0 після наступного старту може вказувати на інший стік."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有 /dev/serial/by-id 下的路径能在重启后保持不变 — 单纯的 /dev/ttyUSB0 在下次启动后可能指向另一个适配器。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polku selviää uudelleenkäynnistyksestä vain kohdassa /dev/serial/by-id — pelkkä /dev/ttyUSB0 voi osoittaa eri tikkuun seuraavan käynnistyksen jälkeen."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пътят преживява рестарт само под /dev/serial/by-id — обикновено /dev/ttyUSB0 може да сочи към различен стик след следващото стартиране."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calea supraviețuiește unei reporniri doar sub /dev/serial/by-id — un simplu /dev/ttyUSB0 poate indica spre un alt stick după următoarea pornire."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putanja preživljava ponovno pokretanje samo pod /dev/serial/by-id — obični /dev/ttyUSB0 može pokazivati na drugi stick nakon sljedećeg pokretanja."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pot preživi ponovni zagon samo pod /dev/serial/by-id — navaden /dev/ttyUSB0 lahko po naslednjem zagonu kaže na drug ključek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stien overlever kun en genstart under /dev/serial/by-id — en almindelig /dev/ttyUSB0 kan pege på en anden stick efter næste opstart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het pad overleeft een herstart alleen onder /dev/serial/by-id — een gewone /dev/ttyUSB0 kan na de volgende start naar een andere stick wijzen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sökvägen överlever en omstart bara under /dev/serial/by-id — en vanlig /dev/ttyUSB0 kan peka på en annan sticka efter nästa start."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az útvonal csak a /dev/serial/by-id alatt éli túl az újraindítást — egy egyszerű /dev/ttyUSB0 a következő indítás után egy másik stickre mutathat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cesta přežije restart pouze pod /dev/serial/by-id — obyčejné /dev/ttyUSB0 může po příštím spuštění ukazovat na jiný klíč."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ścieżka przetrwa ponowne uruchomienie tylko pod /dev/serial/by-id — zwykłe /dev/ttyUSB0 może po następnym starcie wskazywać na inny klucz."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O caminho sobrevive a um reinício apenas em /dev/serial/by-id — um simples /dev/ttyUSB0 pode apontar para uma pen diferente depois do próximo arranque."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tee püsib taaskäivitusel ainult tee /dev/serial/by-id all — tavaline /dev/ttyUSB0 võib pärast järgmist käivitust osutada teisele pulgale."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cesta prežije reštart iba pod /dev/serial/by-id — obyčajné /dev/ttyUSB0 môže po ďalšom spustení ukazovať na iný kľúč."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διαδρομή επιβιώνει από επανεκκίνηση μόνο κάτω από /dev/serial/by-id — ένα απλό /dev/ttyUSB0 μπορεί να δείχνει σε διαφορετικό ραβδάκι μετά την επόμενη εκκίνηση."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceļš pārdzīvo pārstartēšanu tikai zem /dev/serial/by-id — vienkāršs /dev/ttyUSB0 pēc nākamās palaišanas var norādīt uz citu adapteri."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelias išgyvena paleidimą iš naujo tik po /dev/serial/by-id — paprastas /dev/ttyUSB0 po kito paleidimo gali rodyti į kitą adapterį."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní mhaireann an cosán atosú ach faoi /dev/serial/by-id — is féidir le /dev/ttyUSB0 gan mhaisiú a bheith ag díriú ar bhata difriúil tar éis an chéad tosú eile."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It-triq tgħaddi minn riavvju biss taħt /dev/serial/by-id — /dev/ttyUSB0 sempliċi jista' jindika stick differenti wara l-bidu li jmiss."
          }
        }
      }
    },
