        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premještanje zadržava konfiguraciju svakog uređaja: istu adresu, iste ključeve."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
