    "All backups on this server are deleted permanently. Live data is kept. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Backups auf diesem Server werden dauerhaft gelöscht. Aktive Daten bleiben erhalten. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las copias de seguridad de este servidor se eliminan permanentemente. Los datos activos se conservan. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les sauvegardes de ce serveur sont supprimées définitivement. Les données actives sont conservées. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i backup su questo server vengono eliminati definitivamente. I dati attivi vengono mantenuti. L'operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバー上のすべてのバックアップが完全に削除されます。稼働中のデータは保持されます。この操作は取り消せません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все бэкапы на этом сервере удаляются безвозвратно. Рабочие данные сохраняются. Это действие нельзя отменить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі резервні копії на цьому сервері видаляються безповоротно. Робочі дані зберігаються. Цю дію не можна скасувати."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器上的所有备份将被永久删除。运行数据将保留。此操作无法撤销。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki tämän palvelimen varmuuskopiot poistetaan pysyvästi. Elävä data säilyy. Tätä ei voi perua."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всички резервни копия на този сървър се изтриват окончателно. Живите данни се запазват. Това не може да бъде отменено."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve sigurnosne kopije na ovom poslužitelju trajno se brišu. Živi podaci se zadržavaju. Ovo se ne može poništiti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vse varnostne kopije na tem strežniku so trajno izbrisane. Živi podatki so ohranjeni. Tega ni mogoče razveljaviti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle backups på denne server slettes permanent. Live-data bevares. Dette kan ikke fortrydes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle back-ups op deze server worden permanent verwijderd. Live gegevens blijven behouden. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla säkerhetskopior på den här servern tas bort permanent. Livedata behålls. Detta kan inte ångras."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen a szerveren minden biztonsági mentés véglegesen törlődik. Az élő adatok megmaradnak. Ez nem vonható vissza."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate copiile de rezervă de pe acest server sunt șterse definitiv. Datele live sunt păstrate. Această acțiune nu poate fi anulată."
          }
        },
        "et" : {
          "stringUnit" : {
