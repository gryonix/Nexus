          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun SSD ou NVMe libre en dehors du disque système."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níl SSD ná NVMe saor seachas diosca an chórais."
