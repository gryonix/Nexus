            "state" : "translated",
            "value" : "Ainult WireGuard — teised VPN-protokollid nendeni ei jõua"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Len WireGuard — ostatné VPN protokoly sa k nim nedostanú"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tikai WireGuard — citi VPN protokoli tos nesasniedz"
