    "Updating rebuilds it on the server from the sources this app carries. It is never removed or stopped from here — the app manages this server through it." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Актуализацията го компилира наново на сървъра от изходния код, който носи приложението. Оттук никога не се премахва и не се спира — приложението управлява този сървър чрез него."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizace ho na serveru znovu sestaví ze zdrojů, které aplikace nese. Odsud se nikdy neodstraňuje ani nezastavuje — aplikace přes něj tento server spravuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdatering bygger den igen på serveren ud fra de kilder, appen har med. Den fjernes eller stoppes aldrig herfra — appen administrerer serveren gennem den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Aktualisieren wird er auf dem Server aus den Quellen dieser App neu gebaut. Von hier aus wird er nie entfernt oder gestoppt — die App verwaltet diesen Server über ihn."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ενημέρωση τον μεταγλωττίζει ξανά στον διακομιστή από τον πηγαίο κώδικα που φέρει η εφαρμογή. Από εδώ δεν αφαιρείται ούτε σταματά ποτέ — η εφαρμογή διαχειρίζεται τον διακομιστή μέσω αυτού."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al actualizarlo se recompila en el servidor a partir de las fuentes que lleva esta app. Nunca se elimina ni se detiene desde aquí: la app gestiona este servidor a través de él."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uuendamine ehitab selle serveris uuesti rakenduse kaasas olevatest lähtekoodidest. Siit seda kunagi ei eemaldata ega peatata — rakendus haldab serverit selle kaudu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivitys rakentaa sen palvelimella uudelleen sovelluksen mukana tulevista lähteistä. Sitä ei koskaan poisteta tai pysäytetä täältä — sovellus hallitsee palvelinta sen kautta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise à jour le recompile sur le serveur à partir des sources fournies avec cette app. Il n'est jamais supprimé ni arrêté d'ici — l'app gère ce serveur à travers lui."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atógann nuashonrú é ar an bhfreastalaí ó na foinsí atá ag an aip seo. Ní bhaintear ná ní stoptar é as seo riamh — bainistíonn an aip an freastalaí tríd."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ažuriranje ga ponovno gradi na poslužitelju iz izvora koje aplikacija nosi. Odavde se nikad ne uklanja niti zaustavlja — aplikacija preko njega upravlja ovim poslužiteljem."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frissítés újraépíti a szerveren az alkalmazás által hozott forrásokból. Innen soha nem törlődik és nem áll le — az alkalmazás ezen keresztül kezeli a szervert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'aggiornamento lo ricompila sul server dai sorgenti inclusi in questa app. Da qui non viene mai rimosso né fermato: l'app gestisce questo server tramite lui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新すると、このアプリが持つソースからサーバー上で再ビルドされます。ここから削除や停止はしません。アプリはこれを通じてこのサーバーを管理します。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atnaujinimas iš naujo jį sukompiliuoja serveryje iš programėlės turimų šaltinių. Iš čia jis niekada nešalinamas ir nestabdomas — per jį programėlė valdo šį serverį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atjaunināšana to serverī pārbūvē no lietotnes līdzi nestajiem avotiem. No šejienes tas nekad netiek noņemts vai apturēts — caur to lietotne pārvalda šo serveri."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-aġġornament jerġa' jibnih fuq is-server mis-sorsi li ġġorr din l-app. Qatt ma jitneħħa jew jitwaqqaf minn hawn — l-app timmaniġġja dan is-server permezz tiegħu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bijwerken bouwt hem opnieuw op de server uit de bronnen die deze app meedraagt. Hij wordt hier nooit verwijderd of gestopt — de app beheert deze server via hem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizacja buduje go ponownie na serwerze ze źródeł, które niesie aplikacja. Stąd nigdy nie jest usuwany ani zatrzymywany — aplikacja zarządza przez niego tym serwerem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A atualização recompila-o no servidor a partir das fontes que esta app traz. Nunca é removido nem parado daqui — a app gere este servidor através dele."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizarea îl reconstruiește pe server din sursele pe care le poartă aplicația. De aici nu este niciodată eliminat sau oprit — aplicația administrează serverul prin el."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновление пересобирает его на сервере из исходников, которые несёт приложение. Отсюда он никогда не удаляется и не останавливается — через него приложение управляет этим сервером."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizácia ho na serveri znova zostaví zo zdrojov, ktoré aplikácia nesie. Odtiaľto sa nikdy neodstraňuje ani nezastavuje — aplikácia cez neho spravuje tento server."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posodobitev ga na strežniku znova zgradi iz virov, ki jih nosi aplikacija. Od tu se nikoli ne odstrani ali ustavi — aplikacija prek njega upravlja ta strežnik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdatering bygger om den på servern från källorna appen bär med sig. Den tas aldrig bort eller stoppas härifrån — appen hanterar servern genom den."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлення перезбирає його на сервері з вихідних кодів, які несе застосунок. Звідси він ніколи не видаляється й не зупиняється — через нього застосунок керує цим сервером."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新会用本应用携带的源代码在服务器上重新构建它。这里从不删除或停止它——应用通过它管理这台服务器。"
          }
        }
      }
    },
