    "A virtual server: this is its share of the physical host. The hosting provider pays for the electricity." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виртуален сервър: това е неговият дял от физическия хост. Доставчикът на хостинг плаща за електричеството."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virtuální server: toto je jeho podíl fyzického hostitele. Poskytovatel hostingu platí elektřinu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En virtuel server: dette er dens andel af den fysiske vært. Hostingudbyder betaler for strøm."
