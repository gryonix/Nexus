    "The entry, the app's SSH key, and this server's pinned host keys will be deleted. The servers themselves are not affected." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Eintrag, der SSH-Schlüssel der App und die gepinnten Hostschlüssel dieses Servers werden gelöscht. Die Server selbst bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán la entrada, la clave SSH de la aplicación y las claves de host ancladas de este servidor. Los servidores en sí no se ven afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entrée, la clé SSH de l'application et les clés d'hôte épinglées de ce serveur seront supprimées. Les serveurs eux-mêmes ne sont pas affectés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voce, la chiave SSH dell'app e le chiavi host bloccate di questo server verranno eliminate. I server stessi non vengono toccati."
          }
