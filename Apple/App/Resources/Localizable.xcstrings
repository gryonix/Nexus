          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på en token för att publicera med den; pennan innehåller själva token, namnet och vilken leverantör den tillhör."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapáil comhartha chun foilsiú leis; coinníonn an peann luaidhe an comhartha féin, an t-ainm agus cén soláthraí lena mbaineann sé."
          }
