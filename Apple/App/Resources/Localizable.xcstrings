    "%@ is the data this service had before a restore. Deleting it frees the space and cannot be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ са данните на тази услуга преди възстановяването. Изтриването освобождава място и не може да бъде отменено."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jsou data, která tato služba měla před obnovou. Smazáním se uvolní místo a nelze to vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er de data, som denne tjeneste havde før en gendannelse. Sletning frigør pladsen og kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sind die Daten, die dieser Dienst vor einer Wiederherstellung hatte. Beim Löschen wird der Speicher frei; das lässt sich nicht rückgängig machen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ είναι τα δεδομένα που είχε αυτή η υπηρεσία πριν από μια επαναφορά. Η διαγραφή ελευθερώνει χώρο και δεν αναιρείται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ son los datos que tenía este servicio antes de una restauración. Al eliminarlos se libera espacio y no se puede deshacer."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on andmed, mis sellel teenusel enne taastamist olid. Kustutamine vabastab ruumi ja seda ei saa tagasi võtta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on tiedot, jotka tällä palvelulla oli ennen palautusta. Poistaminen vapauttaa tilaa, eikä sitä voi perua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ correspond aux données de ce service avant une restauration. La suppression libère de l'espace et est irréversible."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is iad %@ na sonraí a bhí ag an tseirbhís seo roimh athchóiriú. Saorann scriosadh spás agus ní féidir é a chealú."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ su podaci koje je ova usluga imala prije vraćanja. Brisanjem se oslobađa prostor i to se ne može poništiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ az az adat, amely a szolgáltatásnál a visszaállítás előtt volt. A törlés helyet szabadít fel, és nem vonható vissza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sono i dati che questo servizio aveva prima di un ripristino. L'eliminazione libera spazio e non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は、復元の前にこのサービスが持っていたデータです。削除すると空き容量が増えますが、元に戻せません。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yra duomenys, kuriuos ši paslauga turėjo prieš atkūrimą. Ištrynus atlaisvinama vietos, o veiksmo atšaukti negalima."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ir dati, kas šim pakalpojumam bija pirms atjaunošanas. Dzēšana atbrīvo vietu, un to nevar atsaukt."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ huwa d-data li dan is-servizz kellu qabel rkupru. It-tħassir jeħles l-ispazju u ma jistax jitreġġa' lura."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zijn de gegevens die deze service had vóór een herstelactie. Verwijderen maakt ruimte vrij en kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to dane, które ta usługa miała przed przywróceniem. Usunięcie zwalnia miejsce i nie można tego cofnąć."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ são os dados que este serviço tinha antes de um restauro. Eliminar liberta espaço e não pode ser anulado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sunt datele pe care acest serviciu le avea înainte de o restaurare. Ștergerea eliberează spațiu și nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — это данные, которые были у этого сервиса до восстановления. Удаление освободит место и необратимо."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sú údaje, ktoré mala táto služba pred obnovením. Odstránením sa uvoľní miesto a nedá sa to vrátiť späť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ so podatki, ki jih je imela ta storitev pred obnovitvijo. Z brisanjem se sprosti prostor, dejanja pa ni mogoče razveljaviti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ är de data som den här tjänsten hade före en återställning. Borttagning frigör utrymme och kan inte ångras."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — це дані, які були в цього сервісу до відновлення. Видалення звільнить місце й незворотне."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是此服务在还原之前的数据。删除后会释放空间，且无法撤销。"
          }
        }
      }
