    "Look around first" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst umsehen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero echar un vistazo"
          }
        },
        "fr" : {
          "stringUnit" : {
