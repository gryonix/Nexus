    "While the VPN is on, the connection time, protocol and server stay on the Lock Screen and in the Dynamic Island." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докато VPN е включен, времето на връзката, протоколът и сървърът остават на заключения екран и в Dynamic Island."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokud je VPN zapnutá, zůstává doba připojení, protokol a server na zamčené obrazovce a v Dynamic Islandu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens VPN er slået til, vises forbindelsestid, protokol og server på låseskærmen og i Dynamic Island."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange das VPN aktiv ist, bleiben Verbindungsdauer, Protokoll und Server auf dem Sperrbildschirm und in der Dynamic Island sichtbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσο το VPN είναι ενεργό, ο χρόνος σύνδεσης, το πρωτόκολλο και ο διακομιστής εμφανίζονται στην οθόνη κλειδώματος και στο Dynamic Island."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras la VPN está activa, el tiempo de conexión, el protocolo y el servidor permanecen en la pantalla bloqueada y en la Dynamic Island."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuni VPN on sees, on ühenduse aeg, protokoll ja server näha lukustuskuval ja Dynamic Islandis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun VPN on päällä, yhteysaika, protokolla ja palvelin näkyvät lukitusnäytöllä ja Dynamic Islandissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant que le VPN est actif, la durée de connexion, le protocole et le serveur restent affichés sur l’écran verrouillé et dans la Dynamic Island."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fad atá an VPN ar siúl, fanann am an cheangail, an prótacal agus an freastalaí ar an Scáileán Glasála agus san Dynamic Island."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dok je VPN uključen, vrijeme veze, protokol i poslužitelj ostaju na zaključanom zaslonu i u Dynamic Islandu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amíg a VPN be van kapcsolva, a kapcsolat ideje, a protokoll és a szerver látható a zárolási képernyőn és a Dynamic Islanden."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finché la VPN è attiva, durata della connessione, protocollo e server restano sulla schermata di blocco e nella Dynamic Island."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPNがオンの間、接続時間、プロトコル、サーバーがロック画面とDynamic Islandに表示されます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kol VPN įjungtas, ryšio trukmė, protokolas ir serveris rodomi užrakinimo ekrane ir Dynamic Island."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamēr VPN ir ieslēgts, savienojuma laiks, protokols un serveris redzami bloķēšanas ekrānā un Dynamic Island."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakemm il-VPN ikun mixgħul, il-ħin tal-konnessjoni, il-protokoll u s-server jibqgħu fuq l-iskrin imsakkar u fid-Dynamic Island."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
