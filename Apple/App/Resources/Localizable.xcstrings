    "Drag to reorder. This is the order servers appear in on the Servers tab." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Umsortieren ziehen. In dieser Reihenfolge werden die Server im Tab „Server“ angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to reorder. This is the order servers appear in on the Servers tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para reordenar. Este es el orden en que los servidores aparecen en la pestaña Servidores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour réordonner. C'est l'ordre dans lequel les serveurs apparaissent dans l'onglet Serveurs."
