    "CrowdSec stops attackers. See who was blocked, block addresses by hand, and set automatic rules — by country too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec stoppt Angreifer. Sieh, wer gesperrt wurde, sperre Adressen von Hand und lege automatische Regeln fest – auch nach Ländern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec detiene a los atacantes. Mira a quién se bloqueó, bloquea direcciones a mano y define reglas automáticas, también por país."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec arrête les attaquants. Voyez qui a été bloqué, bloquez des adresses à la main et définissez des règles automatiques — par pays aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec ferma gli attaccanti. Vedi chi è stato bloccato, blocca indirizzi a mano e imposta regole automatiche, anche per paese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec が攻撃者を止めます。ブロックされた相手の確認、手動でのアドレスのブロック、国単位も含む自動ルールの設定ができます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec останавливает атакующих. Смотрите, кто заблокирован, блокируйте адреса вручную и задавайте автоматические правила — в том числе по странам."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec зупиняє нападників. Дивіться, хто заблокований, блокуйте адреси вручну й задавайте автоматичні правила — зокрема за країнами."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec 会拦截攻击者。查看被拦截的对象，手动封禁地址，并设置自动规则——也可按国家。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec pysäyttää hyökkääjät. Katso, kuka estettiin, estä osoitteita käsin, ja aseta automaattisia sääntöjä — maittainkin."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec спира нападателите. Вижте кой е бил блокиран, блокирайте адреси ръчно и задайте автоматични правила — и по държава."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec oprește atacatorii. Vezi cine a fost blocat, blochează adrese manual și setează reguli automate — inclusiv după țară."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec zaustavlja napadače. Pogledajte tko je blokiran, ručno blokirajte adrese i postavite automatska pravila — i po državama."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec ustavlja napadalce. Oglejte si, kdo je bil blokiran, ročno blokirajte naslove in nastavite samodejna pravila — tudi po državah."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec stopper angribere. Se, hvem der blev blokeret, blokér adresser manuelt, og sæt automatiske regler — også efter land."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec stopt aanvallers. Bekijk wie er is geblokkeerd, blokkeer adressen handmatig en stel automatische regels in — ook per land."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec stoppar angripare. Se vem som blockerades, blockera adresser för hand, och ställ in automatiska regler — även per land."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A CrowdSec megállítja a támadókat. Nézze meg, kit blokkoltak, blokkoljon címeket kézzel, és állítson be automatikus szabályokat — országonként is."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec zastavuje útočníky. Podívejte se, kdo byl zablokován, blokujte adresy ručně a nastavte automatická pravidla — i podle země."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec zatrzymuje atakujących. Zobacz, kto został zablokowany, blokuj adresy ręcznie i ustaw automatyczne reguły — także według kraju."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O CrowdSec para os atacantes. Veja quem foi bloqueado, bloqueie endereços à mão, e defina regras automáticas — também por país."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec peatab ründajad. Vaata, kes blokeeriti, blokeeri aadresse käsitsi ja sea automaatseid reegleid — ka riigi järgi."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec zastavuje útočníkov. Pozrite sa, kto bol zablokovaný, blokujte adresy ručne a nastavte automatické pravidlá — aj podľa krajiny."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το CrowdSec σταματά τους επιτιθέμενους. Δείτε ποιος αποκλείστηκε, αποκλείστε διευθύνσεις με το χέρι, και ορίστε αυτόματους κανόνες — και ανά χώρα."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec aptur uzbrucējus. Skatiet, kurš tika bloķēts, bloķējiet adreses ar roku, un iestatiet automātiskus noteikumus — arī pēc valsts."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec sustabdo užpuolikus. Peržiūrėkite, kas buvo užblokuotas, blokuokite adresus rankiniu būdu ir nustatykite automatines taisykles — taip pat pagal šalį."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopann CrowdSec ionsaitheoirí. Féach cé a bhí coiscthe, cuir cosc ar sheoltaí de láimh, agus socraigh rialacha uathoibríocha — de réir tíre freisin."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrowdSec iwaqqaf min jattakka. Ara min ġie mblukkat, imblokka indirizzi bl-idejn, u ssettja regoli awtomatiċi — bil-pajjiż ukoll."
          }
        }
      }
    },
