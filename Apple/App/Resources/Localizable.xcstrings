    "Touch and hold the island to expand it. The round button on the right disconnects after a second tap." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задръжте острова, за да го разгънете. Кръглият бутон вдясно прекъсва връзката след второ натискане."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržením ostrůvek rozbalíte. Kulaté tlačítko vpravo odpojí po druhém klepnutí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold på øen for at udvide den. Den runde knap til højre afbryder efter et ekstra tryk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Insel gedrückt, um sie zu erweitern. Der runde Knopf rechts trennt nach dem zweiten Tippen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγγίξτε παρατεταμένα τη νησίδα για να την αναπτύξετε. Το στρογγυλό κουμπί δεξιά αποσυνδέει μετά από δεύτερο πάτημα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the island to expand it. The round button on the right disconnects after a second tap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada la isla para expandirla. El botón redondo de la derecha desconecta tras un segundo toque."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saare laiendamiseks hoia seda all. Parempoolne ümar nupp katkestab ühenduse teise puudutusega."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laajenna saareke painamalla sitä pitkään. Oikean reunan pyöreä painike katkaisee yhteyden toisella napautuksella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez l’île pour l’étendre. Le bouton rond à droite déconnecte après un second toucher."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coinnigh síos ar an oileán chun é a leathnú. Dícheanglaíonn an cnaipe cruinn ar dheis tar éis an dara tapáil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadržite otok da ga proširite. Okrugli gumb desno prekida vezu nakon drugog dodira."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsa nyomva a szigetet a kibontáshoz. A jobb oldali kerek gomb a második koppintásra bont."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuta l’isola per espanderla. Il pulsante rotondo a destra disconnette al secondo tocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイランドを長押しすると展開します。右の丸いボタンは2回目のタップで切断します。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palaikykite salą, kad ją išskleistumėte. Apvalus mygtukas dešinėje atjungia po antro bakstelėjimo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turiet salu, lai to izvērstu. Apaļā poga labajā pusē atvieno pēc otrā pieskāriena."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żomm il-gżira biex tiftaħha. Il-buttuna tonda fuq il-lemin taqta' wara t-tieni darba."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd het eiland ingedrukt om het uit te vouwen. De ronde knop rechts verbreekt na een tweede tik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj wyspę, aby ją rozwinąć. Okrągły przycisk po prawej rozłącza po drugim stuknięciu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha a ilha premida para a expandir. O botão redondo à direita desliga ao segundo toque."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Țineți apăsat pe insulă pentru a o extinde. Butonul rotund din dreapta deconectează la a doua atingere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте остров, чтобы раскрыть его. Круглая кнопка справа отключает после второго нажатия."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržaním ostrovček rozbalíte. Okrúhle tlačidlo vpravo odpojí po druhom ťuknutí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridržite otok, da ga razširite. Okrogli gumb na desni prekine povezavo ob drugem dotiku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned ön för att expandera den. Den runda knappen till höger kopplar från efter ett andra tryck."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуйте острів, щоб розгорнути його. Кругла кнопка праворуч відключає після другого натискання."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住灵动岛即可展开。右侧圆形按钮在第二次轻点后断开连接。"
          }
        }
      }
    },
