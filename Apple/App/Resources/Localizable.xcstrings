    "The fastest public resolver in most places. Cloudflare deletes query logs within a day and is audited for it." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Най-бързият публичен DNS на повечето места. Cloudflare изтрива журналите на заявките до ден и се проверява за това."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na většině míst nejrychlejší veřejné DNS. Cloudflare maže záznamy dotazů do jednoho dne a prochází kvůli tomu audity."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den hurtigste offentlige DNS de fleste steder. Cloudflare sletter forespørgselslogs inden for et døgn og bliver revideret for det."
          }
        },
