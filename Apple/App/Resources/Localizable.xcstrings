    "The local server sits behind NAT; the VPS receives the traffic and forwards it over WireGuard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der lokale Server steht hinter NAT; der VPS empfängt den Verkehr und leitet ihn über WireGuard weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor local está detrás de NAT; el VPS recibe el tráfico y lo reenvía por WireGuard."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur local est derrière un NAT ; le VPS reçoit le trafic et le transmet via WireGuard."
          }
        },
        "it" : {
          "stringUnit" : {
