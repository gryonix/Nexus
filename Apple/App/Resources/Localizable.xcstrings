      }
    },
    "%@ moves the card through the relay. Close the app or lock the phone: it keeps moving and opens wide at the end." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ движи картата през релето. Затворете приложението или заключете телефона: тя продължава и накрая се разгръща."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ posouvá kartu přes relé. Zavřete aplikaci nebo zamkněte telefon: karta pokračuje a na konci se rozbalí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ flytter kortet via relæet. Luk appen eller lås telefonen: det fortsætter og folder sig ud til sidst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bewegt die Karte über das Relay. Schließe die App oder sperre das Telefon: Sie läuft weiter und öffnet sich am Ende groß."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο %@ προωθεί την κάρτα μέσω του αναμεταδότη. Κλείστε την εφαρμογή ή κλειδώστε το τηλέφωνο: συνεχίζει και στο τέλος ανοίγει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mueve la tarjeta a través del relé. Cierra la app o bloquea el teléfono: sigue avanzando y al final se abre."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ liigutab kaarti releega. Sulge rakendus või lukusta telefon: kaart liigub edasi ja avaneb lõpus suureks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ liikuttaa korttia välittimen kautta. Sulje sovellus tai lukitse puhelin: kortti jatkaa ja avautuu lopuksi suureksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fait avancer la carte via le relais. Fermez l’app ou verrouillez le téléphone : elle continue et s’ouvre en grand à la fin."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bogann %@ an cárta tríd an athsheoltóir. Dún an aip nó cuir glas ar an bhfón: leanann sé ar aghaidh agus osclaíonn sé go mór ag an deireadh."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pomiče karticu preko releja. Zatvorite aplikaciju ili zaključajte telefon: nastavlja i na kraju se širi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ a továbbítón át mozgatja a kártyát. Zárd be az appot vagy zárold a telefont: tovább halad, és a végén kinyílik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fa avanzare la scheda tramite il relay. Chiudi l’app o blocca il telefono: continua e alla fine si apre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ がリレー経由でカードを進めます。アプリを閉じるか画面をロックしても進み、最後に大きく開きます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kortelę stumia per retransliatorių. Uždarykite programą arba užrakinkite telefoną: ji tęsia ir pabaigoje išsiskleidžia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ virza karti caur releju. Aizveriet lietotni vai bloķējiet tālruni: tā turpina un beigās izvēršas."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ imexxi l-karta permezz tar-relay. Agħlaq l-app jew sakkar it-telefon: tibqa’ miexja u fl-aħħar tinfetaħ."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zet de kaart voort via de relay. Sluit de app of vergrendel de telefoon: hij gaat door en klapt aan het eind open."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ przesuwa kartę przez przekaźnik. Zamknij aplikację lub zablokuj telefon: karta idzie dalej i na końcu się rozwija."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ faz avançar o cartão através do relay. Feche a app ou bloqueie o telefone: continua e no fim abre-se."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mută cardul prin releu. Închideți aplicația sau blocați telefonul: continuă și la final se extinde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ведёт карточку через реле. Закройте приложение или заблокируйте телефон: она продолжит идти и в конце развернётся."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ posúva kartu cez relé. Zatvorte aplikáciu alebo zamknite telefón: karta pokračuje a na konci sa rozbalí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ premika kartico prek releja. Zaprite aplikacijo ali zaklenite telefon: nadaljuje in se na koncu razširi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ flyttar kortet via reläet. Stäng appen eller lås telefonen: det fortsätter och fälls ut i slutet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ веде картку через реле. Закрийте застосунок або заблокуйте телефон: вона йтиме далі й наприкінці розгорнеться."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 通过中继推进卡片。关闭应用或锁定手机后它仍会继续，并在结束时展开。"
          }
        }
      }
    },
    "No server sends notifications through a relay, so the app moves the card. Closing the app stops it." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нито един сървър не изпраща известия през реле, затова картата се движи от приложението. Затварянето му я спира."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádný server neposílá oznámení přes relé, kartu tedy posouvá aplikace. Zavřením aplikace se zastaví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen server sender notifikationer via et relæ, så appen flytter kortet. Lukker du appen, stopper det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Server sendet Mitteilungen über ein Relay, darum bewegt die App die Karte. Schließt du die App, bleibt sie stehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κανένας διακομιστής δεν στέλνει ειδοποιήσεις μέσω αναμεταδότη, οπότε την κάρτα την προωθεί η εφαρμογή. Το κλείσιμό της τη σταματά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún servidor envía notificaciones a través de un relé, así que la app mueve la tarjeta. Al cerrar la app, se detiene."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ükski server ei saada teavitusi relee kaudu, seega liigutab kaarti rakendus. Rakenduse sulgemine peatab selle."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikään palvelin ei lähetä ilmoituksia välittimen kautta, joten sovellus liikuttaa korttia. Sovelluksen sulkeminen pysäyttää sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun serveur n’envoie de notifications via un relais : c’est l’app qui fait avancer la carte. La fermer l’arrête."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní sheolann aon fhreastalaí fógraí trí athsheoltóir, mar sin bogann an aip an cárta. Stopann sé má dhúnann tú an aip."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nijedan poslužitelj ne šalje obavijesti preko releja, pa karticu pomiče aplikacija. Zatvaranje aplikacije je zaustavlja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyik szerver sem küld értesítést továbbítón át, ezért az app mozgatja a kártyát. Az app bezárása megállítja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun server invia notifiche tramite un relay, quindi è l’app a far avanzare la scheda. Chiudendo l’app si ferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リレー経由で通知を送るサーバーがないため、アプリがカードを進めます。アプリを閉じると止まります。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joks serveris nesiunčia pranešimų per retransliatorių, todėl kortelę stumia programa. Uždarius programą ji sustoja."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neviens serveris nesūta paziņojumus caur releju, tāpēc karti virza lietotne. Aizverot lietotni, tā apstājas."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-ebda server ma jibgħat notifiki permezz ta’ relay, għalhekk l-app tmexxi l-karta. Jekk tagħlaq l-app, tieqaf."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen enkele server stuurt meldingen via een relay, dus de app zet de kaart voort. Sluit je de app, dan stopt hij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żaden serwer nie wysyła powiadomień przez przekaźnik, więc kartę przesuwa aplikacja. Zamknięcie aplikacji ją zatrzymuje."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum servidor envia notificações através de um relay, por isso é a app que faz avançar o cartão. Fechar a app para-o."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niciun server nu trimite notificări printr-un releu, așa că aplicația mută cardul. Închiderea aplicației îl oprește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни один сервер не шлёт уведомления через реле, поэтому карточку ведёт приложение. Если его закрыть, она остановится."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žiadny server neposiela oznámenia cez relé, kartu teda posúva aplikácia. Zatvorením aplikácie sa zastaví."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noben strežnik ne pošilja obvestil prek releja, zato kartico premika aplikacija. Če jo zaprete, se ustavi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen server skickar notiser via ett relä, så appen flyttar kortet. Stänger du appen stannar det."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жоден сервер не надсилає сповіщення через реле, тож картку веде застосунок. Якщо його закрити, вона зупиниться."
          }
