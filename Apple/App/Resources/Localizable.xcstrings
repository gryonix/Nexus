        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä sovellus ei voi vielä kantaa “%@”-yhteyttä. Palvelin voi sen sijaan antaa tämän laitteen ulos TCP:n yli."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това приложение все още не може да носи връзка „%@“. Вместо това сървърът може да раздаде това устройство през TCP."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această aplicație nu poate încă purta o conexiune „%@”. Serverul poate în schimb să ofere acest dispozitiv prin TCP."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne app kan endnu ikke bære en “%@”-forbindelse. Serveren kan i stedet udlevere denne enhed over TCP."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze app kan nog geen “%@”-verbinding dragen. De server kan dit apparaat in plaats daarvan via TCP uitgeven."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här appen kan ännu inte bära en “%@”-anslutning. Servern kan lämna ut den här enheten via TCP istället."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova aplikacija još ne može nositi vezu “%@”. Poslužitelj umjesto toga može ovaj uređaj izdati putem TCP-a."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta aplikacija še ne more nositi povezave »%@«. Strežnik lahko to napravo namesto tega izda prek TCP-ja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az alkalmazás még nem tud „%@” kapcsolatot vinni. A szerver helyette TCP-n keresztül adhatja ki ezt az eszközt."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato aplikace zatím neumí přenášet připojení „%@“. Server může místo toho vydat toto zařízení přes TCP."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta aplikacja nie potrafi jeszcze przenosić połączenia „%@”. Serwer może zamiast tego wydać to urządzenie przez TCP."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app ainda não consegue transportar uma ligação “%@”. Em vez disso, o servidor pode entregar este dispositivo via TCP."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η εφαρμογή δεν μπορεί ακόμη να φέρει σύνδεση «%@». Ο διακομιστής μπορεί αντ’ αυτού να παραδώσει αυτή τη συσκευή μέσω TCP."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See rakendus ei suuda veel kanda „%@” ühendust. Server saab selle asemel anda selle seadme välja TCP kaudu."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto aplikácia zatiaľ nevie prenášať pripojenie „%@“. Server môže namiesto toho vydať toto zariadenie cez TCP."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šī lietotne vēl nevar nest savienojumu “%@”. Tā vietā serveris var izsniegt šai ierīcei savienojumu caur TCP."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní féidir leis an aip seo nasc “%@” a iompar fós. Is féidir leis an bhfreastalaí an gléas seo a thabhairt amach thar TCP ina ionad sin."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ši programėlė kol kas negali nešti „%@“ ryšio. Vietoje to serveris gali šį įrenginį išduoti per TCP."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din l-app għadha ma tistax iġġorr konnessjoni “%@”. Is-server jista' jagħti dan l-apparat fuq TCP minflok."
          }
        }
      }
    },
