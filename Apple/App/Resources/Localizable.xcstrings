    "An empty field is left alone — only what you type is saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein leeres Feld bleibt unverändert — gespeichert wird nur, was Sie eingeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un campo vacío se deja como está: solo se guarda lo que usted escriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un champ vide est laissé tel quel — seul ce que vous saisissez est enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un campo vuoto resta com'è: si salva solo ciò che digiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空の欄はそのままです — 入力したものだけが保存されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пустое поле остаётся как было — сохраняется только то, что ты ввёл."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порожнє поле лишається як було — зберігається лише те, що ви ввели."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空的字段保持不变 — 只保存你输入的内容。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyhjä kenttä jätetään koskematta — vain kirjoittamasi tallennetaan."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Празно поле остава непроменено — запазва се само това, което въведете."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prazno polje ostaje netaknuto — sprema se samo ono što upišete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prazno polje ostane nespremenjeno — shrani se samo to, kar vnesete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et tomt felt bliver ladet i fred — kun det, du skriver, gemmes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een leeg veld wordt met rust gelaten — alleen wat je typt wordt opgeslagen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett tomt fält lämnas orört — bara det du skriver sparas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tühi väli jäetakse puutumata — salvestatakse ainult see, mille kirjutad."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fágtar réimse folamh mar atá — ní shábháiltear ach an rud a chlóscríobhann tú."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qasam vojt jitħalla kif inhu — jiġi ssejvjat biss dak li tikteb."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um campo vazio é deixado como está — só é guardado o que escrever."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα κενό πεδίο παραμένει ανέπαφο — αποθηκεύεται μόνο ό,τι πληκτρολογείς."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy üres mezőt békén hagyunk — csak az kerül mentésre, amit beírsz."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un câmp gol este lăsat neatins — se salvează doar ceea ce tastezi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puste pole pozostaje bez zmian — zapisywane jest tylko to, co wpiszesz."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prázdné pole zůstává beze změny — ukládá se jen to, co napíšete."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prázdne pole zostáva bez zmeny — ukladá sa iba to, čo napíšete."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tukšs lauks paliek neskarts — tiek saglabāts tikai tas, ko ierakstāt."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuščias laukas paliekamas nepakeistas — išsaugoma tik tai, ką įrašote."
          }
        }
      }
    },
