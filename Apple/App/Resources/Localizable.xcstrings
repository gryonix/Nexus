    "Detected as “%@”. The name is stored on the server, so your other devices see it too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkannt als „%@“. Der Name wird auf dem Server gespeichert, deine anderen Geräte sehen ihn also auch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectado como «%@». El nombre se guarda en el servidor, así que tus otros dispositivos también lo ven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détecté comme « %@ ». Le nom est stocké sur le serveur, vos autres appareils le voient donc aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilevato come «%@». Il nome è salvato sul server, quindi lo vedono anche i tuoi altri dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」として検出されました。名前はサーバーに保存されるため、ほかの端末にも表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определено как «%@». Имя хранится на сервере, поэтому его увидят и другие ваши устройства."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Визначено як «%@». Ім’я зберігається на сервері, тому його побачать й інші ваші пристрої."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测为“%@”。名称保存在服务器上，因此你的其他设备也能看到。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Havaittu nimellä “%@”. Nimi tallennetaan palvelimelle, joten muutkin laitteesi näkevät sen."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разпознато като „%@“. Името се съхранява на сървъра, затова другите ви устройства също го виждат."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkend als “%@”. De naam wordt op de server opgeslagen, dus je andere apparaten zien hem ook."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registreret som “%@”. Navnet gemmes på serveren, så dine andre enheder ser det også."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifierad som “%@”. Namnet lagras på servern, så dina andra enheter ser det också."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otkriveno kao „%@“. Ime se pohranjuje na poslužitelju, pa ga vide i vaši drugi uređaji."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznano kot „%@“. Ime je shranjeno na strežniku, zato ga vidijo tudi vaše druge naprave."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectat ca „%@”. Numele este stocat pe server, astfel încât celelalte dispozitive ale tale îl văd și ele."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykryto jako „%@”. Nazwa jest przechowywana na serwerze, więc widzą ją też inne urządzenia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznáno jako „%@“. Název je uložen na serveru, takže ho vidí i vaše ostatní zařízení."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuvastatud kui „%@”. Nimi salvestatakse serverisse, seega näevad seda ka su teised seadmed."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felismerve mint „%@”. A név a szerveren tárolódik, így a többi eszközöd is látja."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εντοπίστηκε ως «%@». Το όνομα αποθηκεύεται στον διακομιστή, οπότε το βλέπουν και οι άλλες συσκευές σας."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznané ako „%@“. Názov sa ukladá na serveri, takže ho vidia aj vaše ostatné zariadenia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detetado como “%@”. O nome é guardado no servidor, pelo que os seus outros dispositivos também o veem."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noteikts kā “%@”. Nosaukums tiek glabāts serverī, tāpēc to redz arī jūsu citas ierīces."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braite mar “%@”. Stóráiltear an t-ainm ar an bhfreastalaí, agus mar sin feiceann do ghléasanna eile é freisin."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Individwat bħala “%@”. L-isem jinżamm fuq is-server, biex l-apparati l-oħra tiegħek jarawh ukoll."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aptikta kaip „%@“. Pavadinimas saugomas serveryje, todėl jį mato ir kiti jūsų įrenginiai."
          }
        }
      }
    },
