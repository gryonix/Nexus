    "Works from anywhere: it serves the filter over DNS-over-HTTPS through the same HTTPS name as its panel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert von überall: Der Filter wird über DNS-over-HTTPS unter demselben HTTPS-Namen wie das Panel bereitgestellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona desde cualquier lugar: sirve el filtro por DNS-over-HTTPS con el mismo nombre HTTPS que su panel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne de partout : le filtre est servi en DNS-over-HTTPS sous le même nom HTTPS que son panneau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona da ovunque: serve il filtro via DNS-over-HTTPS con lo stesso nome HTTPS del suo pannello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこからでも使えます。パネルと同じ HTTPS 名で DNS-over-HTTPS としてフィルターを提供します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работает откуда угодно: отдаёт фильтр по DNS-over-HTTPS на том же HTTPS-имени, что и его панель."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Працює звідусіль: віддає фільтр через DNS-over-HTTPS на тому самому HTTPS-імені, що й панель."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
