    "Energy is the power history added up over time. The price per kilowatt-hour is set below." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Енергията е историята на мощност, събрана във времето. Цената за киловат-час е установена по-долу."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energie je součet histórie výkonu v čase. Cena za kilowathodinu je nastavena níže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energi er strømmens krafthistorie opsummeret over tid. Prisen per kilowattime indstilles nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energie ist die über die Zeit aufaddierte Leistungshistorie. Der Preis pro Kilowattstunde wird unten eingestellt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ενέργεια είναι ο συνολικός ιστορικός ισχύος για κάποιο διάστημα. Η τιμή ανά κιλοβατώρα ορίζεται παρακάτω."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La energía es el historial de potencia sumado durante el tiempo. El precio por kilovatio-hora se establece a continuación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia on aja jooksul kokku võetud võimsuse ajalugu. Hind kilovatt-tunni kohta määratakse allpool."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia on aika kuluessa kertynyt tehon historia. Hinta kilowattituntia kohti asetetaan alla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'énergie est l'historique de puissance additionné au fil du temps. Le prix au kilowattheure est défini ci-dessous."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is é an fhuinneamh an stair cumhachta suimithe ar feadh an ama. Socruithe an praghas in aghaidh an kilowatt-uaire thíos."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energija je povijest snage zbrojene tijekom vremena. Cijena po kilovatnom satu postavlja se dolje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az energia az idő múlásával összeadott erőforrás-történelem. A kilowattóra ára az alábbiakban állítható be."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'energia è la cronologia della potenza sommata nel tempo. Il prezzo per kilowatt-ora è impostato di seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エネルギーは時間の経過に伴う消費電力の合計です。1 キロワット時間あたりの価格は以下で設定されます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energija yra galios istorija, susumuota per laiką. Kaina už kilovatvalandę nustatyta žemiau."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enerģija ir enerģijas vēsture, kas saskaitīta laika gaitā. Cena par kilovatstundu ir iestatīta zemāk."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-enerġija hija l-istoria tal-qawwa mkabbra fil-ħin. Il-prezz għal kilowatt-ura jitwaqqaf hawn taħt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energie is de opgetelde machtsgeschiedenis over de tijd. De prijs per kilowattuur is hieronder ingesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia to historia mocy zsumowana w czasie. Cena za kilowatogodzinę jest ustawiona poniżej."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A energia é o histórico de potência somado ao longo do tempo. O preço por quilowatt-hora é definido abaixo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia este istoricul puterii adunat în timp. Prețul per kilowatt-oră este setat mai jos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Энергия — это мощность, сложенная по времени. Цена за киловатт-час задаётся ниже."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia je história výkonu sčítaná v čase. Cena za kilowatthodinu je nastavená nižšie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energija je zgodba moči, sešteta skozi čas. Cena za kilovat-uro je nastavljena spodaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energi är machtshistoriken summerad över tid. Priset per kilowattime är inställt nedan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Енергія — це потужність, складена за часом. Ціна за кіловат-годину задається нижче."
          }
        },
        "zh" : {
