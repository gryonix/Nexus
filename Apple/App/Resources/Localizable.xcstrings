    "Set it in Connection Settings — the “…” menu at the top right. Every service address is the service's name plus that domain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze sie in den Verbindungseinstellungen — im Menü „…“ oben rechts. Jede Dienstadresse ist der Name des Dienstes plus diese Domain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
