          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen DNS-account. Voeg er een toe om de gegenereerde records direct in je zone te publiceren in plaats van een zonebestand te exporteren en handmatig te importeren."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
