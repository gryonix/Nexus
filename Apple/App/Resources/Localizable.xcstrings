        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura, sati, trošenje i loši sektori, kako ih javlja svaki disk."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hőmérséklet, üzemórák, kopás és hibás szektorok, ahogy az egyes lemezek jelentik."
