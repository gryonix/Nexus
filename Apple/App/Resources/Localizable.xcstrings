          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ erreicht diesen Server wieder. Die Adresse wird erneut blockiert, wenn sie wiederholt, wofür sie blockiert wurde — schütze sie unten, um das zu verhindern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vuelve a poder acceder a este servidor. Se bloqueará otra vez si repite lo que provocó el bloqueo; protégela abajo para evitarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ peut de nouveau joindre ce serveur. L’adresse sera bloquée à nouveau si elle recommence — protégez-la ci-dessous pour l’éviter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ può raggiungere di nuovo questo server. Verrà bloccato di nuovo se ripete ciò per cui era stato bloccato: proteggilo qui sotto per evitarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は再びこのサーバーに接続できます。ブロックされた行為を繰り返すとまたブロックされます。下で保護すると防げます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ снова сможет обращаться к серверу. Если повторит то, за что был заблокирован, — заблокируется снова; чтобы этого не было, защитите адрес ниже."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ знову зможе звертатися до сервера. Якщо повторить те, за що був заблокований, — заблокується знову; щоб цього не сталося, захистіть адресу нижче."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将可以再次访问此服务器。如果重复被封锁的行为，还会被再次封锁——可在下方保护该地址。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ voi taas tavoittaa tämän palvelimen. Se estetään taas, jos se toistaa sen, minkä takia se estettiin — suojaa se alla estääksesi sen."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ отново може да достигне този сървър. Ще бъде блокиран отново, ако повтори причината за блокирането — защитете го по-долу, за да спрете това."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ poate ajunge din nou la acest server. Va fi blocat din nou dacă repetă ceea ce a fost blocat — protejează-l mai jos pentru a opri asta."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ponovno može pristupiti ovom poslužitelju. Bit će ponovno blokiran ako ponovi ono zbog čega je bio blokiran — zaštitite ga ispod da to spriječite."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lahko znova doseže ta strežnik. Znova bo blokiran, če ponovi tisto, zaradi česar je bil blokiran — zaščitite ga spodaj, da to preprečite."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan nå denne server igen. Den blokeres igen, hvis den gentager det, den blev blokeret for — beskyt den nedenfor for at forhindre det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan deze server weer bereiken. Het wordt opnieuw geblokkeerd als het herhaalt waarvoor het geblokkeerd was — bescherm het hieronder om dat te voorkomen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan nå den här servern igen. Den blockeras igen om den upprepar det den blockerades för — skydda den nedan för att förhindra det."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ ismét elérheti ezt a szervert. Újra blokkolva lesz, ha megismétli azt, amiért blokkolva volt — védje alább, hogy ezt megakadályozza."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se znovu dostane na tento server. Pokud zopakuje to, za co byl zablokován, bude zablokován znovu — chraňte ho níže, abyste tomu zabránili."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ może znów dotrzeć do tego serwera. Zostanie ponownie zablokowany, jeśli powtórzy to, za co został zablokowany — chroń go poniżej, aby to powstrzymać."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pääseb selle serverini uuesti. See blokeeritakse uuesti, kui see kordab seda, mille eest see blokeeriti — kaitse see allpool, et seda peatada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pode voltar a alcançar este servidor. Será bloqueado novamente se repetir o que o fez ser bloqueado — proteja-o abaixo para evitar isso."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sa znova dostane na tento server. Ak zopakuje to, za čo bol zablokovaný, bude zablokovaný znova — chráňte ho nižšie, aby ste tomu zabránili."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ μπορεί να προσπελάσει ξανά αυτόν τον διακομιστή. Θα αποκλειστεί ξανά αν επαναλάβει αυτό για το οποίο αποκλείστηκε — προστατέψτε το παρακάτω για να το σταματήσετε."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ atkal var sasniegt šo serveri. Tas tiks bloķēts atkal, ja atkārtos to, par ko tika bloķēts — aizsargājiet to zemāk, lai to novērstu."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vėl gali pasiekti šį serverį. Jis bus vėl užblokuotas, jei pakartos tai, už ką buvo blokuotas — apsaugokite jį žemiau, kad to išvengtumėte."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is féidir le %@ an freastalaí seo a shroicheadh arís. Cuirfear cosc air arís má dhéanann sé arís an rud a bhfuair sé cosc air — cosain é thíos chun é sin a stopadh."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jista' jilħaq dan is-server mill-ġdid. Jerġa' jiġi mblukkat jekk jirrepeti dak li kien imblukkat għalih — ipproteġih hawn taħt biex twaqqaf dan."
          }
        }
      }
    },
