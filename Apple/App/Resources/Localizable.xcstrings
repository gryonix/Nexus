          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El traslado conserva la configuración de cada dispositivo: la misma dirección, las mismas claves."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teisaldamine säilitab iga seadme seadistuse: sama aadress, samad võtmed."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
