    "The new disk joins the array. A mirror gets one more copy; other levels get more space." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новият диск влиза в масива. Огледалото получава още едно копие, другите нива — повече място."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nový disk se připojí k poli. Zrcadlo získá další kopii, ostatní úrovně více místa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den nye disk kommer med i arrayet. Et spejl får én kopi mere; andre niveauer får mere plads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neue Festplatte kommt ins Array. Ein Spiegel erhält eine weitere Kopie, andere Level mehr Platz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο νέος δίσκος μπαίνει στη συστοιχία. Ο καθρέφτης αποκτά ένα ακόμη αντίγραφο· τα άλλα επίπεδα περισσότερο χώρο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco nuevo se une al conjunto. Un espejo gana una copia más; los demás niveles, más espacio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uus ketas liitub massiiviga. Peegel saab ühe koopia juurde, teised tasemed rohkem ruumi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusi levy liittyy taulukkoon. Peili saa yhden kopion lisää, muut tasot lisää tilaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nouveau disque rejoint l'ensemble. Un miroir gagne une copie de plus ; les autres niveaux, de l'espace."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téann an diosca nua isteach san eagar. Faigheann scáthán cóip bhreise; faigheann leibhéil eile níos mó spáis."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi disk ulazi u polje. Zrcalo dobiva još jednu kopiju, ostale razine više prostora."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az új lemez bekerül a tömbbe. A tükör eggyel több másolatot kap, a többi szint több helyet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nuovo disco entra nell'array. Un mirror ottiene una copia in più; gli altri livelli più spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいディスクがアレイに加わります。ミラーはコピーが1つ増え、他のレベルは容量が増えます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naujas diskas prisijungia prie masyvo. Veidrodis gauna dar vieną kopiją, kiti lygiai – daugiau vietos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaunais disks pievienojas masīvam. Spogulis iegūst vēl vienu kopiju, citi līmeņi — vairāk vietas."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Id-diska l-ġdida tidħol fl-array. Mera tieħu kopja oħra; livelli oħra jieħdu aktar spazju."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De nieuwe schijf komt in de array. Een spiegel krijgt een kopie extra; andere niveaus meer ruimte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowy dysk dołącza do macierzy. Lustro dostaje jeszcze jedną kopię, inne poziomy więcej miejsca."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O disco novo entra no conjunto. Um espelho ganha mais uma cópia; os outros níveis ganham espaço."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discul nou intră în matrice. O oglindă primește încă o copie; celelalte niveluri primesc mai mult spațiu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый диск входит в массив. У зеркала появляется ещё одна копия, у остальных уровней — больше места."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nový disk sa pripojí k poľu. Zrkadlo získa ďalšiu kópiu, ostatné úrovne viac miesta."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nov disk se pridruži polju. Zrcalo dobi še eno kopijo, druge ravni več prostora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den nya disken går med i arrayen. En spegel får en kopia till; andra nivåer får mer plats."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новий диск входить у масив. Дзеркало отримує ще одну копію, інші рівні — більше місця."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新磁盘加入阵列。镜像会多一份副本；其他级别会增加空间。"
          }
        }
      }
    },
    "The new disk waits unused. When a disk in the array fails, the array rebuilds onto it by itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новият диск чака неизползван. Когато диск в масива се повреди, масивът сам се възстановява върху него."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nový disk čeká nevyužitý. Když disk v poli selže, pole se na něj samo obnoví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den nye disk venter ubrugt. Når en disk i arrayet fejler, genopbygger arrayet sig selv på den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neue Festplatte wartet ungenutzt. Fällt eine Festplatte im Array aus, baut sich das Array von selbst darauf neu auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο νέος δίσκος περιμένει αχρησιμοποίητος. Όταν χαλάσει δίσκος της συστοιχίας, η συστοιχία ανακατασκευάζεται πάνω του από μόνη της."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco nuevo espera sin usarse. Cuando falla un disco del conjunto, el conjunto se reconstruye en él por sí solo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uus ketas ootab kasutamata. Kui mõni massiivi ketas rikneb, taastab massiiv end sellele ise."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusi levy odottaa käyttämättömänä. Kun taulukon levy hajoaa, taulukko rakentuu sille itsestään uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nouveau disque attend sans servir. Quand un disque de l'ensemble tombe en panne, l'ensemble se reconstruit dessus tout seul."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanann an diosca nua gan úsáid. Nuair a theipeann ar dhiosca san eagar, atógann an t-eagar air féin uaidh sin."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi disk čeka neiskorišten. Kad disk u polju otkaže, polje se samo obnovi na njega."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az új lemez használaton kívül vár. Ha a tömb egy lemeze meghibásodik, a tömb magától újraépül rá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nuovo disco resta in attesa inutilizzato. Quando un disco dell'array si guasta, l'array si ricostruisce su di esso da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいディスクは使われずに待機します。アレイのディスクが故障すると、アレイは自動的にそのディスクへ再構築されます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naujas diskas laukia nenaudojamas. Sugedus masyvo diskui, masyvas pats atsistato į jį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaunais disks gaida neizmantots. Kad masīva disks sabojājas, masīvs pats atjaunojas uz tā."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Id-diska l-ġdida tistenna mingħajr ma tintuża. Meta diska fl-array tfalli, l-array jerġa' jinbena fuqha waħdu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De nieuwe schijf wacht ongebruikt. Valt een schijf in de array uit, dan herbouwt de array zich er vanzelf op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowy dysk czeka nieużywany. Gdy dysk w macierzy ulegnie awarii, macierz sama odbuduje się na nim."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O disco novo fica à espera, sem uso. Quando um disco do conjunto falha, o conjunto reconstrói-se nele sozinho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discul nou așteaptă nefolosit. Când un disc din matrice se defectează, matricea se reconstruiește singură pe el."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый диск ждёт без дела. Когда диск в массиве сломается, массив сам восстановится на него."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nový disk čaká nevyužitý. Keď disk v poli zlyhá, pole sa naň samo obnoví."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nov disk čaka neuporabljen. Ko disk v polju odpove, se polje samo obnovi nanj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den nya disken väntar oanvänd. När en disk i arrayen går sönder bygger arrayen upp sig själv på den."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новий диск чекає без діла. Коли диск у масиві зламається, масив сам відновиться на нього."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新磁盘处于待命状态，不被使用。阵列中有磁盘故障时，阵列会自动在它上面重建。"
          }
        }
      }
    },
    "The public IP address of your VPS, and the local server's address on your network — an IP or a .local name. Keep this device on that network while installing." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Публичният IP на вашия VPS и адресът на локалния сървър в мрежата ви — IP или име .local. По време на инсталацията дръжте това устройство в тази мрежа."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veřejná IP vašeho VPS a adresa místního serveru ve vaší síti — IP nebo název .local. Během instalace mějte toto zařízení v té síti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din VPS' offentlige IP og den lokale servers adresse på dit netværk – en IP eller et .local-navn. Hold denne enhed på det netværk under installationen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die öffentliche IP deines VPS und die Adresse des lokalen Servers in deinem Netz – eine IP oder ein .local-Name. Bleib mit diesem Gerät während der Installation in diesem Netz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η δημόσια IP του VPS σου και η διεύθυνση του τοπικού διακομιστή στο δίκτυό σου — IP ή όνομα .local. Κράτα αυτή τη συσκευή σε αυτό το δίκτυο κατά την εγκατάσταση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IP pública de tu VPS y la dirección del servidor local en tu red: una IP o un nombre .local. Mantén este dispositivo en esa red durante la instalación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinu VPS-i avalik IP ja kohaliku serveri aadress sinu võrgus — IP või .local-nimi. Hoia seda seadet paigalduse ajal selles võrgus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
