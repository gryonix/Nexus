          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Възстановяването заменя текущите данни на услугата. Контейнерите ѝ спират, докато трае."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herstellen vervangt de huidige gegevens van de dienst. De containers ervan gaan tijdens het proces uit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
