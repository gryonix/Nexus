          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNS odpowiada tylko na tej maszynie. Urządzenia w Twojej sieci nie mogą korzystać z filtra, dopóki tego nie włączysz."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNS odpovídá pouze na tomto stroji. Zařízení ve vaší síti nemohou používat filtr, dokud toto nezapnete."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNS vastab ainult sellel masinal. Sinu võrgu seadmed ei saa filtrit kasutada enne, kui see sisse lülitad."
