    "“Forever” is a perpetual license for the app as it is. It does not promise future updates, new features or support." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Завинаги“ е безсрочен лиценз за приложението в сегашния му вид. Не обещава бъдещи актуализации, нови функции или поддръжка."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Navždy“ je trvalá licence na aplikaci v současné podobě. Neslibuje budoucí aktualizace, nové funkce ani podporu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»For altid« er en tidsubegrænset licens til appen, som den er. Den lover ikke fremtidige opdateringer, nye funktioner eller support."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Für immer“ ist eine unbefristete Lizenz für die App in ihrem jetzigen Stand. Künftige Updates, neue Funktionen oder Support sind nicht zugesagt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «Για πάντα» είναι μόνιμη άδεια για την εφαρμογή όπως είναι. Δεν υπόσχεται μελλοντικές ενημερώσεις, νέες λειτουργίες ή υποστήριξη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Para siempre» es una licencia perpetua de la app tal como es. No promete actualizaciones futuras, funciones nuevas ni soporte."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Igavesti” on tähtajatu litsents rakendusele sellisena, nagu see on. See ei luba tulevasi uuendusi, uusi funktsioone ega tuge."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Ikuinen” on pysyvä lisenssi sovellukseen sellaisena kuin se on. Se ei lupaa tulevia päivityksiä, uusia ominaisuuksia eikä tukea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« À vie » est une licence perpétuelle pour l'app telle qu'elle est. Elle ne promet ni mises à jour futures, ni nouvelles fonctions, ni assistance."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is ceadúnas buan don aip mar atá sí “Go deo”. Ní gheallann sé nuashonruithe sa todhchaí, gnéithe nua ná tacaíocht."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zauvijek” je trajna licenca za aplikaciju kakva jest. Ne obećava buduća ažuriranja, nove značajke ni podršku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az „Örökre” határozatlan idejű licenc az alkalmazás jelenlegi állapotára. Nem ígér jövőbeli frissítéseket, új funkciókat vagy támogatást."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Per sempre» è una licenza perpetua per l'app così com'è. Non promette aggiornamenti futuri, nuove funzioni o assistenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「買い切り」は現状のアプリに対する永続ライセンスです。今後のアップデート、新機能、サポートは約束されません。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Visam laikui“ – neterminuota licencija programėlei tokiai, kokia ji yra. Ji nežada būsimų atnaujinimų, naujų funkcijų ar pagalbos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Uz visiem laikiem” ir beztermiņa licence lietotnei tādai, kāda tā ir. Tā nesola nākotnes atjauninājumus, jaunas funkcijas vai atbalstu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Għal dejjem\" hija liċenzja perpetwa għall-app kif inhi. Ma twiegħedx aġġornamenti futuri, funzjonijiet ġodda jew appoġġ."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Voor altijd’ is een eeuwigdurende licentie voor de app zoals hij is. Er worden geen toekomstige updates, nieuwe functies of ondersteuning beloofd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Na zawsze” to bezterminowa licencja na aplikację w obecnej postaci. Nie obiecuje przyszłych aktualizacji, nowych funkcji ani wsparcia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Para sempre» é uma licença perpétua da app tal como está. Não promete atualizações futuras, novas funcionalidades nem suporte."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Pentru totdeauna” este o licență perpetuă pentru aplicație așa cum este. Nu promite actualizări viitoare, funcții noi sau asistență."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Навсегда» — бессрочная лицензия на приложение в нынешнем виде. Будущие обновления, новые функции и поддержка не обещаются."
