        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte ne peut pas agir en administrateur sur le serveur. Connectez-vous en root ou avec un compte autorisé à utiliser sudo."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní féidir leis an gcuntas seo feidhmiú mar riarthóir ar an bhfreastalaí. Sínigh isteach mar root nó le cuntas atá in ann sudo a úsáid."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj račun ne smije djelovati kao administrator na poslužitelju. Prijavite se kao root ili računom koji smije koristiti sudo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a fiók nem léphet fel rendszergazdaként a szerveren. Jelentkezz be rootként vagy olyan fiókkal, amely használhatja a sudo-t."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
