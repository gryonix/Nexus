    "Each card shows a server's state and live load. Tap one to open it — the tour opens this one for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Karte zeigt den Zustand und die aktuelle Last eines Servers. Tippe darauf, um ihn zu öffnen – die Tour öffnet diesen für dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada tarjeta muestra el estado y la carga en vivo de un servidor. Tócala para abrirlo: el recorrido abre este por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque carte montre l'état et la charge en direct d'un serveur. Touchez-la pour l'ouvrir — la visite ouvre celui-ci pour vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni scheda mostra lo stato e il carico in tempo reale di un server. Toccala per aprirlo: il tour apre questo per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各カードにサーバの状態と現在の負荷が表示されます。タップで開きます。ツアーではこのサーバを代わりに開きます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая карточка показывает состояние сервера и нагрузку в реальном времени. Нажмите, чтобы открыть, — тур откроет этот сервер за вас."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожна картка показує стан сервера й навантаження в реальному часі. Натисніть, щоб відкрити, — тур відкриє цей сервер за вас."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每张卡片显示服务器的状态和实时负载。轻点即可打开——导览会为你打开这一台。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen kortti näyttää palvelimen tilan ja kuorman reaaliajassa. Napauta yhtä avataksesi sen — kierros avaa tämän puolestasi."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всяка карта показва състоянието и текущото натоварване на сървър. Докоснете, за да го отворите — обиколката отваря този вместо вас."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare card arată starea unui server și încărcarea lui live. Atinge unul pentru a-l deschide — turul îl deschide pe acesta pentru tine."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaka kartica prikazuje stanje poslužitelja i opterećenje uživo. Dodirnite jednu za otvaranje — vodič je za vas otvara ovu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsaka kartica prikazuje stanje strežnika in obremenitev v živo. Dotaknite se ene, da jo odprete — vodič to odpre namesto vas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert kort viser en servers tilstand og live-belastning. Tryk på et for at åbne det — rundvisningen åbner dette for dig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke kaart toont de status en live belasting van een server. Tik erop om te openen — de rondleiding opent deze voor jou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje kort visar en servers tillstånd och livebelastning. Tryck på ett för att öppna det — rundturen öppnar det här åt dig."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden kártya megmutatja egy szerver állapotát és élő terhelését. Koppintson egyre a megnyitásához — a bemutató most ezt nyitja meg Önnek."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá karta zobrazuje stav serveru a živé zatížení. Klepnutím na jednu ji otevřete — prohlídka tuto otevře za vás."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda karta pokazuje stan serwera i obciążenie na żywo. Dotknij jednej, aby ją otworzyć — przewodnik otwiera tę za Ciebie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada cartão mostra o estado e a carga em direto de um servidor. Toque num para o abrir — a visita guiada abre este por si."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga kaart näitab serveri olekut ja reaalajas koormust. Puuduta ühte selle avamiseks — tutvustus avab selle sinu jaoks."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá karta zobrazuje stav servera a živé zaťaženie. Klepnutím na jednu ju otvoríte — prehliadka túto otvorí za vás."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε κάρτα δείχνει την κατάσταση και τον φόρτο σε πραγματικό χρόνο ενός διακομιστή. Πατήστε μία για να την ανοίξετε — η ξενάγηση ανοίγει αυτή για εσάς."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katra kartīte rāda servera stāvokli un reāllaika slodzi. Pieskarieties vienai, lai to atvērtu — ekskursija atver šo jūsu vietā."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiekviena kortelė rodo serverio būseną ir apkrovą gyvai. Bakstelėkite vieną, kad ją atvertumėte — apžvalga atveria šią už jus."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taispeánann gach cárta staid agus lód beo freastalaí. Tapáil ceann chun é a oscailt — osclaíonn an turas an ceann seo duit."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kull karta turi l-istat u l-load ħaj ta' server. Agħfas waħda biex tiftaħha — it-tour jiftaħlek din waħda."
          }
        }
      }
    },
