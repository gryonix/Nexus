    "Turn on what you need. Each one installs and configures itself — passwords are shown at the end." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie, was Sie brauchen. Jedes installiert und konfiguriert sich selbst — Passwörter werden am Ende angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa lo que necesites. Cada uno se instala y configura solo; las contraseñas se muestran al final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez ce dont vous avez besoin. Chacun s'installe et se configure tout seul — les mots de passe sont affichés à la fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva ciò che ti serve. Ognuno si installa e si configura da solo: le password vengono mostrate alla fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なものをオンにしてください。それぞれ自動でインストール・設定され、パスワードは最後に表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите то, что нужно. Каждый сам устанавливается и настраивается — пароли показываются в конце."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть те, що потрібно. Кожен сам встановлюється й налаштовується — паролі показуються в кінці."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开您需要的功能。每项都会自动安装和配置——密码在最后显示。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kytke päälle tarvitsemasi. Jokainen asentaa ja määrittää itsensä — salasanat näytetään lopussa."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включете каквото ви трябва. Всяко се инсталира и настройва самò — паролите се показват накрая."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activează ce ai nevoie. Fiecare se instalează și se configurează singur — parolele sunt afișate la final."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uključite što vam treba. Svaka se sama instalira i konfigurira — lozinke se prikazuju na kraju."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå til, hvad du har brug for. Hver enkelt installerer og konfigurerer sig selv — adgangskoder vises til sidst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet aan wat je nodig hebt. Elke dienst installeert en configureert zichzelf — wachtwoorden worden aan het eind getoond."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på det du behöver. Var och en installerar och konfigurerar sig själv — lösenord visas i slutet."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vklopite, kar potrebujete. Vsaka se namesti in konfigurira sama — gesla so prikazana na koncu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolja be, amire szüksége van. Mindegyik önmagát telepíti és konfigurálja — a jelszavak a végén jelennek meg."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte, co potřebujete. Každá se sama nainstaluje a nakonfiguruje — hesla se zobrazí na konci."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz to, czego potrzebujesz. Każda z nich sama się instaluje i konfiguruje — hasła są pokazywane na końcu."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lülita sisse see, mida vajad. Iga üks installib ja seadistab end ise — paroolid näidatakse lõpus."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o que precisar. Cada um instala-se e configura-se a si próprio — as palavras-passe são mostradas no final."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε ό,τι χρειάζεστε. Καθεμία εγκαθίσταται και διαμορφώνεται μόνη της — οι κωδικοί πρόσβασης εμφανίζονται στο τέλος."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnite, čo potrebujete. Každá sa sama nainštaluje a nastaví — heslá sa zobrazia na konci."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieslēdziet to, kas jums nepieciešams. Katrs pats instalējas un konfigurējas — paroles tiek parādītas beigās."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cas ar siúl a bhfuil uait. Suiteálann agus cumraíonn gach ceann é féin — taispeántar pasfhocail ag an deireadh."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įjunkite tai, ko jums reikia. Kiekviena pati įsidiegia ir susikonfigūruoja — slaptažodžiai parodomi pabaigoje."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ixgħel dak li teħtieġ. Kull wieħed jinstalla u jikkonfigura ruħu — il-passwords jintwerew fl-aħħar."
          }
        }
      }
    },
