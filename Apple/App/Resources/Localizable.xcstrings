          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'IP publique de ton VPS et l'adresse du serveur local sur ton réseau — une IP ou un nom .local. Garde cet appareil sur ce réseau pendant l'installation."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seoladh IP poiblí do VPS agus seoladh an fhreastalaí áitiúil ar do líonra — IP nó ainm .local. Coinnigh an gléas seo ar an líonra sin le linn na suiteála."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Javna IP tvog VPS-a i adresa lokalnog poslužitelja u tvojoj mreži — IP ili naziv .local. Tijekom instalacije drži ovaj uređaj u toj mreži."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A VPS nyilvános IP-címe és a helyi szerver címe a hálózatodon — IP vagy .local név. Telepítés közben maradj ezzel az eszközzel azon a hálózaton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'IP pubblico del tuo VPS e l'indirizzo del server locale nella tua rete: un IP o un nome .local. Tieni questo dispositivo su quella rete durante l'installazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPS のパブリック IP と、ネットワーク内のローカルサーバーのアドレス（IP または .local 名）。インストール中はこのデバイスをそのネットワークに置いてください。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsų VPS viešasis IP ir vietinio serverio adresas jūsų tinkle — IP arba .local vardas. Diegimo metu laikykite šį įrenginį tame tinkle."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu VPS publiskā IP un lokālā servera adrese jūsu tīklā — IP vai .local nosaukums. Instalēšanas laikā turiet šo ierīci tajā tīklā."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-IP pubbliku tal-VPS tiegħek u l-indirizz tas-server lokali fin-netwerk tiegħek — IP jew isem .local. Żomm dan it-tagħmir f'dak in-netwerk waqt l-installazzjoni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het publieke IP van je VPS en het adres van de lokale server in je netwerk — een IP of een .local-naam. Houd dit apparaat tijdens de installatie op dat netwerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publiczny IP twojego VPS i adres serwera lokalnego w twojej sieci — IP lub nazwa .local. Podczas instalacji trzymaj to urządzenie w tej sieci."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O IP público do seu VPS e o endereço do servidor local na sua rede — um IP ou um nome .local. Mantenha este dispositivo nessa rede durante a instalação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IP-ul public al VPS-ului tău și adresa serverului local din rețeaua ta — un IP sau un nume .local. Ține acest dispozitiv în acea rețea în timpul instalării."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Публичный IP вашего VPS и адрес локального сервера в вашей сети — IP или имя .local. Во время установки держите это устройство в этой сети."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verejná IP vášho VPS a adresa lokálneho servera vo vašej sieti — IP alebo názov .local. Počas inštalácie majte toto zariadenie v tej sieti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Javni IP tvojega VPS in naslov lokalnega strežnika v tvojem omrežju — IP ali ime .local. Med namestitvijo imej to napravo v tem omrežju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din VPS:s publika IP och den lokala serverns adress i ditt nätverk – en IP eller ett .local-namn. Håll den här enheten i det nätverket under installationen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Публічна IP вашого VPS і адреса локального сервера у вашій мережі — IP або ім'я .local. Під час встановлення тримайте цей пристрій у цій мережі."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 VPS 公网 IP，以及本地服务器在你网络中的地址（IP 或 .local 名称）。安装期间请让本设备保持在该网络中。"
          }
        }
      }
    },
