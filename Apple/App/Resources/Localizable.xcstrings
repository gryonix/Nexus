    "Restoring replaces the service's current data. Its containers go down while it runs." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wiederherstellen werden die aktuellen Daten des Dienstes ersetzt. Seine Container sind währenddessen gestoppt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restoring replaces the service's current data. Its containers go down while it runs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauración reemplaza los datos actuales del servicio. Sus contenedores se detienen mientras se ejecuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauration remplace les données actuelles du service. Ses conteneurs sont arrêtés pendant l’opération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ripristino sostituisce i dati attuali del servizio. I suoi container restano fermi durante l’operazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元するとサービスの現在のデータが置き換えられます。実行中はコンテナが停止します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление заменит текущие данные сервиса. Его контейнеры на это время будут остановлены."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відновлення замінить поточні дані сервісу. Його контейнери на цей час буде зупинено."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复会替换该服务的当前数据。运行期间其容器会停止。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
