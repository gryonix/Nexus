    "This account may not act as administrator on the server. Sign in as root or as an account that may use sudo." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този акаунт няма право да действа като администратор на сървъра. Влезте като root или с акаунт, който може да ползва sudo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento účet nesmí na serveru jednat jako správce. Přihlaste se jako root nebo účtem, který smí používat sudo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne konto må ikke fungere som administrator på serveren. Log ind som root eller med en konto, der må bruge sudo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Konto darf auf dem Server keine Administratorrechte nutzen. Melde dich als root oder mit einem Konto an, das sudo verwenden darf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο λογαριασμός δεν μπορεί να ενεργεί ως διαχειριστής στον διακομιστή. Συνδεθείτε ως root ή με λογαριασμό που μπορεί να χρησιμοποιεί sudo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta no puede actuar como administrador en el servidor. Inicia sesión como root o con una cuenta que pueda usar sudo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See konto ei tohi serveris administraatorina tegutseda. Logi sisse root-kasutajana või kontoga, mis tohib sudo't kasutada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä tili ei voi toimia palvelimella järjestelmänvalvojana. Kirjaudu rootina tai tilillä, joka saa käyttää sudoa."
