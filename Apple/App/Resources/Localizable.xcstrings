          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest server nu are nicio configurație salvată, așa că este reconstruită din ce știe aplicația despre el și afișată spre revizuire înainte ca configurarea să ruleze. Serviciile și datele lor sunt păstrate."
