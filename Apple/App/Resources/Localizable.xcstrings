    "Move gryonixNexus to the Applications folder and open it from there. macOS runs the tunnel only for apps in Applications." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преместете gryonixNexus в папката Приложения и го отворете оттам. macOS стартира тунела само за приложения в Приложения."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přesuňte gryonixNexus do složky Aplikace a otevřete ho odtud. macOS spouští tunel jen pro aplikace ve složce Aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt gryonixNexus til mappen Programmer, og åbn det derfra. macOS kører kun tunnelen for apps i Programmer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegen Sie gryonixNexus in den Ordner „Programme“ und öffnen Sie es von dort. macOS startet den Tunnel nur für Apps in „Programme“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετακινήστε το gryonixNexus στον φάκελο Εφαρμογές και ανοίξτε το από εκεί. Το macOS εκτελεί το τούνελ μόνο για εφαρμογές στις Εφαρμογές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve gryonixNexus a la carpeta Aplicaciones y ábrelo desde allí. macOS solo ejecuta el túnel para apps en Aplicaciones."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teisaldage gryonixNexus kausta Rakendused ja avage see sealt. macOS käivitab tunneli ainult kaustas Rakendused olevatele rakendustele."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrä gryonixNexus Ohjelmat-kansioon ja avaa se sieltä. macOS käynnistää tunnelin vain Ohjelmat-kansiossa oleville apeille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez gryonixNexus dans le dossier Applications et ouvrez-le depuis là. macOS n’exécute le tunnel que pour les apps du dossier Applications."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bog gryonixNexus go dtí an fillteán Applications agus oscail as sin é. Ní ritheann macOS an tollán ach d’aipeanna in Applications."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premjestite gryonixNexus u mapu Aplikacije i otvorite ga odande. macOS pokreće tunel samo za aplikacije u mapi Aplikacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helyezze át a gryonixNexus alkalmazást az Alkalmazások mappába, és onnan nyissa meg. A macOS csak az Alkalmazások mappában lévő appoknak indítja el az alagutat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta gryonixNexus nella cartella Applicazioni e aprilo da lì. macOS avvia il tunnel solo per le app in Applicazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gryonixNexus を「アプリケーション」フォルダに移動し、そこから開いてください。macOS は「アプリケーション」内のアプリに対してのみトンネルを実行します。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
