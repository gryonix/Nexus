          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne maskine har aldrig haft en USB-seriel adapter — der er intet at vælge endnu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze machine heeft nog nooit een USB-seriële adapter gehad — er valt nog niets te kiezen."
