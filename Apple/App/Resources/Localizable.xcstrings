    "Anyone who can reach Vaultwarden can create an account until you close registration again." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всеки, който може да достигне Vaultwarden, може да създаде акаунт, докато не затворите регистрацията отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdokoli, kdo se dostane k Vaultwarden, si může vytvořit účet, dokud znovu neuzavřete registraci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhver der kan nå Vaultwarden kan oprette en konto, indtil du lukker registreringen igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder, der Vaultwarden erreichen kann, kann ein Konto erstellen, bis Sie die Registrierung wieder schließen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οποιοσδήποτε μπορεί να φτάσει στο Vaultwarden μπορεί να δημιουργήσει λογαριασμό μέχρι να κλείσετε ξανά την εγγραφή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera que pueda acceder a Vaultwarden puede crear una cuenta hasta que cierre el registro nuevamente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igaüks, kes jõuab Vaultwardeni, saab luua konto, kuni taas registreerimise sulgemate."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuka tahansa, joka pääsee Vaultwardenii, voi luoda tilin, kunnes suljet rekisteröinnin uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'importe qui peut accéder à Vaultwarden pour créer un compte jusqu'à ce que vous fermiez à nouveau l'enregistrement."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aon duine a bhíonn in ann Vaultwarden a bhaint amach is féidir cuntas a chruthú go dtí go dúna tú an clárúchán arís."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tko god može doći do Vaultwarden može stvoriti račun dok ne zatvorite registraciju ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bárki, aki eléri a Vaultwarden, létrehozhat fiókot, amíg újra nem zárja le a regisztrációt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque possa accedere a Vaultwarden può creare un account finché non chiudi di nuovo la registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden に到達できるユーザーはアカウントを作成できます、登録を再度閉じるまで。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas nors, kas gali pasiekti Vaultwardą, gali sukurti paskyrą, kol jūs nepavėlavęs uždaryti registraciją."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikviens, kas var sasniegt Vaultwarden, var izveidot kontu, līdz jūs atkārtoti aizversat reģistrāciju."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kull-hadd li jista' jilħaq Vaultwarden jista' joħloq kont sa tiegħek tikser il-reġistrazzjoni taħt mil-ġdid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen die Vaultwarden kan bereiken, kan een account maken totdat je registratie opnieuw sluit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy, kto może dotrzeć do Vaultwarden, może stworzyć konto, dopóki nie zamkniesz rejestracji ponownie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa que possa acessar Vaultwarden pode criar uma conta até fechar o registro novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oricine care poate ajunge la Vaultwarden poate crea un cont până când nu inchizi din nou înregistrarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой, у кого есть доступ к Vaultwarden, может создать учётную запись, пока вы снова не закроете регистрацию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ktokoľvek, kto sa dostane k Vaultwarden, si môže vytvoriť účet, kým znova neuzavrieš registráciu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdorkoli, ki lahko doseže Vaultwarden, lahko naredi račun, dokler ne zapreš registracije spet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vem som helst som kan nå Vaultwarden kan skapa ett konto tills du stänger registreringen igen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь-хто з доступом до Vaultwarden може створити обліковий запис, доки ви знову не закриєте реєстрацію."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何能访问 Vaultwarden 的人都可以创建账户，直到您再次关闭注册。"
          }
        }
      }
    },
