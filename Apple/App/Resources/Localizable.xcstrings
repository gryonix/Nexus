    "No saved report yet. It is captured automatically when you install from this device; re-run the installation to fill it in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch kein gespeicherter Bericht. Er wird bei der Installation von diesem Gerät automatisch erfasst — führen Sie die Installation erneut aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay informe guardado. Se captura automáticamente al instalar desde este dispositivo; vuelva a ejecutar la instalación para completarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
