    "Tap a token to publish with it; the pencil holds the token itself, the name and which provider it belongs to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Veröffentlichen auf ein Token tippen; der Stift enthält das Token selbst, seinen Namen und den Anbieter, zu dem es gehört."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque un token para publicar con él; el lápiz contiene el propio token, su nombre y a qué proveedor pertenece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un jeton pour publier avec lui ; le crayon contient le jeton lui-même, son nom et le fournisseur auquel il appartient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un token per pubblicare con esso; la matita contiene il token stesso, il suo nome e il provider a cui appartiene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークンをタップすると、それを使って公開します。鉛筆アイコンには、トークン本体・名前・所属プロバイダーが入っています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на токен, чтобы публиковать через него; в карандаше — сам токен, его имя и то, какому провайдеру он принадлежит."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть на токен, щоб публікувати через нього; в олівці — сам токен, його ім'я і те, якому провайдеру він належить."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按某个令牌即可用它发布；铅笔图标里是令牌本身、名称以及它所属的服务商。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta tokenia julkaistaksesi sillä; kynä pitää itse tokenin, nimen ja palveluntarjoajan, johon se kuuluu."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докоснете токен, за да публикувате с него; моливчето съдържа самия токен, името и на кой доставчик принадлежи."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite token da objavite s njim; olovka sadrži sam token, ime i kojem pružatelju usluge pripada."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
