    "This machine's network card cannot wake it up, for example over Wi-Fi." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мрежовата карта на тази машина не може да я събуди, например през Wi-Fi."
