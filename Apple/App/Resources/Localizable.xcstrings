    "Each card shows a server's state and live load. Click one to open it — the tour opens this one for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Karte zeigt den Zustand und die aktuelle Last eines Servers. Klick auf eine, um sie zu öffnen – die Tour öffnet diese für dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada tarjeta muestra el estado y la carga en vivo de un servidor. Haz clic en una para abrirla; el recorrido abre esta por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque carte montre l'état et la charge en direct d'un serveur. Cliquez sur l'une pour l'ouvrir — la visite ouvre celle-ci pour vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni scheda mostra lo stato e il carico in tempo reale di un server. Fai clic su una per aprirla: il tour apre questa per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各カードにサーバーの状態とリアルタイムの負荷が表示されます。クリックで開きます。ツアーではこのカードを開きます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая карточка показывает состояние сервера и нагрузку в реальном времени. Щёлкните, чтобы открыть, — тур откроет эту сам."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожна картка показує стан сервера й навантаження в реальному часі. Клацніть, щоб відкрити, — тур відкриє цю сам."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每张卡片显示服务器的状态和实时负载。点击即可打开——导览会为你打开这一张。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen kortti näyttää palvelimen tilan ja kuorman reaaliajassa. Napauta yhtä avataksesi sen — kierros avaa tämän puolestasi."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всяка карта показва състоянието и текущото натоварване на сървър. Кликнете върху нея, за да я отворите — обиколката отваря тази вместо вас."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaka kartica prikazuje stanje i trenutno opterećenje poslužitelja. Kliknite na nju da je otvorite — vodič otvara ovu umjesto vas."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsaka kartica prikazuje stanje in trenutno obremenitev strežnika. Kliknite nanjo, da jo odprete — vodeni ogled odpre to namesto vas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert kort viser en servers tilstand og aktuelle belastning. Klik på et for at åbne det — rundvisningen åbner dette for dig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke kaart toont de status en live belasting van een server. Klik op een kaart om deze te openen — de rondleiding opent deze voor je."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje kort visar en servers tillstånd och aktuella belastning. Klicka på ett för att öppna det — rundturen öppnar det här åt dig."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga kaart näitab serveri olekut ja koormust reaalajas. Klõpsa ühel, et see avada — ekskursioon avab selle sinu eest."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taispeánann gach cárta staid agus ualach beo freastalaí. Cliceáil ceann chun é a oscailt — osclaíonn an turas an ceann seo duit."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kull karta turi l-istat u t-tagħbija ħajja ta' server. Ikklikkja waħda biex tiftaħha — it-tour jiftaħlek din."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada cartão mostra o estado e a carga em tempo real de um servidor. Clique num para o abrir — a visita guiada abre este por si."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε κάρτα δείχνει την κατάσταση και το τρέχον φορτίο ενός διακομιστή. Πάτησε σε μία για να την ανοίξεις — η ξενάγηση ανοίγει αυτήν για σένα."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden kártya megmutatja egy szerver állapotát és aktuális terhelését. Kattints egyre a megnyitásához — a bemutató most ezt nyitja meg neked."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare card arată starea și încărcarea live a unui server. Apasă pe unul pentru a-l deschide — turul îl deschide pe acesta pentru tine."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda karta pokazuje stan serwera i bieżące obciążenie. Kliknij jedną, aby ją otworzyć — przewodnik otwiera właśnie tę."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá karta zobrazuje stav serveru a aktuální zátěž. Klikněte na jednu, abyste ji otevřeli — průvodce otevírá právě tuto."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá karta zobrazuje stav servera a aktuálnu záťaž. Kliknite na jednu, aby ste ju otvorili — sprievodca otvára práve túto."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katra kartīte rāda servera stāvokli un tiešraides slodzi. Noklikšķiniet uz vienas, lai to atvērtu — apskates tūre atver šo jūsu vietā."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiekviena kortelė rodo serverio būseną ir realaus laiko apkrovą. Spustelėkite vieną, kad ją atidarytumėte — apžvalga atidaro šią už jus."
          }
        }
      }
    },
