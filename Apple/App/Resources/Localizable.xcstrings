          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-ebda snapshot għadu ma nkiteb — iftaħ it-tagħmir VPN ta' server u erġa' lura."
          }
        },
        "nl" : {
