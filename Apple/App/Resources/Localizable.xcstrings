    "A panel is one server, one metric and one period. Add the few you actually watch and they all update side by side." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Panel ist ein Server, eine Metrik und ein Zeitraum. Legen Sie die wenigen an, die Sie wirklich beobachten — sie aktualisieren sich alle nebeneinander."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un panel es un servidor, una métrica y un periodo. Añade los pocos que realmente vigilas y se actualizan todos a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
