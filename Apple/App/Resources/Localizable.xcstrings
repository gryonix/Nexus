        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-fajl iġorr kollox dwar dan is-server: il-konfigurazzjoni tiegħu, iċ-ċavetta SSH, iċ-ċwievet tat-tunnel u l-passwords. L-apparat l-ieħor jista' jimmaniġġja, jerġa' jinstalla u jsewwi eżattament kif jagħmel dan — għalhekk aqsam il-fajl biss ma' apparat li tafda."
          }
        }
      }
