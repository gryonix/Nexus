        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ toimii nyt koneella %2$@. Vanha kopio on pysäytetty ja sen tiedot säilytetty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fonctionne maintenant sur %2$@. L'ancienne copie est arrêtée et ses données sont conservées."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá %1$@ ag rith ar %2$@ anois. Tá an tseanchóip stoptha agus coinníodh a sonraí."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sada radi na %2$@. Stara kopija je zaustavljena, a njezini podaci su sačuvani."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %1$@ most a(z) %2$@ gépen fut. A régi példány le van állítva, az adatai megmaradtak."
