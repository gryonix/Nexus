    "Old copies (.before-cache) are what the folders held before the move. Delete them once everything works." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Старите копия (.before-cache) са съдържанието на папките преди преместването. Изтрийте ги, когато всичко работи."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staré kopie (.before-cache) jsou obsah složek před přesunem. Smažte je, až vše funguje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamle kopier (.before-cache) er mappernes indhold før flytningen. Slet dem, når alt virker."
