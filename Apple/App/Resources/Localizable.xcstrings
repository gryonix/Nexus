        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Други сървъри се достигат през този. Премахнете ги първо."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere servers worden via deze bereikt. Verwijder ze eerst."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andre servere nås gennem denne. Fjern dem først."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andra servrar nås genom den här. Ta bort dem först."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alte servere sunt accesate prin acesta. Elimină-le mai întâi."
