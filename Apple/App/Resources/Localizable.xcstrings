    "No USB drive is plugged in. Plug one into the server and pull to refresh." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма включено USB устройство. Включете устройство в сървъра и плъзнете надолу за опресняване."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Není připojen žádný USB disk. Připojte jeden k serveru a stažením obnovte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet USB-drev er sat i. Sæt et i serveren, og træk ned for at opdatere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein USB-Laufwerk angeschlossen. Schließe eines an den Server an und ziehe zum Aktualisieren nach unten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει συνδεδεμένη μονάδα USB. Συνδέστε μία στον διακομιστή και σύρετε για ανανέωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna unidad USB conectada. Conecta una al servidor y desliza para actualizar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ühtegi USB-draivi pole ühendatud. Ühenda üks serverisse ja tõmba värskendamiseks alla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-asemaa ei ole kytketty. Kytke asema palvelimeen ja päivitä vetämällä alas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun disque USB n'est branché. Branchez-en un sur le serveur et tirez pour actualiser."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níl aon tiomántán USB ceangailte. Ceangail ceann leis an bhfreastalaí agus tarraing chun athnuachan."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nijedan USB pogon nije priključen. Priključite jedan na poslužitelj i povucite za osvježavanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs USB-meghajtó csatlakoztatva. Csatlakoztass egyet a szerverhez, és húzd le a frissítéshez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna unità USB collegata. Collegane una al server e trascina per aggiornare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB ドライブが接続されていません。サーバーに接続し、引っ張って更新してください。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neprijungtas joks USB diskas. Prijunkite jį prie serverio ir patraukite, kad atnaujintumėte."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nav pievienots neviens USB disks. Pievienojiet to serverim un velciet, lai atsvaidzinātu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-ebda drajv USB mhu mqabbad. Qabbad wieħed mas-server u iġbed biex taġġorna."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen USB-schijf aangesloten. Sluit er een aan op de server en trek omlaag om te vernieuwen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie podłączono żadnego dysku USB. Podłącz go do serwera i przeciągnij, aby odświeżyć."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há nenhuma unidade USB ligada. Ligue uma ao servidor e puxe para atualizar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu este conectată nicio unitate USB. Conectați una la server și trageți pentru reîmprospătare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-накопитель не подключён. Вставьте его в сервер и потяните вниз, чтобы обновить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie je pripojený žiadny USB disk. Pripojte jeden k serveru a potiahnutím obnovte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noben pogon USB ni priključen. Priključite ga na strežnik in povlecite za osvežitev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen USB-enhet är ansluten. Anslut en till servern och dra nedåt för att uppdatera."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-накопичувач не підключено. Вставте його в сервер і потягніть униз, щоб оновити."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未插入 USB 驱动器。请将驱动器插入服务器，然后下拉刷新。"
          }
        }
      }
