    "They cannot be brought back. The data the services use now is not touched." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не могат да бъдат върнати. Данните, които услугите използват сега, не се засягат."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepůjde je vrátit. Data, se kterými služby teď pracují, zůstanou beze změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kan ikke hentes tilbage. De data, tjenesterne bruger nu, røres ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie lassen sich nicht zurückholen. Die Daten, mit denen die Dienste jetzt arbeiten, bleiben unberührt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν θα μπορούν να ανακτηθούν. Τα δεδομένα που χρησιμοποιούν τώρα οι υπηρεσίες δεν επηρεάζονται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se podrán recuperar. Los datos que usan ahora los servicios no se tocan."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neid ei saa tagasi tuua. Andmeid, mida teenused praegu kasutavad, see ei puuduta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niitä ei voi palauttaa. Palveluiden nyt käyttämiin tietoihin ei kosketa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles ne pourront pas être récupérées. Les données utilisées actuellement par les services ne sont pas touchées."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní féidir iad a thabhairt ar ais. Ní dhéantar teagmháil leis na sonraí atá in úsáid ag na seirbhísí anois."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neće se moći vratiti. Podaci koje usluge sada koriste ostaju netaknuti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem hozhatók vissza. A szolgáltatások által most használt adatokat nem érinti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non si potranno recuperare. I dati che i servizi usano ora non vengono toccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元に戻せません。サービスが現在使っているデータには影響しません。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
