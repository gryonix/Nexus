    "Asks the relay to forget this device for every server at once, whoever runs them. It does not need the servers to answer." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моли релето да забрави това устройство за всеки сървър наведнъж, без значение кой ги управлява. Не е необходимо сървърите да отговорят."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požádá přes uzávěru, aby zapomněla na toto zařízení pro všechny servery najednou, bez ohledu na to, kdo je spravuje. Nevyžaduje odpovědi ze serverů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beder relæet om at glemme denne enhed for alle servere på én gang, uanset hvem der kører dem. Det kræver ikke, at serverne svarer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fordert das Relais auf, dieses Gerät für alle Server auf einmal zu vergessen, unabhängig davon, wer sie ausführt. Es benötigt keine Antwort der Server."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζητά από το ρελέ να ξεχάσει αυτή την συσκευή για κάθε διακομιστή ταυτόχρονα, ανεξάρτητα από το ποιος τους εκτελεί. Δεν χρειάζεται απάντηση από τους διακομιστές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pide al relé que olvide este dispositivo para todos los servidores a la vez, sin importar quién los ejecute. No es necesario que los servidores respondan."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palub releel unustada see seade kõigile serveritest korraga, olenemata sellest, kes neid juhib. Serverid ei pea vastama."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyytää välityspalvelinta unohtamaan tämän laitteen kaikille palvelimille kerralla, riippumatta siitä, kuka niitä käyttää. Se ei vaadi palvelimien vastausta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande au relais d'oublier cet appareil pour tous les serveurs à la fois, peu importe qui les gère. Les serveurs n'ont pas besoin de répondre."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iarrann sé ar an bhfreagra an ghaiste seo a dhéanamh dearmad ar gach freastalaí ar an bpointe, beag an baol cé a ritheann iad. Ní gá do na freastalaí a bheith ag freagairt."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traži od releja da zaboravi ovaj uređaj za sve poslužitelje odjednom, bez obzira tko ih upravlja. Ne trebaju odgovori od poslužitelja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A relét arra kéri, hogy felejtse el ezt az eszközt az összes szerverre egyszerre, függetlenül attól, hogy ki futtatja őket. Nem szükséges a szerverek válasza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiede al relè di dimenticare questo dispositivo per tutti i server contemporaneamente, indipendentemente da chi li gestisce. Non è necessaria la risposta dei server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リレーに対して、誰が実行しているかに関わらず、すべてのサーバーから同時にこのデバイスを忘れるよう要求します。サーバーからの応答は不要です。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prašo relės pamiršti šį įrenginį visiems serveriams iš karto, neatsižvelgiant į tai, kas juos valdo. Serveriu atsakymas nereikalingas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lūdz relesi aizmirst šo ierīci visiem serveriem uzreiz, neatkarīgi no tā, kas tos palaišana. Serveri nav jāatbild."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jitlob ir-relay li tisnieh dan l-apparatur għal kull server f'daqqa, x'imkien li jageħmilhom. M'haggħux li s-servers jirrispondu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraagt het relais om dit apparaat voor alle servers tegelijk te vergeten, ongeacht wie ze beheert. De servers hoeven niet te reageren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosi przekaźnik, aby zapomniał o tym urządzeniu dla wszystkich serwerów jednocześnie, niezależnie od tego, kto nimi zarządza. Serwery nie muszą odpowiadać."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pede ao relé para esquecer este dispositivo para todos os servidores de uma vez, independentemente de quem os gerencia. Os servidores não precisam responder."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cere retransmisiei să uite acest dispozitiv pentru fiecare server deodată, indiferent cine le conduce. Serverele nu trebuie să răspundă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просит реле забыть это устройство для всех серверов одновременно, независимо от того, кто их управляет. Серверам не нужно отвечать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zisťuje od relé zabudnúť na toto zariadenie pre všetky servery naraz, bez ohľadu na to, kto ich spravuje. Servery sa nemusíajú odpovedať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosi relej, da pozabi ta naprav za vse strežnike naenkrat, ne glede na to, kdo jih upravlja. Strežniki se ne morajo odzvati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ber relän att glömma denna enhet för alla servrar på en gång, oavsett vem som kör dem. Servern behöver inte svara."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просить реле забути цей пристрій для всіх серверів одночасно, незалежно від того, хто їх управляє. Сервери не повинні відповідати."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求中继忘记此设备，同时向所有服务器发送，无论谁运行它们。服务器不需要回复。"
          }
        }
      }
    },
