    "The configuration has more than one [Peer] section, and this app carries only one." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конфигурацията съдържа повече от един раздел [Peer], но това приложение поддържа само един."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurace obsahuje více než jednu sekci [Peer], ale tato aplikace podporuje pouze jednu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurationen indeholder mere end ét [Peer]-afsnit, men denne app understøtter kun ét."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Konfiguration enthält mehr als einen [Peer]-Abschnitt, aber diese App unterstützt nur einen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διαμόρφωση περιέχει περισσότερα από ένα τμήμα [Peer], αλλά αυτή η εφαρμογή υποστηρίζει μόνο ένα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
