            "value" : "Scriostar sonraí na seirbhíse go buan. Fanann a cúltacaí ar an diosca. Ní féidir é seo a chealú."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paslaugos duomenys ištrinami visam laikui. Jos atsarginės kopijos lieka diske. Šio veiksmo atšaukti negalima."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Id-data tas-servizz titħassar b'mod permanenti. Il-backups tagħha jibqgħu fuq id-disk. Dan ma jistax jitħassar lura."
          }
        }
      }
    },
