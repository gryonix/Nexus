    "RAID 0 has no protection: if any one disk fails, everything on the array is lost." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 няма защита: ако всеки диск се счупи, всичко на масива е загубено."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 nemá ochranu: pokud se kterýkoliv disk nezdaří, vše na poli je ztraceno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 har ingen beskyttelse: hvis en diskfejl opstår, mistes alt på arrayet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 hat keinen Schutz: Wenn ein Datenträger ausfällt, geht alles auf dem Array verloren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το RAID 0 δεν έχει προστασία: εάν ένας δίσκος αποτύχει, όλα στον πίνακα χάνονται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 no tiene protección: si falla algún disco, todo en la matriz se pierde."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 ei ole kaitstud: kui ükskõik milline ketas nurjub, kaob kõik massiivil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 ei ole suojattu: jos mikä tahansa levy epäonnistuu, kaikki taulukossa menetetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 n'a pas de protection : si un disque quelconque échoue, tout sur l'ensemble est perdu."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gan bhreis RAID 0: má theipeann aon dhiosca ar bith, cailltear gach rud ar an sraith."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 nema zaštite: ako bilo koji disk ne uspije, sve na nizu se gubi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A RAID 0-nak nincs védelme: ha bármely lemez meghibásodik, az egész tömb elveszett."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 non ha protezione: se un disco qualsiasi non riesce, tutto sull'array va perso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 は保護がありません。ディスクが故障すると、アレイ上のすべてが失われます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 neturi apsaugos: jei kuris nors diskas sutriko, visi masyvai yra prarasti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 nav aizsardzības: ja kāds disks neizdosies, visas masīvs ir zaudēts."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 m'għandx protezzjoni: jekk xi disk jikser, kollox fuq il-array jitilef."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 heeft geen bescherming: als een schijf uitvalt, gaat alles op de array verloren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 nie ma ochrony: jeśli jakikolwiek dysk ulegnie awarii, wszystko na macierzy zostanie utracone."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 não tem proteção: se algum disco falhar, tudo no array é perdido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 nu are protecție: dacă oricare disk eșuează, totul pe matrice este pierdut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У RAID 0 нет защиты: если откажет любой диск, пропадёт всё, что есть на массиве."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 nemá ochranu: ak sa akýkoľvek disk nezdaří, všetko na poli sa stráca."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 nima zaščite: če kateri koli disk ne uspe, se vse na polju izgubi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 har ingen skydd: om någon disk misslyckas försvinner allt på arrayen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 не має захисту: якщо відмовить будь-який диск, усе на масиві буде втрачено."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 没有保护：如果任何磁盘出现故障，阵列上的所有内容都会丢失。"
          }
        }
      }
    },
