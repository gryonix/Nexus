    "Repairs change disks, so they run as root — the same sign-in the installation used." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поправките променят дисковете, така че работят като root — същият вход, който използва инсталацията."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opravy mění disky, takže běží jako root — stejné přihlášení, které instalace používala."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reparationer ændrer diske, så de køres som root — det samme login-navn som installationen brugte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reparaturen ändern Platten und laufen daher als root — mit derselben Anmeldung wie die Installation."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι επισκευές αλλάζουν δίσκους, κι έτσι τρέχουν ως root — το ίδιο σύνδεσμο που χρησιμοποίησε η εγκατάσταση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reparaciones cambian discos, por lo que se ejecutan como root — el mismo inicio de sesión que usó la instalación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parandused muudavad kettaid, seega jooksevad need root-ina — sama sisselogimine, mida paigaldus kasutas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korjaukset muuttavat levyjä, joten ne toimivat juurena — sama kirjautuminen, jota asennos käytti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réparations changent les disques, elles s'exécutent donc en tant que root — le même identifiant que l'installation a utilisé."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bainim ar dhíoscaí a athrú, mar sin rithionn siad mar root — an t-ionad céanna a raibh an suiteáil ag úsáid."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Popravke mijenjaju diskove, tako da se izvršavaju kao root — ista prijava koju je instalacija koristila."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A javítások megváltoztatják a lemezeket, így root-ként futnak — ugyanaz a bejelentkezés, amelyet a telepítés használt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le riparazioni cambiano i dischi, quindi vengono eseguite come root — lo stesso accesso che l'installazione ha utilizzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修復はディスクを変更するため、root として実行されます。これはインストールが使用したサインインと同じです。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remontai keičia diskus, todėl jie veikia kaip root — tas pats prisijungimas, kurį naudojo diegimas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salabot mainās diskus, tāpēc tie darbojas kā root — tas pats pieteikšanās, ko izmantoja instalācija."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ir-riparazzjoniet ibiddlu d-disketti, allura jaħdmu bħala root — l-istess sign-in li użat l-installazzjoni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reparaties veranderen schijven, dus ze draaien als root — dezelfde inloggegevens die de installatie heeft gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naprawy zmieniają dyski, więc działają jako root — to samo logowanie, które stosował instalator."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reparos mudam discos, então são executados como root — o mesmo login que a instalação usou."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reparațiile schimbă discuri, deci rulează ca root — aceeași conectare pe care a folosit-o instalarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
