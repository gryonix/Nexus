          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara WireGuard — andra VPN-protokoll når dem inte"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo WireGuard — drugi VPN protokoli ih ne dosežu"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo WireGuard — drugi VPN protokoli jih ne dosežejo"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak WireGuard — más VPN protokollok nem érik el őket"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouze WireGuard — ostatní VPN protokoly se k nim nedostanou"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko WireGuard — inne protokoły VPN do nich nie docierają"
          }
        },
        "pt-PT" : {
