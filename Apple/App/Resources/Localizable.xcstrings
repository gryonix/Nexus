    "Devices are added on the server and appear in its VPN panel too — this is the same list, managed from the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geräte werden auf dem Server angelegt und erscheinen auch in dessen VPN-Panel – es ist dieselbe Liste, nur aus der App verwaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dispositivos se añaden en el servidor y aparecen también en su panel VPN: es la misma lista, gestionada desde la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appareils sont ajoutés sur le serveur et apparaissent aussi dans son panneau VPN — c’est la même liste, gérée depuis l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dispositivi vengono aggiunti sul server e compaiono anche nel suo pannello VPN: è la stessa lista, gestita dall’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスはサーバー上に追加され、そのサーバーの VPN パネルにも表示されます。同じ一覧をアプリから管理しているだけです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройства заводятся на сервере и появляются и в его VPN-панели — это один и тот же список, управляемый из приложения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пристрої створюються на сервері й з’являються і в його VPN-панелі — це той самий список, керований із застосунку."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备在服务器上添加，也会出现在该服务器的 VPN 面板中——这是同一份列表，只是从应用管理。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitteet lisätään palvelimella ja ne näkyvät myös sen VPN-paneelissa — tämä on sama lista, hallittuna sovelluksesta."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройствата се добавят на сървъра и се показват и в неговия VPN панел — това е един и същ списък, управляван от приложението."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparaten worden op de server toegevoegd en verschijnen ook in het VPN-paneel — het is dezelfde lijst, beheerd vanuit de app."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enheder tilføjes på serveren og vises også i dens VPN-panel — det er den samme liste, administreret fra appen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enheter läggs till på servern och visas även i dess VPN-panel — det är samma lista, hanterad från appen."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uređaji se dodaju na poslužitelju i pojavljuju se i u njegovom VPN panelu — ovo je isti popis, upravljan iz aplikacije."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naprave se dodajajo na strežniku in se pojavijo tudi v njegovem VPN pultu — to je isti seznam, upravljan iz aplikacije."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispozitivele sunt adăugate pe server și apar și în panoul lui VPN — este aceeași listă, gestionată din aplicație."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urządzenia są dodawane na serwerze i pojawiają się też w jego panelu VPN — to ta sama lista, zarządzana z aplikacji."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařízení se přidávají na serveru a objevují se i v jeho panelu VPN — je to stejný seznam, spravovaný z aplikace."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seadmed lisatakse serverisse ja need ilmuvad ka selle VPN-paneelile — see on sama loend, mida hallatakse rakendusest."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az eszközök a szerveren adódnak hozzá, és a VPN-paneljén is megjelennek — ez ugyanaz a lista, az alkalmazásból kezelve."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συσκευές προστίθενται στον διακομιστή και εμφανίζονται και στο πάνελ VPN του — είναι η ίδια λίστα, διαχειριζόμενη από την εφαρμογή."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zariadenia sa pridávajú na serveri a zobrazujú sa aj v jeho VPN paneli — je to ten istý zoznam, spravovaný z aplikácie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dispositivos são adicionados no servidor e também aparecem no seu painel VPN — é a mesma lista, gerida a partir da app."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ierīces tiek pievienotas serverī un parādās arī tā VPN panelī — tas ir tas pats saraksts, ko pārvalda no lietotnes."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuirtear gléasanna leis ar an bhfreastalaí agus taispeántar iad ina phainéal VPN freisin — is é an liosta céanna é, á bhainistiú ón aip."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-apparati jiżdiedu fuq is-server u jidhru fil-panel VPN tiegħu ukoll — din hija l-istess lista, ġestita mill-app."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įrenginiai pridedami serveryje ir taip pat rodomi jo VPN skydelyje — tai tas pats sąrašas, valdomas iš programėlės."
          }
        }
      }
    },
    "Devices are told apart by the server key. A server moved to another device with Export carries that key, so both show as the same entry — adopt the server on the other device instead to have it listed separately." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geräte werden am Serverschlüssel unterschieden. Ein per Export auf ein anderes Gerät übertragener Server nimmt diesen Schlüssel mit, deshalb erscheinen beide als derselbe Eintrag — übernehmen Sie den Server auf dem anderen Gerät stattdessen, damit er separat aufgeführt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dispositivos se distinguen por la clave del servidor. Un servidor llevado a otro dispositivo con Exportar se lleva esa clave, así que ambos aparecen como la misma entrada; adopta el servidor en el otro dispositivo para que figure por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appareils sont distingués par la clé du serveur. Un serveur transféré vers un autre appareil avec Exporter emporte cette clé, si bien que les deux apparaissent comme une seule entrée — adoptez plutôt le serveur sur l'autre appareil pour qu'il soit listé séparément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dispositivi si distinguono dalla chiave del server. Un server spostato su un altro dispositivo con Esporta porta con sé quella chiave, quindi entrambi compaiono come la stessa voce: adotta invece il server sull'altro dispositivo per vederlo elencato separatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末はサーバー鍵で区別されます。「書き出す」で別の端末へ移したサーバーはその鍵も一緒に持っていくため、両方が同じ 1 件として表示されます。別々に並べたい場合は、もう一方の端末でサーバーを引き継いでください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройства различаются по ключу сервера. Сервер, перенесённый на другое устройство через экспорт, несёт этот ключ с собой, поэтому оба показываются одной записью — чтобы устройство числилось отдельно, подключите сервер на нём как существующий, а не импортом."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пристрої розрізняються за ключем сервера. Сервер, перенесений на інший пристрій через експорт, несе цей ключ із собою, тому обидва показуються одним записом — щоб пристрій був у списку окремо, підключіть сервер на ньому як наявний, а не імпортом."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备是按服务器密钥来区分的。通过“导出”迁移到另一台设备的服务器会带着该密钥，因此两者显示为同一条记录——若想分别列出，请在另一台设备上以“接管已有服务器”的方式添加，而不是导入。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitteet erotetaan toisistaan palvelimen avaimella. Toiselle laitteelle Vie-toiminnolla siirretty palvelin kantaa saman avaimen, joten molemmat näkyvät samana merkintänä — ota palvelin käyttöön toisella laitteella sen sijaan, jotta se listataan erikseen."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройствата се разграничават по ключа на сървъра. Сървър, преместен на друго устройство чрез Експортиране, носи този ключ, затова и двете се показват като един и същ запис — вместо това приемете сървъра на другото устройство, за да се показва отделно."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparaten worden onderscheiden aan de hand van de serversleutel. Een server die met Exporteren naar een ander apparaat is verplaatst, neemt die sleutel mee, dus beide worden als hetzelfde item getoond — neem de server in plaats daarvan op het andere apparaat over om hem apart te laten vermelden."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enheder kendes fra hinanden på servernøglen. En server, der er flyttet til en anden enhed med Eksportér, tager nøglen med, så begge vises som samme post — overtag i stedet serveren på den anden enhed for at få den vist separat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enheter särskiljs med servernyckeln. En server som flyttats till en annan enhet med Exportera tar med sig den nyckeln, så båda visas som samma post — ta i stället över servern på den andra enheten för att få den listad separat."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uređaji se razlikuju po ključu poslužitelja. Poslužitelj premješten na drugi uređaj pomoću Izvoza nosi taj ključ, pa se oba prikazuju kao isti unos — umjesto toga posvojite poslužitelj na drugom uređaju kako bi bio prikazan zasebno."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naprave se ločijo po ključu strežnika. Strežnik, premaknjen na drugo napravo z izvozom, nosi ta ključ, zato se oba prikažeta kot isti vnos — namesto tega posvojite strežnik na drugi napravi, da bo naveden ločeno."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispozitivele sunt deosebite prin cheia serverului. Un server mutat pe alt dispozitiv prin Export poartă acea cheie, astfel încât ambele apar ca aceeași intrare — preia serverul pe celălalt dispozitiv în schimb pentru a-l avea listat separat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urządzenia rozróżnia klucz serwera. Serwer przeniesiony na inne urządzenie za pomocą Eksportu niesie ten sam klucz, więc oba pokazują się jako ten sam wpis — zamiast tego zaadoptuj serwer na innym urządzeniu, aby był wymieniony osobno."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařízení se rozlišují podle klíče serveru. Server přesunutý na jiné zařízení pomocí Exportu nese stejný klíč, takže se obě zobrazují jako stejná položka — místo toho serverem na jiném zařízení adoptujte, aby byl uveden zvlášť."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seadmeid eristatakse serveri võtme järgi. Eksportimisega teise seadmesse viidud server kannab sama võtit, seega näidatakse mõlemat sama kirjena — kanna server selle asemel teises seadmes üle, et see eraldi loendisse saada."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az eszközöket a szerverkulcs különbözteti meg. Az Export segítségével másik eszközre áthelyezett szerver magával viszi azt a kulcsot, így mindkettő ugyanazon bejegyzésként jelenik meg — helyette örökítsd át a szervert a másik eszközön, hogy külön szerepeljen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συσκευές διακρίνονται από το κλειδί του διακομιστή. Ένας διακομιστής που μεταφέρθηκε σε άλλη συσκευή με Εξαγωγή φέρει αυτό το κλειδί, οπότε και οι δύο εμφανίζονται ως η ίδια εγγραφή — υιοθετήστε τον διακομιστή στην άλλη συσκευή για να καταχωρηθεί ξεχωριστά."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zariadenia sa rozlišujú podľa kľúča servera. Server presunutý na iné zariadenie pomocou Export si tento kľúč nesie so sebou, takže obe sa zobrazia ako ten istý záznam — namiesto toho server na druhom zariadení prevezmite, aby sa zobrazoval samostatne."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dispositivos distinguem-se pela chave do servidor. Um servidor movido para outro dispositivo com Exportar transporta essa chave, pelo que ambos aparecem como a mesma entrada — em vez disso, adote o servidor no outro dispositivo para que apareça listado separadamente."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ierīces atšķir pēc servera atslēgas. Serveris, kas ar Eksportu pārvietots uz citu ierīci, saglabā šo atslēgu, tāpēc abas rāda kā vienu ierakstu — lai tas tiktu uzskaitīts atsevišķi, tā vietā pievienojiet serveri otrā ierīcē no jauna."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aithnítear gléasanna óna chéile de réir eochair an fhreastalaí. Iompraíonn freastalaí a bogadh chuig gléas eile le hEaspórtáil an eochair chéanna, agus mar sin taispeántar an dá cheann mar an iontráil chéanna — glac leis an bhfreastalaí ar an ngléas eile ina áit sin chun go liostálfar ar leithligh é."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-apparati jingħarfu minn xulxin biċ-ċavetta tas-server. Server li jiġi mċaqlaq lejn apparat ieħor b'Esporta jġorr dik iċ-ċavetta, u għalhekk it-tnejn jidhru bħala l-istess entrata — addotta s-server fuq l-apparat l-ieħor minflok biex jidher separatament."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įrenginiai atskiriami pagal serverio raktą. Serveris, perkeltas į kitą įrenginį naudojant „Eksportuoti“, perkelia ir tą raktą, todėl abu rodomi kaip vienas įrašas — norėdami, kad jie būtų rodomi atskirai, kitame įrenginyje verčiau prijunkite serverį iš naujo."
          }
        }
      }
    },
