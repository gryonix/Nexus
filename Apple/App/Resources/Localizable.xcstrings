    "Then Face ID, Touch ID or the device passcode is asked for before anything is removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danach wird Face ID, Touch ID oder der Gerätecode abgefragt, bevor etwas entfernt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después se pedirá Face ID, Touch ID o el código del dispositivo antes de eliminar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensuite, Face ID, Touch ID ou le code de l’appareil est demandé avant toute suppression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poi vengono richiesti Face ID, Touch ID o il codice del dispositivo prima di rimuovere qualcosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その後、削除の前に Face ID、Touch ID またはデバイスのパスコードを求めます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После этого перед удалением спросят Face ID, Touch ID или код-пароль устройства."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після цього перед видаленням запитають Face ID, Touch ID або код-пароль пристрою."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随后在移除任何内容之前会要求 Face ID、Touch ID 或设备密码。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitten kysytään Face ID:tä, Touch ID:tä tai laitteen koodia ennen kuin mitään poistetaan."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После се иска Face ID, Touch ID или паролата на устройството, преди нещо да бъде премахнато."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoi se cere Face ID, Touch ID sau codul de acces al dispozitivului înainte ca ceva să fie eliminat."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatim se traži Face ID, Touch ID ili lozinka uređaja prije nego što se išta ukloni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derefter bedes du om Face ID, Touch ID eller enhedens adgangskode, før noget fjernes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervolgens wordt om Face ID, Touch ID of de toegangscode van het apparaat gevraagd voordat iets wordt verwijderd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedan efterfrågas Face ID, Touch ID eller enhetens lösenkod innan något tas bort."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nato se pred odstranitvijo česar koli zahteva Face ID, Touch ID ali koda naprave."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezután Face ID-t, Touch ID-t vagy az eszköz jelkódját kéri, mielőtt bármi is eltávolításra kerülne."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pak se před odebráním čehokoli vyžádá Face ID, Touch ID nebo kód zařízení."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanim cokolwiek zostanie usunięte, wymagane jest Face ID, Touch ID albo kod urządzenia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois é pedido Face ID, Touch ID ou o código do dispositivo antes de algo ser removido."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έπειτα ζητείται Face ID, Touch ID ή ο κωδικός πρόσβασης της συσκευής πριν αφαιρεθεί οτιδήποτε."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seejärel küsitakse Face ID, Touch ID või seadme koodi, enne kui midagi eemaldatakse."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potom sa pred odstránením čohokoľvek vyžiada Face ID, Touch ID alebo kód zariadenia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tad tiek pieprasīts Face ID, Touch ID vai ierīces piekļuves kods, pirms kaut kas tiek noņemts."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansin iarrtar Face ID, Touch ID nó cód pas an ghléis sula mbaintear aon rud."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prieš ką nors pašalinant, prašoma Face ID, Touch ID arba įrenginio slaptažodžio."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbagħad jintalab Face ID, Touch ID jew il-passcode tal-apparat qabel ma jitneħħa xi ħaġa."
          }
        }
      }
    },
    "Then it watches it" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann behält es ihn im Blick"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luego lo vigila"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puis il le surveille"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poi lo tiene d’occhio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのあと見守ります"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потом следит за ним"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потім стежить за ним"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "然后持续照看"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitten se vahtii sitä"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После го наблюдава"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoi îl urmărește"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatim ga nadzire"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derefter overvåger den den"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervolgens houdt het het in de gaten"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedan bevakar den den"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nato ga spremlja"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezután figyeli"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pak to sleduje"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potem to obserwuje"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
