          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virker overalt fra: det server filteret over DNS-over-HTTPS gennem det samme HTTPS-navn som dets panel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
