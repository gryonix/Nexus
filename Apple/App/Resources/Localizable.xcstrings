    "Writes and reads a 256 MB file as root, then deletes it." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записва и чете файл 256 MB като root, след това го изтрива."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapíše a přečte soubor 256 MB jako root, pak jej smaže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver og læser en 256 MB fil som root, derefter sletter den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt und liest eine 256-MB-Datei als root und löscht sie danach."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράφει και διαβάζει ένα αρχείο 256 MB ως root, στη συνέχεια το διαγράφει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe y lee un archivo de 256 MB como root, luego lo elimina."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjutab ja loeb 256 MB faili juurena, seejärel kustutab selle."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoittaa ja lukee 256 MB tiedoston juurena, sitten poistaa sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrit et lit un fichier de 256 MB en tant que root, puis le supprime."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scríobhann agus léann sé comhad 256 MB mar root, ansin briseann sé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piše i čita datoteku od 256 MB kao root, a zatim je briše."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "256 MB fájlt ír és olvas rootként, majd törli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrive e legge un file di 256 MB come root, quindi lo elimina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "256 MBファイルをrootとして書き込みと読み込みを行い、削除します。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rašo ir skaitą 256 MB failą kaip root, tada jį ištryna."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raksta un lasa 256 MB failu kā root, pēc tam to izdzēš."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikteb u jaqra fajl ta' 256 MB bħala root, imbagħad jimmuzieh."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijft en leest een bestand van 256 MB als root, vervolgens verwijdert het."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje i czyta plik 256 MB jako root, a następnie go usuwa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreve e lê um arquivo de 256 MB como root, depois o exclui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrie și cites un fișier de 256 MB ca root, apoi o șterge."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает и читает файл 256 МБ от имени root, затем удаляет его."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje a číta súbor 256 MB ako root, potom ho vymaže."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piše in bere datoteko 256 MB kot root, nato jo izbriše."
          }
        },
