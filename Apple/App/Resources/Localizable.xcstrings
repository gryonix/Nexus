        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’archive est écrite sans chiffrement. Chiffrer une grande bibliothèque coûte des heures de processeur sur un petit serveur, d’où sa désactivation par défaut ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’archivio viene scritto senza cifratura. Cifrare una libreria grande costa ore di processore su un server piccolo: per questo qui è disattivato per impostazione predefinita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブは暗号化せずに書き出されます。大きなライブラリの暗号化は小さなサーバーでは何時間ものCPU時間を要するため、ここでは既定でオフです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архив пишется без шифрования. Зашифровать большую библиотеку — это часы процессорного времени на небольшом сервере, поэтому здесь по умолчанию выключено."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архів пишеться без шифрування. Зашифрувати велику бібліотеку — це години процесорного часу на невеликому сервері, тому тут типово вимкнено."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "归档以未加密方式写入。在小型服务器上加密大型库需要数小时的处理器时间，因此这里默认关闭。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkisto kirjoitetaan salaamattomana. Suuren kirjaston salaaminen maksaa tunteja prosessoriaikaa pienellä palvelimella, minkä vuoksi se on täällä oletuksena pois päältä."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архивът се записва некриптиран. Криптирането на голяма библиотека струва часове процесорно време на малък сървър, затова тук по подразбиране е изключено."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhiva este scrisă necriptată. Criptarea unei biblioteci mari costă ore de timp de procesor pe un server mic, de aceea este dezactivată implicit aici."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het archief wordt onversleuteld geschreven. Een grote bibliotheek versleutelen kost uren processortijd op een kleine server, daarom staat het hier standaard uit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkivet skrives ukrypteret. At kryptere et stort bibliotek koster timers processortid på en lille server, hvorfor det som standard er slået fra her."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkivet skrivs okrypterat. Att kryptera ett stort bibliotek kostar timmar av processortid på en liten server, vilket är varför det är avstängt här som standard."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhiva se zapisuje nešifrirana. Šifriranje velike zbirke stoji satima procesorskog vremena na malom poslužitelju, zbog čega je ovdje po zadanome isključeno."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhiv se zapiše nešifriran. Šifriranje velike knjižnice stane ure procesorskega časa na majhnem strežniku, zato je tukaj privzeto izklopljeno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az archívum titkosítatlanul íródik. Egy nagy könyvtár titkosítása órákig tartó processzoridőbe kerül egy kis szerveren, ezért van alapértelmezetten kikapcsolva itt."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiv se zapisuje nešifrovaně. Šifrování velké knihovny stojí hodiny procesorového času na malém serveru, proto je zde ve výchozím stavu vypnuté."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhiiv kirjutatakse krüptimata. Suure kogu krüptimine maksab väikeses serveris protsessoriaega tunde, mistõttu on see siin vaikimisi väljas."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiwum jest zapisywane bez szyfrowania. Zaszyfrowanie dużej biblioteki kosztuje godziny czasu procesora na małym serwerze, dlatego domyślnie jest tu wyłączone."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo é escrito sem encriptação. Encriptar uma biblioteca grande custa horas de processador num servidor pequeno, por isso está desativado aqui por predefinição."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αρχείο γράφεται μη κρυπτογραφημένο. Η κρυπτογράφηση μιας μεγάλης βιβλιοθήκης κοστίζει ώρες χρόνου επεξεργαστή σε έναν μικρό διακομιστή, γι’ αυτό είναι απενεργοποιημένη εδώ από προεπιλογή."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archív sa zapisuje nešifrovaný. Šifrovanie veľkej knižnice stojí hodiny procesorového času na malom serveri, preto je tu predvolene vypnuté."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scríobhtar an chartlann gan chriptiú. Cosnaíonn criptiú leabharlainne móire uaireanta d'am próiseálaí ar fhreastalaí beag, agus sin an fáth a bhfuil sé as anseo de réir réamhshocraithe."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhīvs tiek rakstīts nešifrēts. Lielas bibliotēkas šifrēšana mazā serverī prasa stundām ilgu procesora laiku, tāpēc pēc noklusējuma tas šeit ir izslēgts."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archyvas įrašomas nešifruotas. Didelės bibliotekos šifravimas mažame serveryje kainuoja valandas procesoriaus laiko, todėl čia numatytai jis išjungtas."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-arkivju jinkiteb mhux ikkriptat. Li tikkripta librerija kbira tiswa sigħat ta' żmien tal-proċessur fuq server żgħir, u għalhekk hawn huwa mitfi b'mod default."
          }
        }
      }
    },
