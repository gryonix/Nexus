    "Devices keep their names, but every VLESS device needs its configuration again. This device gets it on its own." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройствата запазват имената си, но всяко устройство VLESS трябва да получи конфигурацията отново. Това устройство я получава само."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařízení si ponechají názvy, ale každé zařízení VLESS potřebuje konfiguraci znovu. Toto zařízení ji získá samo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhederne beholder deres navne, men hver VLESS-enhed skal have sin konfiguration igen. Denne enhed henter den selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geräte behalten ihre Namen, aber jedes VLESS-Gerät braucht seine Konfiguration neu. Dieses Gerät holt sie selbst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συσκευές κρατούν τα ονόματά τους, αλλά κάθε συσκευή VLESS χρειάζεται ξανά τη ρύθμισή της. Αυτή η συσκευή την παίρνει μόνη της."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devices keep their names, but every VLESS device needs its configuration again. This device gets it on its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dispositivos conservan su nombre, pero cada dispositivo VLESS necesita de nuevo su configuración. Este dispositivo la obtiene solo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seadmed jäävad oma nimede juurde, kuid iga VLESS-seade vajab seadistust uuesti. See seade saab selle ise."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitteet säilyttävät nimensä, mutta jokainen VLESS-laite tarvitsee määrityksensä uudelleen. Tämä laite hakee sen itse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appareils gardent leur nom, mais chaque appareil VLESS doit récupérer sa configuration. Cet appareil la récupère seul."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coinníonn na gléasanna a n-ainmneacha, ach teastaíonn a gcumraíocht arís ó gach gléas VLESS. Faigheann an gléas seo í leis féin."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uređaji zadržavaju nazive, ali svaki VLESS uređaj treba konfiguraciju iznova. Ovaj uređaj je dobiva sam."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az eszközök megtartják a nevüket, de minden VLESS-eszköznek újra kell a konfiguráció. Ez az eszköz magától megkapja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dispositivi mantengono il nome, ma ogni dispositivo VLESS deve riavere la configurazione. Questo dispositivo la riceve da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスの名前はそのままですが、VLESS の各デバイスで構成を取り直す必要があります。このデバイスは自動で取得します。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įrenginiai išlaiko pavadinimus, bet kiekvienam VLESS įrenginiui konfigūracija reikalinga iš naujo. Šis įrenginys ją gauna pats."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ierīces saglabā nosaukumus, bet katrai VLESS ierīcei konfigurācija vajadzīga no jauna. Šī ierīce to saņem pati."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-apparati jżommu isimhom, iżda kull apparat VLESS jeħtieġ il-konfigurazzjoni mill-ġdid. Dan l-apparat jiksibha waħdu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparaten houden hun naam, maar elk VLESS-apparaat heeft zijn configuratie opnieuw nodig. Dit apparaat haalt die zelf op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urządzenia zachowają nazwy, ale każde urządzenie VLESS potrzebuje konfiguracji od nowa. To urządzenie pobierze ją samo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dispositivos mantêm o nome, mas cada dispositivo VLESS precisa de novo da configuração. Este dispositivo obtém-na sozinho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispozitivele își păstrează numele, dar fiecare dispozitiv VLESS are nevoie din nou de configurație. Acest dispozitiv o primește singur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройства сохранят имена, но каждому устройству VLESS понадобится конфигурация заново. Это устройство получит её само."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zariadenia si ponechajú názvy, ale každé zariadenie VLESS potrebuje konfiguráciu znova. Toto zariadenie ju získa samo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naprave obdržijo imena, a vsaka naprava VLESS potrebuje konfiguracijo znova. Ta naprava jo dobi sama."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enheterna behåller sina namn, men varje VLESS-enhet behöver sin konfiguration igen. Den här enheten hämtar den själv."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пристрої збережуть назви, але кожному пристрою VLESS знадобиться конфігурація заново. Цей пристрій отримає її сам."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备名称保持不变，但每个 VLESS 设备都需要重新获取配置。本设备会自动获取。"
          }
        }
      }
    },
