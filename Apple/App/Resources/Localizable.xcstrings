        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atjaunošana aizstāj pakalpojuma pašreizējos datus. Tā konteineri tiek apturēti, kamēr tas notiek."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuireann athchóiriú in ionad shonraí reatha na seirbhíse. Téann a coimeádáin síos fad is atá sé ag rith."
