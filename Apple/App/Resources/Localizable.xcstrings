    "Moving keeps every device's configuration: the same address, the same keys." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преместването запазва конфигурацията на всяко устройство: същия адрес, същите ключове."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přesun zachová konfiguraci každého zařízení: stejnou adresu, stejné klíče."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytningen bevarer hver enheds konfiguration: samme adresse, samme nøgler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Verschieben behält die Konfiguration jedes Geräts: dieselbe Adresse, dieselben Schlüssel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
