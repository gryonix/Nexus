        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuashonraíonn sé pacáistí an fhreastalaí féin. Leanann na seirbhísí ar aghaidh; d'fhéadfadh cúpla ceann atosú."
          }
        },
        "hr" : {
          "stringUnit" : {
