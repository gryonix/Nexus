            "value" : "Aktualisiert die Pakete des Servers selbst. Die Dienste laufen weiter, einige starten eventuell neu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενημερώνει τα πακέτα του ίδιου του διακομιστή. Οι υπηρεσίες συνεχίζουν να τρέχουν· κάποιες μπορεί να επανεκκινηθούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza los paquetes del propio servidor. Los servicios siguen funcionando; algunos pueden reiniciarse."
