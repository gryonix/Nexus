    "Stored in the Keychain on this device only, and never sent anywhere except to this server when you connect." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur im Schlüsselbund dieses Geräts gespeichert und ausschließlich beim Verbinden an diesen Server gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda solo en el Llavero de este dispositivo y solo se envía a este servidor al conectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservé uniquement dans le trousseau de cet appareil, et envoyé à ce serveur seulement lors de la connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservato solo nel portachiavi di questo dispositivo e inviato solo a questo server al momento della connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末のキーチェーンにのみ保存され、接続時にこのサーバーへ送る以外にどこにも送信されません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранится только в связке ключей этого устройства и никуда не уходит, кроме как на этот сервер при подключении."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігається лише у зв'язці ключів цього пристрою і нікуди не надсилається, крім цього сервера під час підключення."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅保存在本设备的钥匙串中，除连接时发送给该服务器外不会发往任何地方。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennettu vain tämän laitteen avainnipussa, eikä koskaan lähetetä minnekään muualle kuin tälle palvelimelle yhdistäessäsi."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съхранено в Keychain само на това устройство и никога не се изпраща никъде освен до този сървър при свързване."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocat doar în Keychain pe acest dispozitiv și nu este trimis niciodată nicăieri, cu excepția acestui server atunci când te conectezi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen opgeslagen in de sleutelhanger van dit apparaat, en nergens naartoe gestuurd behalve naar deze server wanneer je verbinding maakt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun opbevaret i nøgleringen på denne enhed og aldrig sendt nogen steder undtagen til denne server, når du forbinder."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparas endast i nyckelringen på den här enheten och skickas aldrig någonstans annat än till den här servern när du ansluter."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohranjeno samo u Keychainu na ovom uređaju i nikad poslano nikamo osim ovom poslužitelju prilikom povezivanja."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shranjeno le v Keychainu te naprave in nikoli poslano nikamor razen temu strežniku ob povezavi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak ezen az eszközön, a Keychainben van tárolva, és soha nem küldi el sehova, kivéve ehhez a szerverhez, amikor csatlakozik."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloženo pouze v Klíčence tohoto zařízení a nikdy nikam neodesláno kromě tohoto serveru při připojení."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvestatud ainult selle seadme võtmehoidlasse ega saadeta kuhugi mujale peale selle serveri, kui ühendud."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύεται στο Keychain μόνο σε αυτή τη συσκευή, και δεν αποστέλλεται πουθενά αλλού παρά μόνο σε αυτόν τον διακομιστή όταν συνδέεστε."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechowywane w Pęku kluczy tylko na tym urządzeniu i nigdzie nie wysyłane, poza tym serwerem podczas łączenia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado apenas no Keychain deste dispositivo, e nunca enviado para lado nenhum exceto para este servidor quando se liga."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uchováva sa iba v Keychaine tohto zariadenia a nikdy sa nikam neposiela okrem tohto servera pri pripojení."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stóráilte sa Slabhra Eochracha ar an ngléas seo amháin, agus ní sheoltar áit ar bith é riamh ach chuig an bhfreastalaí seo nuair a nascann tú."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glabājas Atslēgu saišķī tikai šajā ierīcē un nekad netiek nosūtīts nekur citur, izņemot šo serveri, kad izveidojat savienojumu."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saugoma tik šio įrenginio raktinėje (Keychain) ir niekada niekur nesiunčiama, išskyrus šį serverį jungiantis."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maħżun fil-Keychain fuq dan l-apparat biss, u qatt ma jintbagħat imkien ħlief lil dan is-server meta tikkonnettja."
          }
        }
      }
    },
