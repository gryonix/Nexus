    "Everything on the drive is erased. Type %@ to confirm. The name is up to 11 lowercase letters, digits or dashes." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всичко на устройството се изтрива. Въведете %@ за потвърждение. Името е до 11 малки латински букви, цифри или тирета."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše na disku bude smazáno. Pro potvrzení napište %@. Název má nejvýše 11 malých písmen, číslic nebo pomlček."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt på drevet slettes. Skriv %@ for at bekræfte. Navnet er højst 11 små bogstaver, cifre eller bindestreger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles auf dem Laufwerk wird gelöscht. Gib zur Bestätigung %@ ein. Der Name hat höchstens 11 Kleinbuchstaben, Ziffern oder Bindestriche."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα στη μονάδα διαγράφονται. Πληκτρολογήστε %@ για επιβεβαίωση. Το όνομα έχει έως 11 πεζά λατινικά γράμματα, ψηφία ή παύλες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borra todo lo que hay en la unidad. Escribe %@ para confirmar. El nombre tiene hasta 11 letras minúsculas, cifras o guiones."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõik draivil kustutatakse. Kinnitamiseks sisesta %@. Nimes võib olla kuni 11 väiketähte, numbrit või sidekriipsu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki aseman tiedot poistetaan. Vahvista kirjoittamalla %@. Nimessä on enintään 11 pientä kirjainta, numeroa tai yhdysmerkkiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le contenu du disque est effacé. Saisissez %@ pour confirmer. Le nom compte au plus 11 lettres minuscules, chiffres ou tirets."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scriostar gach rud ar an tiomántán. Clóscríobh %@ chun deimhniú. Tá suas le 11 litir bheaga, digit nó fleiscín san ainm."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve na pogonu se briše. Za potvrdu upišite %@. Naziv ima najviše 11 malih slova, znamenki ili crtica."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A meghajtón minden törlődik. A megerősítéshez írd be: %@. A név legfeljebb 11 kisbetű, számjegy vagy kötőjel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto il contenuto dell'unità viene cancellato. Digita %@ per confermare. Il nome ha al massimo 11 lettere minuscole, cifre o trattini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドライブ上のすべてが消去されます。確認のため %@ と入力してください。名前は小文字の英字・数字・ハイフンで 11 文字までです。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viskas diske ištrinama. Patvirtinkite įvesdami %@. Pavadinimą sudaro iki 11 mažųjų raidžių, skaitmenų ar brūkšnelių."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viss diskā tiek izdzēsts. Lai apstiprinātu, ierakstiet %@. Nosaukumā ir līdz 11 mazajiem burtiem, cipariem vai defisēm."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kollox fuq id-drajv jitħassar. Ikteb %@ biex tikkonferma. L-isem għandu sa 11-il ittra żgħira, numru jew sing."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles op de schijf wordt gewist. Typ %@ om te bevestigen. De naam heeft maximaal 11 kleine letters, cijfers of streepjes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko na dysku zostanie usunięte. Aby potwierdzić, wpisz %@. Nazwa ma do 11 małych liter, cyfr lub łączników."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo na unidade é apagado. Escreva %@ para confirmar. O nome tem até 11 letras minúsculas, algarismos ou hífenes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totul de pe unitate se șterge. Tastați %@ pentru confirmare. Numele are cel mult 11 litere mici, cifre sau cratime."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё на накопителе будет стёрто. Для подтверждения введите %@. Имя — до 11 строчных латинских букв, цифр или дефисов."
          }
        },
