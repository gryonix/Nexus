        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladarba l-iskripts ikunu mexxew — b'liema mod ikun — is-server jiġi mmaniġġjat minn hawn."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai tik scenarijai baigia darbą — kad ir kokiu būdu — serveris toliau valdomas iš čia."
