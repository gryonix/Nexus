    "Proxies are shared by every server that uses them, so they are kept in the app's own settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxys werden von jedem Server geteilt, der sie nutzt, deshalb liegen sie in den Einstellungen der App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los proxies los comparten todos los servidores que los usan, por eso viven en los ajustes de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les proxys sont partagés par tous les serveurs qui les utilisent, c'est pourquoi ils vivent dans les réglages de l'app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I proxy sono condivisi da ogni server che li usa, perciò vivono nelle impostazioni dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロキシはそれを使うすべてのサーバーで共有されるため、アプリ側の設定に置かれています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокси общие для всех серверов, которые ими пользуются, поэтому они живут в настройках приложения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проксі спільні для всіх серверів, що ними користуються, тож вони живуть у налаштуваннях застосунку."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理由所有使用它的服务器共享，因此保存在应用自己的设置里。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välityspalvelimet ovat jaettuja kaikkien niitä käyttävien palvelimien kesken, joten ne säilytetään sovelluksen omissa asetuksissa."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокситата се споделят от всеки сървър, който ги използва, затова се пазят в собствените настройки на приложението."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxyje dijeli svaki poslužitelj koji ih koristi, pa se čuvaju u vlastitim postavkama aplikacije."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxyje si delijo vsi strežniki, ki jih uporabljajo, zato so shranjeni v lastnih nastavitvah aplikacije."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxyer deles af alle servere, der bruger dem, så de opbevares i appens egne indstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxy's worden gedeeld door elke server die ze gebruikt, dus ze worden bewaard in de eigen instellingen van de app."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxyservrar delas av alla servrar som använder dem, så de sparas i appens egna inställningar."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roinneann gach freastalaí a úsáideann iad na seachfhreastalaithe, mar sin coinnítear iad i socruithe féin na haipe."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-proxies huma kondiviżi minn kull server li jużahom, għalhekk jinżammu fis-settings stess tal-app."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os proxies são partilhados por todos os servidores que os usam, por isso são guardados nas próprias definições da app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxy są współdzielone przez każdy serwer, który z nich korzysta, więc są przechowywane we własnych ustawieniach aplikacji."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxy jsou sdílena všemi servery, které je používají, takže jsou uložena ve vlastním nastavení aplikace."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxy sú zdieľané všetkými servermi, ktoré ich používajú, takže sú uložené vo vlastnom nastavení aplikácie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι διαμεσολαβητές μοιράζονται από κάθε διακομιστή που τους χρησιμοποιεί, οπότε φυλάσσονται στις δικές της ρυθμίσεις της εφαρμογής."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A proxykat minden szerver megosztja, amely használja őket, ezért az alkalmazás saját beállításaiban tárolódnak."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxy-urile sunt partajate de fiecare server care le folosește, deci sunt păstrate în setările proprii ale aplicației."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proksisid jagavad kõik serverid, mis neid kasutavad, seega hoitakse neid rakenduse enda seadetes."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starpniekserverus koplieto visi serveri, kas tos izmanto, tāpēc tie tiek glabāti pašas lietotnes iestatījumos."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarpinius serverius bendrina visi juos naudojantys serveriai, todėl jie saugomi pačios programos nustatymuose."
          }
        }
      }
    },
