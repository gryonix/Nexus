    "Choosing a machine for a service only records where it runs. Install or remove it to actually move it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Auswahl einer Maschine hält nur fest, wo ein Dienst läuft. Zum tatsächlichen Verschieben installieren oder entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegir una máquina solo registra dónde se ejecuta el servicio. Para moverlo de verdad, instálalo o elimínalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisir une machine enregistre seulement où le service s’exécute. Pour le déplacer réellement, installez-le ou supprimez-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegliere una macchina registra soltanto dove gira il servizio. Per spostarlo davvero, installalo o rimuovilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マシンの選択は実行場所を記録するだけです。実際に移すにはインストールまたは削除してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбор машины только записывает, где сервис работает. Чтобы действительно перенести, установите или снесите его."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибір машини лише записує, де сервіс працює. Щоб дійсно перенести, встановіть або знесіть його."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为服务选择机器只是记录它在哪里运行。若要真正迁移，请安装或移除它。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneen valitseminen palvelulle vain tallentaa, missä se toimii. Asenna tai poista se siirtääksesi sen oikeasti."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изборът на машина за услуга само записва къде работи. Инсталирайте или премахнете, за да я преместите реално."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odabir stroja za uslugu samo bilježi gdje radi. Instalirajte ili uklonite da je stvarno premjestite."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbira stroja za storitev samo zabeleži, kje teče. Namestite ali odstranite, da jo dejansko premaknete."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het kiezen van een machine voor een dienst legt alleen vast waar hij draait. Installeer of verwijder hem om hem daadwerkelijk te verplaatsen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At vælge en maskine til en tjeneste noterer kun, hvor den kører. Installér eller fjern den for rent faktisk at flytte den."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att välja en maskin för en tjänst noterar bara var den körs. Installera eller ta bort den för att faktiskt flytta den."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolher uma máquina para um serviço apenas regista onde este corre. Instale-o ou remova-o para o mover de facto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegerea unei mașini pentru un serviciu doar înregistrează unde rulează. Instalează-l sau elimină-l pentru a-l muta efectiv."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybór maszyny dla usługi tylko zapisuje, gdzie działa. Zainstaluj lub usuń ją, aby faktycznie ją przenieść."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výběr stroje pro službu pouze zaznamená, kde běží. Nainstalujte nebo odeberte ji, abyste ji skutečně přesunuli."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masina valimine teenuse jaoks salvestab vaid selle, kus see töötab. Selle päriselt liigutamiseks paigalda või eemalda see."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy gép kiválasztása egy szolgáltatáshoz csak azt rögzíti, hol fut. Telepítsd vagy távolítsd el, hogy ténylegesen áthelyezd."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιλογή μηχανής για μια υπηρεσία απλώς καταγράφει πού εκτελείται. Εγκαταστήστε ή αφαιρέστε την για να τη μετακινήσετε πραγματικά."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výber stroja pre službu iba zaznamená, kde beží. Ak ju chcete skutočne presunúť, nainštalujte ju alebo odstráňte."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iekārtas izvēle pakalpojumam tikai fiksē, kur tas darbojas. Lai to tiešām pārvietotu, instalējiet vai noņemiet to."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní dhéanann roghnú meaisín do sheirbhís ach taifead a dhéanamh ar cén áit a ritheann sí. Suiteáil nó bain í chun í a bhogadh i ndáiríre."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-għażla ta' magna għal servizz sempliċement tirreġistra fejn jaħdem. Installah jew neħħih biex verament tiċċaqlaqha."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įrenginio pasirinkimas paslaugai tik įrašo, kur ji veikia. Kad ją iš tikrųjų perkeltumėte, ją įdiekite arba pašalinkite."
          }
        }
      }
    },
