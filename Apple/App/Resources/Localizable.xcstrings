        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un disco para ver su número de serie, formatearlo o hacer parpadear su luz."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puuduta ketast, et näha seerianumbrit, see vormindada või tuld vilgutada."
