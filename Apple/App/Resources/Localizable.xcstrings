        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma jistgħux jinġiebu lura. Id-dejta li qed jużaw is-servizzi issa ma tintmessx."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze zijn daarna niet terug te halen. De gegevens die de diensten nu gebruiken, blijven onaangeroerd."
