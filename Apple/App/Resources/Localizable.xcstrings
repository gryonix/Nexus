            "value" : "表示されるのは今だけです。サーバーは再度渡しません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показан только сейчас — сервер его больше не отдаёт."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показано лише зараз — сервер його більше не віддає."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅此一次显示——服务器不会再次给出。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se näytetään vain nyt — palvelin ei anna sitä takaisin."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показва се само сега — сървърът не го връща обратно."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wordt alleen nu getoond — de server geeft het niet opnieuw af."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det vises kun nu — serveren udleverer det ikke igen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det visas bara nu — servern lämnar inte ut det igen."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje se samo sada — poslužitelj ga više ne vraća."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazano je samo zdaj — strežnik ga ne vrne več."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este afișat doar acum — serverul nu îl mai oferă înapoi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak most jelenik meg — a szerver többé nem adja vissza."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jest pokazywane tylko teraz — serwer go nie zwraca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí se pouze teď — server ho už nevrátí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See kuvatakse ainult nüüd — server ei anna seda tagasi."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí sa iba teraz — server ho už znova nevydá."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É mostrado apenas agora — o servidor não o devolve mais."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζεται μόνο τώρα — ο διακομιστής δεν το επιστρέφει ξανά."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas tiek rādīts tikai tagad — serveris to atpakaļ neizsniedz."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní thaispeántar é ach anois — ní thugann an freastalaí ar ais é."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jintwera issa biss — is-server ma jagħtihx lura."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jis rodomas tik dabar — serveris jo daugiau nebeatiduoda."
          }
        }
      }
    },
