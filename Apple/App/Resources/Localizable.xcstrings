    "The data on the chosen disk is moved onto the others, then the disk leaves the array. The data must fit on the disks that stay." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данните от избрания диск се преместват на останалите, след което дискът излиза от масива. Данните трябва да се поберат на оставащите дискове."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data z vybraného disku se přesunou na ostatní, pak disk opustí pole. Data se musí vejít na disky, které zůstanou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data på den valgte disk flyttes til de andre, og så forlader disken arrayet. Data skal kunne være på de diske, der bliver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Daten der gewählten Festplatte werden auf die anderen verschoben, dann verlässt sie das Array. Die Daten müssen auf die verbleibenden Festplatten passen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δεδομένα του επιλεγμένου δίσκου μεταφέρονται στους άλλους και μετά ο δίσκος φεύγει από τη συστοιχία. Τα δεδομένα πρέπει να χωράνε στους δίσκους που μένουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos del disco elegido se mueven a los demás y luego el disco sale del conjunto. Los datos deben caber en los discos que quedan."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitud ketta andmed teisaldatakse teistele, seejärel lahkub ketas massiivist. Andmed peavad mahtuma allesjäävatele ketastele."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitun levyn tiedot siirretään muille, sitten levy poistuu taulukosta. Tietojen on mahduttava jäljelle jääville levyille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données du disque choisi sont déplacées sur les autres, puis le disque quitte l'ensemble. Les données doivent tenir sur les disques restants."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bogtar na sonraí ar an diosca roghnaithe chuig na cinn eile, ansin fágann an diosca an t-eagar. Caithfidh na sonraí luí ar na dioscaí a fhanann."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podaci s odabranog diska premještaju se na ostale, zatim disk napušta polje. Podaci moraju stati na diskove koji ostaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiválasztott lemez adatai átkerülnek a többire, majd a lemez kilép a tömbből. Az adatoknak el kell férniük a maradó lemezeken."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati del disco scelto vengono spostati sugli altri, poi il disco esce dall'array. I dati devono stare sui dischi che restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだディスクのデータを他のディスクへ移してから、そのディスクをアレイから外します。データは残るディスクに収まる必要があります。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasirinkto disko duomenys perkeliami į kitus, tada diskas palieka masyvą. Duomenys turi tilpti likusiuose diskuose."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvēlētā diska dati tiek pārvietoti uz pārējiem, tad disks atstāj masīvu. Datiem jāietilpst diskos, kas paliek."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Id-data fuq id-diska magħżula tiċċaqlaq fuq l-oħrajn, imbagħad id-diska toħroġ mill-array. Id-data trid toqgħod fuq id-diski li jibqgħu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gegevens op de gekozen schijf worden naar de andere verplaatst, daarna verlaat de schijf de array. De gegevens moeten passen op de schijven die blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane z wybranego dysku są przenoszone na pozostałe, potem dysk opuszcza macierz. Dane muszą się zmieścić na dyskach, które zostają."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados do disco escolhido passam para os outros e depois o disco sai do conjunto. Os dados têm de caber nos discos que ficam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele de pe discul ales se mută pe celelalte, apoi discul iese din matrice. Datele trebuie să încapă pe discurile care rămân."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные с выбранного диска переносятся на остальные, потом диск выходит из массива. Данные должны поместиться на оставшиеся диски."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dáta z vybraného disku sa presunú na ostatné, potom disk opustí pole. Dáta sa musia zmestiť na disky, ktoré zostanú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podatki z izbranega diska se premaknejo na druge, nato disk zapusti polje. Podatki morajo biti prostor na diskih, ki ostanejo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data på den valda disken flyttas till de andra, sedan lämnar disken arrayen. Datan måste få plats på diskarna som blir kvar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дані з вибраного диска переносяться на інші, потім диск виходить із масиву. Дані мають поміститися на решту дисків."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选磁盘上的数据会迁移到其他磁盘，然后该磁盘离开阵列。数据必须能放进剩下的磁盘。"
          }
        }
      }
    },
    "The disk is read for half a minute, so its light flickers. Look for it in the case." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дискът се чете половин минута, за да мига лампичката му. Потърси го в кутията."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk se půl minuty čte, aby blikala jeho kontrolka. Najděte ho ve skříni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disken læses i et halvt minut, så dens lys blinker. Find den i kabinettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Festplatte wird eine halbe Minute gelesen, damit ihr Licht flackert. Such sie im Gehäuse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο δίσκος διαβάζεται για μισό λεπτό ώστε να αναβοσβήνει η λυχνία του. Βρες τον στο κουτί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco se lee durante medio minuto para que parpadee su luz. Búscalo en la caja."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketast loetakse pool minutit, et selle tuli vilguks. Otsi seda korpusest."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levyä luetaan puoli minuuttia, jotta sen valo vilkkuu. Etsi se kotelosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le disque est lu pendant une demi-minute pour que son voyant clignote. Cherche-le dans le boîtier."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Léitear an diosca ar feadh leathnóiméid ionas go gcaochfaidh a sholas. Aimsigh sa chás é."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk se čita pola minute da mu lampica treperi. Potražite ga u kućištu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lemezt fél percig olvassuk, hogy villogjon a lámpája. Keresd meg a házban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il disco viene letto per mezzo minuto, così la sua spia lampeggia. Cercalo nel case."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクを30秒間読み込み、ランプを点滅させます。ケースの中で探してください。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diskas skaitomas pusę minutės, kad mirksėtų jo lemputė. Suraskite jį korpuse."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disks tiek lasīts pusminūti, lai mirgotu tā lampiņa. Atrodiet to korpusā."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Id-diska tinqara għal nofs minuta biex id-dawl tagħha jteptep. Fittixha fil-kaxxa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De schijf wordt een halve minuut gelezen zodat het lampje knippert. Zoek hem in de behuizing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dysk jest czytany przez pół minuty, aby migała jego lampka. Poszukaj go w obudowie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O disco é lido durante meio minuto para a luz piscar. Procura-o na caixa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discul este citit o jumătate de minut ca să-i clipească ledul. Caută-l în carcasă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диск читается полминуты, чтобы мигала его лампочка. Найдите его в корпусе."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk sa pol minúty číta, aby blikala jeho kontrolka. Nájdite ho v skrinke."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk se bere pol minute, da utripa njegova lučka. Poiščite ga v ohišju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disken läses i en halv minut så att lampan fladdrar. Leta efter den i chassit."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диск читається пів хвилини, щоб блимала його лампочка. Знайдіть його в корпусі."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取磁盘半分钟，使其指示灯闪烁。在机箱里找它。"
          }
        }
      }
    },
    "The disk is unmounted and no longer mounted at start. The data on it stays." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дискът се демонтира и вече не се монтира при старт. Данните на него остават."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk se odpojí a při startu se už nepřipojí. Data na něm zůstanou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disken afmonteres og monteres ikke længere ved start. Data på den bliver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Festplatte wird ausgehängt und beim Start nicht mehr eingehängt. Die Daten darauf bleiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο δίσκος αποπροσαρτάται και δεν προσαρτάται πια κατά την εκκίνηση. Τα δεδομένα του μένουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco se desmonta y ya no se monta al arrancar. Sus datos se conservan."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketas haagitakse lahti ja seda ei haagita enam käivitusel. Andmed jäävad alles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levy irrotetaan eikä sitä enää liitetä käynnistyksessä. Sen tiedot säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le disque est démonté et n'est plus monté au démarrage. Ses données restent."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Díshuiteáiltear an diosca agus ní fheistítear é ag an tús níos mó. Fanann na sonraí air."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk se odspaja i više se ne montira pri pokretanju. Podaci na njemu ostaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lemez leválasztódik, és induláskor sem csatolódik fel többé. A rajta lévő adatok megmaradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il disco viene smontato e non viene più montato all'avvio. I dati restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクをアンマウントし、起動時にもマウントしなくなります。データはそのまま残ります。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diskas atjungiamas ir paleidžiant nebeprijungiamas. Duomenys jame lieka."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disks tiek atvienots un startējot vairs netiek piemontēts. Dati tajā paliek."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Id-diska tiġi żmuntata u ma tibqax tiġi mmuntata mal-bidu. Id-data fuqha tibqa'."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De schijf wordt ontkoppeld en bij het opstarten niet meer aangekoppeld. De gegevens blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dysk zostaje odmontowany i nie jest już montowany przy starcie. Dane na nim zostają."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O disco é desmontado e deixa de ser montado no arranque. Os dados ficam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discul este demontat și nu mai este montat la pornire. Datele de pe el rămân."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диск отключается и больше не подключается при запуске. Данные на нём остаются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk sa odpojí a pri štarte sa už nepripojí. Dáta na ňom zostanú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk se odklopi in se ob zagonu ne priklopi več. Podatki na njem ostanejo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disken avmonteras och monteras inte längre vid start. Datan på den finns kvar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диск відключається й більше не підключається під час запуску. Дані на ньому лишаються."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘会被卸载，开机时也不再挂载。其中的数据保留。"
          }
        }
      }
    },
    "The disk leaves the array so you can pull it out. Until a new disk is put in, the array has less protection." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дискът излиза от масива, за да можеш да го извадиш. Докато не поставиш нов диск, масивът е по-слабо защитен."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk opustí pole, abyste ho mohli vytáhnout. Dokud nevložíte nový disk, má pole menší ochranu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disken forlader arrayet, så du kan tage den ud. Indtil en ny disk sættes i, er arrayet mindre beskyttet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Festplatte verlässt das Array, damit du sie herausziehen kannst. Bis eine neue eingesetzt ist, ist das Array weniger geschützt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο δίσκος φεύγει από τη συστοιχία για να τον αφαιρέσεις. Μέχρι να μπει νέος δίσκος, η συστοιχία έχει λιγότερη προστασία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco sale del conjunto para que puedas sacarlo. Hasta que pongas uno nuevo, el conjunto tiene menos protección."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketas lahkub massiivist, et saaksid selle välja võtta. Kuni uut ketast pole paigaldatud, on massiiv vähem kaitstud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levy poistuu taulukosta, jotta voit irrottaa sen. Kunnes uusi levy on paikallaan, taulukolla on vähemmän suojaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le disque quitte l'ensemble pour que tu puisses le retirer. Tant qu'un nouveau disque n'est pas mis, l'ensemble est moins protégé."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fágann an diosca an t-eagar ionas gur féidir leat é a bhaint amach. Go dtí go gcuirtear diosca nua isteach, tá níos lú cosanta ag an eagar."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk napušta polje kako biste ga mogli izvaditi. Dok se ne umetne novi disk, polje ima manju zaštitu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lemez kilép a tömbből, hogy kivehesd. Amíg nem kerül be új lemez, a tömb kevésbé védett."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il disco esce dall'array così puoi estrarlo. Finché non ne metti uno nuovo, l'array è meno protetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクをアレイから外して取り出せるようにします。新しいディスクを入れるまで、アレイの保護は弱くなります。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diskas palieka masyvą, kad galėtumėte jį ištraukti. Kol neįdėtas naujas diskas, masyvas mažiau apsaugotas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disks atstāj masīvu, lai to varētu izņemt. Kamēr nav ielikts jauns disks, masīvam ir mazāka aizsardzība."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Id-diska toħroġ mill-array biex tkun tista' tneħħiha. Sakemm ma titpoġġiex diska ġdida, l-array ikollu inqas protezzjoni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De schijf verlaat de array zodat je hem eruit kunt halen. Tot er een nieuwe in zit, is de array minder beschermd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dysk opuszcza macierz, aby można go było wyjąć. Dopóki nie włożysz nowego, macierz jest słabiej chroniona."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O disco sai do conjunto para o poderes retirar. Até pores um novo, o conjunto fica menos protegido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discul iese din matrice ca să-l poți scoate. Până pui un disc nou, matricea este mai puțin protejată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диск выходит из массива, чтобы его можно было вынуть. Пока не вставлен новый диск, защита массива слабее."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk opustí pole, aby ste ho mohli vytiahnuť. Kým nevložíte nový disk, pole má menšiu ochranu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk zapusti polje, da ga lahko odstranite. Dokler ne vstavite novega, ima polje manj zaščite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disken lämnar arrayen så att du kan ta ut den. Tills en ny disk sätts i har arrayen sämre skydd."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диск виходить із масиву, щоб його можна було вийняти. Поки не вставлено новий диск, захист масиву слабший."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘离开阵列，以便你拔出它。在装入新磁盘之前，阵列的保护会减少。"
          }
        }
      }
    },
