          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Іконка на домашньому екрані. Зміну підтверджує сама iOS."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主屏幕上的图标。更改由 iOS 自行确认。"
          }
        },
        "fi" : {
          "stringUnit" : {
