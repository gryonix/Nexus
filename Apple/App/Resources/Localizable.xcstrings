    "Data disks need the root sign-in saved at installation." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дисковете данни нуждаят се от входа root, запазен при инсталацията."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datové disky vyžadují přihlášení root uložené během instalace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datadiske kræver root-login gemt under installation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenlaufwerke benötigen die bei der Installation gespeicherte Root-Anmeldung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι δίσκοι δεδομένων χρειάζονται τη σύνδεση root που αποθηκεύτηκε κατά την εγκατάσταση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los discos de datos requieren el inicio de sesión raíz guardado en la instalación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andmekettad vajavad installimise ajal salvestatud juuriga sisselogimist."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietolevyt vaativat asennuksen aikana tallennetun root-kirjautumisen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les disques de données nécessitent la connexion root enregistrée lors de l'installation."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teastáin sonraí ag teastáil an dúnmharu root a sábháladh le linn suiteála."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diskovi podataka trebaju korisnički unos root spreman tijekom instalacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az adatlemezek az instaláció során mentett root-bejelentkezést igényelnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dischi dati richiedono l'accesso root salvato durante l'installazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データディスクはインストール時に保存されたルートサインインが必要です。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duomenų diskams reikalingas root prisijungimas, išsaugotas diegimo metu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datu diskiem nepieciešams root pieteikšanās, kas saglabāts instalācijas laikā."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Id-disketti tad-data jeħtieġ il-root sign-in li ġie salvat matul l-installazzjoni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gegevensschijven vereisen de root-aanmelding die tijdens de installatie is opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dyski danych wymagają logowania root zapisanego podczas instalacji."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os discos de dados precisam do login root salvo durante a instalação."
          }
        },
        "ro" : {
          "stringUnit" : {
