    "Used only when the sensor is silent. This machine reports its own power." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използва се само когато сензорът е мълчалив. Този компютър докладва собствената си мощност."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá se pouze když je senzor tichý. Tento počítač hlásí svou vlastní výkon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges kun når sensoren er stille. Denne maskine rapporterer sin egen kraft."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nur verwendet, wenn der Sensor keine Werte liefert. Diese Maschine meldet ihre eigene Leistung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται μόνο όταν ο αισθητήρας είναι σιωπηλός. Αυτή η μηχανή αναφέρει τη δική της δύναμη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se utiliza solo cuando el sensor está silencioso. Esta máquina reporta su propia potencia."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasutatakse ainult siis, kui andur on vaikne. See masin teatab oma võimsusest."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään vain kun anturi on hiljaa. Tämä kone raportoi omaa tehoaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé uniquement lorsque le capteur est silencieux. Cette machine rapporte sa propre puissance."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní úsáidtear ach nuair a bhíonn an t-fhothram gan fhios. Tuairiscíonn an meaisín seo a cumhacht féin."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi se samo kada je senzor tih. Ovaj računalo prijavljuje svoju moć."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak akkor használatos, ha az érzékelő csendes. Ez a gép saját teljesítményéről számol be."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizzato solo quando il sensore è silenzioso. Questa macchina segnala la propria potenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "センサーが無音の場合にのみ使用されます。このマシンは独自の電力を報告します。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naudojama tik tada, kai jutiklis yra tylus. Šis kompiuteris praneša apie savo galią."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiek izmantots tikai tad, kad sensors ir klusums. Šis dators ziņo par savu jaudu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jintuża biss meta s-senzur huwa kwiet. Din il-magħina tirrapporta l-qawwa tagħha stess."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt alleen gebruikt wanneer de sensor stil is. Deze machine rapporteert zijn eigen vermogen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używane tylko wtedy, gdy czujnik jest cichy. Ta maszyna zgłasza swoją własną moc."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado apenas quando o sensor está silencioso. Esta máquina relata sua própria potência."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizat doar când senzorul este tăcut. Această mașină raportează propria sa putere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
