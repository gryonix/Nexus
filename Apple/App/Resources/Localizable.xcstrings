        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento server vydáva konfigurácie VPN z vlastného panela — tak je nastavený. Zmeňte to v nastaveniach VPN servera, aby sa zariadenia dali spravovať aj tu."
          }
