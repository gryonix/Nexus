    "The tunnel's state at a glance, and the switch for it, without opening the window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zustand des Tunnels auf einen Blick, samt Schalter — ohne das Fenster zu öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El estado del túnel de un vistazo, y su interruptor, sin abrir la ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’état du tunnel d’un coup d’œil, et son interrupteur, sans ouvrir la fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo stato del tunnel a colpo d’occhio, e il suo interruttore, senza aprire la finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウを開かずに、トンネルの状態とスイッチをひと目で。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Состояние туннеля и переключатель к нему — не открывая окна."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стан тунелю й перемикач до нього — не відкриваючи вікна."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不打开窗口即可一眼看到隧道状态，并直接开关。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnelin tila silmäyksellä, ja sen kytkin, ilman ikkunan avaamista."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Състоянието на тунела с един поглед и превключвателят за него, без да отваряте прозореца."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starea tunelului dintr-o privire și comutatorul lui, fără a deschide fereastra."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanje tunela na prvi pogled, i prekidač za njega, bez otvaranja prozora."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanje tunela na prvi pogled in stikalo zanj, brez odpiranja okna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnelens status på ét blik, og kontakten for den, uden at åbne vinduet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De status van de tunnel in één oogopslag, en de schakelaar ervoor, zonder het venster te openen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnelns status på en blick, och reglaget för den, utan att öppna fönstret."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alagút állapota egy pillantással, és a kapcsolója hozzá, az ablak megnyitása nélkül."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stav tunelu na první pohled a přepínač pro něj, aniž byste otevírali okno."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stan tunelu na pierwszy rzut oka i przełącznik dla niego, bez otwierania okna."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunneli olek ühe pilguga ja selle lüliti, ilma akent avamata."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O estado do túnel de relance, e o interruptor para ele, sem abrir a janela."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stav tunela na prvý pohľad a prepínač preň, bez otvárania okna."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κατάσταση της σήραγγας με μια ματιά, και ο διακόπτης της, χωρίς να ανοίξει το παράθυρο."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuneļa stāvoklis vienā skatienā un slēdzis tam, neatverot logu."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunelio būsena iš pirmo žvilgsnio ir jo jungiklis, neatverant lango."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staid an tolláin ar amharc amháin, agus an lasc dó, gan an fhuinneog a oscailt."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-istat tat-tunnel f'ħarsa waħda, u l-buttuna għalih, mingħajr ma tiftaħ it-tieqa."
          }
        }
      }
    },
