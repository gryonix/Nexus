          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versioon %@. Kontrollib uuemat gryonixNexust ja installib selle pärast allkirja kontrollimist."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzia %@. Kontroluje novší gryonixNexus a po overení podpisu ho nainštaluje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versija %@. Pārbauda, vai nav jaunākas gryonixNexus versijas, un instalē to pēc paraksta pārbaudes."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leagan %@. Seiceálann sé le haghaidh gryonixNexus níos nuaí agus suiteálann é tar éis a shíniú a fhíorú."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versija %@. Tikrina, ar yra naujesnė gryonixNexus versija, ir ją įdiegia patikrinęs jos parašą."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verżjoni %@. Jiċċekkja għal gryonixNexus aktar riċenti u jinstallah wara li jivverifika l-firma tiegħu."
