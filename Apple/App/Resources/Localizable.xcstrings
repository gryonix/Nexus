    "The tunnel stopped by itself without an error. iOS ends a tunnel that uses too much memory." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тунелът спря сам, без грешка. iOS спира тунел, който използва твърде много памет."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunel se zastavil sám bez chyby. iOS ukončí tunel, který používá příliš mnoho paměti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnelen stoppede af sig selv uden fejl. iOS lukker en tunnel, der bruger for meget hukommelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tunnel hat sich ohne Fehler selbst beendet. iOS beendet einen Tunnel, der zu viel Speicher belegt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σήραγγα σταμάτησε μόνη της χωρίς σφάλμα. Το iOS τερματίζει μια σήραγγα που χρησιμοποιεί υπερβολική μνήμη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tunnel stopped by itself without an error. iOS ends a tunnel that uses too much memory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El túnel se detuvo solo, sin ningún error. iOS cierra un túnel que usa demasiada memoria."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnel peatus ise ilma veata. iOS lõpetab tunneli, mis kasutab liiga palju mälu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunneli pysähtyi itsestään ilman virhettä. iOS lopettaa tunnelin, joka käyttää liikaa muistia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tunnel s’est arrêté de lui-même, sans erreur. iOS arrête un tunnel qui utilise trop de mémoire."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop an tollán leis féin gan earráid. Stopann iOS tollán a úsáideann an iomarca cuimhne."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunel se sam zaustavio bez pogreške. iOS gasi tunel koji koristi previše memorije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alagút hiba nélkül, magától leállt. Az iOS leállítja azt az alagutat, amely túl sok memóriát használ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tunnel si è fermato da solo, senza errori. iOS chiude un tunnel che usa troppa memoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トンネルはエラーなしで自動的に停止しました。iOS はメモリを使いすぎるトンネルを終了します。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
