          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se instalează pe server. Poți închide aplicația — serverul continuă, iar acest ecran reia rularea."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telepítés a szerveren. Bezárhatod az alkalmazást — a szerver folytatja, és ez a képernyő felveszi a futtatás fonalát."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalowanie na serwerze. Możesz zamknąć aplikację — serwer kontynuuje, a ten ekran wznowi śledzenie postępu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instaluje se na serveru. Aplikaci můžete zavřít — server pokračuje a tato obrazovka navázání znovu zachytí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paigaldamine serveris. Võid rakenduse sulgeda — server jätkab ja see ekraan haarab kulgemise uuesti üles."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inštaluje sa na serveri. Aplikáciu môžete zatvoriť — server pokračuje ďalej a táto obrazovka beh znova naviaže."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A instalar no servidor. Pode fechar a app — o servidor continua e este ecrã retoma a execução."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εγκατάσταση στον διακομιστή. Μπορείτε να κλείσετε την εφαρμογή — ο διακομιστής συνεχίζει, και αυτή η οθόνη συνεχίζει την εκτέλεση όταν επιστρέψετε."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalē serverī. Varat aizvērt lietotni — serveris turpina darbu, un šis ekrāns atkal to uztvers."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Á shuiteáil ar an bhfreastalaí. Is féidir leat an aip a dhúnadh — leanann an freastalaí ar aghaidh, agus pioctar an rith seo suas arís ag an scáileán seo."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qed tiġi installata fuq is-server. Tista' tagħlaq l-app — is-server ikompli, u dan l-iskrin jerġa' jaqbad ir-run."
          }
        },
        "lt" : {
          "stringUnit" : {
