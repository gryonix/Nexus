    "This server carries no services of its own. It holds the public address and forwards the deployment's ports to the server behind it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server trägt keine eigenen Dienste. Er hält die öffentliche Adresse und leitet die Ports der Installation an den dahinterliegenden Server weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor no aloja ningún servicio propio. Mantiene la dirección pública y reenvía los puertos de la instalación al servidor que hay detrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur ne porte aucun service propre. Il détient l'adresse publique et transmet les ports du déploiement au serveur situé derrière lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo server non ospita servizi propri. Detiene l'indirizzo pubblico e inoltra le porte dell'installazione al server dietro di esso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバー自体はサービスを持ちません。公開アドレスを保持し、構成のポートを背後のサーバーへ転送します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом сервере нет собственных сервисов. Он держит публичный адрес и пробрасывает порты развёртывания на сервер за ним."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На цьому сервері немає власних сервісів. Він тримає публічну адресу і пробрасує порти розгортання на сервер за ним."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器本身不承载任何服务。它持有公网地址，并将本次部署的端口转发到其后面的服务器。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä palvelimella ei ole omia palveluita. Se pitää julkisen osoitteen ja välittää käyttöönoton portit sen takana olevalle palvelimelle."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този сървър не носи собствени услуги. Той държи публичния адрес и препраща портовете на внедряването към сървъра зад него."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest server nu poartă niciun serviciu propriu. Deține adresa publică și redirecționează porturile implementării către serverul din spatele lui."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj poslužitelj ne nosi vlastite usluge. Drži javnu adresu i prosljeđuje portove raspoređivanja poslužitelju iza sebe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne server har ingen egne tjenester. Den har den offentlige adresse og videresender installationens porte til serveren bag den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze server draagt geen eigen diensten. Hij houdt het publieke adres vast en stuurt de poorten van de implementatie door naar de server erachter."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här servern har inga egna tjänster. Den har den publika adressen och vidarebefordrar driftsättningens portar till servern bakom den."
          }
        },
        "sl" : {
          "stringUnit" : {
