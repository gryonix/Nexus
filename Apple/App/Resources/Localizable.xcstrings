    "“%@” is already on this device. Replacing it swaps its SSH key, passwords and pinned host keys for the ones in the file." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" вече е на това устройство. Замяната ще замени неговия SSH-ключ, пароли и закрепени ключове на хостове с тези във файла."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" je již na tomto zařízení. Nahrazením se vyměňují jeho SSH klíč, hesla a připnuté klíče hostitele za ty v souboru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" er allerede på denne enhed. Udskiftning bytter dens SSH-nøgle, adgangskoder og fastgjorte værtsnøgler med dem i filen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist bereits auf diesem Gerät. Beim Ersetzen werden SSH-Schlüssel, Passwörter und gemerkte Host-Schlüssel durch die aus der Datei ersetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" είναι ήδη σε αυτή τη συσκευή. Η αντικατάστασή του ανταλλάσσει το κλειδί SSH, τους κωδικούς πρόσβασης και τα σταθερά κλειδιά κεντρικού υπολογιστή με αυτά στο αρχείο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" ya está en este dispositivo. Reemplazarlo intercambia su clave SSH, contraseñas y claves de host fijas por las del archivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" on sellel seadmel juba. Selle asendamine vahetab selle SSH-võtme, paroolid ja kinnitatud hostivõtmed failis olevate vastu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" on jo tällä laitteella. Sen korvaaminen vaihtaa sen SSH-avaimen, salasanat ja kiinnitetyt isäntäavaimet tiedoston avaimiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" est déjà sur cet appareil. Le remplacer permute sa clé SSH, ses mots de passe et ses clés d'hôte épinglées par ceux du fichier."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" atá ar an bhfreagra seo cheana féin. Má dhéantar a ionad, beidh a eochair SSH, passwords agus eochair phríobháideach fhostaithe curtha in ionad na ndaoine sa comhad."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" je već na ovoj napravi. Zamjena zamjenjuje njegov SSH ključ, lozinke i pričvršćene ključeve domaćina onima u datoteci."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" már ezen az eszközön van. A cserélés az SSH-kulcsát, jelszavait és rögzített gazdakulcsait felcseréli a fájl olyanaival."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" è già su questo dispositivo. Sostituirlo scambia la sua chiave SSH, le password e le chiavi host bloccate con quelle nel file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" は既にこのデバイスにあります。置き換えるとSSH鍵、パスワード、および固定されたホストキーがファイルのものと交換されます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" jau yra šiame įrenginyje. Jo pakeitimas sukeičia jo SSH raktą, slaptažodžius ir pritvirtintus tarnybinio kompiuterio raktus iš failo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" jau ir šajā ierīcē. Aizstāšana apmaina tā SSH atslēgu, paroles un piespraustos saimnieka atslēgas ar tiem, kas atrodas failā."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" huwa diġà fuq dan it-tagħmir. L-ibdil tal-permezz tal-kisja SSH, passwords u keys tal-host pinned għal dawk fil-file."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" staat al op dit apparaat. Vervanging wisselt de SSH-sleutel, wachtwoorden en vastgezette hostsleutels uit voor die in het bestand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" już jest na tym urządzeniu. Zamiana wymienia jego klucz SSH, hasła i przypięte klucze hosta na te z pliku."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" já está neste dispositivo. Substituir troca sua chave SSH, senhas e chaves de anfitrião fixadas pelas do arquivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" este deja pe acest dispozitiv. Înlocuirea schimbă cheia sa SSH, parolele și cheile de gazdă fixate cu cele din fișier."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» уже есть на этом устройстве. При замене его SSH-ключ, пароли и закреплённые ключи хостов будут заменены на те, что в файле."
