    "Every device that joined this mesh. They reach each other directly, and this server relays only when a network refuses a direct connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Gerät, das diesem Mesh beigetreten ist. Sie erreichen einander direkt; dieser Server leitet nur weiter, wenn ein Netzwerk keine direkte Verbindung zulässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada dispositivo que se unió a esta malla. Se alcanzan directamente y este servidor solo hace de relé cuando una red rechaza la conexión directa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque appareil ayant rejoint ce maillage. Ils se joignent directement ; ce serveur ne relaie que si un réseau refuse la connexion directe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni dispositivo che si è unito a questa rete mesh. Si raggiungono direttamente e questo server fa da relay solo quando una rete rifiuta la connessione diretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このメッシュに参加しているすべてのデバイス。互いに直接接続し、ネットワークが直接接続を許可しない場合だけこのサーバーが中継します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все устройства, подключённые к этой mesh-сети. Они соединяются напрямую, а сервер ретранслирует только там, где прямое соединение не проходит."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі пристрої, підключені до цієї mesh-мережі. Вони з’єднуються напряму, а сервер ретранслює лише там, де пряме з’єднання не проходить."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已加入此网状网络的所有设备。它们直接互联，只有在网络拒绝直连时本服务器才做中继。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen laite, joka on liittynyt tähän verkkoon. Ne tavoittavat toisensa suoraan, ja tämä palvelin välittää vain, kun verkko kieltäytyy suorasta yhteydestä."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всяко устройство, присъединило се към тази мрежа. Те се достигат директно едно друго, а този сървър препредава само когато мрежа отказва директна връзка."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk apparaat dat lid is van dit mesh. Ze bereiken elkaar rechtstreeks, en deze server relayeert alleen als een netwerk een directe verbinding weigert."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle enheder, der har tilsluttet sig dette mesh. De når hinanden direkte, og denne server videresender kun, når et netværk afviser en direkte forbindelse."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje enhet som anslutit till det här meshet. De når varandra direkt, och den här servern vidarebefordrar bara när ett nätverk vägrar en direkt anslutning."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki uređaj koji se pridružio ovoj mreži. Dosežu jedan drugog izravno, a ovaj poslužitelj prosljeđuje samo kad mreža odbije izravnu vezu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsaka naprava, ki se je pridružila tej mreži. Druga do druge dosežejo neposredno, ta strežnik pa posreduje le, ko omrežje zavrne neposredno povezavo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare dispozitiv care s-a alăturat acestei rețele mesh. Se conectează direct între ele, iar acest server retransmite doar atunci când o rețea refuză o conexiune directă."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden eszköz, amely csatlakozott ehhez a hálózathoz. Közvetlenül elérik egymást, és ez a szerver csak akkor közvetít, ha egy hálózat elutasítja a közvetlen kapcsolatot."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde urządzenie, które dołączyło do tej sieci mesh. Łączą się ze sobą bezpośrednio, a ten serwer pośredniczy tylko wtedy, gdy sieć odmawia bezpośredniego połączenia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé zařízení, které se připojilo k této síti mesh. Spojují se přímo mezi sebou a tento server zprostředkovává pouze tehdy, když síť odmítne přímé spojení."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga seade, mis on selle mesh-võrguga liitunud. Nad ühenduvad üksteisega otse ja see server vahendab ainult siis, kui võrk keeldub otseühendusest."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé zariadenie, ktoré sa pripojilo do tejto siete mesh. Navzájom sa dosahujú priamo a tento server preposiela iba vtedy, keď sieť odmietne priame pripojenie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os dispositivos que aderiram a esta mesh. Alcançam-se diretamente entre si, e este servidor só faz o reencaminhamento quando uma rede recusa uma ligação direta."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε συσκευή που έχει ενταχθεί σε αυτό το mesh. Επικοινωνούν απευθείας μεταξύ τους, και αυτός ο διακομιστής αναμεταδίδει μόνο όταν ένα δίκτυο αρνείται απευθείας σύνδεση."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katra ierīce, kas pievienojusies šim tīklam. Tās sasniedz viena otru tieši, un šis serveris pārraida tikai tad, kad tīkls liedz tiešu savienojumu."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gach gléas a chuaigh isteach sa mheasc seo. Sroicheann siad a chéile go díreach, agus ní athsheachadann an freastalaí seo ach nuair a dhiúltaíonn líonra do nasc díreach."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kull apparat li ngħaqad ma' din ix-xibka. Jilħqu lil xulxin direttament, u dan is-server jgħaddi biss meta netwerk jirrifjuta konnessjoni diretta."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiekvienas įrenginys, prisijungęs prie šio tinklo (mesh). Jie pasiekia vienas kitą tiesiogiai, o šis serveris persiunčia tik tada, kai tinklas atsisako tiesioginio ryšio."
          }
        }
      }
    },
