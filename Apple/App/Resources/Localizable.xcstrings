    "Lets you manage this server from the app (Servers tab) and install it straight from this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht die Verwaltung dieses Servers über die App (Tab „Server“) und die Installation direkt von diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te permite gestionar este servidor desde la app (pestaña Servidores) e instalarlo directamente desde este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous permet de gérer ce serveur depuis l'app (onglet Serveurs) et de l'installer directement depuis cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti consente di gestire questo server dall'app (scheda Server) e di installarlo direttamente da questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ（サーバータブ）からこのサーバーを管理し、このデバイスから直接インストールできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет управлять этим сервером из приложения (вкладка «Серверы») и установить его прямо с этого устройства."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяє керувати цим сервером із застосунку (вкладка «Сервери») та встановити його прямо з цього пристрою."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让您可以从应用（服务器标签页）管理此服务器，并直接从此设备安装它。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antaa sinun hallita tätä palvelinta sovelluksesta (Palvelimet-välilehti) ja asentaa sen suoraan tältä laitteelta."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволява ви да управлявате този сървър от приложението (раздел Сървъри) и да го инсталирате направо от това устройство."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee beheer je deze server vanuit de app (tabblad Servers) en installeer je hem rechtstreeks vanaf dit apparaat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lader dig administrere denne server fra appen (fanen Servere) og installere den direkte fra denne enhed."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låter dig hantera den här servern från appen (fliken Servrar) och installera den direkt från den här enheten."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućuje upravljanje ovim poslužiteljem iz aplikacije (kartica Poslužitelji) i instalaciju izravno s ovog uređaja."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogoča upravljanje tega strežnika iz aplikacije (zavihek Strežniki) in namestitev neposredno s te naprave."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îți permite să gestionezi acest server din aplicație (fila Servere) și să îl instalezi direct de pe acest dispozitiv."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehetővé teszi, hogy ezt a szervert az alkalmazásból (Szerverek fül) kezeld, és közvetlenül erről az eszközről telepítsd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala zarządzać tym serwerem z aplikacji (karta Serwery) i instalować go bezpośrednio z tego urządzenia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožňuje spravovat tento server z aplikace (karta Servery) a nainstalovat ho přímo z tohoto zařízení."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Võimaldab seda serverit hallata rakendusest (vahekaart Serverid) ja seda otse sellest seadmest paigaldada."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožňuje spravovať tento server z aplikácie (karta Servery) a inštalovať ho priamo z tohto zariadenia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite gerir este servidor a partir da app (separador Servidores) e instalá-lo diretamente a partir deste dispositivo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σας επιτρέπει να διαχειρίζεστε αυτόν τον διακομιστή από την εφαρμογή (καρτέλα Servers) και να τον εγκαθιστάτε απευθείας από αυτή τη συσκευή."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ļauj pārvaldīt šo serveri no lietotnes (cilne Serveri) un instalēt to tieši no šīs ierīces."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligeann sé duit an freastalaí seo a bhainistiú ón aip (cluaisín Freastalaithe) agus é a shuiteáil díreach ón ngléas seo."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iħallik timmaniġġja dan is-server mill-app (skeda Servers) u tinstallah direttament minn dan l-apparat."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leidžia valdyti šį serverį iš programėlės (skirtukas „Serveriai“) ir įdiegti jį tiesiai iš šio įrenginio."
          }
        }
      }
    },
