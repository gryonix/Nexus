    "Left by an earlier install: it is brought back as it is, with the databases on it — nothing is formatted." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставено от по-ранна инсталация: се връща както е, с базите данни на него — нищо не се форматира."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanecháno starší instalací: vrátí se, jak je, s databázemi na něm — nic se neformátuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efterladt af en tidligere installation: det bringes tilbage som det er, med databaserne på det — intet formateres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von einer früheren Installation: wird so übernommen, wie es ist, samt Datenbanken — nichts wird formatiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποхωρήθηκε από προηγούμενη εγκατάσταση: ανακτάται ως είναι, με τις βάσεις δεδομένων σε αυτό — τίποτα δεν μορφοποιείται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejado por una instalación anterior: se devuelve tal cual, con las bases de datos en él — nada se formatea."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jäetud varasemast paigaldusest: see tuuakse tagasi sellisena, nagu see on, koos andmebaaside ja sellele — midagi ei vormindada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jätetty aiemmasta asennuksesta: se tuodaan takaisin sellaisena kuin se on, tietokannat sillä — mitään ei alusteta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissé par une installation antérieure : il est ramené tel quel, avec les bases de données dessus — rien n'est formaté."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fágtha ag bunú níos luaithe: tugtar ar ais ar a bhealach, leis na bunachair air — ní formáidithe a dhada."
