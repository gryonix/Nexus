    "It runs on the server, so the app can be closed. The screen refreshes by itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тя работи на сървъра, така че приложението може да се затвори. Екранът се опреснява сам."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Běží na serveru, aplikaci tedy můžete zavřít. Obrazovka se obnovuje sama."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kører på serveren, så appen kan lukkes. Skærmen opdaterer sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie läuft auf dem Server, die App kann also geschlossen werden. Der Bildschirm aktualisiert sich von selbst."
