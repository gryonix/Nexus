    "Restarts the services on the local server, then the tunnel on both machines, and waits for it to come back. Each step is shown as it happens." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet die Dienste auf dem lokalen Server neu, danach den Tunnel auf beiden Maschinen, und wartet auf dessen Rückkehr. Jeder Schritt wird live angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restarts the services on the local server, then the tunnel on both machines, and waits for it to come back. Each step is shown as it happens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinicia los servicios del servidor local, luego el túnel en ambas máquinas, y espera a que vuelva. Cada paso se muestra en directo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redémarre les services du serveur local, puis le tunnel sur les deux machines, et attend son rétablissement. Chaque étape s'affiche au fur et à mesure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riavvia i servizi sul server locale, poi il tunnel su entrambe le macchine, e attende il suo ritorno. Ogni passaggio viene mostrato mentre avviene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルサーバーのサービスを再起動し、続いて両方のマシンのトンネルを再起動して、復旧を待ちます。各ステップは進行に合わせて表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перезапускает сервисы на локальном сервере, затем туннель на обеих машинах, и ждёт его возвращения. Каждый шаг показывается по ходу дела."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перезапускає сервіси на локальному сервері, потім тунель на обох машинах, і чекає на його повернення. Кожен крок показується по ходу."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先重启本地服务器上的服务，然后重启两台机器上的隧道，并等待其恢复。每一步都会实时显示。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käynnistää palvelut kotipalvelimella uudelleen, sitten tunnelin molemmilla koneilla, ja odottaa sen palaamista. Jokainen vaihe näytetään tapahtuessaan."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рестартира услугите на локалния сървър, после тунела на двете машини, и изчаква да се върне. Всяка стъпка се показва в момента на изпълнението ѝ."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herstart de diensten op de lokale server, daarna de tunnel op beide machines, en wacht tot deze terugkomt. Elke stap wordt getoond terwijl deze gebeurt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genstarter tjenesterne på den lokale server, derefter tunnelen på begge maskiner, og venter på, at den kommer tilbage. Hvert trin vises, mens det sker."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startar om tjänsterna på den lokala servern, sedan tunneln på båda maskinerna, och väntar på att den ska komma tillbaka. Varje steg visas när det händer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repornește serviciile pe serverul local, apoi tunelul pe ambele mașini, și așteaptă să revină. Fiecare pas este afișat pe măsură ce se întâmplă."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponovno pokreće usluge na lokalnom poslužitelju, zatim tunel na oba stroja, i čeka da se vrati. Svaki korak prikazuje se u trenutku izvršavanja."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znova zažene storitve na lokalnem strežniku, nato tunel na obeh strojih, in počaka, da se vrne. Vsak korak je prikazan, ko se zgodi."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reštartuje služby na lokálnom serveri, potom tunel na oboch strojoch, a čaká, kým sa vráti. Každý krok sa zobrazuje priebežne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Újraindítja a szolgáltatásokat a helyi szerveren, majd az alagutat mindkét gépen, és megvárja, amíg visszatér. Minden lépés megjelenik, ahogy történik."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restartuje služby na místním serveru, poté tunel na obou strojích a čeká, až se vrátí. Každý krok se zobrazí, jak probíhá."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taaskäivitab teenused kohalikus serveris, seejärel tunneli mõlemas masinas, ja ootab selle tagasitulekut. Iga samm kuvatakse selle toimumise ajal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamia ponownie usługi na serwerze lokalnym, potem tunel na obu maszynach, i czeka, aż wróci. Każdy krok jest pokazywany na bieżąco."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επανεκκινεί τις υπηρεσίες στον τοπικό διακομιστή, έπειτα τη σήραγγα και στα δύο μηχανήματα, και περιμένει να επανέλθει. Κάθε βήμα εμφανίζεται καθώς συμβαίνει."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinicia os serviços no servidor local, depois o túnel em ambas as máquinas, e aguarda que volte. Cada passo é mostrado à medida que acontece."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restartē pakalpojumus lokālajā serverī, tad tuneli abās mašīnās, un gaida, kamēr tas atgriežas. Katrs solis tiek parādīts, kad tas notiek."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atosaítear na seirbhísí ar an bhfreastalaí áitiúil, ansin an tollán ar an dá mheaisín, agus fanann sé go dtiocfaidh sé ar ais. Taispeántar gach céim de réir mar a tharlaíonn sí."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paleidžia paslaugas vietiniame serveryje iš naujo, tada tunelį abiejose mašinose, ir laukia, kol jis atsistatys. Kiekvienas žingsnis rodomas jam vykstant."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terġa' tibda s-servizzi fuq is-server lokali, imbagħad it-tunnel fuq iż-żewġ magni, u tistenna li jerġa' lura. Kull pass jintwera hekk kif iseħħ."
          }
        }
      }
    },
