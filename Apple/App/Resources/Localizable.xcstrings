          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi ridurre l'app: l'installazione continua sul server e l'app la riprende quando torni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを最小化できます。インストールはサーバーで続き、戻るとアプリが引き継ぎます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programą galite sumažinti: diegimas tęsiasi serveryje, o grįžus programa jį perims."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lietotni var minimizēt: instalēšana turpinās serverī, un lietotne to pārņem, kad atgriežaties."
