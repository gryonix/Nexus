        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semmi sem lett telepítve azon a gépen — a futtatás leállt, mielőtt bármit létrehozott volna."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na ten stroj sa nič nenainštalovalo — beh sa zastavil skôr, než niečo vytvoril."
