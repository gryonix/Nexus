        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis serveris izsniedz VPN konfigurācijas no sava paša paneļa — tā tas ir iestatīts. Mainiet to servera VPN iestatījumos, lai ierīces pārvaldītu arī šeit."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tugann an freastalaí seo cumraíochtaí VPN óna phainéal féin — sin mar atá sé socraithe. Athraigh é i socruithe VPN an fhreastalaí chun gléasanna a bhainistiú anseo freisin."
