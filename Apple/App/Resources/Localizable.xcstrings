    "The report is also saved on this device (Keychain) — reopen it any time via “Access & passwords” in the dashboard." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bericht ist auch auf diesem Gerät gespeichert (Schlüsselbund) — öffnen Sie ihn jederzeit über „Zugänge & Passwörter“ im Dashboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El informe también se guarda en este dispositivo (llavero); vuelva a abrirlo en cualquier momento desde «Accesos y contraseñas» en el panel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rapport est aussi enregistré sur cet appareil (trousseau) — rouvrez-le à tout moment via « Accès et mots de passe » dans le tableau de bord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rapporto è salvato anche su questo dispositivo (portachiavi): riaprilo in qualsiasi momento da «Accessi e password» nella dashboard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レポートはこのデバイス（キーチェーン）にも保存されています。ダッシュボードの「アクセスとパスワード」からいつでも開けます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отчёт также сохранён на этом устройстве (Keychain) — откройте его в любой момент через «Доступы и пароли» в дашборде."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звіт також збережено на цьому пристрої (Keychain) — відкрийте його будь-коли через «Доступи та паролі» в дашборді."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "报告也已保存在此设备上（钥匙串）——随时可通过仪表板中的“访问与密码”重新打开。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raportti on myös tallennettu tälle laitteelle (avainnippu) — avaa se uudelleen milloin tahansa hallintapaneelin kohdasta “Pääsy ja salasanat”."
