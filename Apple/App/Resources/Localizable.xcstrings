          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uključite usluge koje želite iza jedne prijave — pojavit će se ovdje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå de tjenester til, du vil have bag ét login — de vises her."
