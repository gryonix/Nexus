        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stikalo zgoraj zapre vsak račun. Izklopite ga, da odločate po posameznih računih."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle konti lukkes af kontakten ovenfor. Slå den fra for at afgøre konto for konto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk account wordt gesloten door de schakelaar hierboven. Zet deze uit om per account te beslissen."
