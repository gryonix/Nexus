          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurația acestui tunel nu mai este pe acest dispozitiv. Deschide dispozitivul pe serverul lui și alege din nou „Use on this device”."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne tunnels konfiguration er ikke længere på denne enhed. Åbn enheden på dens server, og vælg “Brug på denne enhed” igen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De configuratie van deze tunnel staat niet meer op dit apparaat. Open het apparaat op de server en kies opnieuw “Gebruik op dit apparaat”."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här tunnelns konfiguration finns inte längre på den här enheten. Öppna enheten på dess server och välj “Använd på den här enheten” igen."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfiguracija ovog tunela više nije na ovom uređaju. Otvorite uređaj na njegovom poslužitelju i ponovno odaberite “Koristi na ovom uređaju”."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfiguracije tega tunela na tej napravi ni več. Odprite napravo na njenem strežniku in znova izberite »Uporabi na tej napravi«."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennek az alagútnak a konfigurációja már nincs ezen az eszközön. Nyissa meg az eszközt a szerverén, és válassza ismét a „Használat ezen az eszközön” lehetőséget."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurace tohoto tunelu už na tomto zařízení není. Otevřete zařízení na jeho serveru a znovu zvolte „Použít na tomto zařízení“."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfiguracja tego tunelu nie jest już na tym urządzeniu. Otwórz urządzenie na jego serwerze i ponownie wybierz „Użyj na tym urządzeniu”."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle tunneli seadistus pole enam selles seadmes. Ava seade selle serveris ja vali uuesti „Kasuta selles seadmes”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A configuração deste túnel já não está neste dispositivo. Abra o dispositivo no seu servidor e escolha novamente “Usar neste dispositivo”."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurácia tohto tunela už na tomto zariadení nie je. Otvorte zariadenie na jeho serveri a znova zvoľte „Použiť na tomto zariadení“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διαμόρφωση αυτής της σήραγγας δεν βρίσκεται πλέον σε αυτή τη συσκευή. Ανοίξτε τη συσκευή στον διακομιστή της και επιλέξτε ξανά «Χρήση σε αυτή τη συσκευή»."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šī tuneļa konfigurācijas šajā ierīcē vairs nav. Atveriet ierīci tās serverī un vēlreiz izvēlieties “Izmantot šajā ierīcē”."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níl cumraíocht an tolláin seo ar an ngléas seo a thuilleadh. Oscail an gléas ar a fhreastalaí agus roghnaigh “Úsáid ar an ngléas seo” arís."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šio tunelio konfigūracijos šiame įrenginyje nebėra. Atverkite įrenginį jo serveryje ir vėl pasirinkite „Naudoti šiame įrenginyje“."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-konfigurazzjoni ta' dan it-tunnel m'għadhiex fuq dan l-apparat. Iftaħ l-apparat fuq is-server tiegħu u agħżel “Use on this device” mill-ġdid."
          }
        }
      }
    },
