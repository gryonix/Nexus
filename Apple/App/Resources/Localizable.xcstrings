        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "玩家需要在自己的游戏里安装相同的模组才能加入。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
