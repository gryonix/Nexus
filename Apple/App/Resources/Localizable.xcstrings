            "value" : "Свободните дискове могат да се присъединят към нов масив. Всичко на избраните дискове ще бъде изтрито."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volné disky lze spojit do nového pole. Všechno na vybraných discích bude smazáno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ledige diske kan sluttes sammen til et nyt array. Alt på de diske du vælger slettes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freie Laufwerke lassen sich zu einem neuen Array verbinden. Alles auf den gewählten Laufwerken wird gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι δίσκοι που είναι ελεύθεροι μπορούν να συνδεθούν σε ένα νέο array. Όλα στους δίσκους που επιλέγεις θα διαγραφούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los discos libres se pueden unir en un nuevo array. Todo lo que hay en los discos que elijas se borra."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vabad kettad saab liita uude massiivi. Kõik valitud kettadel olev kustutatakse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vapaat levyt voidaan yhdistää uuteen ryhmään. Kaikki valitsemillasi levyilla olevan poistetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les disques libres peuvent être joints dans un nouveau array. Tout sur les disques que tu choisis sera effacé."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is féidir le dioscaí saor a bheith ceangailte i eagar nua. Scrios gach rud ar na dioscaí a bhíonn tú a roghnú."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slobodni diskovi mogu biti spojeni u novi niz. Sve na odabranim diskovima bit će obrisano."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szabad merevlemezek új tömbhöz csatolhatók. A kiválasztott lemezek összes tartalma törlődik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dischi liberi possono essere uniti in un nuovo array. Tutto nei dischi scelti verrà cancellato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空いているディスクを新しいアレイに結合できます。選択したディスク上のすべてが削除されます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisvi diskai gali būti sujungti į naują masyvą. Viskas pasirinktose diskuose bus ištrinta."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brīvos diskus var pievienot jaunam masīvam. Viss jūsu izvēlētajos diskos tiks dzēsts."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-diskini ħielsa jistgħu jiġu ggallbati fi arranġament ġdid. Kollox fuq id-diskini li tagħżel se jitħassar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrije schijven kunnen in een nieuw array worden samengevoegd. Alles op de schijven die je kiest wordt verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wolne dyski mogą być połączone w nową tablicę. Wszystko na wybranych dyskach zostanie usunięte."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os discos livres podem ser unidos em um novo array. Tudo nos discos que escolher será apagado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discurile libere pot fi alăturate într-un nou array. Tot ce se află pe discurile pe care le alegi va fi șters."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свободные диски можно объединить в новый массив. Всё на выбранных дисках будет стёрто."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voľné disky sa dajú spojiť do nového poľa. Všetko na vybraných diskoch bude vymazané."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proste diske je mogoče spojiti v novo polje. Vse na izbanih diskih bo izbrisano."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lediga diskar kan sammanfogas i en ny array. Allt på de diskar du väljer raderas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вільні диски можна об'єднати в новий масив. Усе на вибраних дисках буде стерто."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用磁盘可以加入新阵列。你选择的磁盘上的所有内容都将被删除。"
          }
        }
      }
    },
