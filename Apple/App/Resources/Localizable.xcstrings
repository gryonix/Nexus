        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καμία αποθηκευμένη αναφορά ακόμη. Καταγράφεται αυτόματα όταν εγκαθιστάτε από αυτή τη συσκευή· επαναλάβετε την εγκατάσταση για να τη συμπληρώσετε."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeszcze brak zapisanego raportu. Jest przechwytywany automatycznie przy instalacji z tego urządzenia — uruchom instalację ponownie, aby go uzupełnić."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda sem relatório guardado. É capturado automaticamente quando instala a partir deste dispositivo; volte a executar a instalação para o preencher."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vēl nav saglabāta pārskata. Tas tiek automātiski izveidots, instalējot no šīs ierīces; palaidiet instalāciju vēlreiz, lai to aizpildītu."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gan tuairisc shábháilte fós. Gabhtar go huathoibríoch í nuair a shuiteálann tú ón ngléas seo; rith an tsuiteáil arís chun í a líonadh isteach."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-ebda rapport salvat s'issa. Jinqabad awtomatikament meta tinstalla minn dan l-apparat; erġa' mexxi l-installazzjoni biex timlih."
