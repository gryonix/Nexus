        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento server sám nenese žádné služby. Drží veřejnou adresu a přeposílá porty nasazení na server za ním."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten serwer nie ma żadnych własnych usług. Przechowuje publiczny adres i przekierowuje porty wdrożenia do serwera za nim."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor não transporta serviços próprios. Detém o endereço público e reencaminha as portas da implementação para o servidor por trás dele."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο διακομιστής δεν φέρει δικές του υπηρεσίες. Κατέχει τη δημόσια διεύθυνση και προωθεί τις θύρες της ανάπτυξης στον διακομιστή πίσω από αυτόν."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sellel serveril pole ühtegi oma teenust. See hoiab avalikku aadressi ja suunab juurutuse pordid selle taga olevasse serverisse."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento server neprevádzkuje žiadne vlastné služby. Drží verejnú adresu a presmerováva porty nasadenia na server za ním."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šim serverim nav savu pakalpojumu. Tas satur publisko adresi un pārsūta izvietošanas portus uz serveri aiz tā."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní iompraíonn an freastalaí seo aon seirbhísí dá chuid féin. Coinníonn sé an seoladh poiblí agus cuireann sé calafoirt an imscartha ar aghaidh chuig an bhfreastalaí taobh thiar de."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis serveris neneša jokių savo paslaugų. Jis laiko viešą adresą ir persiunčia diegimo prievadus į už jo esantį serverį."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dan is-server ma jġorr l-ebda servizz tiegħu stess. Iżomm l-indirizz pubbliku u jgħaddi l-ports tad-deployment lis-server warajh."
          }
        }
      }
    },
    "This server hands out VPN configurations from its own panel — that is how it is set up. Change it in the server's VPN settings to manage devices here as well." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server gibt VPN-Konfigurationen über sein eigenes Panel aus — so ist er eingerichtet. Ändere es in den VPN-Einstellungen des Servers, um Geräte auch hier zu verwalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor entrega las configuraciones VPN desde su propio panel: así está configurado. Cámbialo en los ajustes VPN del servidor para gestionar los dispositivos también aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
