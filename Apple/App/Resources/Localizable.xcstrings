    "Updates the server's own packages. Services keep running; a few may restart." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновява пакетите на самия сървър. Услугите продължават да работят, някои може да се рестартират."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizuje balíčky samotného serveru. Služby běží dál, některé se mohou restartovat."
          }
        },
        "da" : {
          "stringUnit" : {
