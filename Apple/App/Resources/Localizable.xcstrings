    "Pick Forgejo instead if your server is smaller — the same git hosting on a fraction of that." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm stattdessen Forgejo, wenn dein Server kleiner ist — dasselbe Git-Hosting mit einem Bruchteil davon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Forgejo si tu servidor es más pequeño: el mismo alojamiento git con una fracción de esa memoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez plutôt Forgejo si votre serveur est plus petit — le même hébergement git pour une fraction de cette mémoire."
