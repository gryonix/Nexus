    "Left empty, the proxy is used without a sign-in. The password is kept in this device's keychain, never in the server list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer gelassen wird der Proxy ohne Anmeldung verwendet. Das Passwort liegt im Schlüsselbund dieses Geräts, nie in der Serverliste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se deja vacío, el proxy se usa sin inicio de sesión. La contraseña se guarda en el llavero de este dispositivo, nunca en la lista de servidores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissé vide, le proxy est utilisé sans connexion. Le mot de passe est conservé dans le trousseau de cet appareil, jamais dans la liste des serveurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lasciato vuoto, il proxy è usato senza accesso. La password resta nel portachiavi di questo dispositivo, mai nell'elenco dei server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空のままならプロキシはサインインなしで使われます。パスワードはこの端末のキーチェーンに保管され、サーバー一覧には入りません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте пустым — прокси используется без входа. Пароль хранится в связке ключей этого устройства и никогда в списке серверов."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лишіть порожнім — проксі використовується без входу. Пароль зберігається у зв'язці ключів цього пристрою й ніколи у списку серверів."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空则不使用登录。密码保存在本设备的钥匙串中，绝不会写入服务器列表。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyhjäksi jätettynä välityspalvelinta käytetään ilman kirjautumista. Salasana säilytetään tämän laitteen avainnipussa, ei koskaan palvelinlistalla."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставено празно, прокси се използва без вход. Паролата се съхранява в Keychain на това устройство, никога в списъка със сървъри."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostavljeno prazno, proxy se koristi bez prijave. Lozinka se čuva u Keychainu ovog uređaja, nikad na popisu poslužitelja."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če pustite prazno, se proxy uporablja brez prijave. Geslo je shranjeno v Keychainu te naprave, nikoli na seznamu strežnikov."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladet tomt bruges proxyen uden login. Adgangskoden opbevares i denne enheds nøglering, aldrig i serverlisten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leeg gelaten, wordt de proxy zonder aanmelding gebruikt. Het wachtwoord wordt bewaard in de Sleutelhanger van dit apparaat, nooit in de serverlijst."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lämnat tomt används proxyn utan inloggning. Lösenordet sparas i den här enhetens nyckelring, aldrig i serverlistan."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tühjaks jäetuna kasutatakse puhverserverit ilma sisselogimiseta. Parool hoitakse selle seadme võtmehoidjas, mitte kunagi serverinimekirjas."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má fhágtar folamh é, úsáidtear an seachfhreastalaí gan síniú isteach. Coinnítear an focal faire i keychain an ghléis seo, ní choíche sa liosta freastalaithe."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jekk jitħalla vojt, il-proxy jintuża mingħajr login. Il-password tinżamm fil-keychain ta' dan l-apparat, qatt fil-lista tas-servers."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se deixado vazio, o proxy é usado sem início de sessão. A palavra-passe é guardada no keychain deste dispositivo, nunca na lista de servidores."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν μείνει κενό, ο διαμεσολαβητής (proxy) χρησιμοποιείται χωρίς σύνδεση. Ο κωδικός φυλάσσεται στο Keychain αυτής της συσκευής, ποτέ στη λίστα διακομιστών."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üresen hagyva a proxy bejelentkezés nélkül lesz használva. A jelszó ennek az eszköznek a Keychainjében marad, sosem a szerverlistában."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lăsat gol, proxy-ul este folosit fără autentificare. Parola este păstrată în keychain-ul acestui dispozitiv, niciodată în lista de servere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostawione puste, proxy jest używane bez logowania. Hasło jest przechowywane w pęku kluczy tego urządzenia, nigdy na liście serwerów."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponecháno prázdné, proxy se použije bez přihlášení. Heslo je uloženo v klíčence tohoto zařízení, nikdy v seznamu serverů."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak necháte prázdne, proxy sa použije bez prihlásenia. Heslo je uložené v kľúčenke tohto zariadenia, nikdy v zozname serverov."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja atstāts tukšs, starpniekserveris tiek izmantots bez pieteikšanās. Parole tiek glabāta šīs ierīces atslēgu saišķī, nekad servera sarakstā."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paliktas tuščias, tarpinis serveris naudojamas be prisijungimo. Slaptažodis saugomas šio įrenginio raktinėje, niekada serverių sąraše."
          }
        }
      }
    },
