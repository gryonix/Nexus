    },
    "This server has a RAID array. Files, photos and other data of the new services can live on it instead of the main disk." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този сървър има RAID масив. Файловете, снимките и другите данни на новите услуги може да са на него вместо на основния диск."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento server má pole RAID. Soubory, fotky a další data nových služeb mohou být na něm místo na hlavním disku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne server har et RAID-array. Filer, billeder og andre data fra de nye tjenester kan ligge der i stedet for på hoveddisken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server hat einen RAID-Verbund. Dateien, Fotos und andere Daten der neuen Dienste können dort statt auf der Hauptfestplatte liegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο διακομιστής έχει συστοιχία RAID. Αρχεία, φωτογραφίες και άλλα δεδομένα των νέων υπηρεσιών μπορούν να βρίσκονται εκεί αντί για τον κύριο δίσκο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor tiene una matriz RAID. Los archivos, fotos y demás datos de los nuevos servicios pueden guardarse en ella en lugar del disco principal."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sellel serveril on RAID-massiiv. Uute teenuste failid, fotod ja muud andmed võivad olla sellel, mitte põhikettal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä palvelimella on RAID-pakka. Uusien palveluiden tiedostot, kuvat ja muut tiedot voivat olla siellä päälevyn sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur a une grappe RAID. Les fichiers, photos et autres données des nouveaux services peuvent y être placés plutôt que sur le disque principal."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá eagar RAID ag an bhfreastalaí seo. Is féidir comhaid, grianghraif agus sonraí eile na seirbhísí nua a chur air in áit an phríomhdhiosca."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj poslužitelj ima RAID polje. Datoteke, fotografije i drugi podaci novih usluga mogu biti na njemu umjesto na glavnom disku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen a szerveren van RAID-tömb. Az új szolgáltatások fájljai, fotói és egyéb adatai a fő lemez helyett ott is lehetnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo server ha un array RAID. File, foto e altri dati dei nuovi servizi possono stare lì invece che sul disco principale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーには RAID アレイがあります。新しいサービスのファイルや写真などのデータを、メインディスクではなくそこに置けます。"
