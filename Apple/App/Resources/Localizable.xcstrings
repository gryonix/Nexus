        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alte Kopien (.before-cache) sind der Inhalt der Ordner vor dem Umzug. Lösche sie, sobald alles funktioniert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα παλιά αντίγραφα (.before-cache) είναι το περιεχόμενο των φακέλων πριν από τη μετακίνηση. Διαγράψτε τα όταν όλα λειτουργούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias antiguas (.before-cache) son lo que tenían las carpetas antes del traslado. Bórralas cuando todo funcione."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
