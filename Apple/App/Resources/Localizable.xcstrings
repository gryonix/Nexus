          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återställning ersätter tjänstens nuvarande data. Dess containrar går ner medan det pågår."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
