    "Selected backups: %lld. They will be permanently deleted from the server." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избрани резервни копия: %lld. Те ще бъдат изтрити завинаги от сървъра."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybrané zálohy: %lld. Budou trvale smazány ze serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgte sikkerhedskopier: %lld. De slettes permanent fra serveren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgewählte Backups: %lld. Sie werden dauerhaft vom Server gelöscht."
