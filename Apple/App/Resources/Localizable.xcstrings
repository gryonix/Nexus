    "Services, their data and the agent's settings stay. Installing the agent again picks them up." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Услугите, данните им и настройките на агента остават. Повторното инсталиране на агента ги поема."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Služby, jejich data a nastavení agenta zůstanou. Nová instalace agenta je převezme."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjenester, deres data og agentens indstillinger bliver. En ny installation af agenten overtager dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dienste, ihre Daten und die Einstellungen des Agenten bleiben. Eine neue Installation des Agenten übernimmt sie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι υπηρεσίες, τα δεδομένα τους και οι ρυθμίσεις του πράκτορα παραμένουν. Μια νέα εγκατάσταση τα αναλαμβάνει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servicios, sus datos y los ajustes del agente se conservan. Al instalar el agente de nuevo, los recupera."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teenused, nende andmed ja agendi seaded jäävad alles. Agendi uuesti paigaldamine võtab need üle."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelut, niiden tiedot ja agentin asetukset säilyvät. Agentin uudelleenasennus ottaa ne käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les services, leurs données et les réglages de l'agent restent. Réinstaller l'agent les reprend."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanann na seirbhísí, a sonraí agus socruithe an ghníomhaire. Glacann athshuiteáil an ghníomhaire leo."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usluge, njihovi podaci i postavke agenta ostaju. Ponovna instalacija agenta ih preuzima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szolgáltatások, adataik és az ügynök beállításai megmaradnak. Az ügynök újratelepítése átveszi őket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I servizi, i loro dati e le impostazioni dell'agente restano. Reinstallando l'agente vengono ripresi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービス、そのデータ、エージェントの設定は残ります。エージェントを再インストールすると引き継がれます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
