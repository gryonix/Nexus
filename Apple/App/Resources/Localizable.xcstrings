          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версия %@. Автоматичните обновявания не са настроени в тази версия — тя не носи източник за обновяване или ключ за подписване."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versiunea %@. Actualizările automate nu sunt configurate în acest build — nu poartă nicio sursă de actualizare sau cheie de semnare."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %@. Automatiske opdateringer er ikke sat op i denne udgave — den indeholder ingen opdateringskilde eller signeringsnøgle."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
