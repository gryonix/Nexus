        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたレポートはまだありません。このデバイスからインストールすると自動的に記録されます。インストールを再実行してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённого отчёта пока нет. Он записывается автоматически при установке с этого устройства — перезапустите установку, чтобы он появился."
