    "Address of the local server on your network (the app must be on the same network). It is used only during installation — afterwards the dashboard reaches this machine through the WireGuard tunnel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresse des lokalen Servers in Ihrem Netzwerk (die App muss sich im selben Netzwerk befinden). Sie wird nur während der Installation verwendet — danach erreicht das Panel diese Maschine über den WireGuard-Tunnel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dirección del servidor local en su red (la aplicación debe estar en la misma red). Solo se usa durante la instalación — después, el panel se conecta a esta máquina a través del túnel WireGuard."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresse du serveur local sur votre réseau (l'application doit être sur le même réseau). Elle n'est utilisée que pendant l'installation — ensuite, le panneau atteint cette machine via le tunnel WireGuard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indirizzo del server locale nella vostra rete (l'app deve trovarsi nella stessa rete). Viene usato solo durante l'installazione — in seguito il pannello raggiunge questa macchina attraverso il tunnel WireGuard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク上のローカルサーバーのアドレスです (アプリが同じネットワークにある必要があります)。インストール中にのみ使用され、その後パネルは WireGuard トンネル経由でこのマシンに接続します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адрес локального сервера в вашей сети (устройство с приложением должно быть в той же сети). Он используется только во время установки — затем панель управления подключается к этой машине через туннель WireGuard."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адреса локального сервера у вашій мережі (пристрій із застосунком має бути в тій самій мережі). Вона використовується лише під час встановлення — далі панель керування підключається до цієї машини через тунель WireGuard."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地服务器在网络中的地址（应用需处于同一网络）。仅在安装期间使用 — 之后面板将通过 WireGuard 隧道连接这台机器。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kotipalvelimen osoite verkossasi (sovelluksen täytyy olla samassa verkossa). Sitä käytetään vain asennuksen aikana — sen jälkeen hallintapaneeli tavoittaa tämän koneen WireGuard-tunnelin kautta."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адрес на локалния сървър в мрежата ви (приложението трябва да е в същата мрежа). Използва се само по време на инсталацията — след това таблото достига тази машина през тунела на WireGuard."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresa lokalnog poslužitelja u vašoj mreži (aplikacija mora biti u istoj mreži). Koristi se samo tijekom instalacije — nakon toga nadzorna ploča doseže ovaj stroj kroz WireGuard tunel."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naslov lokalnega strežnika v vašem omrežju (aplikacija mora biti v istem omrežju). Uporablja se samo med namestitvijo — pozneje nadzorna plošča doseže ta stroj skozi predor WireGuard."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresse på den lokale server på dit netværk (appen skal være på samme netværk). Den bruges kun under installationen — bagefter når dashboardet denne maskine gennem WireGuard-tunnelen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adres van de lokale server op je netwerk (de app moet zich op hetzelfde netwerk bevinden). Dit wordt alleen tijdens de installatie gebruikt — daarna bereikt het dashboard deze machine via de WireGuard-tunnel."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adress till den lokala servern på ditt nätverk (appen måste vara på samma nätverk). Den används bara under installationen — därefter når instrumentpanelen den här maskinen genom WireGuard-tunneln."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A helyi szerver címe a hálózatodon (az alkalmazásnak ugyanazon a hálózaton kell lennie). Csak a telepítés alatt használatos — ezután a műszerfal a WireGuard-alagúton keresztül éri el ezt a gépet."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresa serverului local din rețeaua ta (aplicația trebuie să fie în aceeași rețea). Este folosită doar în timpul instalării — ulterior, panoul ajunge la această mașină prin tunelul WireGuard."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohaliku serveri aadress sinu võrgus (rakendus peab olema samas võrgus). Seda kasutatakse ainult installimise ajal — pärast seda jõuab juhtpaneel selle masinani WireGuard tunneli kaudu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endereço do servidor local na sua rede (a app tem de estar na mesma rede). É usado apenas durante a instalação — depois o painel alcança esta máquina através do túnel WireGuard."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seoladh an fhreastalaí áitiúil ar do líonra (caithfidh an aip a bheith ar an líonra céanna). Ní úsáidtear é ach le linn na suiteála — ina dhiaidh sin sroicheann an painéal an meaisín seo tríd an tollán WireGuard."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indirizz tas-server lokali fuq in-netwerk tiegħek (l-app trid tkun fuq l-istess netwerk). Jintuża biss waqt l-installazzjoni — wara l-pannell jilħaq din il-magna permezz tat-tunnel WireGuard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adres lokalnego serwera w Twojej sieci (aplikacja musi być w tej samej sieci). Jest używany tylko podczas instalacji — potem panel łączy się z tą maszyną przez tunel WireGuard."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresa lokálního serveru ve vaší síti (aplikace musí být ve stejné síti). Používá se pouze během instalace — poté se panel k tomuto stroji připojuje přes tunel WireGuard."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresa lokálneho servera vo vašej sieti (aplikácia musí byť v rovnakej sieti). Používa sa iba počas inštalácie — potom sa panel k tomuto stroju pripája cez tunel WireGuard."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vietējā servera adrese jūsu tīklā (lietotnei jāatrodas tajā pašā tīklā). Tā tiek izmantota tikai instalēšanas laikā — pēc tam panelis sasniedz šo datoru caur WireGuard tuneli."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vietinio serverio adresas jūsų tinkle (programa turi būti tame pačiame tinkle). Jis naudojamas tik diegimo metu — vėliau skydelis pasiekia šį kompiuterį per WireGuard tunelį."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διεύθυνση του τοπικού διακομιστή στο δίκτυό σας (η εφαρμογή πρέπει να βρίσκεται στο ίδιο δίκτυο). Χρησιμοποιείται μόνο κατά την εγκατάσταση — στη συνέχεια το dashboard προσεγγίζει αυτή τη μηχανή μέσω του tunnel WireGuard."
          }
        }
      }
    },
