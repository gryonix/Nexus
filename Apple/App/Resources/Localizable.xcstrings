          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устанавливается на сервере. Приложение можно закрыть — сервер продолжит сам, а этот экран потом подхватит установку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встановлюється на сервері. Застосунок можна закрити — сервер продовжить сам, а цей екран потім підхопить встановлення."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
