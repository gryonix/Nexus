    "Each service stops while its data is copied, then starts again. The old copy stays beside it as .before-cache." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всяка услуга спира, докато данните ѝ се копират, после стартира отново. Старото копие остава до нея като .before-cache."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá služba se zastaví, dokud se kopírují její data, pak se znovu spustí. Stará kopie zůstane vedle jako .before-cache."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver tjeneste stopper, mens dens data kopieres, og starter igen. Den gamle kopi bliver liggende som .before-cache."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Dienst stoppt, während seine Daten kopiert werden, und startet danach wieder. Die alte Kopie bleibt daneben als .before-cache."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε υπηρεσία σταματά όσο αντιγράφονται τα δεδομένα της και μετά ξεκινά ξανά. Το παλιό αντίγραφο μένει δίπλα ως .before-cache."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada servicio se detiene mientras se copian sus datos y luego vuelve a arrancar. La copia antigua queda al lado como .before-cache."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga teenus peatub andmete kopeerimise ajaks ja käivitub seejärel uuesti. Vana koopia jääb kõrvale nimega .before-cache."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen palvelu pysähtyy tietojen kopioinnin ajaksi ja käynnistyy sitten uudelleen. Vanha kopio jää viereen nimellä .before-cache."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque service s’arrête pendant la copie de ses données, puis redémarre. L’ancienne copie reste à côté sous le nom .before-cache."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopann gach seirbhís fad a chóipeáiltear a sonraí, ansin tosaíonn sí arís. Fanann an seanchóip in aice léi mar .before-cache."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaka usluga se zaustavlja dok se kopiraju njezini podaci, zatim se ponovno pokreće. Stara kopija ostaje pokraj kao .before-cache."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden szolgáltatás leáll, amíg az adatai másolódnak, majd újraindul. A régi másolat mellette marad .before-cache néven."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni servizio si ferma durante la copia dei suoi dati, poi riparte. La vecchia copia resta accanto come .before-cache."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各サービスはデータのコピー中に停止し、その後再起動します。古いコピーは .before-cache として隣に残ります。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiekviena paslauga sustoja, kol kopijuojami jos duomenys, tada vėl paleidžiama. Senoji kopija lieka šalia kaip .before-cache."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katrs pakalpojums apstājas, kamēr tiek kopēti tā dati, pēc tam atkal startē. Vecā kopija paliek blakus kā .before-cache."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kull servizz jieqaf waqt li d-dejta tiegħu tiġi kkupjata, imbagħad jerġa’ jibda. Il-kopja l-qadima tibqa’ ħdejh bħala .before-cache."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke dienst stopt terwijl zijn gegevens worden gekopieerd en start daarna opnieuw. De oude kopie blijft ernaast staan als .before-cache."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda usługa zatrzymuje się na czas kopiowania danych, potem startuje ponownie. Stara kopia zostaje obok jako .before-cache."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada serviço para enquanto os dados são copiados e depois volta a arrancar. A cópia antiga fica ao lado como .before-cache."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare serviciu se oprește cât timp i se copiază datele, apoi pornește din nou. Copia veche rămâne alături ca .before-cache."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый сервис останавливается, пока копируются его данные, потом запускается снова. Старая копия остаётся рядом как .before-cache."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá služba sa zastaví, kým sa kopírujú jej dáta, potom sa znova spustí. Stará kópia zostane vedľa ako .before-cache."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsaka storitev se ustavi, dokler se kopirajo njeni podatki, nato se znova zažene. Stara kopija ostane zraven kot .before-cache."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje tjänst stoppas medan dess data kopieras och startar sedan igen. Den gamla kopian ligger kvar bredvid som .before-cache."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен сервіс зупиняється, доки копіюються його дані, потім запускається знову. Стара копія лишається поруч як .before-cache."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个服务在复制其数据时停止，然后重新启动。旧副本以 .before-cache 保留在旁边。"
          }
        }
      }
    },
