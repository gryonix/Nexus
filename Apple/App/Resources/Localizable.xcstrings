    "The engine goes on the machine at home, where a graphics card can do the work; this server only relays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Engine läuft auf der Maschine zu Hause, wo eine Grafikkarte die Arbeit übernehmen kann; dieser Server leitet nur weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El motor va en la máquina de casa, donde una tarjeta gráfica puede hacer el trabajo; este servidor solo retransmite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le moteur tourne sur la machine à la maison, où une carte graphique peut faire le travail ; ce serveur ne fait que relayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il motore va sulla macchina di casa, dove una scheda grafica può fare il lavoro; questo server fa solo da relay."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンジンは自宅のマシンに置き、グラフィックカードに処理させます。このサーバーは中継するだけです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движок ставится на домашнюю машину, где работу может делать видеокарта; этот сервер только передаёт трафик."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рушій ставиться на домашню машину, де роботу може робити відеокарта; цей сервер лише передає трафік."
          }
        },
        "zh" : {
          "stringUnit" : {
