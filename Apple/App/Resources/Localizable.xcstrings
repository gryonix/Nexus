            "value" : "Teenuse teisaldamiseks on igal masinal vaja serveriagenti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelun siirtäminen vaatii palvelinagentin jokaiselle koneelle."
          }
        },
        "fr" : {
          "stringUnit" : {
