          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunelis apstājās pats bez kļūdas. iOS aptur tuneli, kas izmanto pārāk daudz atmiņas."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-mina waqfet waħedha mingħajr żball. L-iOS iwaqqaf mina li tuża wisq memorja."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tunnel stopte vanzelf, zonder fout. iOS beëindigt een tunnel die te veel geheugen gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunel zatrzymał się sam, bez błędu. iOS kończy tunel, który zużywa zbyt dużo pamięci."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
