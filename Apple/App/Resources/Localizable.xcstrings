    "Simple keeps wording friendly and flows guided. Advanced (Pro) shows technical terms and the full options." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einfach hält die Formulierungen verständlich und die Abläufe geführt. Erweitert (Pro) zeigt Fachbegriffe und alle Optionen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sencillo mantiene un lenguaje claro y flujos guiados. Avanzado (Pro) muestra términos técnicos y todas las opciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simple garde un langage accessible et des parcours guidés. Avancé (Pro) affiche les termes techniques et toutes les options."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semplice mantiene un linguaggio chiaro e flussi guidati. Avanzato (Pro) mostra termini tecnici e tutte le opzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シンプルは分かりやすい表現とガイド付きの操作を保ちます。詳細（Pro）は専門用語とすべてのオプションを表示します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычный сохраняет понятные формулировки и пошаговые сценарии. Продвинутый (Pro) показывает технические термины и все параметры."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звичайний зберігає зрозумілі формулювання та покрокові сценарії. Просунутий (Pro) показує технічні терміни та всі параметри."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "简单模式保持措辞友好、流程引导。高级（Pro）显示技术术语和全部选项。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksinkertainen pitää sanamuodon ystävällisenä ja kulut ohjattuina. Edistynyt (Pro) näyttää tekniset termit ja täydet valinnat."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опростеният режим пази езика дружелюбен, а стъпките — водени. Разширеният (Pro) показва техническите термини и всички опции."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simplu păstrează formulările prietenoase și fluxurile ghidate. Avansat (Pro) arată termenii tehnici și toate opțiunile."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Eenvoudig' houdt de bewoordingen vriendelijk en de stappen begeleid. 'Geavanceerd (Pro)' toont technische termen en alle opties."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Enkel\" holder formuleringen venlig og forløbet guidet. \"Avanceret (Pro)\" viser tekniske termer og alle indstillinger."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Enkel\" håller ordvalet vänligt och flödena guidade. \"Avancerad (Pro)\" visar tekniska termer och alla alternativ."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednostavno zadržava prijateljski jezik i vođene tijekove. Napredno (Pro) prikazuje tehničke izraze i sve opcije."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preprosto ohranja jezik prijazen in poteke vodene. Napredno (Pro) prikaže tehnične izraze in vse možnosti."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednoduché udržiava priateľské formulácie a vedené postupy. Pokročilé (Pro) zobrazuje technické termíny a všetky možnosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Egyszerű barátságos szóhasználatot és irányított folyamatokat tart. A Speciális (Pro) technikai kifejezéseket és a teljes lehetőségeket mutatja."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednoduché udržuje formulace přívětivé a postupy vedené. Pokročilé (Pro) zobrazuje technické termíny a všechny možnosti."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihtne hoiab sõnastuse sõbraliku ja käigud juhendatud. Täpsem (Pro) näitab tehnilisi termineid ja kõiki valikuid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb prosty utrzymuje przyjazne sformułowania i prowadzone przepływy. Zaawansowany (Pro) pokazuje terminy techniczne i pełne opcje."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Απλό διατηρεί τη διατύπωση φιλική και τις ροές καθοδηγούμενες. Το Προχωρημένο (Pro) εμφανίζει τεχνικούς όρους και όλες τις επιλογές."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simples mantém a linguagem amigável e os fluxos guiados. Avançado (Pro) mostra termos técnicos e todas as opções."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coinníonn Simplí an fhriotal cairdiúil agus na sreafaí treoraithe. Taispeánann Casta (Pro) téarmaí teicniúla agus na roghanna iomlána."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vienkāršais režīms saglabā draudzīgu formulējumu un vadītas plūsmas. Papildu (Pro) rāda tehniskos terminus un pilnas opcijas."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Paprasta“ palieka draugišką formuluotę ir vedamą eigą. „Išplėstinis (Pro)“ rodo techninius terminus ir visas parinktis."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempliċi żżomm il-kliem ta' ħbiberija u l-fluss iggwidat. Avvanzat (Pro) juri termini tekniċi u l-għażliet kollha."
          }
        }
      }
    },
