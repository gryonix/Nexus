          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpovedá verejne, presmerúva na druhý server"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atbild publiski, pārsūta uz otru serveri"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απαντά δημόσια, προωθεί στον άλλο διακομιστή"
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freagraíonn go poiblí, seolann ar aghaidh chuig an bhfreastalaí eile"
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iwieġeb pubblikament, jgħaddi lis-server l-ieħor"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atsako viešai, persiunčia į kitą serverį"
          }
        }
      }
    },
    "Any machine you can reach over SSH — nothing has to be installed on it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Maschine, die Sie über SSH erreichen — es muss nichts darauf installiert sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier máquina a la que llegue por SSH: no hace falta instalar nada en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’importe quelle machine accessible en SSH — rien n’a besoin d’y être installé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualsiasi macchina raggiungibile via SSH: non serve installarci nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH で到達できるマシンなら何でも。そのマシンに何かをインストールする必要はありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любая машина, до которой вы достаёте по SSH, — ставить на неё ничего не нужно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь-яка машина, до якої ви дістаєтеся по SSH, — установлювати на неї нічого не потрібно."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何可以通过 SSH 访问的机器——无需在其上安装任何东西。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikä tahansa kone, jonka tavoitat SSH:n yli — sille ei tarvitse asentaa mitään."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всяка машина, до която можете да достигнете през SSH — не е нужно нищо да е инсталирано на нея."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilo koji stroj koji možete dosegnuti preko SSH-a — na njemu ništa ne mora biti instalirano."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kateri koli stroj, ki ga lahko dosežete prek SSH — nanj ni treba ničesar namestiti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhver maskine, du kan nå via SSH — der skal ikke installeres noget på den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke machine die je via SSH kunt bereiken — er hoeft niets op geïnstalleerd te zijn."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilken maskin som helst du kan nå via SSH — inget behöver installeras på den."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bármely gép, amelyet SSH-n keresztül elérsz — semmit sem kell telepíteni rá."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orice mașină pe care o poți accesa prin SSH — nu trebuie instalat nimic pe ea."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suvaline masin, mida saad SSH kaudu ühendada — sellele ei pea midagi installima."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer máquina a que consiga aceder por SSH — não é preciso instalar nada nela."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dowolna maszyna, do której masz dostęp przez SSH — nic nie musi być na niej zainstalowane."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakýkoli stroj, na který se dostanete přes SSH — nic na něm nemusí být nainstalováno."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akýkoľvek stroj, na ktorý sa dostanete cez SSH — nič na ňom nemusí byť nainštalované."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jebkurš dators, ko varat sasniegt caur SSH — uz tā nekas nav jāinstalē."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οποιαδήποτε μηχανή μπορείτε να προσεγγίσετε μέσω SSH — δεν χρειάζεται να είναι εγκατεστημένο τίποτα σε αυτήν."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aon mheaisín ar féidir leat teacht air thar SSH — ní gá aon rud a shuiteáil air."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwalunkwe magna li tista' tilħaq permezz ta' SSH — ma jkun hemm bżonn xejn installat fuqha."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bet kuri mašina, kurią galite pasiekti per SSH — joje nieko diegti nereikia."
          }
        }
      }
    },
