    "Or run the script yourself on the server — open it to copy or share the file." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder führen Sie das Skript selbst auf dem Server aus — öffnen Sie es, um es zu kopieren oder die Datei zu teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or run the script yourself on the server — open it to copy or share the file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ejecuta el script tú mismo en el servidor: ábrelo para copiarlo o compartir el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou exécutez le script vous-même sur le serveur — ouvrez-le pour le copier ou partager le fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure esegui lo script tu stesso sul server: aprilo per copiarlo o condividere il file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "または、サーバー上でスクリプトを自分で実行します。開いてコピーするか、ファイルを共有してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или запустите скрипт на сервере сами — откройте его, чтобы скопировать или поделиться файлом."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Або запустіть скрипт на сервері самі — відкрийте його, щоб скопіювати або поділитися файлом."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者你也可以自己在服务器上运行脚本 — 打开它即可复制或分享文件。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai aja skripti itse palvelimella — avaa se kopioidaksesi tai jakaaksesi tiedoston."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или изпълнете скрипта сами на сървъра — отворете го, за да копирате или споделите файла."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of voer het script zelf op de server uit — open het om het bestand te kopiëren of te delen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller kør scriptet selv på serveren — åbn det for at kopiere eller dele filen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller kör skriptet själv på servern — öppna det för att kopiera eller dela filen."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau rulează tu însuți scriptul pe server — deschide-l pentru a copia sau partaja fișierul."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ili sami izvršite skriptu na poslužitelju — otvorite je za kopiranje ili dijeljenje datoteke."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali sami zaženite skripto na strežniku — odprite jo za kopiranje ali deljenje datoteke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vagy futtasd magad a szkriptet a szerveren — nyisd meg a fájl másolásához vagy megosztásához."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alebo spustite skript na serveri sami — otvorte ho, aby ste súbor skopírovali alebo zdieľali."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebo spusťte skript sami na serveru — otevřete ho, abyste soubor zkopírovali nebo sdíleli."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Või käivita skript ise serveris — ava see faili kopeerimiseks või jagamiseks."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ή εκτελέστε οι ίδιοι το σενάριο στον διακομιστή — ανοίξτε το για αντιγραφή ή κοινή χρήση του αρχείου."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albo uruchom skrypt samodzielnie na serwerze — otwórz go, aby skopiować lub udostępnić plik."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou execute o script você mesmo no servidor — abra-o para copiar ou partilhar o ficheiro."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai palaidiet skriptu pats serverī — atveriet to, lai kopētu vai kopīgotu failu."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
