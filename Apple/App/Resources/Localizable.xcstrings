    "Nothing to connect to yet. Add a connection to reach any machine over SSH." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts zum Verbinden. Fügen Sie eine Verbindung hinzu, um über SSH auf eine beliebige Maschine zuzugreifen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay nada a lo que conectarse. Añada una conexión para llegar a cualquier máquina por SSH."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à quoi se connecter pour l’instant. Ajoutez une connexion pour atteindre n’importe quelle machine en SSH."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
