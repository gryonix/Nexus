    "Checks every block for damage. Needs more memory; on Debian the ZFS module is built first, which takes a while." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверява всеки блок за повреди. Нужна е повече памет; в Debian първо се компилира модулът на ZFS, което отнема време."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroluje každý blok na poškození. Potřebuje víc paměti; na Debianu se nejprve sestaví modul ZFS, což chvíli trvá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjekker hver blok for skader. Kræver mere hukommelse; på Debian bygges ZFS-modulet først, hvilket tager lidt tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft jeden Block auf Schäden. Braucht mehr Arbeitsspeicher; unter Debian wird das ZFS-Modul zuerst gebaut, das dauert eine Weile."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγχει κάθε μπλοκ για φθορές. Χρειάζεται περισσότερη μνήμη· στο Debian πρώτα μεταγλωττίζεται η μονάδα ZFS, κάτι που παίρνει χρόνο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba cada bloque en busca de daños. Necesita más memoria; en Debian primero se compila el módulo de ZFS, lo que tarda un rato."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollib iga plokki kahjustuste suhtes. Vajab rohkem mälu; Debianis ehitatakse esmalt ZFS-moodul, mis võtab aega."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkistaa jokaisen lohkon vaurioiden varalta. Tarvitsee enemmän muistia; Debianissa ZFS-moduuli käännetään ensin, mikä vie aikaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie chaque bloc contre les dommages. Demande plus de mémoire ; sous Debian, le module ZFS est d'abord compilé, ce qui prend un moment."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seiceálann sé gach bloc le haghaidh damáiste. Teastaíonn níos mó cuimhne; ar Debian tógtar modúl ZFS ar dtús, rud a thógann tamall."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjerava svaki blok na oštećenja. Treba više memorije; na Debianu se najprije gradi ZFS modul, što potraje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden blokkot ellenőriz sérülésre. Több memóriát igényel; Debianon előbb a ZFS-modul fordul le, ami eltart egy ideig."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla ogni blocco contro i danni. Richiede più memoria; su Debian il modulo ZFS viene prima compilato, il che richiede un po'."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのブロックの破損を検査します。メモリを多く使います。Debian では先に ZFS モジュールをビルドするため時間がかかります。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tikrina kiekvieną bloką dėl pažeidimų. Reikia daugiau atminties; Debian sistemoje pirmiausia sukompiliuojamas ZFS modulis, tai užtrunka."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārbauda katru bloku, vai nav bojājumu. Vajag vairāk atmiņas; Debian vispirms tiek būvēts ZFS modulis, tas aizņem laiku."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jiċċekkja kull blokk għal ħsara. Jeħtieġ aktar memorja; fuq Debian il-modulu ZFS jinbena l-ewwel, u dan jieħu ftit ħin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleert elk blok op schade. Vraagt meer geheugen; op Debian wordt eerst de ZFS-module gebouwd, wat even duurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdza każdy blok pod kątem uszkodzeń. Wymaga więcej pamięci; na Debianie najpierw budowany jest moduł ZFS, co chwilę trwa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica cada bloco quanto a danos. Precisa de mais memória; no Debian o módulo ZFS é compilado primeiro, o que demora um pouco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifică fiecare bloc pentru deteriorări. Are nevoie de mai multă memorie; pe Debian modulul ZFS se compilează întâi, ceea ce durează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяет каждый блок на повреждения. Нужно больше памяти; на Debian сначала собирается модуль ZFS — это занимает время."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroluje každý blok na poškodenie. Potrebuje viac pamäte; na Debiane sa najprv zostaví modul ZFS, čo chvíľu trvá."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preveri vsak blok za poškodbe. Potrebuje več pomnilnika; na Debianu se najprej zgradi modul ZFS, kar traja nekaj časa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollerar varje block efter skador. Kräver mer minne; på Debian byggs ZFS-modulen först, vilket tar en stund."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевіряє кожен блок на пошкодження. Потрібно більше пам'яті; на Debian спершу збирається модуль ZFS — це займає час."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查每个块是否损坏。需要更多内存；在 Debian 上会先编译 ZFS 模块，需要一些时间。"
          }
        }
      }
    },
    "Choose a whole region at once, or search for one country below." : {
      "localizations" : {
