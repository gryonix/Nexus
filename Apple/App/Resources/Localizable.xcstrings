        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μία έως τέσσερις διευθύνσεις IPv4 ή IPv6, χωρισμένες με κόμμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De una a cuatro direcciones IPv4 o IPv6, separadas por comas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üks kuni neli IPv4- või IPv6-aadressi, komadega eraldatud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdestä neljään IPv4- tai IPv6-osoitetta pilkuilla erotettuina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
