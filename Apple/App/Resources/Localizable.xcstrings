    "An SSD or NVMe here speeds up databases and caches. Nothing on a disk with files is erased." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSD или NVMe тук ускорява базите данни и кешовете. Нищо не се изтрива от диск с файлове."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSD nebo NVMe zde zrychlí databáze a mezipaměti. Z disku se soubory se nic nemaže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En SSD eller NVMe her gør databaser og cache hurtigere. Intet slettes på en disk med filer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine SSD oder NVMe beschleunigt hier Datenbanken und Caches. Auf einem Laufwerk mit Dateien wird nichts gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας SSD ή NVMe εδώ επιταχύνει βάσεις δεδομένων και cache. Δεν διαγράφεται τίποτα από δίσκο με αρχεία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un SSD o NVMe aquí acelera las bases de datos y cachés. No se borra nada de un disco con archivos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSD või NVMe kiirendab siin andmebaase ja vahemälu. Failidega kettalt ei kustutata midagi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSD tai NVMe nopeuttaa tässä tietokantoja ja välimuisteja. Levyltä, jolla on tiedostoja, ei poisteta mitään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un SSD ou NVMe ici accélère les bases de données et les caches. Rien n'est effacé sur un disque qui contient des fichiers."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuireann SSD nó NVMe anseo dlús le bunachair shonraí agus taisí. Ní scriostar aon rud ó dhiosca a bhfuil comhaid air."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSD ili NVMe ovdje ubrzava baze podataka i predmemorije. S diska s datotekama ništa se ne briše."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy SSD vagy NVMe itt gyorsítja az adatbázisokat és gyorsítótárakat. Fájlokat tartalmazó lemezről semmi sem törlődik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un SSD o NVMe qui velocizza database e cache. Su un disco con file non viene cancellato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで SSD や NVMe を選ぶとデータベースとキャッシュが速くなります。ファイルのあるディスクは何も消去されません。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSD ar NVMe čia pagreitina duomenų bazes ir podėlius. Iš disko su failais niekas netrinama."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSD vai NVMe šeit paātrina datubāzes un kešatmiņu. No diska ar failiem nekas netiek dzēsts."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSD jew NVMe hawn tħaffef id-databases u l-caches. Xejn ma jitħassar minn diska b'fajls."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een SSD of NVMe versnelt hier databases en caches. Op een schijf met bestanden wordt niets gewist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSD lub NVMe przyspiesza tu bazy danych i pamięci podręczne. Z dysku z plikami nic nie jest usuwane."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um SSD ou NVMe aqui acelera bases de dados e caches. Nada é apagado num disco com ficheiros."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un SSD sau NVMe aici accelerează bazele de date și cache-urile. Nimic nu se șterge de pe un disc cu fișiere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSD или NVMe здесь ускоряет базы данных и кеши. С диска, где уже есть файлы, ничего не стирается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSD alebo NVMe tu zrýchli databázy a vyrovnávacie pamäte. Z disku so súbormi sa nič nemaže."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSD ali NVMe tu pospeši podatkovne zbirke in predpomnilnike. Z diska z datotekami se nič ne izbriše."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En SSD eller NVMe här snabbar upp databaser och cache. Inget raderas på en disk med filer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSD або NVMe тут пришвидшує бази даних і кеші. З диска, де вже є файли, нічого не стирається."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此使用 SSD 或 NVMe 可加快数据库和缓存。含有文件的磁盘不会被清除任何内容。"
          }
        }
      }
    },
    "An account with no key of its own cannot be closed: turning passwords off around it would leave nobody a way in, and the server refuses to do it. Add a key to that account first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Konto ohne eigenen Schlüssel kann nicht geschlossen werden: Passwörter darum herum abzuschalten ließe niemandem einen Weg hinein, und der Server verweigert das. Legen Sie zuerst einen Schlüssel auf dieses Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cuenta sin clave propia no se puede cerrar: desactivar las contraseñas a su alrededor no dejaría a nadie una forma de entrar, y el servidor se niega a hacerlo. Añada primero una clave a esa cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compte sans clé à lui ne peut pas être fermé : désactiver les mots de passe autour de lui ne laisserait à personne un moyen d'entrer, et le serveur le refuse. Ajoutez d'abord une clé à ce compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un account senza una chiave propria non può essere chiuso: disattivare le password attorno ad esso non lascerebbe a nessuno un modo per entrare, e il server si rifiuta. Aggiungi prima una chiave a quell'account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の鍵を持たないアカウントは閉じられません。その周りでパスワードを切ると誰も入れなくなるため、サーバーが拒否します。先にそのアカウントへ鍵を追加してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учётную запись без собственного ключа закрыть нельзя: отключение паролей вокруг неё не оставит никому входа, и сервер это откажется делать. Сначала добавьте ключ на эту учётную запись."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обліковий запис без власного ключа закрити не можна: вимкнення паролів навколо нього не залишить нікому входу, і сервер це відмовиться робити. Спершу додайте ключ на цей обліковий запис."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有自己密钥的账户无法关闭：在它周围关掉密码会让任何人都无法进入，服务器会拒绝。请先为该账户添加密钥。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiliä ilman omaa avainta ei voi sulkea: salasanojen sulkeminen sen ympäriltä jättäisi kenenkään ilman pääsyä, joten palvelin kieltäytyy tekemästä sitä. Lisää tilille ensin avain."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акаунт без собствен ключ не може да бъде затворен: изключването на паролите около него би оставило никого без начин за вход, а сървърът отказва да го направи. Първо добавете ключ към този акаунт."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Račun bez vlastitog ključa ne može se zatvoriti: isključivanje lozinki oko njega ne bi ostavilo nikome način ulaska, pa poslužitelj to odbija učiniti. Prvo dodajte ključ tom računu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Računa brez lastnega ključa ni mogoče zapreti: izklop gesel okoli njega ne bi nikomur pustil načina za vstop, zato strežnik tega noče narediti. Najprej dodajte ključ temu računu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En konto uden sin egen nøgle kan ikke lukkes: at slå adgangskoder fra omkring den ville ikke give nogen en vej ind, og serveren nægter at gøre det. Tilføj først en nøgle til den konto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een account zonder eigen sleutel kan niet worden gesloten: wachtwoorden eromheen uitschakelen zou niemand nog een ingang laten, en de server weigert dit te doen. Voeg eerst een sleutel aan dat account toe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett konto utan egen nyckel kan inte stängas: att stänga av lösenord runt det skulle inte lämna någon väg in, och servern vägrar göra det. Lägg till en nyckel i kontot först."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontot ilma oma võtmeta ei saa sulgeda: paroolide väljalülitamine selle ümber jätaks kellegi ilma sissepääsuta, ja server keeldub seda tegemast. Lisa kontole kõigepealt võti."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní féidir cuntas gan eochair féin a dhúnadh: dá gcuirfí focail fhaire as feidhm ina thimpeall ní bheadh aon bhealach isteach ag aon duine, agus diúltaíonn an freastalaí é a dhéanamh. Cuir eochair leis an gcuntas sin ar dtús."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kont mingħajr ċavetta tiegħu stess ma jistax jingħalaq: jekk titfi l-passwords madwaru ħadd ma jibqagħlu triq ġewwa, u s-server jirrifjuta li jagħmilha. L-ewwel żid ċavetta ma' dak il-kont."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma conta sem chave própria não pode ser fechada: desativar as palavras-passe à sua volta não deixaria ninguém entrar, e o servidor recusa-se a fazê-lo. Adicione primeiro uma chave a essa conta."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας λογαριασμός χωρίς δικό του κλειδί δεν μπορεί να κλειδωθεί: η απενεργοποίηση των κωδικών γύρω του δεν θα άφηνε σε κανέναν τρόπο εισόδου, και ο διακομιστής αρνείται να το κάνει. Πρόσθεσε πρώτα ένα κλειδί σε αυτόν τον λογαριασμό."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy saját kulcs nélküli fiókot nem lehet lezárni: a jelszavak kikapcsolása körülötte senkinek nem hagyna bejutási lehetőséget, és a szerver megtagadja ezt. Adj hozzá először egy kulcsot ehhez a fiókhoz."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cont fără cheie proprie nu poate fi închis: dezactivarea parolelor în jurul lui ar lăsa pe nimeni cu acces, iar serverul refuză să facă asta. Adaugă mai întâi o cheie contului respectiv."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konta bez własnego klucza nie można zamknąć: wyłączenie haseł przy nim odcięłoby wszystkim dostęp, więc serwer odmawia. Najpierw dodaj klucz do tego konta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účet bez vlastního klíče nelze uzavřít: vypnutí hesel by u něj nikomu nezanechalo cestu dovnitř, takže to server odmítá. Nejdřív k tomuto účtu přidejte klíč."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účet bez vlastného kľúča nemožno uzavrieť: vypnutie hesiel okolo neho by nikomu nenechalo cestu dnu, takže to server odmieta. Najprv k tomuto účtu pridajte kľúč."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontu bez savas atslēgas nevar slēgt: paroļu izslēgšana tam apkārt neatstātu nevienam ieejas iespēju, un serveris to atsakās darīt. Vispirms pievienojiet šim kontam atslēgu."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paskyros be savo rakto negalima uždaryti: išjungus slaptažodžius aplink ją niekas neturėtų kaip prisijungti, todėl serveris tai atsisako daryti. Pirmiausia pridėkite tai paskyrai raktą."
          }
        }
      }
    },
