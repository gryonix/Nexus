    "%@ is removed from the server's paired-device list. This does NOT revoke its SSH access — its key keeps working until it is removed from the server separately." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird aus der Liste der gekoppelten Geräte des Servers entfernt. Das widerruft NICHT den SSH-Zugriff — der Schlüssel funktioniert weiter, bis er separat vom Server entfernt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se quita de la lista de dispositivos emparejados del servidor. Esto NO revoca su acceso SSH — su clave sigue funcionando hasta que se elimine del servidor por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est retiré de la liste des appareils associés du serveur. Cela ne révoque PAS son accès SSH — sa clé continue de fonctionner jusqu'à ce qu'elle soit supprimée du serveur séparément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ viene rimosso dall'elenco dei dispositivi associati al server. Questo NON revoca il suo accesso SSH — la sua chiave continua a funzionare finché non viene rimossa dal server separatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はサーバーのペアリング済みデバイス一覧から削除されます。これによって SSH アクセスが取り消されるわけではありません — 鍵はサーバー側で別途削除されるまで有効なままです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ убирается из списка сопряжённых устройств сервера. Это НЕ отзывает его SSH-доступ — ключ продолжает работать, пока его не удалят с сервера отдельно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ прибирається зі списку спарених пристроїв сервера. Це НЕ відкликає його SSH-доступ — ключ і далі працює, поки його окремо не видалять із сервера."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将从服务器的已配对设备列表中移除。这并不会撤销其 SSH 访问权限 — 其密钥在从服务器单独移除之前将持续有效。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ poistetaan palvelimen pariutettujen laitteiden listalta. Tämä EI peruuta sen SSH-pääsyä — sen avain toimii yhä, kunnes se poistetaan palvelimelta erikseen."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ е премахнат от списъка с сдвоени устройства на сървъра. Това НЕ отменя SSH достъпа му — ключът му продължава да работи, докато не бъде премахнат отделно от сървъра."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je uklonjen s popisa uparenih uređaja poslužitelja. Ovo NE opoziva njegov SSH pristup — njegov ključ i dalje radi dok se zasebno ne ukloni s poslužitelja."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je odstranjen s seznama seznanjenih naprav strežnika. To NE prekliče njegovega dostopa SSH — njegov ključ deluje naprej, dokler ni ločeno odstranjen s strežnika."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fjernes fra serverens liste over parrede enheder. Dette tilbagekalder IKKE dens SSH-adgang — dens nøgle bliver ved med at virke, indtil den fjernes fra serveren separat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wordt verwijderd uit de lijst met gekoppelde apparaten van de server. Dit trekt de SSH-toegang NIET in — de sleutel blijft werken totdat deze afzonderlijk van de server wordt verwijderd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tas bort från serverns lista över parkopplade enheter. Detta återkallar INTE dess SSH-åtkomst — nyckeln fortsätter fungera tills den tas bort från servern separat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jest usuwane z listy sparowanych urządzeń serwera. To NIE odbiera mu dostępu SSH — jego klucz nadal działa, dopóki nie zostanie osobno usunięty z serwera."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se odebere ze seznamu spárovaných zařízení serveru. Tím se NEODEBÍRÁ přístup SSH — jeho klíč funguje dál, dokud není ze serveru odebrán zvlášť."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sa odstráni zo zoznamu spárovaných zariadení servera. Tým sa NEODOBERÁ prístup SSH — jeho kľúč funguje ďalej, kým nie je zo servera odstránený samostatne."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ αφαιρείται από τη λίστα συζευγμένων συσκευών του διακομιστή. Αυτό ΔΕΝ ανακαλεί την πρόσβαση SSH — το κλειδί του συνεχίζει να λειτουργεί μέχρι να αφαιρεθεί ξεχωριστά από τον διακομιστή."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ eltávolításra kerül a szerver párosított eszközeinek listájáról. Ez NEM vonja vissza az SSH-hozzáférését — a kulcsa tovább működik, amíg külön el nem távolítják a szerverről."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ este eliminat din lista de dispozitive asociate a serverului. Acest lucru NU revocă accesul SSH — cheia sa continuă să funcționeze până este eliminată separat de pe server."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é removido da lista de dispositivos emparelhados do servidor. Isto NÃO revoga o seu acesso SSH — a sua chave continua a funcionar até ser removida do servidor separadamente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ eemaldatakse serveri seotud seadmete nimekirjast. See EI tühista selle SSH-juurdepääsu — selle võti töötab edasi, kuni see eemaldatakse serverist eraldi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baintear %@ ó liosta gléasanna péireáilte an fhreastalaí. NÍ chúlghairtear rochtain SSH air seo — leanann a eochair ag obair go dtí go mbaintear ón bhfreastalaí ar leithligh í."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tneħħa mil-lista ta' apparati mqabbla tas-server. Dan MA jirrevokax l-aċċess SSH tiegħu — iċ-ċavetta tiegħu tibqa' taħdem sakemm titneħħa mis-server separatament."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiek noņemts no servera pārī savienoto ierīču saraksta. Tas NEATCEĻ tā SSH piekļuvi — tā atslēga turpina darboties, līdz tā tiek atsevišķi noņemta no servera."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pašalinamas iš serverio susietų įrenginių sąrašo. Tai NEATŠAUKIA jo SSH prieigos — jo raktas toliau veiks, kol jis nebus atskirai pašalintas iš serverio."
          }
        }
      }
    },
    "%@ is stopped and removed from the server. Its data and backups stay on disk." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird gestoppt und vom Server entfernt. Seine Daten und Backups bleiben auf der Festplatte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se detiene y se quita del servidor. Sus datos y copias de seguridad permanecen en el disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est arrêté et supprimé du serveur. Ses données et sauvegardes restent sur le disque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ viene arrestato e rimosso dal server. I suoi dati e backup restano sul disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は停止し、サーバーから削除されます。データとバックアップはディスクに残ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ останавливается и удаляется с сервера. Его данные и резервные копии остаются на диске."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ зупиняється та видаляється із сервера. Його дані та резервні копії залишаються на диску."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将被停止并从服务器中移除。其数据和备份仍保留在磁盘上。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pysäytetään ja poistetaan palvelimelta. Sen data ja varmuuskopiot jäävät levylle."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ е спрян и премахнат от сървъра. Данните и резервните копия остават на диска."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je zaustavljen i uklonjen s poslužitelja. Njegovi podaci i sigurnosne kopije ostaju na disku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je ustavljen in odstranjen s strežnika. Njegovi podatki in varnostne kopije ostanejo na disku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stoppes og fjernes fra serveren. Dens data og backups forbliver på disken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wordt gestopt en van de server verwijderd. De gegevens en back-ups blijven op schijf staan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stoppas och tas bort från servern. Dess data och säkerhetskopior finns kvar på disken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jest zatrzymywane i usuwane z serwera. Jego dane i kopie zapasowe pozostają na dysku."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se zastaví a odebere ze serveru. Jeho data a zálohy zůstávají na disku."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sa zastaví a odstráni zo servera. Jeho dáta a zálohy zostávajú na disku."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ σταματά και αφαιρείται από τον διακομιστή. Τα δεδομένα και τα αντίγραφα ασφαλείας του παραμένουν στον δίσκο."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ leáll és eltávolításra kerül a szerverről. Az adatai és a biztonsági mentései a lemezen maradnak."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ este oprit și eliminat de pe server. Datele și copiile de rezervă rămân pe disc."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é parado e removido do servidor. Os seus dados e cópias de segurança permanecem no disco."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ peatatakse ja eemaldatakse serverist. Selle andmed ja varukoopiad jäävad kettale."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá %@ stoptha agus bainte ón bhfreastalaí. Fanann a chuid sonraí agus cúltacaí ar an diosca."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ waqaf u tneħħa mis-server. Id-data u l-backups tiegħu jibqgħu fuq id-disk."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiek apturēts un noņemts no servera. Tā dati un dublējumi paliek diskā."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sustabdomas ir pašalinamas iš serverio. Jo duomenys ir atsarginės kopijos lieka diske."
          }
        }
      }
    },
    "%@ leaves the mesh immediately. It can join again with a new key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verlässt das Mesh sofort. Es kann mit einem neuen Schlüssel wieder beitreten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sale de la malla de inmediato. Puede volver a unirse con una clave nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ quitte le maillage immédiatement. Il peut rejoindre avec une nouvelle clé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lascia subito la rete mesh. Può rientrare con una nuova chiave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はただちにメッシュから外れます。新しいキーで再参加できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ немедленно покидает mesh-сеть. Подключиться снова можно с новым ключом."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ негайно залишає mesh-мережу. Підключитися знову можна з новим ключем."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会立即离开网状网络。可用新密钥重新加入。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ poistuu verkosta heti. Se voi liittyä uudelleen uudella avaimella."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ напуска мрежата незабавно. Може да се присъедини отново с нов ключ."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ odmah napušta mrežu. Može se ponovno pridružiti s novim ključem."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ takoj zapusti omrežje. Znova se lahko pridruži z novim ključem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ forlader mesh'et med det samme. Den kan tilslutte sig igen med en ny nøgle."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verlaat het mesh onmiddellijk. Het kan opnieuw toetreden met een nieuwe sleutel."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lämnar meshet omedelbart. Den kan gå med igen med en ny nyckel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ natychmiast opuszcza sieć mesh. Może dołączyć ponownie z nowym kluczem."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ okamžitě opustí mesh síť. Může se znovu připojit s novým klíčem."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ okamžite opustí mesh sieť. Môže sa znova pripojiť s novým kľúčom."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ αποχωρεί από το mesh αμέσως. Μπορεί να συνδεθεί ξανά με νέο κλειδί."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ azonnal elhagyja a hálót (mesh). Új kulccsal újra csatlakozhat."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ părăsește mesh-ul imediat. Se poate alătura din nou cu o cheie nouă."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sai da malha imediatamente. Pode voltar a juntar-se com uma nova chave."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lahkub võrgustikust kohe. See saab uuesti liituda uue võtmega."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fágann %@ an mogalra láithreach. Is féidir leis a bheith páirteach arís le heochair nua."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jitlaq mill-mesh minnufih. Jista' jerġa' jingħaqad b'ċavetta ġdida."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nekavējoties pamet tīklu. Tas var pievienoties atkārtoti ar jaunu atslēgu."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nedelsiant palieka tinklą. Jis gali prisijungti iš naujo su nauju raktu."
          }
        }
      }
    },
