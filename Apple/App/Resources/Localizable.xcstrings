        }
      }
    },
    "Version %@. Automatic updates are not set up in this build — it carries no update source or signing key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %@. Automatische Updates sind in diesem Build nicht eingerichtet — es hat weder Update-Quelle noch Signaturschlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versión %@. Las actualizaciones automáticas no están configuradas en esta compilación: no tiene origen de actualizaciones ni clave de firma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %@. Les mises à jour automatiques ne sont pas configurées dans cette version : elle n’a ni source de mise à jour ni clé de signature."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versione %@. Gli aggiornamenti automatici non sono configurati in questa build: non ha né origine degli aggiornamenti né chiave di firma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バージョン %@。このビルドでは自動アップデートが設定されていません — 更新の取得元も署名鍵もありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версия %@. В этой сборке автообновление не настроено — в ней нет ни источника обновлений, ни ключа подписи."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версія %@. У цій збірці автооновлення не налаштоване — у ній немає ні джерела оновлень, ні ключа підпису."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
