    "One to four IPv4 or IPv6 addresses, separated by commas." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Един до четири IPv4 или IPv6 адреса, разделени със запетаи."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna až čtyři adresy IPv4 nebo IPv6 oddělené čárkami."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En til fire IPv4- eller IPv6-adresser adskilt af kommaer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine bis vier IPv4- oder IPv6-Adressen, durch Kommas getrennt."
