        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk zadržava svoje datoteke; na njemu se stvara mapa. Tamo idu baze podataka, predmemorije i podaci Dockera; fotografije, datoteke i mediji ostaju gdje jesu."
