    "Other servers are reached through this one. Remove them first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Server werden über diesen erreicht. Entferne zuerst jene."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otros servidores se alcanzan a través de este. Elimínalos primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’autres serveurs sont joints via celui-ci. Supprimez-les d’abord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altri server vengono raggiunti tramite questo. Rimuovili prima."
