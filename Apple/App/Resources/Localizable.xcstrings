          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna do četiri IPv4 ili IPv6 adrese odvojene zarezima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy–négy IPv4- vagy IPv6-cím, vesszővel elválasztva."
