    "Paints the app's buttons, switches and highlights. Delete and erase stay red whatever is chosen here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färbt die Schaltflächen, Schalter und Hervorhebungen der App. Löschen und Zurücksetzen bleiben rot, was hier auch gewählt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorea los botones, interruptores y resaltados de la app. Eliminar y borrar siguen en rojo, se elija lo que se elija aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colore les boutons, les interrupteurs et les surbrillances de l'app. Supprimer et effacer restent rouges quel que soit le choix ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colora i pulsanti, gli interruttori e le evidenziazioni dell'app. Elimina e cancella restano rossi qualunque cosa si scelga qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのボタン・スイッチ・ハイライトの色です。削除と消去は、ここで何を選んでも赤のままです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Красит кнопки, переключатели и выделения приложения. Удаление и стирание остаются красными, что бы здесь ни выбрали."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фарбує кнопки, перемикачі та виділення застосунку. Видалення та стирання залишаються червоними, хоч би що тут обрали."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为应用的按钮、开关和高亮着色。无论在此选择什么，删除和清除始终为红色。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maalaa sovelluksen painikkeet, kytkimet ja korostukset. Poista ja pyyhi pysyvät punaisina riippumatta täällä valitusta."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оцветява бутоните, превключвателите и акцентите на приложението. Изтриване и заличаване остават червени, каквото и да е избрано тук."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleurt de knoppen, schakelaars en accenten van de app. Verwijderen en wissen blijven rood, wat hier ook wordt gekozen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farver appens knapper, kontakter og fremhævninger. Slet og slet fuldstændigt forbliver røde, uanset hvad der vælges her."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färgar appens knappar, brytare och markeringar. Ta bort och radera förblir röda oavsett vad som väljs här."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vopsește butoanele, comutatoarele și evidențierile aplicației. Ștergere și distrugere rămân roșii indiferent ce este ales aici."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oboji gumbe, prekidače i isticanja aplikacije. Izbriši i izbriši sve ostaju crveni bez obzira što je ovdje odabrano."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobarva gumbe, stikala in poudarke aplikacije. Izbriši in izbriši vse ostaneta rdeča ne glede na to, kaj je izbrano tukaj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazás gombjait, kapcsolóit és kiemeléseit festi. A Törlés és a törlés mindig piros marad, bármit is választasz itt."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyfarbí tlačidlá, prepínače a zvýraznenia aplikácie. Odstrániť a vymazať zostávajú červené bez ohľadu na to, čo je tu vybrané."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obarví tlačítka, přepínače a zvýraznění aplikace. Smazat a vymazat zůstávají červené bez ohledu na to, co je zde vybráno."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värvib rakenduse nupud, lülitid ja esiletõstud. Kustuta ja kustuta jäävad punaseks, olenemata siin valitust."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάφει τα κουμπιά, τους διακόπτες και τις επισημάνσεις της εφαρμογής. Η διαγραφή και η εξάλειψη παραμένουν κόκκινες ανεξαρτήτως τι επιλέγεται εδώ."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koloruje przyciski, przełączniki i wyróżnienia aplikacji. Usuwanie i kasowanie zawsze pozostają czerwone, niezależnie od wyboru tutaj."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinta os botões, interruptores e realces da app. Eliminar e apagar mantêm-se a vermelho seja o que for escolhido aqui."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nosaka lietotnes pogu, slēdžu un izcēlumu krāsu. Dzēst un notīrīt vienmēr paliek sarkani, neatkarīgi no izvēles."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Péinteálann sé cnaipí, lasca agus aibhsithe na haipe. Fanann Scrios agus Glan dearg cibé rud a roghnaítear anseo."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jiżbogħ il-buttuni, l-swiċċijiet u l-enfażi tal-app. Ħassar u imħassar jibqgħu ħomor tkun xi tkun l-għażla hawn."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nudažo programėlės mygtukus, jungiklius ir paryškinimus. „Ištrinti“ ir „Sunaikinti“ lieka raudoni, kad ir kas čia pasirinkta."
          }
        }
      }
    },
