    "Nothing can be changed while the array is not healthy. Repair it first." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докато масивът не е изправен, нищо не може да се променя. Първо го поправи."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokud pole není v pořádku, nelze nic měnit. Nejdřív ho opravte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet kan ændres, mens arrayet ikke er sundt. Reparer det først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange das Array nicht gesund ist, lässt sich nichts ändern. Repariere es zuerst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τίποτα δεν αλλάζει όσο η συστοιχία δεν είναι υγιής. Επισκεύασέ τη πρώτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede cambiar nada mientras el conjunto no esté sano. Repáralo primero."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuni massiiv pole terve, ei saa midagi muuta. Paranda see kõigepealt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitään ei voi muuttaa, kun taulukko ei ole kunnossa. Korjaa se ensin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne peut être changé tant que l'ensemble n'est pas sain. Répare-le d'abord."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní féidir aon rud a athrú fad nach bhfuil an t-eagar sláintiúil. Deisigh é ar dtús."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dok polje nije ispravno, ništa se ne može mijenjati. Najprije ga popravite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amíg a tömb nem ép, semmi sem módosítható. Előbb javítsd meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non si può cambiare nulla finché l'array non è sano. Riparalo prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アレイが正常でない間は何も変更できません。先に修復してください。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kol masyvas netvarkingas, nieko keisti negalima. Pirmiausia jį pataisykite."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamēr masīvs nav vesels, neko nevar mainīt. Vispirms salabojiet to."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xejn ma jista' jinbidel sakemm l-array mhux f'saħħtu. Sewwih l-ewwel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zolang de array niet gezond is, kan er niets veranderen. Herstel hem eerst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopóki macierz nie jest sprawna, nic nie można zmienić. Najpierw ją napraw."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada pode ser alterado enquanto o conjunto não estiver são. Repara-o primeiro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu se poate schimba nimic cât timp matricea nu e sănătoasă. Repar-o întâi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока массив неисправен, ничего менять нельзя. Сначала почините его."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kým pole nie je v poriadku, nedá sa nič meniť. Najprv ho opravte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokler polje ni zdravo, ni mogoče ničesar spremeniti. Najprej ga popravite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget kan ändras medan arrayen inte är frisk. Reparera den först."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки масив несправний, нічого змінювати не можна. Спершу полагодьте його."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阵列不健康时无法做任何更改。请先修复。"
          }
        }
      }
    },
    "Nothing to move: no service here keeps a database or cache in its own folder." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма какво да се мести: никоя услуга тук не държи база данни или кеш в собствена папка."
          }
        },
        "cs" : {
          "stringUnit" : {
