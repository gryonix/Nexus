    "This machine has never had a USB serial adapter — there is nothing to pick yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An dieser Maschine war noch nie ein USB-Seriell-Adapter — es gibt noch nichts auszuwählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta máquina nunca ha tenido un adaptador serie USB: todavía no hay nada que elegir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette machine n'a jamais eu d'adaptateur série USB — il n'y a encore rien à choisir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa macchina non ha mai avuto un adattatore seriale USB: non c'è ancora nulla da scegliere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このマシンには USB シリアルアダプターが接続されたことがありません。まだ選べるものはありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
