        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλεγμένα αντίγραφα ασφαλείας: %lld. Θα διαγραφούν οριστικά από τον διακομιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copias de seguridad seleccionadas: %lld. Se eliminarán de forma permanente del servidor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitud varukoopiad: %lld. Need kustutatakse serverist jäädavalt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitut varmuuskopiot: %lld. Ne poistetaan palvelimelta pysyvästi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegardes sélectionnées : %lld. Elles seront supprimées définitivement du serveur."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cúltacaí roghnaithe: %lld. Scriosfar go buan ón bhfreastalaí iad."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
