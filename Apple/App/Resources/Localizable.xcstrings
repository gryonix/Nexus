    "Use it if the server's Reality key was shown to someone. A new key pair is made on the server; the old one stops working." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако някой е видял ключа Reality на сървъра. На сървъра се създава нова двойка ключове; старата спира да работи."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použijte, pokud někdo viděl klíč Reality serveru. Na serveru vznikne nový pár klíčů; starý přestane fungovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug det, hvis nogen har set serverens Reality-nøgle. Der laves et nyt nøglepar på serveren; det gamle holder op med at virke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn jemand den Reality-Schlüssel des Servers gesehen hat. Auf dem Server entsteht ein neues Schlüsselpaar; das alte gilt nicht mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν κάποιος είδε το κλειδί Reality του διακομιστή. Δημιουργείται νέο ζεύγος κλειδιών στον διακομιστή· το παλιό παύει να λειτουργεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use it if the server's Reality key was shown to someone. A new key pair is made on the server; the old one stops working."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsalo si alguien vio la clave Reality del servidor. Se crea un nuevo par de claves en el servidor; el anterior deja de funcionar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasuta, kui keegi nägi serveri Reality võtit. Serveris luuakse uus võtmepaar; vana lakkab töötamast."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä, jos joku on nähnyt palvelimen Reality-avaimen. Palvelimelle luodaan uusi avainpari; vanha lakkaa toimimasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si quelqu’un a vu la clé Reality du serveur. Une nouvelle paire de clés est créée sur le serveur ; l’ancienne ne fonctionne plus."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsáid é má chonaic duine éigin eochair Reality an fhreastalaí. Cruthaítear péire eochracha nua ar an bhfreastalaí; stopann an seanphéire."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upotrijebite ako je netko vidio Reality ključ poslužitelja. Na poslužitelju nastaje novi par ključeva; stari prestaje raditi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akkor használd, ha valaki látta a szerver Reality-kulcsát. A szerveren új kulcspár készül; a régi nem működik tovább."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usalo se qualcuno ha visto la chiave Reality del server. Sul server nasce una nuova coppia di chiavi; quella vecchia smette di funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーの Reality キーが他人に見られた場合に使います。サーバーで新しいキーペアが作られ、古いものは使えなくなります。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naudokite, jei kas nors matė serverio Reality raktą. Serveryje sukuriama nauja raktų pora; senoji nebeveikia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izmanto, ja kāds redzēja servera Reality atslēgu. Serverī tiek izveidots jauns atslēgu pāris; vecais vairs nedarbojas."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użaha jekk xi ħadd ra ċ-ċavetta Reality tas-server. Jinħoloq par ġdid ta’ ċwievet fuq is-server; il-qadim ma jibqax jaħdem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik dit als iemand de Reality-sleutel van de server heeft gezien. Er komt een nieuw sleutelpaar op de server; het oude werkt niet meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj, jeśli ktoś widział klucz Reality serwera. Na serwerze powstaje nowa para kluczy; stara przestaje działać."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use se alguém viu a chave Reality do servidor. É criado um novo par de chaves no servidor; o antigo deixa de funcionar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește dacă cineva a văzut cheia Reality a serverului. Pe server se creează o nouă pereche de chei; cea veche nu mai funcționează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно, если ключ Reality сервера кто-то увидел. На сервере создаётся новая пара ключей, старая перестаёт работать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použite, ak niekto videl kľúč Reality servera. Na serveri vznikne nový pár kľúčov; starý prestane fungovať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporabite, če je kdo videl ključ Reality strežnika. Na strežniku nastane nov par ključev; stari preneha delovati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd om någon har sett serverns Reality-nyckel. Ett nytt nyckelpar skapas på servern; det gamla slutar fungera."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потрібно, якщо ключ Reality сервера хтось побачив. На сервері створюється нова пара ключів, стара перестає працювати."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果服务器的 Reality 密钥被他人看到，请使用此项。服务器会生成新的密钥对，旧的将失效。"
          }
        }
      }
    },
