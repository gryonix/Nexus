    "Valid until %@. It is shown only now — the server does not hand it back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gültig bis %@. Er wird nur jetzt angezeigt — der Server gibt ihn nicht erneut heraus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válida hasta %@. Solo se muestra ahora: el servidor no la vuelve a entregar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valable jusqu’au %@. Elle n’est affichée que maintenant — le serveur ne la redonne pas."
          }
        },
        "it" : {
          "stringUnit" : {
