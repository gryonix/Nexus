    "The server is applying the change. Tapping again now would undo it." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сървърът прилага промяната. Ново докосване сега би я отменило."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server změnu právě používá. Další klepnutí by ji teď vrátilo zpět."
