          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá an cúltaca seo %@ — tá uaslódálacha ón ngléas teoranta go %@. Athchóirigh é ón liosta ar an bhfreastalaí ina ionad sin."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ši atsarginė kopija yra %@ — įkėlimai iš įrenginio riboti iki %@. Verčiau atkurkite ją iš sąrašo serveryje."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dan il-backup huwa %@ — it-tlugħ mill-apparat huwa limitat għal %@. Irrestawrah mil-lista fuq is-server minflok."
          }
        }
      }
    },
