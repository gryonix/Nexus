    "Turn this device's tunnel on or off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Tunnel dieses Geräts ein- oder ausschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa o desactiva el túnel de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer ou désactiver le tunnel de cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva o disattiva il tunnel di questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末のトンネルをオン／オフします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить или выключить туннель этого устройства."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкнути або вимкнути тунель цього пристрою."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开或关闭本设备的隧道。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kytkee tämän laitteen tunnelin päälle tai pois."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включи или изключи тунела на това устройство."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uključi ili isključi tunel ovog uređaja."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vklopi ali izklopi predor te naprave."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet de tunnel van dit apparaat aan of uit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tænd eller sluk denne enheds tunnel."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på eller av den här enhetens tunnel."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa ou desativa o túnel deste dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pornește sau oprește tunelul acestui dispozitiv."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz lub wyłącz tunel tego urządzenia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte nebo vypněte tunel tohoto zařízení."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnite alebo vypnite tunel tohto zariadenia."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lülita selle seadme tunnel sisse või välja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennek az eszköznek az alagútját be- vagy kikapcsolja."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieslēgt vai izslēgt šīs ierīces tuneli."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποίηση ή απενεργοποίηση του tunnel αυτής της συσκευής."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įjunkite arba išjunkite šio įrenginio tunelį."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cas tollán an ghléis seo ar nó as."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ixgħel jew itfi t-tunnel ta' dan l-apparat."
          }
        }
      }
    },
