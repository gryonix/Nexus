            "value" : "Kõik selle serveri varukoopiad kustutatakse jäädavalt. Elusandmed säilivad. Seda ei saa tagasi võtta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as cópias de segurança neste servidor são eliminadas permanentemente. Os dados em produção são mantidos. Isto não pode ser desfeito."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
