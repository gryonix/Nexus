    "Subscribe to this topic in the ntfy app. Anyone who knows the topic can read it, so keep it random." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Абонирайте се за тази тема в приложението ntfy. Всеки, който знае темата, може да я чете, затова я оставете случайна."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlaste se k odběru tohoto tématu v aplikaci ntfy. Kdo téma zná, může ho číst, proto ho nechte náhodné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnér på dette emne i ntfy-appen. Alle, der kender emnet, kan læse det, så lad det være tilfældigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonniere dieses Thema in der ntfy-App. Wer das Thema kennt, kann mitlesen – lass es also zufällig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εγγραφείτε σε αυτό το θέμα στην εφαρμογή ntfy. Όποιος γνωρίζει το θέμα μπορεί να το διαβάσει, γι' αυτό κρατήστε το τυχαίο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suscríbete a este tema en la app ntfy. Quien conozca el tema puede leerlo, así que déjalo aleatorio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telli see teema ntfy rakenduses. Teemat teadja saab seda lugeda, seega hoia see juhuslik."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilaa tämä aihe ntfy-sovelluksessa. Kuka tahansa aiheen tietävä voi lukea sen, joten pidä se satunnaisena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnez-vous à ce sujet dans l'app ntfy. Quiconque connaît le sujet peut le lire : gardez-le aléatoire."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liostáil leis an topaic seo in aip ntfy. Is féidir le duine ar bith a bhfuil an topaic ar eolas aige í a léamh, mar sin coinnigh randamach í."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretplatite se na ovu temu u aplikaciji ntfy. Svatko tko zna temu može je čitati, pa neka ostane nasumična."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iratkozz fel erre a témára az ntfy alkalmazásban. Aki ismeri a témát, olvashatja, ezért maradjon véletlenszerű."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iscriviti a questo argomento nell'app ntfy. Chi conosce l'argomento può leggerlo, quindi lascialo casuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ntfy アプリでこのトピックを購読してください。トピックを知っている人は誰でも読めるので、ランダムなままにしてください。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Užsiprenumeruokite šią temą ntfy programėlėje. Ją gali skaityti visi, kas žino temą, todėl palikite ją atsitiktinę."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonējiet šo tēmu lietotnē ntfy. To var lasīt ikviens, kas zina tēmu, tāpēc atstājiet to nejaušu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbona għal dan is-suġġett fl-app ntfy. Kull min jaf is-suġġett jista' jaqrah, għalhekk żommu każwali."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonneer je in de ntfy-app op dit onderwerp. Iedereen die het onderwerp kent, kan het lezen, dus houd het willekeurig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasubskrybuj ten temat w aplikacji ntfy. Każdy, kto zna temat, może go czytać, więc zostaw go losowym."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscreva este tópico na app ntfy. Qualquer pessoa que conheça o tópico pode lê-lo, por isso mantenha-o aleatório."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonează-te la acest subiect în aplicația ntfy. Oricine cunoaște subiectul îl poate citi, așa că păstrează-l aleatoriu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпишитесь на эту тему в приложении ntfy. Прочитать её может любой, кто знает тему, поэтому оставьте её случайной."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prihláste sa na odber tejto témy v aplikácii ntfy. Kto tému pozná, môže ju čítať, preto ju nechajte náhodnú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naročite se na to temo v aplikaciji ntfy. Kdor pozna temo, jo lahko bere, zato naj ostane naključna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenumerera på det här ämnet i ntfy-appen. Alla som känner till ämnet kan läsa det, så håll det slumpmässigt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підпишіться на цю тему в застосунку ntfy. Прочитати її може будь-хто, хто знає тему, тож залиште її випадковою."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 ntfy 应用中订阅此主题。任何知道主题的人都能读取，所以请保持随机。"
          }
        }
      }
    },
