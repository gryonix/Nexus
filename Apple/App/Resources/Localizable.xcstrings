        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direktan pristup disku je odbijen ovdje, pa brojevi uključuju memorijsku keš."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A közvetlen lemezhez való hozzáférés itt meg van tagadva, így a számok tartalmazzák a memória gyorsítótárát."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso diretto al disco è rifiutato qui, quindi i numeri includono la cache della memoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここではディスク直接アクセスが拒否されているため、数値にはメモリキャッシュが含まれます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiesioginis diskiniu pasiekimas čia uždrausta, todėl skaičiai apima atminties keš."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiešā diska piekļuve šeit ir liegta, tāpēc skaitļi ietver atmiņas kešu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-aċċess dirett għad-disk jitħallef hawn, għalhekk in-numri jinkludu l-cache tal-memorja."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directe schijftoegang wordt hier geweigerd, dus de getallen bevatten de memorycache."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpośredni dostęp do dysku jest tutaj zabroniony, więc liczby zawierają pamięć podręczną pamięci."
