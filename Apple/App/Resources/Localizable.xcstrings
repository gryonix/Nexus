          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todo lo que gryonixNexus instaló: contenedores, el proxy inverso, el túnel, los scripts auxiliares y el propio acceso de la app, en todas las máquinas de este servidor."
          }
        },
