    "Everything the service holds now is replaced by the backup. This cannot be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was der Dienst jetzt enthält, wird durch das Backup ersetzt. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything the service holds now is replaced by the backup. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que el servicio contiene ahora se reemplaza por la copia de seguridad. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que le service contient actuellement est remplacé par la sauvegarde. C’est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che il servizio contiene ora viene sostituito dal backup. L’operazione è irreversibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービスの現在のデータはすべてバックアップで置き換えられます。元に戻すことはできません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все текущие данные сервиса будут заменены резервной копией. Это необратимо."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі поточні дані сервісу буде замінено резервною копією. Це незворотно."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该服务当前的全部数据都将被备份替换。此操作无法撤销。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki, mitä palvelulla nyt on, korvataan varmuuskopiolla. Tätä ei voi perua."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всичко, което услугата държи сега, се заменя от резервното копие. Това не може да бъде отменено."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles wat de dienst nu bevat, wordt vervangen door de back-up. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt, tjenesten indeholder nu, erstattes af sikkerhedskopien. Dette kan ikke fortrydes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt tjänsten innehåller nu ersätts av säkerhetskopian. Det här kan inte ångras."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve što usluga trenutno sadrži zamjenjuje se sigurnosnom kopijom. Ovo se ne može poništiti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vse, kar storitev trenutno hrani, nadomesti varnostna kopija. Tega ni mogoče razveljaviti."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tot ce deține serviciul acum este înlocuit de backup. Această acțiune nu poate fi anulată."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindent, amit a szolgáltatás most tárol, lecserél a biztonsági mentés. Ez nem vonható vissza."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko, co usługa teraz przechowuje, zostaje zastąpione kopią zapasową. Tego nie da się cofnąć."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše, co služba nyní obsahuje, se nahradí zálohou. Toto nelze vrátit zpět."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
