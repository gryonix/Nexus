          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spostamento mantiene la configurazione di ogni dispositivo: stesso indirizzo, stesse chiavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動しても各デバイスの設定はそのままです。アドレスも鍵も変わりません。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkėlimas išlaiko kiekvieno įrenginio konfigūraciją: tą patį adresą, tuos pačius raktus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārvietošana saglabā katras ierīces konfigurāciju: to pašu adresi, tās pašas atslēgas."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-ġarr iżomm il-konfigurazzjoni ta' kull apparat: l-istess indirizz, l-istess ċwievet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaatsen behoudt de configuratie van elk apparaat: hetzelfde adres, dezelfde sleutels."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeniesienie zachowuje konfigurację każdego urządzenia: ten sam adres, te same klucze."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mudança mantém a configuração de cada dispositivo: o mesmo endereço, as mesmas chaves."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutarea păstrează configurația fiecărui dispozitiv: aceeași adresă, aceleași chei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При переносе конфигурации устройств не меняются: тот же адрес, те же ключи."
          }
        },
        "sk" : {
          "stringUnit" : {
