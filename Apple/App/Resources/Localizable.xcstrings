    "Friendly names group each program under a name you know; off shows what the system calls them." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разбираемите имена групират всяка програма под познато име; изключено показва как ги нарича системата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Srozumitelné názvy seskupí každý program pod známým jménem; vypnuto ukazuje, jak je nazývá systém."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letforståelige navne samler hvert program under et kendt navn; slået fra vises det, systemet kalder dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verständliche Namen fassen jedes Programm unter einem bekannten Namen zusammen; ausgeschaltet zeigt es, wie das System sie nennt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κατανοητά ονόματα ομαδοποιούν κάθε πρόγραμμα κάτω από ένα γνωστό όνομα· απενεργοποιημένα δείχνουν πώς τα λέει το σύστημα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres comprensibles agrupan cada programa bajo un nombre conocido; desactivado muestra cómo los llama el sistema."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arusaadavad nimed koondavad iga programmi tuntud nime alla; väljas näitab, kuidas süsteem neid nimetab."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selkeät nimet ryhmittelevät jokaisen ohjelman tutun nimen alle; pois päältä näkyy, miten järjestelmä niitä kutsuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms lisibles regroupent chaque programme sous un nom connu ; désactivé, on voit comment le système les appelle."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grúpálann ainmneacha soiléire gach clár faoi ainm atá ar eolas agat; nuair atá sé múchta, taispeántar an t-ainm atá ag an gcóras orthu."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razumljivi nazivi grupiraju svaki program pod poznatim imenom; isključeno prikazuje kako ih sustav zove."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az érthető nevek minden programot ismert név alá csoportosítanak; kikapcsolva a rendszer saját elnevezései látszanak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nomi leggibili raggruppano ogni programma sotto un nome noto; disattivato mostra come li chiama il sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "わかりやすい名前では各プログラムを知っている名前でまとめます。オフにするとシステム上の名前を表示します。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprantami pavadinimai sugrupuoja kiekvieną programą pažįstamu vardu; išjungus rodoma, kaip jas vadina sistema."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saprotami nosaukumi apvieno katru programmu zem pazīstama vārda; izslēgts rāda, kā tās sauc sistēma."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-ismijiet li jinftiehmu jiġbru kull programm taħt isem magħruf; mitfi juri kif isejħilhom is-sistema."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrijpelijke namen groeperen elk programma onder een bekende naam; uit toont hoe het systeem ze noemt."
