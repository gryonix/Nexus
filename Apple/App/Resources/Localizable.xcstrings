    "Direct disk access is refused here, so the numbers include the memory cache." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прямият достъп до диска е отказан тук, поради което числата включват кеша на паметта."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přímý přístup na disk je zde odmítnut, takže čísla zahrnují mezipaměť paměti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkte diskadgang nægtes her, så tallene inkluderer hukommelsescachen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkter Plattenzugriff ist hier nicht möglich, daher enthalten die Werte den Speicher-Cache."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η άμεση πρόσβαση σε δίσκο αρνείται εδώ, έτσι οι αριθμοί περιλαμβάνουν την προσωρινή μνήμη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso directo al disco se rechaza aquí, por lo que los números incluyen la caché de memoria."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otse kettale pääs siin keelatud, seega sisaldavad numbrid mälukeš."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suorat levynsäännöt evätään täällä, joten luvut sisältävät muistin välimuistin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès direct au disque est refusé ici, donc les chiffres incluent le cache mémoire."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diúltaítear an rochtain dhíreach ar dhiosca anseo, mar sin áirítear an cache cuimhne sna huimhreacha."
