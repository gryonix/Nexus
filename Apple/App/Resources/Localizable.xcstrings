    "Values the server marked as credentials stay hidden until you ask for them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werte, die der Server als Zugangsdaten eingestuft hat, bleiben verborgen, bis du sie anforderst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores que el servidor marcó como credenciales permanecen ocultos hasta que los pidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs que le serveur a marquées comme identifiants restent masquées jusqu’à ce que vous les demandiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I valori che il server ha marcato come credenziali restano nascosti finché non li chiedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーが認証情報と判断した値は、要求するまで隠されたままです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значения, которые сервер счёл учётными данными, скрыты, пока вы их не запросите."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значення, які сервер вважає обліковими даними, приховані, доки ви їх не запитаєте."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器判定为凭据的值在你主动查看前保持隐藏。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvot, jotka palvelin on merkinnyt tunnuksiksi, pysyvät piilossa, kunnes pyydät niitä."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стойности, маркирани от сървъра като идентификации, остават скрити, докато не ги поискате."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valorile pe care serverul le-a marcat drept acreditări rămân ascunse până când le ceri."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værdier, serveren har markeret som loginoplysninger, forbliver skjulte, indtil du beder om dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarden die de server als inloggegevens heeft gemarkeerd blijven verborgen tot je erom vraagt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värden som servern markerat som inloggningsuppgifter förblir dolda tills du efterfrågar dem."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrijednosti koje je poslužitelj označio kao vjerodajnice ostaju skrivene dok ih ne zatražite."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrednosti, ki jih je strežnik označil kot poverilnice, ostanejo skrite, dokler jih ne zahtevate."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az értékek, amelyeket a szerver hitelesítő adatként jelölt meg, rejtve maradnak, amíg nem kéri őket."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnoty, které server označil jako přihlašovací údaje, zůstávají skryté, dokud o ně nepožádáte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartości oznaczone przez serwer jako poświadczenia pozostają ukryte, dopóki o nie nie poprosisz."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väärtused, mille server on märkinud tunnusandmetena, jäävad varjatuks, kuni sa neid küsid."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores que o servidor marcou como credenciais ficam escondidos até os pedir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τιμές που ο διακομιστής επισήμανε ως διαπιστευτήρια παραμένουν κρυφές μέχρι να τις ζητήσετε."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnoty, ktoré server označil ako prístupové údaje, zostávajú skryté, kým si o ne nepožiadate."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vērtības, ko serveris atzīmējis kā akreditācijas datus, paliek slēptas, kamēr tās nepieprasāt."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanann luachanna a mharcáil an freastalaí mar dhintiúir i bhfolach go dtí go n-iarrann tú iad."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reikšmės, kurias serveris pažymėjo kaip prisijungimo duomenis, lieka paslėptos, kol jų nepaprašysite."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valuri li s-server immarka bħala kredenzjali jibqgħu moħbija sakemm titlobhom."
          }
        }
      }
    },
