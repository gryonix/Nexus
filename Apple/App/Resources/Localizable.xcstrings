    "Picking another machine moves the service there. Its data is copied over, and the old copy stays, stopped." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изборът на друга машина премества услугата там. Данните се копират, а старото копие остава спряно."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výběrem jiného stroje se služba přesune tam. Její data se zkopírují a stará kopie zůstane zastavená."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du vælger en anden maskine, flyttes tjenesten dertil. Dens data kopieres, og den gamle kopi bliver liggende, stoppet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählst du eine andere Maschine, wird der Dienst dorthin verschoben. Seine Daten werden kopiert, und die alte Kopie bleibt gestoppt erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιλογή άλλου μηχανήματος μετακινεί εκεί την υπηρεσία. Τα δεδομένα της αντιγράφονται και το παλιό αντίγραφο μένει σταματημένο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegir otra máquina traslada el servicio allí. Sus datos se copian y la copia anterior se queda detenida."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teise masina valimine teisaldab teenuse sinna. Selle andmed kopeeritakse ja vana koopia jääb peatatuna alles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toisen koneen valinta siirtää palvelun sinne. Sen tiedot kopioidaan, ja vanha kopio jää pysäytettynä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisir une autre machine y déplace le service. Ses données sont copiées et l'ancienne copie reste, arrêtée."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má roghnaíonn tú meaisín eile, bogtar an tseirbhís ann. Cóipeáiltear a sonraí, agus fanann an tseanchóip, stoptha."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odabirom drugog stroja usluga se premješta tamo. Njezini se podaci kopiraju, a stara kopija ostaje zaustavljena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy másik gép kiválasztásával a szolgáltatás oda költözik. Az adatai átmásolódnak, a régi példány pedig leállítva megmarad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegliendo un'altra macchina il servizio viene spostato lì. I suoi dati vengono copiati e la vecchia copia resta, ferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のマシンを選ぶと、サービスがそこへ移動します。データはコピーされ、古いコピーは停止した状態で残ります。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasirinkus kitą mašiną, paslauga perkeliama ten. Jos duomenys nukopijuojami, o senoji kopija lieka sustabdyta."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvēloties citu mašīnu, pakalpojums tiek pārvietots uz to. Tā dati tiek nokopēti, un vecā kopija paliek apturēta."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jekk tagħżel magna oħra, is-servizz jiġi ċċaqlaq hemm. Id-data tiegħu tiġi kkupjata, u l-kopja l-qadima tibqa' waqfa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een andere machine kiezen verplaatst de dienst daarheen. De gegevens worden gekopieerd en de oude kopie blijft gestopt staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybranie innej maszyny przenosi tam usługę. Jej dane są kopiowane, a stara kopia pozostaje zatrzymana."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolher outra máquina move o serviço para lá. Os dados são copiados e a cópia antiga fica parada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegerea altei mașini mută serviciul acolo. Datele lui sunt copiate, iar copia veche rămâne oprită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбор другой машины переносит сервис туда. Данные копируются, а старая копия остаётся остановленной."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výberom iného stroja sa služba presunie tam. Jej údaje sa skopírujú a stará kópia zostane zastavená."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z izbiro drugega stroja se storitev premakne tja. Njeni podatki se kopirajo, stara kopija pa ostane ustavljena."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du väljer en annan maskin flyttas tjänsten dit. Dess data kopieras och den gamla kopian blir kvar, stoppad."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибір іншої машини переносить сервіс туди. Дані копіюються, а стара копія залишається зупиненою."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择另一台机器会把服务移到那里。数据会被复制过去，旧副本则保留在原处并处于停止状态。"
          }
        }
      }
    },
