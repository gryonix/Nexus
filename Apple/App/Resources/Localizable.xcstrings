    "Hides the Dock icon and the app switcher entry. The menu bar becomes the only way in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet das Dock-Symbol und den Eintrag im App-Umschalter aus. Die Menüleiste ist dann der einzige Weg hinein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta el icono del Dock y la entrada en el selector de apps. La barra de menús pasa a ser la única vía de entrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque l’icône du Dock et l’entrée du sélecteur d’apps. La barre des menus devient le seul accès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde l’icona nel Dock e la voce nel selettore di app. La barra dei menu diventa l’unico accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock のアイコンと App スイッチャーの項目を隠します。入口はメニューバーだけになります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убирает значок из Dock и из переключателя приложений. Войти можно будет только через строку меню."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прибирає піктограму з Dock і з перемикача застосунків. Увійти можна буде лише через рядок меню."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏 Dock 图标和应用切换器条目。菜单栏将成为唯一入口。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilottaa Dock-kuvakkeen ja sovellusvaihtajan merkinnän. Valikkorivistä tulee ainoa sisäänpääsy."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрива иконата в Dock и записа в превключвателя на приложения. Лентата с менюта става единственият начин за влизане."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascunde pictograma din Dock și intrarea din comutatorul de aplicații. Bara de meniu devine singura cale de intrare."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriva ikonu u Docku i unos u prebacivaču aplikacija. Traka izbornika postaje jedini način ulaska."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrije ikono v Docku in vnos v preklopniku aplikacij. Menijska vrstica postane edini način vstopa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler Dock-ikonet og posten i appskifteren. Menulinjen bliver den eneste vej ind."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbergt het Dock-icoon en het item in de app-switcher. De menubalk wordt de enige weg naar binnen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Döljer Dock-ikonen och posten i appväxlaren. Menyraden blir den enda vägen in."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elrejti a Dock ikont és az alkalmazásváltó bejegyzést. A menüsor lesz az egyetlen belépési pont."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skryje ikonu v Docku a položku v přepínači aplikací. Lišta nabídek se stane jedinou cestou dovnitř."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukrywa ikonę w Docku i wpis w przełączniku aplikacji. Pasek menu staje się jedyną drogą wejścia."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peidab Docki ikooni ja rakenduste vaheti kirje. Menüüriba muutub ainsaks sissepääsuks."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esconde o ícone do Dock e a entrada no seletor de apps. A barra de menus torna-se a única forma de entrar."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skryje ikonu v Docku a položku v prepínači aplikácií. Lišta ponúk sa stane jedinou cestou dnu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρύβει το εικονίδιο στο Dock και την καταχώριση στον εναλλάκτη εφαρμογών. Η γραμμή μενού γίνεται ο μόνος τρόπος εισόδου."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paslēpj Dock ikonu un ierakstu lietotņu pārslēdzējā. Izvēļņjosla kļūst par vienīgo ceļu iekšā."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paslepia „Dock“ piktogramą ir įrašą programų perjungiklyje. Meniu juosta tampa vieninteliu būdu patekti."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folaíonn sé deilbhín an Dock agus iontráil an aistritheora aipeanna. Éiríonn an barra roghchláir mar an t-aon bhealach isteach."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taħbi l-ikona tad-Dock u l-entrata fl-app switcher. Il-menu bar issir l-unika triq għal ġewwa."
          }
        }
      }
    },
    "Language, notifications, Face ID and local network access for this app — the settings the phone owns rather than the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprache, Mitteilungen, Face ID und Zugriff auf das lokale Netzwerk für diese App — die Einstellungen, die dem Telefon gehören, nicht der App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idioma, notificaciones, Face ID y acceso a la red local de esta app: los ajustes que pertenecen al teléfono, no a la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langue, notifications, Face ID et accès au réseau local pour cette app — les réglages qui appartiennent au téléphone, pas à l'app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
