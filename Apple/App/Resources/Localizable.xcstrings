    "The service's data and every backup of it are deleted permanently. There is no way back from this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Daten des Dienstes und jedes Backup davon werden endgültig gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos del servicio y todas sus copias de seguridad se eliminan de forma permanente. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données du service et toutes ses sauvegardes sont supprimées définitivement. C'est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati del servizio e ogni suo backup vengono eliminati definitivamente. L'operazione è irreversibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービスのデータとそのすべてのバックアップが完全に削除されます。元に戻すことはできません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные сервиса и все его резервные копии удаляются безвозвратно. Это необратимо."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дані сервісу та всі його резервні копії видаляються безповоротно. Це незворотно."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该服务的数据及其所有备份都将被永久删除。此操作无法撤销。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelun data ja jokainen sen varmuuskopio poistetaan pysyvästi. Tästä ei ole paluuta."
