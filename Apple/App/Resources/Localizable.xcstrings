        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miután a szkriptek lefutottak — bármelyik módon — a szerver innen kezelhető."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď skripty prebehnú — akýmkoľvek spôsobom — server sa spravuje odtiaľto."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakmile skripty doběhnou — tak či onak — server se odsud spravuje."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui skriptid on käivitatud — ükskõik kummal viisil —, hallatakse serverit siit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόλις εκτελεστούν τα σενάρια — με όποιον τρόπο — ο διακομιστής διαχειρίζεται από εδώ."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy skrypty się wykonają — którąkolwiek drogą — serwerem zarządza się stąd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assim que os scripts tiverem corrido — seja de que forma for — o servidor é gerido a partir daqui."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad skripti ir izpildīti — vienalga kādā veidā — serveris tiek pārvaldīts no šejienes."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuair a bheidh na scripteanna rite — cibé bealach — bainistítear an freastalaí as seo amach."
