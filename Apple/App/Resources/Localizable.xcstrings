          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt op de server geïnstalleerd. Je kunt de app sluiten — de server gaat door, en dit scherm pakt de uitvoering weer op."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installerer på serveren. Du kan lukke appen — serveren fortsætter, og denne skærm samler forløbet op igen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installerar på servern. Du kan stänga appen — servern fortsätter, och den här skärmen fångar upp körningen igen."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instaliranje na poslužitelju. Možete zatvoriti aplikaciju — poslužitelj nastavlja, a ovaj zaslon će ponovno preuzeti tijek."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
