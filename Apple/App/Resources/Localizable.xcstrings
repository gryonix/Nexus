    "Containers and configuration are removed; data and backups stay on disk, so installing the service again can pick them up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Container und Konfiguration werden entfernt; Daten und Backups bleiben auf der Festplatte, sodass eine erneute Installation des Dienstes sie wieder aufgreifen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los contenedores y la configuración se quitan; los datos y las copias de seguridad permanecen en el disco, así que si vuelves a instalar el servicio podrá recuperarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conteneurs et la configuration sont supprimés ; les données et les sauvegardes restent sur le disque, de sorte qu'une réinstallation du service pourra les récupérer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I container e la configurazione vengono rimossi; i dati e i backup restano sul disco, così una nuova installazione del servizio potrà recuperarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテナと設定は削除されますが、データとバックアップはディスクに残るため、サービスを再インストールすれば引き継げます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контейнеры и конфигурация удаляются; данные и резервные копии остаются на диске, поэтому повторная установка сервиса сможет их подхватить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контейнери та конфігурація видаляються; дані та резервні копії залишаються на диску, тому повторне встановлення сервісу зможе їх підхопити."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容器和配置将被移除；数据和备份仍保留在磁盘上，因此重新安装该服务后可以继续使用它们。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilöt ja konfiguraatio poistetaan; data ja varmuuskopiot jäävät levylle, joten palvelun asentaminen uudelleen voi ottaa ne käyttöön."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контейнерите и конфигурацията се премахват; данните и резервните копия остават на диска, така че повторното инсталиране на услугата може да ги вземе отново."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremnici i konfiguracija se uklanjaju; podaci i sigurnosne kopije ostaju na disku, pa ih ponovna instalacija usluge može preuzeti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsebniki in konfiguracija se odstranijo; podatki in varnostne kopije ostanejo na disku, tako da jih lahko ponovna namestitev storitve znova prevzame."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Containers en configuratie worden verwijderd; gegevens en back-ups blijven op de schijf staan, zodat de dienst opnieuw installeren ze weer kan oppikken."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Containere og konfiguration fjernes; data og sikkerhedskopier forbliver på disken, så en gentagen installation af tjenesten kan tage dem op igen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Containrar och konfiguration tas bort; data och säkerhetskopior finns kvar på disken, så en ny installation av tjänsten kan plocka upp dem igen."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Containerele și configurația sunt eliminate; datele și backup-urile rămân pe disc, astfel încât reinstalarea serviciului le poate prelua."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontenery i konfiguracja są usuwane; dane i kopie zapasowe pozostają na dysku, więc ponowna instalacja usługi może je odzyskać."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontejnery a konfigurace se odstraní; data a zálohy zůstávají na disku, takže opětovná instalace služby je může převzít."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konteinerid ja seadistus eemaldatakse; andmed ja varukoopiad jäävad kettale, nii et teenuse uuesti paigaldamine saab need üles võtta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A konténerek és a konfiguráció eltávolításra kerülnek; az adatok és a biztonsági mentések a lemezen maradnak, így a szolgáltatás újratelepítése felveheti őket."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα containers και η ρύθμιση αφαιρούνται· τα δεδομένα και τα αντίγραφα ασφαλείας παραμένουν στον δίσκο, ώστε η επανεγκατάσταση της υπηρεσίας να μπορεί να τα βρει."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontajnery a konfigurácia sa odstránia; dáta a zálohy zostanú na disku, takže ich opätovná inštalácia služby môže znova použiť."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os contentores e a configuração são removidos; os dados e as cópias de segurança permanecem no disco, pelo que reinstalar o serviço os pode recuperar."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konteineri un konfigurācija tiek noņemti; dati un dublējumi paliek diskā, tāpēc, instalējot pakalpojumu no jauna, tos var izmantot atkal."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baintear coimeádáin agus cumraíocht; fanann sonraí agus cúltacaí ar an diosca, agus mar sin is féidir leo a bheith pioctha suas arís nuair a shuiteáiltear an tseirbhís arís."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-kontenituri u l-konfigurazzjoni jitneħħew; id-data u l-backups jibqgħu fuq id-disk, biex jekk terġa' tinstalla s-servizz din tista' terġa' taqbadhom."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konteineriai ir konfigūracija pašalinami; duomenys ir atsarginės kopijos lieka diske, todėl vėl įdiegus paslaugą jie gali būti panaudoti."
          }
        }
      }
    },
