    "This agent is too old to remove itself. Update it, then remove it." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този агент е твърде стар, за да се премахне сам. Обновете го, след това го премахнете."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento agent je příliš starý, aby se odebral sám. Aktualizujte ho a pak ho odeberte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne agent er for gammel til at fjerne sig selv. Opdater den, og fjern den derefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Agent ist zu alt, um sich selbst zu entfernen. Aktualisiere ihn und entferne ihn dann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο πράκτορας είναι πολύ παλιός για να αφαιρεθεί μόνος του. Ενημερώστε τον και μετά αφαιρέστε τον."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este agente es demasiado antiguo para quitarse solo. Actualízalo y luego quítalo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
