        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Installationsschlüssel konnte vom Server nicht entfernt werden. Entfernen Sie ihn manuell aus den autorisierten Schlüsseln des Servers."
