    "Everything on the array's disks is erased. Type %@ to confirm." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всичко на дисковете на масива се изтрива. Въведи %@ за потвърждение."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše na discích pole bude smazáno. Pro potvrzení napište %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt på arrayets diske slettes. Skriv %@ for at bekræfte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles auf den Festplatten des Arrays wird gelöscht. Gib %@ zur Bestätigung ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα στους δίσκους της συστοιχίας διαγράφονται. Πληκτρολόγησε %@ για επιβεβαίωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borra todo lo de los discos del conjunto. Escribe %@ para confirmar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõik massiivi ketastel kustutatakse. Kinnitamiseks sisesta %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki taulukon levyillä poistetaan. Vahvista kirjoittamalla %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui est sur les disques de l'ensemble est effacé. Tape %@ pour confirmer."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scriostar gach rud ar dhioscaí an eagair. Clóscríobh %@ le deimhniú."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve na diskovima polja bit će izbrisano. Upišite %@ za potvrdu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tömb lemezein minden törlődik. A megerősítéshez írd be: %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto sui dischi dell'array viene cancellato. Digita %@ per confermare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アレイのディスクの内容はすべて消去されます。確認のため %@ と入力してください。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viskas masyvo diskuose bus ištrinta. Norėdami patvirtinti, įveskite %@."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viss masīva diskos tiks izdzēsts. Lai apstiprinātu, ierakstiet %@."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kollox fuq id-diski tal-array jitħassar. Ikteb %@ biex tikkonferma."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles op de schijven van de array wordt gewist. Typ %@ om te bevestigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko na dyskach macierzy zostanie usunięte. Wpisz %@, aby potwierdzić."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo nos discos do conjunto é apagado. Escreve %@ para confirmar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tot de pe discurile matricei se șterge. Scrie %@ pentru confirmare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё на дисках массива будет стёрто. Введите %@ для подтверждения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetko na diskoch poľa sa vymaže. Na potvrdenie napíšte %@."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vse na diskih polja bo izbrisano. Za potrditev vpišite %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt på arrayens diskar raderas. Skriv %@ för att bekräfta."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе на дисках масиву буде стерто. Введіть %@ для підтвердження."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阵列磁盘上的所有内容都会被擦除。输入 %@ 以确认。"
          }
        }
      }
    },
    "Everything on the chosen disk is copied onto the new one while the array stays protected. Then the old disk leaves the array and can be pulled out." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всичко от избрания диск се копира на новия, докато масивът остава защитен. След това старият диск излиза от масива и може да се извади."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše z vybraného disku se zkopíruje na nový, zatímco pole zůstává chráněné. Potom starý disk opustí pole a lze ho vytáhnout."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt på den valgte disk kopieres til den nye, mens arrayet forbliver beskyttet. Derefter forlader den gamle disk arrayet og kan tages ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles auf der gewählten Festplatte wird auf die neue kopiert, während das Array geschützt bleibt. Danach verlässt die alte Festplatte das Array und kann herausgezogen werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα από τον επιλεγμένο δίσκο αντιγράφονται στον νέο, ενώ η συστοιχία παραμένει προστατευμένη. Μετά ο παλιός δίσκος φεύγει από τη συστοιχία και μπορεί να αφαιρεθεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo del disco elegido se copia al nuevo mientras el conjunto sigue protegido. Luego el disco viejo sale del conjunto y se puede sacar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõik valitud kettalt kopeeritakse uuele, samal ajal kui massiiv jääb kaitstuks. Seejärel lahkub vana ketas massiivist ja selle saab välja võtta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki valitulta levyltä kopioidaan uudelle, kun taulukko pysyy suojattuna. Sen jälkeen vanha levy poistuu taulukosta ja sen voi irrottaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le contenu du disque choisi est copié sur le nouveau pendant que l'ensemble reste protégé. Ensuite l'ancien disque quitte l'ensemble et peut être retiré."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cóipeáiltear gach rud ar an diosca roghnaithe chuig an gceann nua fad a fhanann an t-eagar cosanta. Ansin fágann an seandiosca an t-eagar agus is féidir é a bhaint amach."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve s odabranog diska kopira se na novi dok polje ostaje zaštićeno. Zatim stari disk napušta polje i može se izvaditi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiválasztott lemez teljes tartalma átmásolódik az újra, miközben a tömb védett marad. Utána a régi lemez kilép a tömbből, és kivehető."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che è sul disco scelto viene copiato sul nuovo mentre l'array resta protetto. Poi il vecchio disco esce dall'array e si può estrarre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アレイの保護を保ったまま、選んだディスクの内容をすべて新しいディスクにコピーします。その後、古いディスクはアレイから外れ、取り外せます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viskas iš pasirinkto disko nukopijuojama į naują, kol masyvas lieka apsaugotas. Tada senas diskas palieka masyvą ir jį galima ištraukti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viss no izvēlētā diska tiek nokopēts uz jauno, kamēr masīvs paliek aizsargāts. Pēc tam vecais disks atstāj masīvu, un to var izņemt."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kollox fuq id-diska magħżula jiġi kkupjat fuq il-ġdida waqt li l-array jibqa' protett. Imbagħad id-diska l-antika toħroġ mill-array u tista' titneħħa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles op de gekozen schijf wordt naar de nieuwe gekopieerd terwijl de array beschermd blijft. Daarna verlaat de oude schijf de array en kan eruit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko z wybranego dysku jest kopiowane na nowy, a macierz pozostaje chroniona. Potem stary dysk opuszcza macierz i można go wyjąć."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo no disco escolhido é copiado para o novo enquanto o conjunto continua protegido. Depois o disco antigo sai do conjunto e pode ser retirado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tot de pe discul ales se copiază pe cel nou, în timp ce matricea rămâne protejată. Apoi discul vechi iese din matrice și poate fi scos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё с выбранного диска копируется на новый, пока массив остаётся под защитой. Потом старый диск выходит из массива, и его можно вынуть."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetko z vybraného disku sa skopíruje na nový, kým pole zostáva chránené. Potom starý disk opustí pole a dá sa vytiahnuť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vse z izbranega diska se kopira na novega, medtem ko polje ostane zaščiteno. Nato stari disk zapusti polje in ga lahko odstranite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt på den valda disken kopieras till den nya medan arrayen förblir skyddad. Sedan lämnar den gamla disken arrayen och kan tas ut."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе з вибраного диска копіюється на новий, поки масив залишається під захистом. Потім старий диск виходить із масиву, і його можна вийняти."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在阵列保持保护的同时，所选磁盘上的全部内容会复制到新磁盘。之后旧磁盘离开阵列，可以拔出。"
          }
        }
      }
    },
