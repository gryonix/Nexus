    "Temperature, hours, wear and bad sectors, as each disk reports them." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Температура, часове, износване и лоши сектори, както ги съобщава всеки диск."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teplota, hodiny, opotřebení a vadné sektory, jak je hlásí každý disk."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatur, timer, slid og dårlige sektorer, som hver disk melder dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatur, Betriebsstunden, Verschleiß und defekte Sektoren, wie jedes Laufwerk sie meldet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θερμοκρασία, ώρες, φθορά και κατεστραμμένοι τομείς, όπως τα αναφέρει κάθε δίσκος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura, horas, desgaste y sectores defectuosos, tal como los informa cada disco."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatuur, tunnid, kulumine ja vigased sektorid, nagu iga ketas neid teatab."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lämpötila, tunnit, kuluminen ja vialliset sektorit kunkin levyn ilmoittamana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Température, heures, usure et secteurs défectueux, tels que chaque disque les indique."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teocht, uaireanta, caitheamh agus droch-earnálacha, mar a thuairiscíonn gach diosca iad."
