          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco conserva sus archivos; se crea una carpeta en él. Allí van las bases de datos, las cachés y los datos de Docker; fotos, archivos y multimedia se quedan donde están."
