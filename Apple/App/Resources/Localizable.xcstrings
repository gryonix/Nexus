          "stringUnit" : {
            "state" : "translated",
            "value" : "手持ちの映画・ドラマ・音楽をどの端末にも配信します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Транслирует ваши фильмы, сериалы и музыку на любое устройство."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Транслює ваші фільми, серіали та музику на будь-який пристрій."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你已有的电影、剧集和音乐串流到任意设备。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suoratoistaa jo omistamiasi elokuvia, sarjoja ja musiikkia mille tahansa laitteelle."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стриймва филми, сериали и музика, които вече притежавате, към всяко устройство."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmite filme, seriale și muzică pe care le deții deja către orice dispozitiv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streamt films, series en muziek die je al bezit naar elk apparaat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streamer film, serier og musik, du allerede ejer, til enhver enhed."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strömmar filmer, serier och musik du redan äger till valfri enhet."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strujno prenosi filmove, serije i glazbu koje već posjedujete na bilo koji uređaj."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretaka filme, serije in glasbo, ki jih že imate, na katero koli napravo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streameli a filmeket, sorozatokat és zenéket, amelyekkel már rendelkezik, bármely eszközre."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streamuje filmy, seriály a hudbu, které už vlastníte, na jakékoli zařízení."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voogedastab filme, sarju ja muusikat, mis sul juba on, mis tahes seadmesse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεταδίδει ταινίες, σειρές και μουσική που ήδη κατέχετε σε οποιαδήποτε συσκευή."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesyła strumieniowo posiadane już filmy, seriale i muzykę na dowolne urządzenie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmite filmes, séries e música que já possui para qualquer dispositivo."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streamuje filmy, seriály a hudbu, ktoré už vlastníte, na akékoľvek zariadenie."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sruthaíonn sé scannáin, sraitheanna agus ceol atá agat cheana féin chuig aon ghléas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
