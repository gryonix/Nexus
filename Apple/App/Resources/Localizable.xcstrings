          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do folderu dodawana jest własna nazwa tego serwera, więc kilka serwerów może współdzielić jedno miejsce docelowe bez wzajemnego nadpisywania."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do složky se přidá vlastní název tohoto serveru, takže si více serverů může sdílet jeden cíl, aniž by si vzájemně přepisovaly data."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do priečinka sa pridá vlastný názov tohto servera, takže viac serverov si môže zdieľať jeden cieľ bez toho, aby si vzájomne prepisovali dáta."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ίδιο το όνομα αυτού του διακομιστή προστίθεται στον φάκελο, ώστε πολλοί διακομιστές να μπορούν να μοιράζονται έναν προορισμό χωρίς να πατάνε ο ένας πάνω στον άλλον."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennek a szervernek a saját neve hozzáadódik a mappához, így több szerver is megoszthat egy célt anélkül, hogy egymásra írnának."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numele propriu al acestui server este adăugat la folder, astfel încât mai multe servere pot partaja o singură destinație fără să se suprapună."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O próprio nome deste servidor é adicionado à pasta, para que vários servidores possam partilhar um destino sem se sobreporem."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle serveri enda nimi lisatakse kausta, et mitu serverit saaksid jagada ühte sihtkohta üksteise peale sattumata."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuirtear ainm an fhreastalaí seo féin leis an bhfillteán, ionas gur féidir le roinnt freastalaithe ceann scríbe amháin a roinnt gan tuirlingt ar a chéile."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isem is-server innifsu jiżdied mal-fowlder, sabiex diversi servers jistgħu jaqsmu destinazzjoni waħda mingħajr ma jaqgħu fuq xulxin."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šī servera paša nosaukums tiek pievienots mapei, lai vairāki serveri varētu koplietot vienu galamērķi, nesajaucoties savā starpā."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
