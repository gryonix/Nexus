    "This server's backup tools are older than USB drives. Run Repair server on it first." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструментите за архивиране на този сървър са по-стари от поддръжката на USB устройства. Първо изпълнете „Поправка на сървъра“."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zálohovací nástroje tohoto serveru jsou starší než podpora USB disků. Nejprve na něm spusťte Opravit server."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverens backupværktøjer er ældre end USB-drev. Kør Reparer server på den først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Backup-Werkzeuge dieses Servers sind älter als die USB-Laufwerk-Funktion. Führe zuerst „Server reparieren“ aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα εργαλεία αντιγράφων ασφαλείας αυτού του διακομιστή είναι παλαιότερα από τις μονάδες USB. Εκτελέστε πρώτα «Επισκευή διακομιστή»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las herramientas de copia de este servidor son anteriores a las unidades USB. Ejecuta primero Reparar servidor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
