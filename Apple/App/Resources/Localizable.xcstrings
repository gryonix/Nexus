    "Turn on the services you want behind one login — they will appear here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalten Sie die Dienste ein, die hinter einer Anmeldung stehen sollen — sie erscheinen dann hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active los servicios que quiera detrás de un único inicio de sesión: aparecerán aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez les services que vous voulez placer derrière une seule connexion — ils apparaîtront ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva i servizi che vuoi mettere dietro un unico accesso: compariranno qui."
