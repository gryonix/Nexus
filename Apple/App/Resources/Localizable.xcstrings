            "value" : "Titta runt först"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prvo se osvrnite"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprej se razglejte"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uită-te mai întâi în jur"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nézz körül előbb"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw się rozejrzyj"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív se rozhlédnout"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaata kõigepealt ringi"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprv sa poobzerať"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρίξτε πρώτα μια ματιά"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ver primeiro"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vispirms apskatieties"
          }
        },
        "ga" : {
