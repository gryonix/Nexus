    "Connection lost — reconnecting (attempt %lld). The installation keeps running on the server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung unterbrochen — Verbindung wird wiederhergestellt (Versuch %lld). Die Installation läuft weiter auf dem Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexión perdida — reconectando (intento %lld). La instalación sigue ejecutándose en el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion perdue — reconnexion en cours (tentative %lld). L'installation continue de s'exécuter sur le serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connessione persa — riconnessione in corso (tentativo %lld). L'installazione continua a essere eseguita sul server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続が切断されました — 再接続しています (試行 %lld)。インストールはサーバー上で実行を続けています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединение потеряно — переподключение (попытка %lld). Установка продолжает выполняться на сервере."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З'єднання втрачено — повторне підключення (спроба %lld). Встановлення продовжує виконуватися на сервері."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接已断开 — 正在重新连接（第 %lld 次尝试）。安装仍在服务器上运行。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteys menetetty — yhdistetään uudelleen (yritys %lld). Asennus jatkuu palvelimella."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Връзката е загубена — повторно свързване (опит %lld). Инсталацията продължава да работи на сървъра."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veza izgubljena — ponovno povezivanje (pokušaj %lld). Instalacija se nastavlja izvoditi na poslužitelju."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povezava izgubljena — vnovično povezovanje (poskus %lld). Namestitev se nadaljuje na strežniku."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinding verbroken — opnieuw verbinden (poging %lld). De installatie blijft op de server doorlopen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelse mistet — genopretter forbindelse (forsøg %lld). Installationen fortsætter på serveren."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslutningen bröts — ansluter igen (försök %lld). Installationen fortsätter köras på servern."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexiune pierdută — se reconectează (încercarea %lld). Instalarea continuă să ruleze pe server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utracono połączenie — ponowne łączenie (próba %lld). Instalacja nadal działa na serwerze."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojení ztraceno — opětovné připojování (pokus %lld). Instalace na serveru stále běží."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ühendus katkes — taasühendumine (katse %lld). Paigaldus jätkub serveris."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kapcsolat megszakadt — újracsatlakozás (%lld. próbálkozás). A telepítés tovább fut a szerveren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σύνδεση χάθηκε — επανασύνδεση (προσπάθεια %lld). Η εγκατάσταση συνεχίζεται στον διακομιστή."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripojenie sa stratilo — opätovné pripájanie (pokus %lld). Inštalácia na serveri beží ďalej."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligação perdida — a religar (tentativa %lld). A instalação continua a decorrer no servidor."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Savienojums pazaudēts — mēģina savienoties atkārtoti (%lld. mēģinājums). Instalācija turpina darboties serverī."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasc caillte — ag athnascadh (iarracht %lld). Leanann an tsuiteáil ag rith ar an bhfreastalaí."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konnessjoni mitlufa — qed jerġa' jikkonnettja (tentattiv %lld). L-installazzjoni tibqa' taħdem fuq is-server."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryšys prarastas — jungiamasi iš naujo (bandymas %lld). Diegimas tebevyksta serveryje."
          }
        }
