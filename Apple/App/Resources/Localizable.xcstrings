    "You can still add it as a regular server and manage it over SSH." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können ihn trotzdem als regulären Server hinzufügen und über SSH verwalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aun así puedes añadirlo como servidor normal y administrarlo por SSH."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez tout de même l'ajouter comme serveur classique et le gérer via SSH."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi comunque aggiungerlo come server normale e gestirlo tramite SSH."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常のサーバーとして追加し、SSH経由で管理することもできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы всё же можете добавить его как обычный сервер и управлять по SSH."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви все ж можете додати його як звичайний сервер і керувати через SSH."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您仍然可以将其作为普通服务器添加，并通过 SSH 进行管理。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit silti lisätä sen tavallisena palvelimena ja hallita sitä SSH:n yli."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все още можете да го добавите като обикновен сървър и да го управлявате през SSH."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îl poți adăuga totuși ca server obișnuit și îl poți gestiona prin SSH."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan stadig tilføje den som en almindelig server og administrere den over SSH."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt hem nog steeds als gewone server toevoegen en via SSH beheren."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan fortfarande lägga till den som en vanlig server och hantera den över SSH."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dalje ga možete dodati kao obični poslužitelj i upravljati njime putem SSH-a."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Še vedno ga lahko dodate kot navaden strežnik in z njim upravljate prek SSH-ja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még mindig hozzáadhatja rendes szerverként, és SSH-n keresztül kezelheti."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stále ho můžete přidat jako běžný server a spravovat ho přes SSH."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadal możesz dodać go jako zwykły serwer i zarządzać nim przez SSH."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda pode adicioná-lo como um servidor normal e geri-lo via SSH."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε ακόμη να τον προσθέσετε ως κανονικό διακομιστή και να τον διαχειριστείτε μέσω SSH."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saad selle siiski lisada tavalise serverina ja hallata seda SSH kaudu."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stále ho môžete pridať ako bežný server a spravovať ho cez SSH."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūs joprojām varat to pievienot kā parastu serveri un pārvaldīt caur SSH."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is féidir leat é a chur leis fós mar ghnáthfhreastalaí agus é a bhainistiú thar SSH."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis tiek galite jį pridėti kaip įprastą serverį ir valdyti per SSH."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tista' xorta żżidu bħala server normali u timmaniġġjah permezz ta' SSH."
          }
        }
      }
    },
