        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На цій машині ніколи не було USB-перехідника — обирати поки нема чого."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台机器从未接入过 USB 串口适配器 — 目前没有可选项。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä koneella ei ole koskaan ollut USB-sarjasovitinta — ei ole vielä mitään valittavaa."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тази машина никога не е имала USB сериен адаптер — все още няма какво да се избере."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această mașină nu a avut niciodată un adaptor serial USB — încă nu este nimic de ales."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj stroj nikad nije imao USB serijski adapter — još nema ništa za odabrati."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
