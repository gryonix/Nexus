    "Devices running an older version of the app cannot sign in while this is on — update them first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geräte mit einer älteren App-Version können sich nicht anmelden, solange dies aktiv ist – aktualisieren Sie sie zuerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dispositivos con una versión anterior de la app no pueden iniciar sesión mientras esto esté activado: actualícelos primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appareils utilisant une ancienne version de l’app ne peuvent pas se connecter tant que ceci est activé : mettez-les à jour d’abord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dispositivi con una versione precedente dell’app non possono accedere finché questa opzione è attiva: aggiornali prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この設定が有効な間、古いバージョンのアプリのデバイスはサインインできません。先にアップデートしてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока это включено, устройства со старой версией приложения войти не смогут — сперва обновите их."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки це ввімкнено, пристрої зі старою версією застосунку увійти не зможуть — спершу оновіть їх."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用此项后，运行旧版本应用的设备无法登录，请先更新它们。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovelluksen vanhempaa versiota ajavat laitteet eivät voi kirjautua sisään tämän ollessa päällä — päivitä ne ensin."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройства с по-стара версия на приложението не могат да влизат, докато това е включено — първо ги обновете."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uređaji sa starijom verzijom aplikacije ne mogu se prijaviti dok je ovo uključeno — prvo ih ažurirajte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naprave s starejšo različico aplikacije se ne morejo prijaviti, dokler je to vklopljeno — najprej jih posodobite."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enheder, der kører en ældre version af appen, kan ikke logge ind, mens dette er slået til — opdater dem først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparaten met een oudere versie van de app kunnen zich niet aanmelden zolang dit aanstaat — werk ze eerst bij."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enheter som kör en äldre version av appen kan inte logga in medan det här är på — uppdatera dem först."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispositivos com uma versão mais antiga da app não conseguem iniciar sessão enquanto isto estiver ativo — atualize-os primeiro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispozitivele care rulează o versiune mai veche a aplicației nu se pot autentifica cât timp aceasta este activă — actualizează-le mai întâi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urządzenia ze starszą wersją aplikacji nie mogą się zalogować, gdy to jest włączone — najpierw je zaktualizuj."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařízení se starší verzí aplikace se nemohou přihlásit, dokud je toto zapnuto — nejprve je aktualizujte."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zariadenia so staršou verziou aplikácie sa nemôžu prihlásiť, kým je toto zapnuté — najprv ich aktualizujte."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanemat rakenduse versiooni kasutavad seadmed ei saa sisse logida, kui see on sees — uuenda need enne ära."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazás régebbi verzióját futtató eszközök nem tudnak bejelentkezni, amíg ez be van kapcsolva — frissítsd őket előbb."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ierīces, kurās darbojas vecāka lietotnes versija, nevar pieteikties, kamēr tas ir ieslēgts — vispirms tās atjauniniet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συσκευές με παλαιότερη έκδοση της εφαρμογής δεν μπορούν να συνδεθούν όσο αυτό είναι ενεργό — ενημερώστε τις πρώτα."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní féidir le gléasanna atá ag rith seanleagan den aip síniú isteach fad is atá seo ann — nuashonraigh iad ar dtús."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparati li qed jaħdmu b'verżjoni aktar antika tal-app ma jistgħux jidħlu waqt li dan huwa mixgħul — aġġornahom l-ewwel."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įrenginiai, kuriuose veikia senesnė programėlės versija, negali prisijungti, kol tai įjungta — pirmiausia juos atnaujinkite."
          }
        }
      }
    },
