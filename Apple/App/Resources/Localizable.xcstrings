    "Installing on the server. You can close the app — the server carries on, and this screen picks the run back up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird auf dem Server installiert. Du kannst die App schließen — der Server macht weiter, und dieser Bildschirm nimmt den Lauf wieder auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalando en el servidor. Puedes cerrar la app: el servidor continúa y esta pantalla retoma la ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installation sur le serveur. Vous pouvez fermer l’app : le serveur poursuit, et cet écran reprend l’exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
