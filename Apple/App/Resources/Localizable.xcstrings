    "The account the server was added with must be root or allowed to use sudo without a password." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акаунтът, с който е добавен сервърът, трябва да бъде root или разрешен да използва sudo без пароль."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účet, kterým byl server přidán, musí být root nebo povoluje sudo bez hesla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontoen, som serveren blev tilføjet med, skal være root eller tilladt at bruge sudo uden adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Konto, mit dem der Server hinzugefügt wurde, muss root sein oder sudo ohne Passwort nutzen dürfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο λογαριασμός με τον οποίο προστέθηκε ο διακομιστής πρέπει να είναι root ή να επιτρέπει sudo χωρίς κωδικό πρόσβασης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta con la que se agregó el servidor debe ser root o permitir usar sudo sin contraseña."
          }
