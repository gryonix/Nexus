        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moottori menee kotikoneelle, jossa näytönohjain voi tehdä työn; tämä palvelin vain välittää."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
