    "A board sensor measures the processor; disks, memory, the board and the power supply's losses are added from the machine's parts." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сензор на платката измерва процесора; дисковете, паметта, платката и загубите на захранването се добавят по частите."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senzor na desce měří procesor; disky, paměť, deska a ztráty zdroje se doplní podle součástí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En sensor på bundkortet måler processoren; diske, hukommelse, bundkort og strømforsyningens tab lægges til ud fra delene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Sensor auf dem Mainboard misst den Prozessor; Laufwerke, Speicher, Mainboard und die Verluste des Netzteils werden aus den Bauteilen ergänzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας αισθητήρας της μητρικής μετρά τον επεξεργαστή· δίσκοι, μνήμη, μητρική και απώλειες τροφοδοτικού προστίθενται από τα εξαρτήματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sensor de la placa mide el procesador; los discos, la memoria, la placa y las pérdidas de la fuente se añaden a partir de las piezas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emaplaadi andur mõõdab protsessorit; kettad, mälu, emaplaat ja toiteploki kaod lisatakse osade põhjal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emolevyn anturi mittaa suoritinta; levyt, muisti, emolevy ja virtalähteen häviöt lisätään osien perusteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un capteur de la carte mesure le processeur ; les disques, la mémoire, la carte et les pertes de l'alimentation sont ajoutés d'après les composants."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomhaiseann braiteoir ar an gclár an próiseálaí; cuirtear na dioscaí, an chuimhne, an clár agus caillteanais an tsoláthair leis ó na codanna."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senzor na ploči mjeri procesor; diskovi, memorija, ploča i gubici napajanja dodaju se prema dijelovima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy alaplapi érzékelő a processzort méri; a lemezek, a memória, az alaplap és a tápegység vesztesége az alkatrészek alapján adódik hozzá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sensore sulla scheda misura il processore; dischi, memoria, scheda e perdite dell'alimentatore sono aggiunti in base ai componenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボードのセンサーがプロセッサーを測定します。ディスク、メモリ、ボード、電源の損失は部品から加算されます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plokštės jutiklis matuoja procesorių; diskai, atmintis, plokštė ir maitinimo bloko nuostoliai pridedami pagal dalis."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plates sensors mēra procesoru; diski, atmiņa, plate un barošanas bloka zudumi tiek pieskaitīti pēc daļām."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensor fuq il-bord ikejjel il-proċessur; id-diski, il-memorja, il-bord u t-telf tal-provvista jiżdiedu mill-partijiet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een sensor op het moederbord meet de processor; schijven, geheugen, moederbord en de verliezen van de voeding worden aangevuld uit de onderdelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czujnik na płycie mierzy procesor; dyski, pamięć, płyta i straty zasilacza są doliczane na podstawie części."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um sensor da placa mede o processador; os discos, a memória, a placa e as perdas da fonte são somados a partir das peças."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un senzor de pe placă măsoară procesorul; discurile, memoria, placa și pierderile sursei se adaugă după componente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Датчик на плате измеряет процессор; диски, память, плата и потери блока питания добавляются по деталям машины."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senzor na doske meria procesor; disky, pamäť, doska a straty zdroja sa doplnia podľa súčastí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senzor na plošči meri procesor; diski, pomnilnik, plošča in izgube napajalnika se dodajo glede na dele."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En sensor på moderkortet mäter processorn; diskar, minne, moderkort och nätaggregatets förluster läggs till utifrån delarna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Датчик на платі вимірює процесор; диски, пам'ять, плата й втрати блока живлення додаються за деталями машини."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主板传感器测量处理器；磁盘、内存、主板和电源损耗根据部件补充计算。"
          }
        }
      }
    },
    "A card offers Wake up once its machine at home has not answered for this long, and only while this device is on that machine's network." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Картата предлага „Събуди“, когато домашната машина не отговаря толкова време — и само ако това устройство е в мрежата ѝ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta nabídne Probudit, když domácí stroj tak dlouho neodpovídá — a jen pokud je toto zařízení v jeho síti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et kort tilbyder Væk, når maskinen derhjemme ikke har svaret så længe — og kun når denne enhed er på maskinens netværk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Karte bietet „Aufwecken“ an, sobald ihr Rechner zu Hause so lange nicht geantwortet hat – und nur, wenn dieses Gerät im Netz dieses Rechners ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κάρτα προσφέρει «Αφύπνιση» όταν το μηχάνημα του σπιτιού δεν απαντά τόσο χρόνο — και μόνο όταν αυτή η συσκευή είναι στο δίκτυό του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tarjeta ofrece Despertar cuando su equipo de casa lleva este tiempo sin responder, y solo si este dispositivo está en la red de ese equipo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaart pakub „Ärata“, kui kodune masin pole nii kaua vastanud — ja ainult siis, kui see seade on selle masina võrgus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kortti tarjoaa Herätä, kun kodin kone ei ole vastannut näin pitkään — ja vain, kun tämä laite on koneen verkossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une carte propose Réveiller quand sa machine à la maison ne répond plus depuis ce délai, et seulement si cet appareil est sur le réseau de cette machine."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tairgeann cárta Múscail nuair nach bhfuil a meaisín sa bhaile tar éis freagairt chomh fada seo — agus ach amháin nuair atá an gléas seo ar líonra an mheaisín."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartica nudi Probudi kad kućno računalo toliko dugo ne odgovara — i samo dok je ovaj uređaj u njegovoj mreži."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kártya akkor kínálja a Felébresztést, ha az otthoni gép ennyi ideje nem válaszol — és csak ha ez az eszköz a gép hálózatán van."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una scheda offre Risveglia quando la sua macchina di casa non risponde da questo tempo, e solo se questo dispositivo è nella rete di quella macchina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自宅のマシンがこの時間応答しないと、カードに「起動」が表示されます。このデバイスがそのマシンのネットワークにいるときだけです。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kortelė siūlo „Pažadinti“, kai namų įrenginys tiek laiko neatsako — ir tik jei šis įrenginys yra jo tinkle."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartīte piedāvā “Pamodināt”, kad mājas dators tik ilgi neatbild — un tikai, ja šī ierīce ir tā tīklā."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta toffri Qajjem meta l-magna tad-dar ma tkunx wieġbet għal dan iż-żmien — u biss jekk dan it-tagħmir ikun fin-netwerk tagħha."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een kaart biedt Wekken aan zodra de machine thuis zo lang niet heeft geantwoord — en alleen als dit apparaat op het netwerk van die machine zit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta proponuje Obudź, gdy domowa maszyna milczy tak długo — i tylko wtedy, gdy to urządzenie jest w jej sieci."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um cartão oferece Acordar quando a máquina de casa não responde há este tempo, e só se este dispositivo estiver na rede dessa máquina."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cardul oferă Trezește când mașina de acasă nu a răspuns atâta timp — și doar dacă acest dispozitiv e în rețeaua ei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карточка предлагает «Разбудить», когда домашняя машина молчит столько времени, — и только если это устройство в сети этой машины."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta ponúkne Zobudiť, keď domáci stroj tak dlho neodpovedá — a len ak je toto zariadenie v jeho sieti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartica ponudi Zbudi, ko domači računalnik toliko časa ne odgovarja — in le, ko je ta naprava v njegovem omrežju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett kort erbjuder Väck när maskinen hemma inte har svarat så länge — och bara när den här enheten är på maskinens nätverk."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Картка пропонує «Розбудити», коли домашня машина мовчить стільки часу, — і лише якщо цей пристрій у мережі цієї машини."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家中的机器在这段时间内没有响应时，卡片会显示“唤醒”——仅当本设备在那台机器的网络中时。"
          }
        }
      }
    },
    "A card says No connection once its server has not answered for this long. After the longer wait the app opens a new connection; on a slow mobile network, longer waits are gentler on the server." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Картата показва „Няма връзка“, когато сървърът ѝ не е отговарял толкова време. След по-дългото чакане приложението отваря нова връзка; при бавна мобилна мрежа по-дългото чакане щади сървъра."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta ukáže „Bez spojení“, když server tak dlouho neodpověděl. Po delším čekání aplikace otevře nové spojení; na pomalé mobilní síti delší čekání šetří server."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et kort viser “Ingen forbindelse”, når serveren ikke har svaret så længe. Efter den længere ventetid åbner appen en ny forbindelse; på et langsomt mobilnet skåner længere ventetider serveren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Karte zeigt „Keine Verbindung“, sobald ihr Server so lange nicht geantwortet hat. Nach der längeren Wartezeit baut die App eine neue Verbindung auf; in einem langsamen Mobilnetz schonen längere Zeiten den Server."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια κάρτα δείχνει «Χωρίς σύνδεση» όταν ο διακομιστής της δεν έχει απαντήσει για τόσο διάστημα. Μετά τη μεγαλύτερη αναμονή η εφαρμογή ανοίγει νέα σύνδεση· σε αργό δίκτυο κινητής, οι μεγαλύτερες αναμονές επιβαρύνουν λιγότερο τον διακομιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tarjeta muestra «Sin conexión» cuando su servidor no ha respondido durante este tiempo. Tras la espera más larga, la app abre una conexión nueva; en una red móvil lenta, esperas más largas cuidan el servidor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaart näitab „Ühendus puudub“, kui server pole nii kaua vastanud. Pärast pikemat ootamist avab rakendus uue ühenduse; aeglases mobiilivõrgus säästavad pikemad ootamised serverit."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kortti näyttää ”Ei yhteyttä”, kun palvelin ei ole vastannut näin pitkään aikaan. Pidemmän odotuksen jälkeen sovellus avaa uuden yhteyden; hitaassa mobiiliverkossa pidemmät odotukset säästävät palvelinta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une carte affiche « Pas de connexion » quand son serveur n'a pas répondu pendant ce temps. Après l'attente la plus longue, l'app ouvre une nouvelle connexion ; sur un réseau mobile lent, des attentes plus longues ménagent le serveur."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taispeánann cárta “Gan nasc” nuair nach bhfuil freagra tugtha ag a fhreastalaí ar feadh an ama seo. Tar éis na feithimh is faide, osclaíonn an aip nasc nua; ar líonra móibíleach mall, is éadroime ar an bhfreastalaí feithimh níos faide."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartica prikazuje „Nema veze” kad poslužitelj ne odgovara ovoliko dugo. Nakon duljeg čekanja aplikacija otvara novu vezu; na sporoj mobilnoj mreži dulje čekanje štedi poslužitelj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kártya „Nincs kapcsolat” feliratot mutat, ha a szerver ennyi ideig nem válaszol. A hosszabb várakozás után az app új kapcsolatot nyit; lassú mobilhálózaton a hosszabb várakozás kíméli a szervert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una scheda mostra «Nessuna connessione» quando il suo server non risponde da questo tempo. Dopo l'attesa più lunga l'app apre una nuova connessione; su una rete mobile lenta, attese più lunghe pesano meno sul server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーがこの時間応答しないと、カードに「接続なし」と表示されます。長いほうの待ち時間が過ぎると、アプリは新しく接続し直します。遅いモバイル回線では、長めにするとサーバーへの負担が減ります。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kortelė rodo „Nėra ryšio“, kai serveris tiek laiko neatsako. Po ilgesnio laukimo programa atidaro naują ryšį; lėtame mobiliajame tinkle ilgesnis laukimas tausoja serverį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartīte rāda “Nav savienojuma”, kad serveris tik ilgi nav atbildējis. Pēc garākās gaidīšanas lietotne atver jaunu savienojumu; lēnā mobilajā tīklā ilgāka gaidīšana saudzē serveri."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta turi “L-ebda konnessjoni” meta s-server tagħha ma weġibx għal dan iż-żmien. Wara l-istennija itwal, l-app tiftaħ konnessjoni ġdida; fuq netwerk mobbli bil-mod, stennija itwal hija eħfef fuq is-server."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een kaart toont ‘Geen verbinding’ zodra de server zo lang niet heeft geantwoord. Na de langere wachttijd opent de app een nieuwe verbinding; op een traag mobiel netwerk sparen langere wachttijden de server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta pokazuje „Brak połączenia”, gdy serwer nie odpowiada przez tyle czasu. Po dłuższym czasie aplikacja otwiera nowe połączenie; w wolnej sieci komórkowej dłuższe oczekiwanie oszczędza serwer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um cartão mostra «Sem ligação» quando o servidor não responde durante este tempo. Após a espera mais longa, a app abre uma nova ligação; numa rede móvel lenta, esperas mais longas poupam o servidor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un card afișează „Fără conexiune” când serverul nu a răspuns atâta timp. După așteptarea mai lungă, aplicația deschide o conexiune nouă; într-o rețea mobilă lentă, așteptările mai lungi menajează serverul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карточка пишет «Нет связи», когда сервер молчит столько времени. После более долгого ожидания приложение открывает новое подключение; на медленном мобильном интернете долгое ожидание бережёт сервер."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta ukáže „Bez spojenia“, keď server toľko času neodpovedal. Po dlhšom čakaní aplikácia otvorí nové spojenie; na pomalej mobilnej sieti dlhšie čakanie šetrí server."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartica pokaže »Ni povezave«, ko strežnik tako dolgo ne odgovori. Po daljšem čakanju aplikacija odpre novo povezavo; v počasnem mobilnem omrežju daljše čakanje prizanese strežniku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett kort visar ”Ingen anslutning” när servern inte har svarat så länge. Efter den längre väntan öppnar appen en ny anslutning; på ett långsamt mobilnät skonar längre väntan servern."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Картка пише «Немає зв'язку», коли сервер мовчить стільки часу. Після довшого очікування застосунок відкриває нове підключення; на повільному мобільному інтернеті довше очікування береже сервер."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器在这段时间内没有响应时，卡片显示“无连接”。超过较长的等待时间后，应用会建立新连接；在较慢的移动网络上，等待更久对服务器更友好。"
          }
        }
      }
    },
    "A continent ticks every region under it. The number on each row is how many of its countries are picked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kontinent wählt alle seine Regionen aus. Die Zahl in jeder Zeile zeigt, wie viele seiner Länder gewählt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un continente marca todas sus regiones. El número de cada fila indica cuántos de sus países están elegidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un continent coche toutes ses régions. Le nombre sur chaque ligne indique combien de ses pays sont choisis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un continente seleziona tutte le sue regioni. Il numero su ogni riga dice quanti dei suoi paesi sono scelti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大陸を選ぶと、その下のすべての地域が選ばれます。各行の数字は、選ばれている国の数です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Континент отмечает все свои регионы. Число в строке — сколько его стран выбрано."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Континент позначає всі свої регіони. Число в рядку — скільки його країн вибрано."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择大洲会选中其下所有地区。每行的数字是已选国家的数量。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maanosa merkitsee kaikki sen alla olevat alueet. Rivin luku kertoo, kuinka monta sen maata on valittu."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Континент отмята всеки регион под себе си. Числото на всеки ред показва колко от неговите държави са избрани."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontinent označava svaku regiju ispod sebe. Broj u svakom retku pokazuje koliko je njegovih zemalja odabrano."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celina označi vsako regijo pod seboj. Število v vsaki vrstici pove, koliko njenih držav je izbranih."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et kontinent afkrydser hver region under det. Tallet på hver række viser, hvor mange af dets lande der er valgt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een continent vinkt elke regio eronder aan. Het getal op elke rij geeft aan hoeveel van de landen zijn gekozen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kontinent bockar för alla regioner under sig. Siffran på varje rad visar hur många av dess länder som är valda."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manner märgib kõik selle all olevad piirkonnad. Rea number näitab, mitu tema riiki on valitud."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuireann ilchríoch tic le gach réigiún atá fúithi. Is é an uimhir ar gach ró líon na dtíortha atá roghnaithe inti."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontinent jimmarka kull reġjun taħtu. In-numru f'kull ringiela huwa kemm mill-pajjiżi tiegħu huma magħżula."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um continente marca todas as regiões que contém. O número em cada linha indica quantos dos seus países estão selecionados."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια ήπειρος επιλέγει κάθε περιοχή από κάτω της. Ο αριθμός σε κάθε γραμμή δείχνει πόσες χώρες της είναι επιλεγμένες."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kontinens kijelöli az alá tartozó minden régiót. A soronkénti szám azt mutatja, hány országa van kiválasztva."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un continent bifează fiecare regiune de sub el. Numărul de pe fiecare rând arată câte țări din el sunt selectate."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontynent zaznacza każdy region pod sobą. Liczba w każdym wierszu to liczba wybranych w nim krajów."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontinent zaškrtne každý region pod sebou. Číslo u každého řádku udává, kolik jeho zemí je vybráno."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontinent zaškrtne každý región pod sebou. Číslo pri každom riadku udáva, koľko jeho krajín je vybraných."
          }
