    "Every account is closed by the switch above. Turn it off to decide account by account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Konto ist durch den Schalter oben geschlossen. Schalten Sie ihn aus, um Konto für Konto zu entscheiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las cuentas están cerradas por el interruptor de arriba. Desactívelo para decidir cuenta por cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les comptes sont fermés par l'interrupteur ci-dessus. Désactivez-le pour décider compte par compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti gli account sono chiusi dall'interruttore qui sopra. Disattivalo per decidere account per account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上のスイッチによって、すべてのアカウントが閉じられています。アカウントごとに決めるには、それをオフにしてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все учётные записи закрыты переключателем выше. Выключите его, чтобы решать по каждой отдельно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі облікові записи закриті перемикачем вище. Вимкніть його, щоб вирішувати щодо кожного окремо."
          }
        },
        "zh" : {
          "stringUnit" : {
