          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesita unos 8 GB de memoria por sí solo y varios minutos para su primer arranque. Forgejo es el mismo alojamiento git con una fracción de eso."
          }
        },
        "fr" : {
          "stringUnit" : {
