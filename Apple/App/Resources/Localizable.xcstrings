            "state" : "translated",
            "value" : "Ikonen på hemskärmen. iOS bekräftar ändringen själv."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikona na početnom zaslonu. iOS sam potvrđuje promjenu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikona na začetnem zaslonu. iOS sam potrdi spremembo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kezdőképernyőn lévő ikon. Az iOS maga erősíti meg a változtatást."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikona na ploše. iOS změnu sám potvrdí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikoon avakuval. iOS kinnitab muudatuse ise."
          }
        },
        "pl" : {
          "stringUnit" : {
