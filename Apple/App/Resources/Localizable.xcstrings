    "Every backup of the service is deleted permanently. Its live data stays. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Backups des Dienstes werden dauerhaft gelöscht. Seine aktiven Daten bleiben erhalten. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las copias de seguridad del servicio se eliminan permanentemente. Sus datos activos permanecen. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les sauvegardes du service sont supprimées définitivement. Ses données actives sont conservées. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i backup del servizio vengono eliminati definitivamente. I suoi dati attivi restano. L'operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービスのすべてのバックアップが完全に削除されます。稼働中のデータは残ります。この操作は取り消せません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все бэкапы сервиса удаляются безвозвратно. Его рабочие данные остаются. Это действие нельзя отменить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі резервні копії сервісу видаляються безповоротно. Його робочі дані залишаються. Цю дію не можна скасувати."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务的所有备份将被永久删除。其运行数据将保留。此操作无法撤销。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen palvelun varmuuskopio poistetaan pysyvästi. Sen elävä data säilyy. Tätä ei voi perua."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всички резервни копия на услугата се изтриват окончателно. Живите ѝ данни остават. Това не може да бъде отменено."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke back-up van de dienst wordt definitief verwijderd. De actieve gegevens blijven staan. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle sikkerhedskopier af tjenesten slettes permanent. Dens aktive data forbliver. Dette kan ikke fortrydes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla säkerhetskopior av tjänsten tas bort permanent. Dess aktiva data finns kvar. Det här kan inte ångras."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaka sigurnosna kopija usluge trajno se briše. Njeni trenutni podaci ostaju. Ovo se ne može poništiti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsaka varnostna kopija storitve se trajno izbriše. Njeni trenutni podatki ostanejo. Tega ni mogoče razveljaviti."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare backup al serviciului este șters permanent. Datele sale active rămân. Această acțiune nu poate fi anulată."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szolgáltatás minden biztonsági mentése véglegesen törlődik. Az élő adatai megmaradnak. Ez nem vonható vissza."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda kopia zapasowa usługi jest trwale usuwana. Jej bieżące dane pozostają. Tego nie da się cofnąć."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá záloha služby je trvale smazána. Její živá data zůstávají. Toto nelze vrátit zpět."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teenuse iga varukoopia kustutatakse jäädavalt. Selle jooksvad andmed jäävad alles. Seda ei saa tagasi võtta."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá záloha služby sa natrvalo odstráni. Jej živé dáta zostanú zachované. Toto sa nedá vrátiť späť."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as cópias de segurança do serviço são eliminadas permanentemente. Os seus dados em direto permanecem. Isto não pode ser desfeito."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε αντίγραφο ασφαλείας της υπηρεσίας διαγράφεται οριστικά. Τα ενεργά δεδομένα της παραμένουν. Αυτό δεν αναιρείται."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visi pakalpojuma dublējumi tiek dzēsti neatgriezeniski. Tā aktīvie dati paliek. Šo darbību nevar atsaukt."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scriostar gach cúltaca den tseirbhís go buan. Fanann a sonraí beo. Ní féidir é seo a chur ar ceal."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kull backup tas-servizz jitħassar b'mod permanenti. Id-data ħajja tibqa'. Dan ma jistax jitħassar lura."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visos paslaugos atsarginės kopijos ištrinamos visam laikui. Jos aktyvūs duomenys lieka. Šio veiksmo atšaukti negalima."
          }
        }
      }
    },
