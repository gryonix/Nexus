    },
    "Tap a disk to see its serial number, format it or make its light blink." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докосни диск, за да видиш серийния му номер, да го форматираш или да накараш лампичката му да мига."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na disk zobrazíte sériové číslo, naformátujete ho nebo rozblikáte kontrolku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på en disk for at se serienummeret, formatere den eller få lyset til at blinke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Festplatte, um ihre Seriennummer zu sehen, sie zu formatieren oder ihr Licht blinken zu lassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτησε έναν δίσκο για να δεις τον σειριακό του αριθμό, να τον μορφοποιήσεις ή να αναβοσβήσει η λυχνία του."
