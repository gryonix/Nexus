          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda sem conta DNS. Adicione uma para publicar os registos gerados diretamente na sua zona, em vez de exportar um ficheiro de zona e o importar manualmente."
          }
        },
        "ro" : {
          "stringUnit" : {
