    "Pick as many as you need — they run side by side." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie so viele, wie Sie brauchen — sie laufen nebeneinander."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige tantos como necesites: funcionan uno junto a otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez-en autant que nécessaire — ils fonctionnent côte à côte."
