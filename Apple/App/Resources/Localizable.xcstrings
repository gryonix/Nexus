        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet de diensten aan die je achter één login wilt — ze verschijnen hier."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
