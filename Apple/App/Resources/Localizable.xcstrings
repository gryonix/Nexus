    "%1$@ now runs on %2$@. The old copy is stopped and its data kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ вече работи на %2$@. Старото копие е спряно, а данните му са запазени."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nyní běží na %2$@. Stará kopie je zastavená a její data zůstala zachována."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kører nu på %2$@. Den gamle kopi er stoppet, og dens data er bevaret."
