    "Create a Personal Access Token from the GoDaddy Developer dashboard. It is kept in the Keychain on this device and used only to write the records above." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie ein Personal Access Token im GoDaddy Developer Dashboard. Es wird im Schlüsselbund dieses Geräts gespeichert und nur zum Schreiben der obigen Einträge verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cree un Personal Access Token en el panel de GoDaddy Developer. Se guarda en el Llavero de este dispositivo y solo se usa para escribir los registros anteriores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez un Personal Access Token depuis le tableau de bord GoDaddy Developer. Il est conservé dans le trousseau de cet appareil et sert uniquement à écrire les enregistrements ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un Personal Access Token dalla dashboard GoDaddy Developer. Viene conservato nel portachiavi di questo dispositivo e usato solo per scrivere i record qui sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GoDaddy Developer ダッシュボードで Personal Access Token を作成してください。トークンはこの端末のキーチェーンに保存され、上記のレコードを書き込むためだけに使われます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте Personal Access Token в панели GoDaddy Developer. Он хранится в Keychain этого устройства и используется только для записи перечисленных выше записей."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створіть Personal Access Token у панелі GoDaddy Developer. Він зберігається в Keychain цього пристрою й використовується лише для запису наведених вище записів."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 GoDaddy Developer 控制台创建一个 Personal Access Token。令牌保存在本设备的钥匙串中，仅用于写入上述记录。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo henkilökohtainen käyttöoikeustoken GoDaddyn kehittäjänäkymästä. Se säilytetään tämän laitteen avainnipussa ja sitä käytetään vain yllä olevien tietueiden kirjoittamiseen."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Създайте личен токен за достъп от таблото на GoDaddy Developer. Той се съхранява в Keychain на това устройство и се използва само за записване на записите по-горе."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izradite osobni pristupni token na GoDaddy Developer nadzornoj ploči. Čuva se u Keychainu na ovom uređaju i koristi se samo za zapisivanje gornjih zapisa."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustvarite osebni žeton za dostop v nadzorni plošči GoDaddy Developer. Shranjen je v Keychainu te naprave in se uporablja samo za zapisovanje zgornjih zapisov."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret en Personal Access Token fra GoDaddy Developer-dashboardet. Den opbevares i nøgleringen på denne enhed og bruges kun til at skrive posterne ovenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een Personal Access Token aan via het GoDaddy Developer-dashboard. Deze wordt bewaard in de Sleutelhanger op dit apparaat en alleen gebruikt om de records hierboven te schrijven."
          }
        },
        "sv" : {
