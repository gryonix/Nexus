          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historik indsamles på serveren; længere perioder fyldes med tiden."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historik samlas in på servern; längre perioder fylls i med tiden."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povijest se prikuplja na poslužitelju; duži rasponi se popunjavaju tijekom vremena."
