    "Takes hours on big disks. The server keeps working, and you can close the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При големи дискове отнема часове. Сървърът продължава да работи и можеш да затвориш приложението."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na velkých discích trvá hodiny. Server dál běží a aplikaci můžete zavřít."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tager timer på store diske. Serveren kører videre, og du kan lukke appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dauert bei großen Festplatten Stunden. Der Server arbeitet weiter, und du kannst die App schließen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε μεγάλους δίσκους διαρκεί ώρες. Ο διακομιστής συνεχίζει να δουλεύει και μπορείς να κλείσεις την εφαρμογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarda horas con discos grandes. El servidor sigue funcionando y puedes cerrar la app."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suurte ketaste puhul võtab tunde. Server töötab edasi ja rakenduse võib sulgeda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isoilla levyillä kestää tunteja. Palvelin toimii edelleen, ja voit sulkea sovelluksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prend des heures sur de gros disques. Le serveur continue de tourner et tu peux fermer l'app."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tógann sé uaireanta ar dhioscaí móra. Leanann an freastalaí ag obair, agus is féidir leat an aip a dhúnadh."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na velikim diskovima traje satima. Poslužitelj nastavlja raditi i možete zatvoriti aplikaciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagy lemezeken órákig tart. A szerver tovább működik, az alkalmazás bezárható."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede ore con dischi grandi. Il server continua a funzionare e puoi chiudere l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きなディスクでは数時間かかります。サーバーは動き続け、アプリを閉じてもかまいません。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dideliuose diskuose trunka valandas. Serveris veikia toliau, programą galima uždaryti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lielos diskos ilgst stundām. Serveris turpina strādāt, un lietotni var aizvērt."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuq diski kbar tieħu sigħat. Is-server jibqa' jaħdem, u tista' tagħlaq l-app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duurt uren op grote schijven. De server blijft werken en je kunt de app sluiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
