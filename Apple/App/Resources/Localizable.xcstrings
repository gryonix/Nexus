    "Connects to %@ directly, without looking up the domain. If the server's address changes, switch back to the domain name." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свързва се директно с %@, без да търси домейна. Ако адресът на сървъра се промени, върнете се към името на домейна."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojuje se přímo k %@ bez vyhledání domény. Pokud se adresa serveru změní, přepněte zpět na název domény."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbinder direkte til %@ uden at slå domænet op. Hvis serverens adresse ændres, så skift tilbage til domænenavnet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindet direkt mit %@, ohne die Domain nachzuschlagen. Ändert sich die Adresse des Servers, wechsle zurück zum Domainnamen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέεται απευθείας στο %@, χωρίς αναζήτηση του τομέα. Αν αλλάξει η διεύθυνση του διακομιστή, επιστρέψτε στο όνομα τομέα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conecta directamente a %@, sin buscar el dominio. Si cambia la dirección del servidor, vuelve al nombre de dominio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ühendub otse aadressiga %@, domeeni otsimata. Kui serveri aadress muutub, vali uuesti domeeninimi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistää suoraan osoitteeseen %@ hakematta verkkotunnusta. Jos palvelimen osoite muuttuu, vaihda takaisin verkkotunnukseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se connecte directement à %@, sans résoudre le domaine. Si l'adresse du serveur change, revenez au nom de domaine."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceanglaíonn sé go díreach le %@, gan an fearann a chuardach. Má athraíonn seoladh an fhreastalaí, téigh ar ais chuig an ainm fearainn."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povezuje se izravno na %@, bez traženja domene. Ako se adresa poslužitelja promijeni, vratite se na naziv domene."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Közvetlenül a(z) %@ címhez csatlakozik, a domain feloldása nélkül. Ha a szerver címe megváltozik, válts vissza a domainnévre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si connette direttamente a %@, senza risolvere il dominio. Se l'indirizzo del server cambia, torna al nome di dominio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドメインを調べずに %@ に直接接続します。サーバーのアドレスが変わったら、ドメイン名に戻してください。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jungiasi tiesiai prie %@, neieškodamas domeno. Jei serverio adresas pasikeis, grįžkite prie domeno vardo."
          }
