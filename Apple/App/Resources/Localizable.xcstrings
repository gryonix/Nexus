    "WireGuard only — other VPN protocols do not reach them" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur WireGuard — andere VPN-Protokolle erreichen sie nicht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo WireGuard: los demás protocolos VPN no llegan a ellos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WireGuard uniquement — les autres protocoles VPN n'y accèdent pas"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo WireGuard — gli altri protocolli VPN non li raggiungono"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WireGuard のみ — 他の VPN プロトコルからは届きません"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только WireGuard — другие протоколы VPN до них не доходят"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише WireGuard — інші протоколи VPN до них не доходять"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅限 WireGuard——其他 VPN 协议无法访问"
