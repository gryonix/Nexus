        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сървърът избира навън и държи връзката отворена, така че сайтовете му работят от интернет дори зад рутер без публичен IP."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverul apelează în afară și menține conexiunea deschisă, astfel încât site-urile lui funcționează de pe internet chiar și în spatele unui router fără IP public."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj bira izlaz i drži vezu otvorenom, tako da njegove stranice rade s interneta čak i iza usmjerivača bez javnog IP-a."
