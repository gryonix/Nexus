        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här serverns intrångsskydd gick inte att nå — det är kanske inte installerat, eller så är agenten för gammal för att rapportera det. Installera det här, kör inställningen igen, eller uppdatera agenten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się uzyskać dostępu do ochrony przed włamaniami tego serwera — może nie być zainstalowana albo agent może być zbyt stary, by ją zgłosić. Zainstaluj ją tutaj, uruchom ponownie konfigurację albo zaktualizuj agenta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K obraně proti narušení tohoto serveru se nepodařilo dostat — nemusí být nainstalována, nebo agent může být příliš starý na to, aby ji ohlásil. Nainstalujte ji zde, spusťte znovu nastavení, nebo aktualizujte agenta."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K obrane proti narušeniu tohto servera sa nepodarilo dostať — nemusí byť nainštalovaná, alebo agent môže byť príliš starý na to, aby ju ohlásil. Nainštalujte ju tu, spustite znova nastavenie, alebo aktualizujte agenta."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η επικοινωνία με την άμυνα κατά εισβολών αυτού του διακομιστή — ίσως δεν είναι εγκατεστημένη, ή ο agent να είναι πολύ παλιός για να την αναφέρει. Εγκατέστησέ την εδώ, τρέξε ξανά τη ρύθμιση, ή ενημέρωσε τον agent."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennek a szervernek a behatolásvédelme nem volt elérhető — lehet, hogy nincs telepítve, vagy az ügynök túl régi a jelentéséhez. Telepítsd itt, futtasd újra a beállítást, vagy frissítsd az ügynököt."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apărarea împotriva intruziunilor a acestui server nu a putut fi contactată — este posibil să nu fie instalată, sau agentul să fie prea vechi pentru a o raporta. Instaleaz-o aici, rulează din nou configurarea sau actualizează agentul."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível contactar a defesa contra intrusões deste servidor — pode não estar instalada, ou o agente pode ser demasiado antigo para a reportar. Instale-a aqui, volte a executar a configuração ou atualize o agente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle serveri sissetungikaitset ei õnnestunud ühendada — see ei pruugi olla installitud või agent võib olla liiga vana, et sellest teatada. Installi see siin, käivita seadistus uuesti või uuenda agenti."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níorbh fhéidir teacht ar chosaint ionraidh an fhreastalaí seo — b'fhéidir nach bhfuil sé suiteáilte, nó go bhfuil an gníomhaire róshean lena thuairisciú. Suiteáil anseo é, rith an socrú arís, nó nuashonraigh an gníomhaire."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma setax jintlaħaq id-difiża kontra l-intrużjoni ta' dan is-server — jista' jkun li mhux installat, jew li l-aġent qadim wisq biex jirrapportah. Installah hawn, erġa' mexxi s-setup, jew aġġorna l-aġent."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šī servera ielaušanās aizsardzību neizdevās sasniegt — iespējams, tā nav instalēta, vai aģents ir pārāk vecs, lai par to ziņotu. Instalējiet to šeit, palaidiet iestatīšanu vēlreiz vai atjauniniet aģentu."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šio serverio įsilaužimo apsaugos nepavyko pasiekti — ji gali būti neįdiegta, arba agentas gali būti per senas, kad apie tai praneštų. Įdiekite ją čia, paleiskite sąranką iš naujo arba atnaujinkite agentą."
          }
        }
      }
