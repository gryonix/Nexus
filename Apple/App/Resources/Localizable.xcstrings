    "Links your own phones, laptops and servers straight to each other, wherever they are. Nothing is published to the internet." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindet deine Telefone, Notebooks und Server direkt miteinander, wo sie auch sind. Nichts wird im Internet veröffentlicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta directamente tus teléfonos, portátiles y servidores, estén donde estén. No se publica nada en internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relie directement vos téléphones, portables et serveurs, où qu’ils soient. Rien n’est publié sur internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega direttamente i tuoi telefoni, portatili e server, ovunque siano. Nulla viene pubblicato su internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のスマホ・ノート PC・サーバーを、どこにあっても直接つなぎます。インターネットには何も公開しません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Связывает ваши телефоны, ноутбуки и серверы напрямую, где бы они ни были. В интернет ничего не публикуется."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пов’язує ваші телефони, ноутбуки та сервери напряму, де б вони не були. В інтернет нічого не публікується."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你自己的手机、笔记本和服务器直接连在一起，无论它们在哪里。不向互联网公开任何东西。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistää omat puhelimesi, kannettavasi ja palvelimesi suoraan toisiinsa, missä ikinä ne ovatkin. Mitään ei julkaista internetiin."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свързва собствените ви телефони, лаптопи и сървъри директно един с друг, където и да се намират. Нищо не се публикува в интернет."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindt je eigen telefoons, laptops en servers rechtstreeks met elkaar, waar ze zich ook bevinden. Niets wordt op internet gepubliceerd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbinder dine egne telefoner, bærbare og servere direkte med hinanden, uanset hvor de er. Intet offentliggøres på internettet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Länkar dina egna telefoner, bärbara datorer och servrar direkt till varandra, var de än befinner sig. Inget publiceras på internet."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povezuje vaše telefone, prijenosna računala i poslužitelje izravno jedne s drugima, gdje god bili. Ništa se ne objavljuje na internetu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neposredno povezuje vaše telefone, prenosnike in strežnike med seboj, kjer koli so. Nič se ne objavi na internetu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îți conectează direct telefoanele, laptopurile și serverele între ele, oriunde s-ar afla. Nimic nu este publicat pe internet."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Közvetlenül összeköti a telefonjaidat, laptopjaidat és szervereidet egymással, bárhol is legyenek. Semmi sem kerül publikálásra az internetre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Łączy Twoje telefony, laptopy i serwery bezpośrednio ze sobą, gdziekolwiek się znajdują. Nic nie jest publikowane w internecie."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propojuje vaše telefony, notebooky a servery přímo mezi sebou, ať jsou kdekoli. Nic se nezveřejňuje na internetu."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ühendab sinu telefonid, sülearvutid ja serverid otse omavahel, kus iganes need asuvad. Midagi ei avaldata internetti."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepája vaše telefóny, notebooky a servery priamo medzi sebou, nech sú kdekoľvek. Nič sa nezverejňuje na internet."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liga os seus telemóveis, portáteis e servidores diretamente entre si, onde quer que estejam. Nada é publicado na internet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέει απευθείας τα δικά σας τηλέφωνα, φορητούς υπολογιστές και διακομιστές μεταξύ τους, όπου κι αν βρίσκονται. Τίποτα δεν δημοσιεύεται στο διαδίκτυο."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Savieno jūsu tālruņus, klēpjdatorus un serverus tieši vienu ar otru, lai kur tie atrastos. Nekas netiek publicēts internetā."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascann sé do chuid fón, ríomhairí glúine agus freastalaithe féin díreach lena chéile, cibé áit a bhfuil siad. Ní fhoilsítear aon rud ar an idirlíon."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jgħaqqad il-mowbajls, il-laptops u s-servers tiegħek stess direttament ma' xulxin, kull fejn ikunu. Xejn ma jiġi ppubblikat fuq l-internet."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sujungia jūsų pačių telefonus, nešiojamus kompiuterius ir serverius tiesiogiai vienus su kitais, kad ir kur jie būtų. Niekas nepaskelbiama internete."
          }
        }
      }
    },
