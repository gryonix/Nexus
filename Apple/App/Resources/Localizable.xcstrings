    "The connection dropped; the server keeps building. Reconnecting…" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Връзката прекъсна; сървърът продължава изграждането. Свързване отново…"
