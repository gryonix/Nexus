    "CPU" : {
      "shouldTranslate" : false
    },
    "CPU, memory and disk can be shown together — they share one 0–100 % axis. Anything else is plotted on its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, Arbeitsspeicher und Datenträger lassen sich zusammen anzeigen — sie teilen sich eine Achse von 0–100 %. Alles andere wird für sich geplottet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, memoria y disco pueden mostrarse juntos: comparten un eje de 0–100 %. Cualquier otra métrica se representa por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le processeur, la mémoire et le disque peuvent être affichés ensemble : ils partagent un axe de 0 à 100 %. Toute autre mesure est tracée seule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, memoria e disco possono essere mostrati insieme: condividono un asse 0–100 %. Qualsiasi altra metrica viene tracciata da sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU・メモリ・ディスクは 0〜100 % の同じ軸を共有するため、まとめて表示できます。それ以外の指標は単独で描画されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процессор, память и диск показываются вместе — у них одна ось 0–100 %. Всё остальное строится отдельно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процесор, пам’ять і диск показуються разом — у них одна вісь 0–100 %. Усе інше будується окремо."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU、内存和磁盘可以一起显示，它们共用 0–100 % 的坐标轴。其他指标各自单独绘制。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, muisti ja levy voidaan näyttää yhdessä — ne jakavat yhden 0–100 %:n akselin. Kaikki muu piirretään omanaan."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, паметта и дискът могат да се показват заедно — те споделят една ос от 0–100 %. Всичко останало се начертава отделно."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, memorija i disk mogu se prikazati zajedno — dijele jednu os od 0–100 %. Sve ostalo se iscrtava zasebno."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPE, pomnilnik in disk je mogoče prikazati skupaj — delijo eno os od 0–100 %. Vse drugo se izriše ločeno."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, geheugen en schijf kunnen samen worden getoond — ze delen één as van 0–100%. Al het andere wordt apart uitgezet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, hukommelse og disk kan vises sammen — de deler én akse fra 0–100 %. Alt andet plottes for sig."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processor, minne och disk kan visas tillsammans — de delar en axel från 0–100 %. Allt annat plottas för sig."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, memoria și discul pot fi afișate împreună — partajează o singură axă 0–100 %. Orice altceva este reprezentat separat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, pamięć i dysk można pokazać razem — dzielą jedną oś 0–100%. Wszystko inne jest rysowane osobno."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, paměť a disk lze zobrazit společně — sdílejí jednu osu 0–100 %. Cokoli jiného je vykresleno samostatně."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU-d, mälu ja ketast saab näidata koos — need jagavad üht 0–100% telge. Kõike muud kuvatakse eraldi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A CPU, a memória és a lemez együtt jeleníthető meg — egy közös 0–100%-os tengelyen osztoznak. Minden más önállóan van ábrázolva."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, μνήμη και δίσκος μπορούν να εμφανιστούν μαζί — μοιράζονται έναν άξονα 0–100%. Οτιδήποτε άλλο σχεδιάζεται μόνο του."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, pamäť a disk je možné zobraziť spolu — zdieľajú jednu os 0 – 100 %. Všetko ostatné sa vykresľuje samostatne."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, memória e disco podem ser mostrados em conjunto — partilham um único eixo de 0–100 %. Qualquer outra coisa é representada à parte."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, atmiņu un disku var rādīt kopā — tiem ir viena 0–100 % ass. Viss pārējais tiek attēlots atsevišķi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is féidir CPU, cuimhne agus diosca a thaispeáint le chéile — roinneann siad ais 0–100 % amháin. Cuirtear aon rud eile ar a ais féin."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, memorja u disk jistgħu jintwerew flimkien — jaqsmu assi wieħed ta' 0–100 %. Kull ħaġa oħra tintwera fuq l-assi tagħha stess."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, atmintis ir diskas gali būti rodomi kartu — jie dalijasi viena 0–100 % ašimi. Viskas kita braižoma atskirai."
          }
        }
      }
    },
    "CPU, Memory and Disk can share one panel — they all read as a percentage. The others carry their own units, so picking one of them replaces the selection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, Arbeitsspeicher und Festplatte können sich ein Panel teilen — alle drei sind Prozentwerte. Die übrigen haben eigene Einheiten, deshalb ersetzt die Auswahl einer von ihnen die bisherige."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, Memoria y Disco pueden compartir un panel: los tres se leen en porcentaje. Las demás llevan sus propias unidades, así que elegir una de ellas sustituye la selección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processeur, mémoire et disque peuvent partager un panneau : les trois se lisent en pourcentage. Les autres ont leurs propres unités, donc en choisir une remplace la sélection."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, memoria e disco possono condividere un pannello: si leggono tutti in percentuale. Le altre hanno unità proprie, quindi sceglierne una sostituisce la selezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU・メモリ・ディスクは 1 つのパネルに同居できます（いずれもパーセント表示のため）。それ以外は独自の単位を持つので、選ぶと選択が置き換わります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, память и диск умещаются в одну панель — все трое читаются в процентах. У остальных свои единицы, поэтому выбор любой из них заменяет текущий набор."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, пам'ять і диск вміщуються в одну панель — усі троє читаються у відсотках. В інших свої одиниці, тож вибір будь-якої з них замінює поточний набір."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU、内存和磁盘可以共用一个面板——它们都以百分比读数。其他指标各有自己的单位，因此选中其中一个会替换当前选择。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, Muisti ja Levy voivat jakaa yhden paneelin — ne kaikki luetaan prosentteina. Muut kantavat omia yksiköitään, joten yhden valitseminen niistä korvaa valinnan."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, паметта и дискът могат да споделят един панел — всички се отчитат като процент. Останалите носят собствени единици, затова изборът на един от тях заменя избора."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, memorija i disk mogu dijeliti jedan panel — svi se očitavaju kao postotak. Ostali nose vlastite jedinice, pa odabir jednog od njih zamjenjuje odabir."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPE, pomnilnik in disk si lahko delijo en panel — vsi se berejo kot odstotek. Ostali nosijo lastne enote, zato izbira enega od njih zamenja izbiro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, geheugen en schijf kunnen één paneel delen — ze zijn allemaal een percentage. De andere hebben hun eigen eenheden, dus het kiezen van een van hen vervangt de selectie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, hukommelse og disk kan dele ét panel — de aflæses alle som en procent. De øvrige har deres egne enheder, så valg af en af dem erstatter markeringen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processor, minne och disk kan dela en panel — de läses alla av som procent. De övriga har egna enheter, så att välja en av dem ersätter urvalet."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, Memoria și Discul pot partaja un singur panou — toate se citesc ca procent. Celelalte au propriile unități, așa că alegerea uneia dintre ele înlocuiește selecția."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, Pamięć i Dysk mogą dzielić jeden panel — wszystkie odczytywane są jako procent. Pozostałe mają własne jednostki, więc wybranie jednej z nich zastępuje wybór."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, Paměť a Disk mohou sdílet jeden panel — všechny se čtou jako procento. Ostatní mají vlastní jednotky, takže výběr jedné z nich nahradí výběr."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, mälu ja ketas saavad jagada üht paneeli — need kõik loetakse protsendina. Ülejäänutel on omad ühikud, seega ühe neist valimine asendab valiku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A CPU, a Memória és a Lemez megoszthat egy panelt — mindegyik százalékként olvasható. A többiek saját mértékegységgel rendelkeznek, így az egyikük kiválasztása lecseréli a kijelölést."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, Μνήμη και Δίσκος μπορούν να μοιράζονται ένα πάνελ — διαβάζονται όλα ως ποσοστό. Τα υπόλοιπα έχουν τις δικές τους μονάδες, οπότε η επιλογή ενός από αυτά αντικαθιστά την επιλογή."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, pamäť a disk môžu zdieľať jeden panel — všetky sa čítajú ako percento. Ostatné majú vlastné jednotky, takže výberom jednej z nich sa výber nahradí."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, Memória e Disco podem partilhar um painel — todos se leem em percentagem. Os restantes têm as suas próprias unidades, pelo que escolher um deles substitui a seleção."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, atmiņa un disks var koplietot vienu paneli — tie visi tiek lasīti procentos. Pārējiem ir savas mērvienības, tāpēc, izvēloties kādu no tiem, izvēle tiek aizstāta."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is féidir le CPU, Cuimhne agus Diosca painéal amháin a roinnt — léitear iad go léir mar chéatadán. Iompraíonn na cinn eile a n-aonaid féin, mar sin cuireann roghnú ceann acu an roghnúchán in ionad a chéile."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, Memorja u Disk jistgħu jaqsmu panel wieħed — kollha jinqraw bħala perċentwal. L-oħrajn iġorru l-unitajiet tagħhom stess, għalhekk l-għażla ta' waħda minnhom tissostitwixxi l-għażla."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, atmintis ir diskas gali dalytis vienu skydeliu — visi jie skaitomi procentais. Kiti turi savo vienetus, todėl vieno iš jų pasirinkimas pakeičia ankstesnį pasirinkimą."
          }
        }
      }
    },
