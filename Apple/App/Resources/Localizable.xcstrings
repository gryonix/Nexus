          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogas atbild uz nospiešanu ar īsu klikšķi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freagraíonn cnaipí do bhrú le cnag gairid."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-buttuni jwieġbu għal press b'tokka qasira."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mygtukai atsako į paspaudimą trumpu virptelėjimu."
          }
        }
      }
    },
    "Buttons answer a press with a short tap. Only trackpads that support it can play one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasten antworten auf einen Druck mit einem kurzen Impuls. Nur Trackpads, die das unterstützen, können ihn wiedergeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los botones responden a la pulsación con un toque breve. Solo los trackpads compatibles pueden reproducirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les boutons répondent à l'appui par une brève impulsion. Seuls les trackpads compatibles peuvent la restituer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pulsanti rispondono alla pressione con un breve tocco. Solo i trackpad compatibili possono riprodurlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボタンを押すと短い振動で応えます。対応するトラックパッドでのみ再生されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопки отвечают на нажатие коротким откликом. Воспроизвести его умеют только трекпады с поддержкой."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопки відповідають на натискання коротким відгуком. Відтворити його можуть лише трекпади з підтримкою."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下按钮时会有短促的震动反馈。仅支持此功能的触控板才能播放。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Painikkeet vastaavat painallukseen lyhyellä napautuksella. Vain sitä tukevat ohjauslevyt voivat toistaa sen."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бутоните отговарят на натискане с кратко почукване. Само трекпадове, които го поддържат, могат да го възпроизведат."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumbi odgovaraju na pritisak kratkim dodirom. Samo trackpadi koji to podržavaju mogu ga reproducirati."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumbi na pritisk odgovorijo s kratkim dotikom. To lahko predvajajo samo sledilne ploščice, ki to podpirajo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knoppen beantwoorden een druk met een korte tik. Alleen trackpads die dit ondersteunen kunnen dit afspelen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knapper besvarer et tryk med et kort dunk. Kun trackpads, der understøtter det, kan afspille det."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knappar svarar på en tryckning med en kort knäpp. Endast styrplattor som stöder det kan spela upp en."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os botões respondem a uma pressão com um toque curto. Só trackpads que o suportem conseguem reproduzi-lo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Butoanele răspund la apăsare cu o vibrație scurtă. Doar trackpad-urile care o suportă o pot reda."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyciski odpowiadają na naciśnięcie krótkim stuknięciem. Tylko gładziki, które to obsługują, mogą je odtworzyć."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlačítka reagují na stisk krátkým ťuknutím. Přehrát ho mohou pouze trackpady, které to podporují."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlačidlá reagujú na stlačenie krátkym ťuknutím. Prehrať ho môžu iba trackpady, ktoré to podporujú."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nupud vastavad vajutusele lühikese koputusega. Seda saavad esitada ainult seda toetavad puuteplaadid."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gombok egy rövid koppintással válaszolnak a megnyomásra. Csak az ezt támogató trackpadek tudják lejátszani."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κουμπιά απαντούν σε ένα πάτημα με ένα σύντομο χτύπημα. Μόνο τα trackpad που το υποστηρίζουν μπορούν να το αναπαράγουν."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogas atbild uz nospiešanu ar īsu klikšķi. To var atskaņot tikai skārienpaliktņi, kas to atbalsta."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freagraíonn cnaipí do bhrú le cnag gairid. Ní féidir ach le rianphaidí a thacaíonn leis é a sheinm."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-buttuni jwieġbu għal press b'tokka qasira. Trackpads li jappoġġaw dan biss jistgħu jdoqquha."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mygtukai atsako į paspaudimą trumpu virptelėjimu. Tai gali atkurti tik tai palaikantys jutikliniai kilimėliai."
          }
        }
      }
    },
