    "Requests arrive here through the entry server's forwarded ports, and this machine answers them with its own certificate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anfragen erreichen diesen Server über die weitergeleiteten Ports des Eingangsservers, und diese Maschine beantwortet sie mit ihrem eigenen Zertifikat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las solicitudes llegan aquí a través de los puertos reenviados del servidor de entrada, y esta máquina las responde con su propio certificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les requêtes arrivent ici via les ports transmis par le serveur d'entrée, et cette machine y répond avec son propre certificat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le richieste arrivano qui tramite le porte inoltrate dal server di ingresso, e questa macchina risponde con il proprio certificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストはエントリーサーバーが転送するポートを通じてここに届き、このマシンは自身の証明書で応答します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запросы приходят сюда через проброшенные порты входного сервера, и эта машина отвечает на них своим собственным сертификатом."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запити надходять сюди через прокинуті порти вхідного сервера, і ця машина відповідає на них своїм власним сертифікатом."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求通过入口服务器转发的端口到达这里，本机以自己的证书作出响应。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyynnöt saapuvat tänne sisäänpääsypalvelimen välitettyjen porttien kautta, ja tämä kone vastaa niihin omalla sertifikaatillaan."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заявките пристигат тук през пренасочените портове на входния сървър, а тази машина им отговаря със собствен сертификат."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzoeken komen hier binnen via de doorgestuurde poorten van de ingangsserver, en deze machine beantwoordt ze met zijn eigen certificaat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forespørgsler ankommer hertil gennem indgangsserverens videresendte porte, og denne maskine besvarer dem med sit eget certifikat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förfrågningar anländer hit via ingångsserverns vidarebefordrade portar, och den här maskinen svarar med sitt eget certifikat."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cererile ajung aici prin porturile redirecționate ale serverului de intrare, iar această mașină le răspunde cu propriul certificat."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahtjevi ovdje stižu preko proslijeđenih portova ulaznog poslužitelja, a ovaj im stroj odgovara vlastitim certifikatom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahteve sem prispejo prek posredovanih vrat vstopnega strežnika, ta stroj pa nanje odgovori z lastnim potrdilom."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požiadavky sem prichádzajú cez presmerované porty vstupného servera a tento stroj na ne odpovedá vlastným certifikátom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kérések a belépési szerver továbbított portjain keresztül érkeznek ide, és ez a gép a saját tanúsítványával válaszol rájuk."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požadavky sem přicházejí přes přesměrované porty vstupního serveru a tento stroj na ně odpovídá svým vlastním certifikátem."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päringud jõuavad siia sisenemisserveri edastatud portide kaudu ja see masin vastab neile oma sertifikaadiga."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αιτήματα φτάνουν εδώ μέσω των προωθημένων θυρών του διακομιστή εισόδου, και αυτό το μηχάνημα τα απαντά με το δικό του πιστοποιητικό."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żądania docierają tutaj przez przekierowane porty serwera wejściowego, a ta maszyna odpowiada na nie własnym certyfikatem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pedidos chegam aqui através das portas reencaminhadas do servidor de entrada, e esta máquina responde-lhes com o seu próprio certificado."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieprasījumi šeit ienāk caur ieejas servera pārsūtītajiem portiem, un šī mašīna atbild ar savu sertifikātu."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sroicheann iarratais anseo trí phoirt curtha ar aghaidh an fhreastalaí iontrála, agus freagraíonn an meaisín seo iad lena dheimhniú féin."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Užklausos čia ateina per įėjimo serverio persiunčiamus prievadus, o ši mašina į jas atsako savo pačios sertifikatu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It-talbiet jaslu hawn permezz tal-ports mgħoddija tas-server tad-dħul, u din il-magna twieġeb bihom biċ-ċertifikat tagħha stess."
          }
        }
      }
    },
