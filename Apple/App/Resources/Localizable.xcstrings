        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-aġent ta' dan is-server huwa aktar antik minn din l-app u għad m'afhamx din l-azzjoni. Pveż fuq „Aġġorna l-aġent“ fil-lingwa Ġenerali tas-server u jaċċetta għal darbtejn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De agent van deze server is ouder dan deze app en kent deze actie nog niet. Tik op „Werk de agent bij“ op het tabblad Algemeen van de server en probeer het opnieuw."
          }
        },
        "pl" : {
