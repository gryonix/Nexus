    "History is collected on the server; longer ranges fill in over time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Verlauf wird auf dem Server gesammelt; längere Zeiträume füllen sich mit der Zeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial se recopila en el servidor; los rangos más largos se completan con el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique est collecté sur le serveur ; les plages plus longues se remplissent avec le temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo storico viene raccolto sul server; gli intervalli più lunghi si riempiono col tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴はサーバー側で収集されます。長い範囲は時間とともに蓄積されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История собирается на сервере; длинные диапазоны заполняются со временем."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Історія збирається на сервері; довші діапазони заповнюються з часом."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "历史数据在服务器端收集；较长的范围会随时间逐渐填满。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historia kerätään palvelimella; pidemmät jaksot täyttyvät ajan mittaan."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Историята се събира на сървъра; по-дълги диапазони се попълват с времето."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
