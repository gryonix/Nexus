    "A server is added only after it answers, so the deployment never holds a machine the app cannot reach." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Server wird erst hinzugefügt, wenn er antwortet — so hält das Deployment nie eine Maschine, die die App nicht erreicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un servidor se añade solo después de responder, para que el despliegue nunca guarde una máquina que la app no alcanza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un serveur n’est ajouté qu’après avoir répondu, afin que le déploiement ne contienne jamais une machine que l’app ne peut joindre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un server viene aggiunto solo dopo che risponde, così il deployment non contiene mai una macchina che l’app non raggiunge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバは応答してから追加されます。アプリが到達できないマシンをデプロイが抱えることはありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер добавляется только после ответа — развёртывание никогда не держит машину, до которой приложение не дотягивается."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер додається лише після відповіді — розгортання ніколи не тримає машину, до якої застосунок не дотягується."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器只有在应答后才会被添加，因此部署永远不会持有应用无法访问的机器。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin lisätään vasta sen jälkeen, kun se vastaa, joten käyttöönotto ei koskaan pidä konetta, jota sovellus ei tavoita."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сървър се добавя само след като отговори, така че разгръщането никога не задържа машина, която приложението не може да достигне."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj se dodaje tek nakon što odgovori, pa postavljanje nikad ne sadrži stroj koji aplikacija ne može dosegnuti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strežnik se doda šele, ko odgovori, zato postavitev nikoli ne vsebuje stroja, ki ga aplikacija ne more doseči."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En server tilføjes først, når den svarer, så udrulningen aldrig indeholder en maskine, appen ikke kan nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een server wordt pas toegevoegd nadat hij antwoordt, zodat de implementatie nooit een machine bevat die de app niet kan bereiken."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En server läggs bara till efter att den svarat, så driftsättningen aldrig håller en maskin appen inte kan nå."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy szerver csak azután kerül hozzáadásra, hogy válaszol, így a telepítés soha nem tartalmaz olyan gépet, amelyet az alkalmazás nem tud elérni."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un server este adăugat doar după ce răspunde, așa că implementarea nu conține niciodată o mașină pe care aplicația nu o poate accesa."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server lisatakse alles pärast vastamist, nii et paigaldus ei hoia kunagi masinat, mida rakendus ei suuda ühendada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um servidor só é adicionado depois de responder, para que a implantação nunca fique com uma máquina que a app não consegue alcançar."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní chuirtear freastalaí leis ach amháin tar éis dó freagra a thabhairt, ionas nach mbíonn meaisín ag an imlonnú riamh nach féidir leis an aip teacht air."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server jiżdied biss wara li jwieġeb, sabiex id-deployment qatt ma jkollha magna li l-app ma tistax tilħaq."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer jest dodawany dopiero po tym, jak odpowie, więc wdrożenie nigdy nie zawiera maszyny, do której aplikacja nie ma dostępu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server se přidá až poté, co odpoví, takže nasazení nikdy neobsahuje stroj, ke kterému se aplikace nedostane."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server sa pridá až po tom, čo odpovie, takže nasadenie nikdy neobsahuje stroj, ku ktorému sa aplikácia nedostane."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveris tiek pievienots tikai pēc tam, kad tas atbild, tāpēc izvietojumā nekad neietilpst dators, ko lietotne nevar sasniegt."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveris pridedamas tik po to, kai jis atsako, todėl diegime niekada nėra kompiuterio, kurio programa negali pasiekti."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας διακομιστής προστίθεται μόνο αφού απαντήσει, ώστε η ανάπτυξη να μην κρατά ποτέ μια μηχανή που η εφαρμογή δεν μπορεί να προσεγγίσει."
          }
        }
      }
    },
    "A server on your own network only — no public IP, no domain, a self-signed certificate. Mail and VPN aren't available, since both need to be reachable from outside." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Server nur in Ihrem eigenen Netzwerk — keine öffentliche IP, keine Domain, ein selbstsigniertes Zertifikat. Mail und VPN sind nicht verfügbar, da beide von außen erreichbar sein müssen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un servidor solo en tu propia red — sin IP pública, sin dominio, con un certificado autofirmado. El correo y la VPN no están disponibles, ya que ambos necesitan ser accesibles desde fuera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un serveur uniquement sur votre propre réseau — pas d'IP publique, pas de domaine, un certificat autosigné. La messagerie et le VPN ne sont pas disponibles, car tous deux doivent être joignables depuis l'extérieur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un server solo nella tua rete — nessun IP pubblico, nessun dominio, un certificato autofirmato. Posta e VPN non sono disponibili, perché entrambi devono essere raggiungibili dall'esterno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のネットワーク内だけで動くサーバーです — パブリックIPもドメインもなく、証明書は自己署名になります。メールとVPNは外部からの到達性が必要なため利用できません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер только в вашей собственной сети — без публичного IP, без домена, с самоподписанным сертификатом. Почта и VPN недоступны, так как обоим нужен доступ снаружи."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер лише у вашій власній мережі — без публічної IP-адреси, без домену, із самопідписаним сертифікатом. Пошта та VPN недоступні, оскільки обом потрібен доступ ззовні."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在您自己网络内运行的服务器 — 没有公网 IP，没有域名，使用自签名证书。邮件和 VPN 均需要从外部访问，因此不可用。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin vain omassa verkossasi — ei julkista IP:tä, ei verkkotunnusta, itseallekirjoitettu sertifikaatti. Posti ja VPN eivät ole käytettävissä, koska molemmat tarvitsevat tavoitettavuuden ulkopuolelta."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сървър само в собствената ви мрежа — без публичен IP, без домейн, самоподписан сертификат. Пощата и VPN не са налични, защото и двете трябва да са достижими отвън."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj samo u vlastitoj mreži — bez javnog IP-a, bez domene, samopotpisani certifikat. Pošta i VPN nisu dostupni, jer oboje treba biti dostupno izvana."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strežnik samo v vašem lastnem omrežju — brez javnega IP, brez domene, samopodpisano potrdilo. Pošta in VPN nista na voljo, ker morata biti oba dosegljiva od zunaj."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En server kun på dit eget netværk — ingen offentlig IP, intet domæne, et selvsigneret certifikat. Mail og VPN er ikke tilgængelige, da begge skal kunne nås udefra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een server alleen op je eigen netwerk — geen openbaar IP, geen domein, een zelfondertekend certificaat. Mail en VPN zijn niet beschikbaar, aangezien beide van buitenaf bereikbaar moeten zijn."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En server bara på ditt eget nätverk — ingen offentlig IP, ingen domän, ett självsignerat certifikat. Mejl och VPN är inte tillgängliga, eftersom båda måste kunna nås utifrån."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy szerver csak a saját hálózatodon — nincs nyilvános IP, nincs domain, önaláírt tanúsítvány. A levelezés és a VPN nem érhető el, mivel mindkettőnek kívülről elérhetőnek kell lennie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un server doar pe rețeaua ta — fără IP public, fără domeniu, un certificat autosemnat. Mail-ul și VPN-ul nu sunt disponibile, deoarece ambele trebuie să fie accesibile din exterior."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server ainult sinu enda võrgus — puudub avalik IP, puudub domeen, ise-allkirjastatud sertifikaat. Meil ja VPN pole saadaval, kuna mõlemad peavad olema väljastpoolt ühendatavad."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um servidor apenas na sua própria rede — sem IP público, sem domínio, um certificado autoassinado. O correio e a VPN não estão disponíveis, já que ambos precisam de ser alcançáveis a partir do exterior."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freastalaí ar do líonra féin amháin — gan IP poiblí, gan fearann, teastas féin-sínithe. Níl ríomhphost ná VPN ar fáil, ó theastaíonn go mbeidís sroichte ón taobh amuigh."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server fuq in-netwerk tiegħek stess biss — mingħajr IP pubbliku, mingħajr dominju, ċertifikat iffirmat awtomatikament. Il-posta u l-VPN mhumiex disponibbli, peress li t-tnejn jeħtieġu li jkunu aċċessibbli minn barra."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer tylko w Twojej własnej sieci — bez publicznego IP, bez domeny, z certyfikatem samopodpisanym. Poczta i VPN są niedostępne, ponieważ oba muszą być osiągalne z zewnątrz."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server pouze ve vaší vlastní síti — bez veřejné IP, bez domény, se samopodepsaným certifikátem. Pošta a VPN nejsou dostupné, protože obojí musí být dosažitelné zvenčí."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server iba vo vašej vlastnej sieti — bez verejnej IP, bez domény, so samopodpísaným certifikátom. Pošta a VPN nie sú dostupné, keďže obe musia byť dosiahnuteľné zvonku."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveris tikai jūsu paša tīklā — bez publiskas IP, bez domēna, pašparakstīts sertifikāts. Pasts un VPN nav pieejami, jo abiem jābūt sasniedzamiem no ārpuses."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveris tik jūsų pačių tinkle — jokio viešo IP, jokio domeno, savarankiškai pasirašytas sertifikatas. Paštas ir VPN neprieinami, nes abiem reikia būti pasiekiamiems iš išorės."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας διακομιστής μόνο στο δικό σας δίκτυο — χωρίς δημόσια IP, χωρίς domain, με αυτο-υπογεγραμμένο πιστοποιητικό. Το mail και το VPN δεν είναι διαθέσιμα, καθώς και τα δύο πρέπει να είναι προσβάσιμα από έξω."
          }
        }
      }
    },
    "A shell on this machine, under an account you choose. The Terminal tab is the same for every server at once — turn it on in Settings › Sections." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Shell auf dieser Maschine, unter einem Konto Ihrer Wahl. Der Terminal-Tab zeigt dasselbe für alle Server auf einmal — einschalten unter Einstellungen › Bereiche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un shell en esta máquina, con la cuenta que elija. La pestaña Terminal es lo mismo para todos los servidores a la vez: actívela en Ajustes › Secciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un shell sur cette machine, sous le compte de votre choix. L'onglet Terminal fait la même chose pour tous les serveurs à la fois — activez-le dans Réglages › Sections."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una shell su questa macchina, con l'account che scegli. La scheda Terminale fa lo stesso per tutti i server insieme: attivala in Impostazioni › Sezioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このマシン上のシェルを、選んだアカウントで開きます。ターミナルタブは全サーバー分をまとめて表示します（設定 › セクションで有効化）。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шелл на этой машине под аккаунтом, который вы выберете. Вкладка «Терминал» — то же самое сразу для всех серверов, включается в Настройках › Разделы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шел на цій машині під акаунтом, який ви оберете. Вкладка «Термінал» — те саме одразу для всіх серверів, вмикається в Налаштуваннях › Розділи."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这台机器上以你选择的账户打开 shell。终端标签页一次显示所有服务器——可在设置 › 分区中开启。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuori tällä koneella, valitsemasi tilin alla. Terminal-välilehti on sama kaikille palvelimille kerralla — kytke se päälle kohdassa Asetukset › Osiot."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обвивка на тази машина, под акаунт, който изберете. Разделът Терминал е един и същ за всеки сървър наведнъж — включете го в Настройки › Раздели."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljuska na ovom stroju, pod računom koji odaberete. Kartica Terminal ista je za sve poslužitelje odjednom — uključite je u Postavke › Odjeljci."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lupina na tem stroju, pod računom, ki ga izberete. Zavihek Terminal je enak za vse strežnike naenkrat — vklopite ga v Nastavitve › Razdelki."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En shell på denne maskine, under en konto, du vælger. Terminal-fanen er den samme for alle servere på én gang — slå den til i Indstillinger › Sektioner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een shell op deze machine, onder een account dat je kiest. Het Terminal-tabblad is voor elke server tegelijk hetzelfde — zet het aan in Instellingen › Secties."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett skal på den här maskinen, under ett konto du väljer. Terminal-fliken är samma för alla servrar samtidigt — slå på den i Inställningar › Sektioner."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy héj (shell) ezen a gépen, egy általad választott fiók alatt. A Terminál fül egyszerre azonos minden szerverhez — kapcsold be a Beállítások › Szakaszok alatt."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un shell pe această mașină, sub un cont pe care îl alegi. Fila Terminal este aceeași pentru toate serverele deodată — activeaz-o în Setări › Secțiuni."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell sellel masinal konto all, mille valid. Terminali vahekaart on korraga sama kõigi serverite jaoks — lülita see sisse jaotises Seaded › Sektsioonid."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma shell nesta máquina, sob a conta que escolher. O separador Terminal é o mesmo para todos os servidores ao mesmo tempo — ative-o em Definições › Secções."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blaosc ar an meaisín seo, faoi chuntas a roghnaíonn tú. Tá an cluaisín Teirminéal mar an gcéanna do gach freastalaí ag an am céanna — cas air é i Socruithe › Ranna."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell fuq din il-magna, taħt kont li tagħżel. It-tab tat-Terminal huwa l-istess għal kull server f'daqqa — ixgħelh fis-Settings › Sezzjonijiet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powłoka na tej maszynie, na koncie, które wybierzesz. Karta Terminal jest wspólna dla wszystkich serwerów naraz — włącz ją w Ustawienia › Sekcje."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell na tomto stroji, pod účtem, který zvolíte. Karta Terminál je společná pro všechny servery najednou — zapněte ji v Nastavení › Sekce."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell na tomto stroji, pod účtom, ktorý zvolíte. Karta Terminál je spoločná pre všetky servery naraz — zapnite ju v Nastavenia › Sekcie."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čaula šajā datorā, zem jūsu izvēlēta konta. Termināļa cilne ir vienāda visiem serveriem vienlaikus — ieslēdziet to sadaļā Iestatījumi › Sadaļas."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apvalkalas šiame kompiuteryje, jūsų pasirinktoje paskyroje. Terminalo skirtukas yra tas pats visiems serveriams vienu metu — įjunkite jį skiltyje Nustatymai › Skiltys."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα κέλυφος σε αυτή τη μηχανή, με λογαριασμό της επιλογής σας. Η καρτέλα Terminal είναι ίδια για όλους τους διακομιστές ταυτόχρονα — ενεργοποιήστε τη στις Ρυθμίσεις › Ενότητες."
          }
        }
      }
    },
