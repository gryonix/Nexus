    "Moving a service needs the server agent on every machine." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За преместване на услуга е нужен сървърният агент на всяка машина."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přesun služby vyžaduje serverového agenta na každém stroji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At flytte en tjeneste kræver serveragenten på hver maskine."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Verschieben eines Dienstes braucht jede Maschine den Server-Agenten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μετακίνηση μιας υπηρεσίας απαιτεί τον πράκτορα διακομιστή σε κάθε μηχάνημα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mover un servicio hace falta el agente del servidor en cada máquina."
          }
        },
        "et" : {
          "stringUnit" : {
