    "With the app's defaults, this server follows Settings → Notifications and keeps following it. Turn them off to choose for this server alone." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С настройките по подразбиране този сървър следва Настройки → Известия и промените им занапред. Изключете ги, за да изберете само за този сървър."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S výchozím nastavením se tento server řídí Nastavení → Oznámení, i jeho pozdějšími změnami. Vypněte ho a vyberte jen pro tento server."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med appens standarder følger denne server Indstillinger → Notifikationer, også når de ændres. Slå dem fra for at vælge for denne server alene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit den Standardeinstellungen der App folgt dieser Server Einstellungen → Benachrichtigungen, auch bei späteren Änderungen. Schalte sie aus, um nur für diesen Server zu wählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με τις προεπιλογές, αυτός ο διακομιστής ακολουθεί τις Ρυθμίσεις → Ειδοποιήσεις και τις αλλαγές τους. Απενεργοποιήστε τες για να επιλέξετε μόνο για αυτόν τον διακομιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con los ajustes predeterminados, este servidor sigue Ajustes → Notificaciones, también cuando cambien. Desactívalos para elegir solo para este servidor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaikeseadetega järgib see server Seaded → Teavitused ka edaspidi. Lülita need välja, et valida ainult selle serveri jaoks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletusasetuksilla tämä palvelin seuraa kohtaa Asetukset → Ilmoitukset myös jatkossa. Poista ne käytöstä valitaksesi vain tälle palvelimelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec les réglages par défaut, ce serveur suit Réglages → Notifications, y compris leurs changements futurs. Désactivez-les pour choisir pour ce serveur seul."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leis na réamhshocruithe, leanann an freastalaí seo Socruithe → Fógraí agus a n-athruithe. Múch iad chun rogha a dhéanamh don fhreastalaí seo amháin."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uz zadane postavke ovaj poslužitelj prati Postavke → Obavijesti i njihove buduće promjene. Isključite ih da biste birali samo za ovaj poslužitelj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alapbeállításokkal ez a szerver a Beállítások → Értesítések szerint működik, később is. Kapcsold ki, ha csak erre a szerverre akarsz választani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con le impostazioni predefinite, questo server segue Impostazioni → Notifiche, anche quando cambiano. Disattivale per scegliere solo per questo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既定の設定では、このサーバーは「設定 → 通知」に従い、変更後も従い続けます。オフにすると、このサーバーだけの設定を選べます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su numatytaisiais nustatymais šis serveris seka Nustatymai → Pranešimai ir jų pakeitimus. Išjunkite, kad pasirinktumėte tik šiam serveriui."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar noklusējuma iestatījumiem šis serveris seko sadaļai Iestatījumi → Paziņojumi arī turpmāk. Izslēdziet tos, lai izvēlētos tikai šim serverim."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bid-defaults tal-app, dan is-server isegwi Settings → Notifiki u l-bidliet tagħhom. Itfihom biex tagħżel għal dan is-server biss."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met de standaardinstellingen volgt deze server Instellingen → Meldingen, ook als die later veranderen. Zet ze uit om alleen voor deze server te kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z ustawieniami domyślnymi ten serwer stosuje Ustawienia → Powiadomienia, także po ich zmianie. Wyłącz je, aby wybrać tylko dla tego serwera."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com as predefinições, este servidor segue Definições → Notificações, mesmo quando mudam. Desative-as para escolher só para este servidor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cu setările implicite, acest server urmează Setări → Notificări și schimbările lor. Dezactivează-le ca să alegi doar pentru acest server."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С настройками по умолчанию этот сервер следует «Настройки → Уведомления» и дальше подхватывает их изменения. Выключите, чтобы выбрать только для этого сервера."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S predvoleným nastavením sa tento server riadi Nastavenia → Upozornenia aj po ich zmene. Vypnite ho a vyberte len pre tento server."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S privzetimi nastavitvami ta strežnik sledi Nastavitve → Obvestila, tudi ko se spremenijo. Izklopite jih, da izberete samo za ta strežnik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med appens standard följer den här servern Inställningar → Aviseringar, även när de ändras. Stäng av dem för att välja för den här servern ensam."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З типовими налаштуваннями цей сервер слідує «Налаштування → Сповіщення» і далі підхоплює їхні зміни. Вимкніть, щоб обрати лише для цього сервера."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用默认设置时，此服务器遵循“设置 → 通知”，之后的更改也会跟随。关闭后可单独为此服务器选择。"
          }
        }
      }
    },
