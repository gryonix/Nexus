        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogon ide na stroj kod kuće, gdje grafička kartica može obaviti posao; ovaj poslužitelj samo prosljeđuje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogon gre na stroj doma, kjer lahko grafična kartica opravi delo; ta strežnik le posreduje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motoren kører på maskinen derhjemme, hvor et grafikkort kan gøre arbejdet; denne server relæer bare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De engine draait op de machine thuis, waar een videokaart het werk kan doen; deze server geeft alleen door."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motorn körs på maskinen hemma, där ett grafikkort kan göra jobbet; den här servern bara vidarebefordrar."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téann an t-inneall ar an meaisín sa bhaile, áit ar féidir le cárta grafaicí an obair a dhéanamh; ní dhéanann an freastalaí seo ach athsheachadadh."
