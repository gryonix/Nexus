    "The agent installs on the server and keeps going if you close the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агентът се инсталира на сървъра и продължава да работи, ако затворите приложението."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
