        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-karta tibqa’ għaddejja għal 30 sekonda. Oħroġ mill-app jew sakkar it-telefon biex tarah fil-gżira."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kaart loopt 30 seconden. Verlaat de app of vergrendel de telefoon om hem op het eiland te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta działa przez 30 sekund. Wyjdź z aplikacji lub zablokuj telefon, aby zobaczyć ją na wyspie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão dura 30 segundos. Saia da app ou bloqueie o telefone para o ver na ilha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cardul rulează 30 de secunde. Ieșiți din aplicație sau blocați telefonul pentru a-l vedea pe insulă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карточка идёт 30 секунд. Сверните приложение или заблокируйте телефон, чтобы увидеть её на острове."
          }
        },
        "sk" : {
          "stringUnit" : {
