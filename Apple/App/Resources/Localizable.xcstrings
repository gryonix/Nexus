    "Estimated from the machine's parts and processor load: it has no power sensor." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценено от компонентите на машината и натоварването на процесора: няма датчик на мощност."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odhadnuto z částí stroje a zatížení procesoru: nemá senzor výkonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimeret ud fra maskinens dele og processorbelastning: den har ingen effektsensor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschätzt aus den Bauteilen und der Prozessorlast: Die Maschine hat keinen Leistungssensor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτιμώμενο από τα εξαρτήματα της μηχανής και τη φόρτιση του επεξεργαστή: δεν έχει αισθητήρα ισχύος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimado a partir de las partes de la máquina y la carga del procesador: no tiene sensor de potencia."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinnang masina osadest ja protsessori koormusest: ei ole energiasensorit."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvioitu koneen osista ja prosessorin kuormituksesta: sillä ei ole tehonsensoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimé à partir des pièces de la machine et de la charge du processeur : elle n'a pas de capteur de puissance."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measta ó na codanna an meisín agus ualach an phróiseálaithe: níl fáir cumhachta aici."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procijenjeno iz dijelova računala i opterećenja procesora: nema senzora snage."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gép alkatrészeibő és processzor terhelésből becsült: nincs energiaszenzora."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimato dalle parti della macchina e dal carico del processore: non ha un sensore di potenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マシンの部品とプロセッサ負荷から推定 : パワーセンサーはありません。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įvertinta iš mašinos dalių ir procesoriaus apkrovos: nėra energijos jutiklio."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novērtēts no mašīnas daļām un procesora slodzes: nav jaudas sensora."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stima mill-partijiet tal-magħina u t-tagħbija tal-proċessur: m'għandha l-ebda senzur tal-qawwa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
