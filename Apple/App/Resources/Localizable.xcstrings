          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij token, aby nim publikować; ołówek zawiera sam token, jego nazwę i dostawcę, do którego należy."
          }
        },
        "cs" : {
          "stringUnit" : {
