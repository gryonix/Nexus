        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein virtueller Server: Das ist sein Anteil am physischen Host. Den Strom bezahlt der Hosting-Anbieter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα εικονικό δserver: αυτό είναι το μερίδιό του στον φυσικό κεντρικό υπολογιστή. Ο πάροχος φιλοξενίας πληρώνει το ηλεκτρικό ρεύμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un servidor virtual: este es su porcentaje del host físico. El proveedor de alojamiento paga la electricidad."
