    "Version %@. Checks for a newer gryonixNexus and installs it after verifying its signature." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %@. Sucht nach einem neueren gryonixNexus und installiert es, nachdem die Signatur geprüft wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versión %@. Busca una versión más reciente de gryonixNexus y la instala tras verificar su firma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %@. Recherche un gryonixNexus plus récent et l’installe après avoir vérifié sa signature."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versione %@. Cerca un gryonixNexus più recente e lo installa dopo averne verificato la firma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バージョン %@。新しい gryonixNexus を確認し、署名を検証してからインストールします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версия %@. Ищет более новый gryonixNexus и устанавливает его после проверки подписи."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версія %@. Шукає новіший gryonixNexus і встановлює його після перевірки підпису."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
