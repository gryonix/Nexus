    "No free disk to put in. Add a new disk to the server, then pull down to read the disks again." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма свободен диск за поставяне. Добавете нов диск към сървъра, след това потегли надолу, за да преочетете дисковете."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Není volný disk k vložení. Přidejte nový disk na server, poté táhněte dolů, aby se disky přečetly znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet ledigt drev at sætte i. Tilføj en ny disk til serveren, træk derefter ned for at læse diskene igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine freie Platte zum Einsetzen. Baue eine neue Platte in den Server ein und ziehe dann nach unten, um die Platten neu einzulesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει ελεύθερος δίσκος για τοποθέτηση. Προσθέστε ένα νέο δίσκο στον διακομιστή, στη συνέχεια τραβήξτε προς τα κάτω για να ξαναδιαβάσετε τους δίσκους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin disco libre para poner. Agrega un nuevo disco al servidor, luego tira hacia abajo para leer los discos nuevamente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pole vaba ketta paigaldamiseks. Lisage serverisse uus ketas, seejärel tõmmake alla, et lugeda kettaid uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei vapaa levy upottamiseen. Lisää uusi levy palvelimelle, vedä sitten alas lukeaksesi levyt uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun disque libre à insérer. Ajoutez un nouveau disque au serveur, puis tirez vers le bas pour relire les disques."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gan diosca saor le chur isteach. Cuir diosca nua leis an bhfreastalaí, ansin tarraing síos chun na dioscaí a léamh arís."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema slobodnog diska za stavljanje. Dodajte novi disk serveru, zatim povucite prema dolje da ponovno pročitate diskove."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs szabad lemez a behelyezéshez. Adjon új lemezt a szerverhez, majd húzza le az alábbiakat, hogy újra olvassa el a lemezeket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun disco libero da mettere in. Aggiungi un nuovo disco al server, quindi tira verso il basso per leggere di nuovo i dischi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空きディスクがありません。サーバーに新しいディスクを追加し、下にプルしてディスクを再度読む。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nėra laisvos disko į dedamą. Pridėkite naują diską prie serverio, tada traukite žemyn, kad iš naujo perskaitytumėte diskus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nav brīva diska ievietošanai. Pievienojiet jaunus diskus serverim, tad vilkt lejup, lai atkārtoti nolasītu diskus."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-ebda disk ħieles biex tindaħħal. Żid disk ġdid mas-server, imbagħad ġbid isfel biex taqra d-disketti erġa'."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen vrije schijf om in te voegen. Voeg een nieuwe schijf toe aan de server, trek vervolgens omlaag om de schijven opnieuw in te lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak wolnego dysku do wstawienia. Dodaj nowy dysk do serwera, następnie pociągnij w dół, aby ponownie przeczytać dyski."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem disco livre para colocar. Adicione um novo disco ao servidor, depois puxe para baixo para ler os discos novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niciun disc liber de pus. Adaugă un disc nou la server, apoi trage în jos pentru a relua citirea discurilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет свободного диска для замены. Поставьте в сервер новый диск и потяните экран вниз, чтобы перечитать диски."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žiadny voľný disk na vloženie. Pridajte nový disk k serveru, potom potiahnite nadol, aby ste disky znova prečítali."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni prostega diska za vstavljanje. Dodajte novi disk strežniku, nato povlecite navzdol, da ponovno preberete diske."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen fri disk att sätta in. Lägg till en ny disk till servern, dra sedan ner för att läsa diskarna igen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає вільного диска для заміни. Додайте в сервер новий диск і потягніть екран униз, щоб перечитати диски."
          }
        },
        "zh" : {
          "stringUnit" : {
