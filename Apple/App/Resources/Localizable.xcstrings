    "This is a large backup. It can take a long time and will use as much disk space again while it runs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist eine große Sicherung. Sie kann lange dauern und belegt während des Laufs noch einmal so viel Speicherplatz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es una copia grande. Puede tardar mucho y ocupará otro tanto de disco mientras se ejecuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde est volumineuse. Elle peut être longue et occupera autant d’espace disque de plus pendant son exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo backup è grande. Può richiedere molto tempo e occuperà altrettanto spazio su disco mentre viene eseguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは大きなバックアップです。時間がかかり、実行中は同じだけのディスク容量を追加で使います。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это большая копия. Она может идти долго и на время прогона займёт столько же места на диске ещё раз."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це велика копія. Вона може тривати довго й на час прогону займе стільки ж місця на диску ще раз."
          }
        },
        "zh" : {
          "stringUnit" : {
