    "Check a service to install it on this run. The services already on the server keep their data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie einen Dienst, um ihn bei diesem Durchlauf zu installieren. Bereits auf dem Server vorhandene Dienste behalten ihre Daten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque un servicio para instalarlo en esta ejecución. Los servicios que ya están en el servidor conservan sus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cochez un service pour l'installer lors de cette exécution. Les services déjà présents sur le serveur conservent leurs données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona un servizio per installarlo in questa esecuzione. I servizi già presenti sul server mantengono i propri dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービスをチェックすると、この実行でインストールされます。サーバーに既にあるサービスはデータを保持します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметьте службу, чтобы установить её при этом запуске. Службы, уже имеющиеся на сервере, сохраняют свои данные."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позначте службу, щоб встановити її під час цього запуску. Служби, які вже є на сервері, зберігають свої дані."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾选某项服务即可在此次运行中安装它。服务器上已有的服务会保留其数据。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse palvelu asentaaksesi sen tällä ajolla. Palvelimella jo olevat palvelut säilyttävät datansa."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметнете услуга, за да я инсталирате в този процес. Услугите, които вече са на сървъра, запазват данните си."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označite uslugu da je instalirate u ovom pokretanju. Usluge koje su već na poslužitelju zadržavaju svoje podatke."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označite storitev, da jo namestite v tem poteku. Storitve, ki so že na strežniku, obdržijo svoje podatke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vink een dienst aan om die bij deze uitvoering te installeren. Diensten die al op de server staan, behouden hun gegevens."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markér en tjeneste for at installere den i dette forløb. Tjenester, der allerede er på serveren, beholder deres data."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markera en tjänst för att installera den i den här körningen. Tjänster som redan finns på servern behåller sina data."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assinale um serviço para o instalar nesta execução. Os serviços já no servidor mantêm os seus dados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bifează un serviciu pentru a-l instala în această rulare. Serviciile deja existente pe server își păstrează datele."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznacz usługę, aby zainstalować ją w tym przebiegu. Usługi już obecne na serwerze zachowują swoje dane."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaškrtněte službu, kterou chcete nainstalovat v tomto běhu. Služby již na serveru si zachovají svá data."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Märgi teenus, et see selle käivitusega paigaldada. Serveris juba olevad teenused säilitavad oma andmed."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelölj be egy szolgáltatást, hogy ebben a futtatásban telepítsd. A szerveren már meglévő szolgáltatások megtartják adataikat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε μια υπηρεσία για να την εγκαταστήσετε σε αυτή την εκτέλεση. Οι υπηρεσίες που υπάρχουν ήδη στον διακομιστή διατηρούν τα δεδομένα τους."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaškrtnutím služby ju nainštalujete pri tomto behu. Služby už bežiace na serveri si zachovajú svoje dáta."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atzīmējiet pakalpojumu, lai to instalētu šajā reizē. Pakalpojumi, kas jau ir serverī, saglabā savus datus."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuir tic le seirbhís chun í a shuiteáil sa rith seo. Coinníonn na seirbhísí atá ar an bhfreastalaí cheana féin a gcuid sonraí."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immarka servizz biex tinstallah f'din il-ġirja. Is-servizzi li huma diġà fuq is-server iżommu d-data tagħhom."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pažymėkite paslaugą, kad ji būtų įdiegta šio paleidimo metu. Jau serveryje esančios paslaugos išsaugo savo duomenis."
          }
        }
      }
    },
