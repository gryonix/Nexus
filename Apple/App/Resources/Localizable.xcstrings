          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このマシンが入口サーバの背後にある場合は入口サーバを選んでください（トンネル内、またはアプリが直接到達できないネットワーク上）。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите входной сервер, если эта машина стоит за ним — внутри туннеля или в сети, до которой приложение не дотягивается напрямую."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть вхідний сервер, якщо ця машина стоїть за ним — усередині тунелю або в мережі, до якої застосунок не дотягується напряму."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
