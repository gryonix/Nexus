          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun domaine n’est défini pour ce serveur, ses adresses ne peuvent donc pas être construites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
