    "—" : {
      "shouldTranslate" : false
    },
    "“%@” connects to %@, which the server “%@” already manages. Merging keeps its saved logins and removes the duplicate row." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ verbindet sich mit %@, das der Server „%@“ bereits verwaltet. Beim Zusammenführen bleiben die gespeicherten Anmeldungen erhalten und die doppelte Zeile verschwindet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» se conecta a %@, que el servidor «%@» ya gestiona. Al combinar se conservan sus inicios de sesión guardados y se elimina la fila duplicada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » se connecte à %@, que le serveur « %@ » gère déjà. La fusion conserve ses connexions enregistrées et supprime la ligne en double."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» si connette a %@, che il server «%@» già gestisce. L’unione conserva gli accessi salvati e rimuove la riga duplicata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の接続先 %@ は、サーバー「%@」がすでに管理しています。統合すると保存済みのログインはそのままに、重複した行が取り除かれます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» подключается к %@ — этой машиной уже управляет сервер «%@». Объединение сохранит записанные учётные записи и уберёт дубликат."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» під’єднується до %@ — цією машиною вже керує сервер «%@». Об’єднання збереже записані облікові записи й прибере дублікат."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”连接到 %@，而服务器“%@”已经在管理它。合并会保留已保存的登录方式并移除重复条目。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” yhdistyy kohteeseen %@, jota palvelin “%@” hallitsee jo. Yhdistäminen säilyttää sen tallennetut kirjautumiset ja poistaa kaksoisrivin."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ се свързва с %@, който сървърът „%@“ вече управлява. Сливането запазва записаните входове и премахва дублиращия се ред."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ se spaja na %@, kojim poslužitelj „%@“ već upravlja. Spajanje zadržava spremljene prijave i uklanja dupli redak."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« se poveže z %@, ki ga strežnik »%@« že upravlja. Združitev ohrani shranjene prijave in odstrani podvojeno vrstico."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” opretter forbindelse til %@, som serveren “%@” allerede administrerer. Sammenlægning bevarer dens gemte logins og fjerner den dobbelte række."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” maakt verbinding met %@, dat server “%@” al beheert. Samenvoegen behoudt de opgeslagen logins en verwijdert de dubbele rij."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ansluter till %@, som servern “%@” redan hanterar. Sammanslagning behåller dess sparade inloggningar och tar bort den dubbla raden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” łączy się z %@, którym już zarządza serwer „%@”. Scalenie zachowuje jego zapisane loginy i usuwa zduplikowany wiersz."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ se připojuje k %@, který již spravuje server „%@“. Sloučení zachová jeho uložená přihlášení a odstraní duplicitní řádek."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ sa pripája k %@, ktorý už spravuje server „%@“. Zlúčenie zachová jeho uložené prihlásenia a odstráni duplicitný riadok."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «%@» συνδέεται με %@, το οποίο ο διακομιστής «%@» διαχειρίζεται ήδη. Η συγχώνευση διατηρεί τις αποθηκευμένες συνδέσεις και αφαιρεί τη διπλότυπη γραμμή."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) „%@\" ehhez kapcsolódik: %@, amelyet a(z) „%@\" szerver már kezel. Az egyesítés megtartja a mentett bejelentkezéseket, és eltávolítja a duplikált sort."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@\" se conectează la %@, pe care serverul „%@\" îl gestionează deja. Îmbinarea păstrează datele de autentificare salvate și elimină rândul duplicat."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” liga-se a %@, que o servidor “%@” já gere. Unir mantém os inícios de sessão guardados e remove a linha duplicada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” ühendub aadressiga %@, mida server „%@” juba haldab. Ühendamine säilitab selle salvestatud sisselogimised ja eemaldab duplikaatrea."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceanglaíonn “%@” le %@, a bhfuil an freastalaí “%@” á bhainistiú aige cheana. Coinníonn an cumasc a shíniú isteach sábháilte agus baintear an ró dúblach."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” tikkonnettja ma' %@, li s-server “%@” diġà jimmaniġġja. Il-fużjoni żżomm id-dħul salvat tagħha u tneħħi r-ringiela duplikata."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” savienojas ar %@, ko serveris “%@” jau pārvalda. Apvienošana saglabā tā saglabātos pieteikšanās datus un noņem dublēto rindu."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ jungiasi prie %@, kurį serveris „%@“ jau valdo. Sujungus išsaugomi jo prisijungimai ir pašalinama dubliuota eilutė."
          }
        }
      }
    },
