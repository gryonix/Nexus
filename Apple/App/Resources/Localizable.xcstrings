    "An encrypted tunnel into this server from anywhere, with a panel that hands out client profiles." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein verschlüsselter Tunnel von überall zu diesem Server, mit einer Oberfläche, die Client-Profile ausgibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un túnel cifrado hacia este servidor desde cualquier lugar, con un panel que reparte perfiles de cliente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tunnel chiffré vers ce serveur depuis n’importe où, avec un panneau qui distribue les profils clients."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tunnel cifrato verso questo server da ovunque, con un pannello che distribuisce i profili client."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこからでもこのサーバーへつながる暗号化トンネル。クライアント設定を配るパネルつき。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шифрованный туннель до этого сервера откуда угодно, с панелью, которая выдаёт профили клиентов."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
