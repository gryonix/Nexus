    "Admin panels open only over WireGuard. This tunnel carries internet traffic." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Админ-панелите се отварят само чрез WireGuard. Този туннел осигурява само интернет трафик."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrativní panely se otevírají pouze přes WireGuard. Tento tunel přenáší pouze internetový provoz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admin-paneler åbnes kun via WireGuard. Denne tunnel bærer kun internettrafik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admin-Panels öffnen sich nur über WireGuard. Dieser Tunnel transportiert nur Internetverkehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα Admin panels ανοίγουν μόνο μέσω WireGuard. Αυτή η σήραγγα μεταφέρει μόνο διαδικτυακή κίνηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
