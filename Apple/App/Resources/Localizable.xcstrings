          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på et token for at udgive med det; blyanten indeholder selve token'et, navnet og hvilken udbyder det tilhører."
          }
        },
        "nl" : {
          "stringUnit" : {
