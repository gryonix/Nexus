    "The machine has not reported its network card yet. Open this server once while it is on." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Машината още не е съобщила мрежовата си карта. Отворете този сървър веднъж, докато е включен."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stroj zatím nenahlásil svou síťovou kartu. Otevřete tento server jednou, když je zapnutý."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maskinen har endnu ikke oplyst sit netværkskort. Åbn denne server én gang, mens den er tændt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Maschine hat ihre Netzwerkkarte noch nicht gemeldet. Öffne diesen Server einmal, während er läuft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το μηχάνημα δεν έχει αναφέρει ακόμη την κάρτα δικτύου του. Ανοίξτε αυτόν τον διακομιστή μία φορά όσο είναι αναμμένος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La máquina aún no ha informado de su tarjeta de red. Abre este servidor una vez mientras esté encendido."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masin pole veel oma võrgukaarti teatanud. Ava see server üks kord, kui see on sees."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kone ei ole vielä ilmoittanut verkkokorttiaan. Avaa tämä palvelin kerran, kun se on päällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La machine n'a pas encore indiqué sa carte réseau. Ouvrez ce serveur une fois pendant qu'il est allumé."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níor thuairiscigh an meaisín a chárta líonra fós. Oscail an freastalaí seo uair amháin agus é ar siúl."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stroj još nije javio svoju mrežnu karticu. Otvorite ovaj poslužitelj jednom dok je uključen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gép még nem jelentette a hálózati kártyáját. Nyisd meg egyszer ezt a szervert, amíg be van kapcsolva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La macchina non ha ancora comunicato la sua scheda di rete. Apri questo server una volta mentre è acceso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マシンはまだネットワークカードを報告していません。電源が入っている間に一度このサーバーを開いてください。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mašina dar nepranešė savo tinklo plokštės. Atidarykite šį serverį vieną kartą, kol jis įjungtas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
