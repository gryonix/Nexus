        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rendszergazdai jogokat igényel. Add meg egyszer a jelszavát: az app maga állítja be a hozzáférést, és nem tárolja a jelszót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
