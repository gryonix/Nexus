          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De data van de dienst en elke back-up ervan worden permanent verwijderd. Hier is geen weg terug van."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
