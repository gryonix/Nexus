      }
    },
    "Every block is read and compared, and repaired where the array can. It runs in the background." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всеки блок се прочита и сравнява и се поправя, където масивът може. Работи във фонов режим."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý blok se přečte a porovná a tam, kde to pole umí, se opraví. Běží na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver blok læses og sammenlignes og repareres, hvor arrayet kan. Det kører i baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Block wird gelesen, verglichen und, wo das Array es kann, repariert. Das läuft im Hintergrund."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε μπλοκ διαβάζεται και συγκρίνεται και επισκευάζεται όπου μπορεί η συστοιχία. Εκτελείται στο παρασκήνιο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lee y compara cada bloque, y se repara donde el conjunto puede. Se hace en segundo plano."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga plokk loetakse ja võrreldakse ning parandatakse, kus massiiv suudab. See käib taustal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen lohko luetaan ja verrataan, ja korjataan missä taulukko pystyy. Se toimii taustalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque bloc est lu, comparé et réparé là où l'ensemble le peut. Cela se fait en arrière-plan."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Léitear agus cuirtear gach bloc i gcomparáid, agus deisítear é nuair is féidir leis an eagar. Ritheann sé sa chúlra."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki blok se čita i uspoređuje te popravlja gdje polje može. Radi u pozadini."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden blokk beolvasásra és összevetésre kerül, és ahol a tömb tudja, javítja. A háttérben fut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni blocco viene letto, confrontato e riparato dove l'array può. Avviene in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのブロックを読み取って照合し、アレイで可能な箇所は修復します。バックグラウンドで実行されます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiekvienas blokas nuskaitomas ir palyginamas, o kur masyvas gali – pataisomas. Vyksta fone."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katrs bloks tiek nolasīts un salīdzināts, un, kur masīvs var, salabots. Tas notiek fonā."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kull blokk jinqara u jitqabbel, u jissewwa fejn l-array jista'. Jaħdem fl-isfond."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk blok wordt gelezen en vergeleken, en hersteld waar de array dat kan. Dit loopt op de achtergrond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy blok jest odczytywany i porównywany, a tam, gdzie macierz może, naprawiany. Działa w tle."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada bloco é lido e comparado, e reparado onde o conjunto consegue. Corre em segundo plano."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare bloc este citit, comparat și reparat acolo unde matricea poate. Rulează în fundal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый блок читается и сверяется, а где массив может — исправляется. Это идёт в фоне."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý blok sa prečíta a porovná a tam, kde to pole dokáže, sa opraví. Beží na pozadí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsak blok se prebere in primerja ter popravi, kjer polje zmore. Teče v ozadju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje block läses och jämförs, och repareras där arrayen kan. Det körs i bakgrunden."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен блок читається й звіряється, а де масив може — виправляється. Це йде у фоні."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐块读取并比对，阵列能修复的地方会修复。在后台运行。"
          }
        }
      }
    },
    "Every entry is pinned to one build, so a restart cannot move this world onto a version nobody chose." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Eintrag ist auf einen Build festgelegt, damit ein Neustart diese Welt nicht auf eine Version verschiebt, die niemand gewählt hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada entrada está fijada a una compilación, para que un reinicio no lleve este mundo a una versión que nadie eligió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque entrée est figée sur une version précise, pour qu'un redémarrage ne fasse pas passer ce monde sur une version que personne n'a choisie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni voce è fissata a una build, così un riavvio non sposta questo mondo su una versione che nessuno ha scelto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各項目は特定のビルドに固定されているので、再起動で誰も選んでいないバージョンにワールドが移ることはありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая запись закреплена на одной сборке, поэтому перезапуск не перенесёт этот мир на версию, которую никто не выбирал."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен запис закріплено на одній збірці, тож перезапуск не перенесе цей світ на версію, якої ніхто не вибирав."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一项都固定到具体版本，所以重启不会把这个世界迁移到没人选择的版本上。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen tietue on kiinnitetty yhteen buildiin, joten uudelleenkäynnistys ei voi siirtää tätä maailmaa versiolle, jota kukaan ei ole valinnut."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всеки запис е закачен за една компилация, така че рестарт не може да премести този свят на версия, която никой не е избрал."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki je unos vezan uz jednu izradu, pa ponovno pokretanje ne može prebaciti ovaj svijet na verziju koju nitko nije odabrao."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsak vnos je pripet na eno gradnjo, zato ga vnovični zagon ne more premakniti na različico, ki je nihče ni izbral."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver post er fastlåst til én build, så en genstart ikke kan flytte denne verden til en version, som ingen har valgt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke invoer is vastgezet op één build, zodat een herstart deze wereld niet naar een versie kan verplaatsen die niemand heeft gekozen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje post är fäst vid en enda build, så en omstart kan inte flytta den här världen till en version som ingen valt."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga kirje on kinnitatud ühe versiooni külge, nii et taaskäivitus ei saa viia seda maailma versioonile, mida keegi ei valinud."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá gach iontráil pionnáilte le build amháin, sa chaoi nach féidir le hatosú an domhan seo a bhogadh chuig leagan nár roghnaigh aon duine."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kull entrata hija ffissata ma' build waħda, biex restart ma jistax iċaqlaq din id-dinja fuq verżjoni li ħadd ma għażel."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada entrada está fixada a uma versão, para que um reinício não possa mover este mundo para uma versão que ninguém escolheu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε καταχώριση είναι καρφιτσωμένη σε μία έκδοση (build), ώστε μια επανεκκίνηση να μην μπορεί να μεταφέρει αυτόν τον κόσμο σε μια έκδοση που κανείς δεν επέλεξε."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden bejegyzés egy adott buildhez van rögzítve, így egy újraindítás nem tudja ezt a világot olyan verzióra állítani, amelyet senki sem választott."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare intrare este fixată la o anumită versiune compilată, așa că o repornire nu poate muta această lume pe o versiune pe care nimeni nu a ales-o."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy wpis jest przypięty do jednej wersji (build), więc restart nie może przenieść tego świata na wersję, której nikt nie wybrał."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý záznam je připnut k jednomu buildu, takže restart nemůže tento svět přesunout na verzi, kterou nikdo nezvolil."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý záznam je pripnutý k jednému buildu, takže reštart nemôže presunúť tento svet na verziu, ktorú nikto nezvolil."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katrs ieraksts ir piesaistīts vienam būvējumam, tāpēc restartēšana nevar pārvietot šo pasauli uz versiju, ko neviens nav izvēlējies."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiekvienas įrašas priskirtas vienai versijai (build), todėl paleidus iš naujo šis pasaulis negali persikelti į versiją, kurios niekas nepasirinko."
          }
        }
      }
    },
