          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έπειτα το παρακολουθεί"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seejärel jälgib seda"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potom to sleduje"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tad tas to novēro"
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansin déanann sé faire air"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tada jis tai stebi"
