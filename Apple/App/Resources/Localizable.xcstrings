        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този сървър раздава VPN конфигурации от собствения си панел — така е настроен. Променете го в VPN настройките на сървъра, за да управлявате устройствата и тук."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest server oferă configurații VPN din propriul panou — așa este configurat. Schimbă asta în setările VPN ale serverului pentru a gestiona dispozitivele și de aici."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj poslužitelj dijeli VPN konfiguracije iz vlastitog panela — tako je postavljen. Promijenite to u VPN postavkama poslužitelja da biste ovdje upravljali uređajima."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne server uddeler VPN-konfigurationer fra sit eget panel — sådan er den sat op. Ændr det i serverens VPN-indstillinger for også at administrere enheder her."
