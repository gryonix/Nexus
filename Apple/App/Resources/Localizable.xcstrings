    "Live CPU, memory, disk and traffic, backups on a schedule, updates with a rollback if the new image does not come up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-CPU, Speicher, Platte und Traffic, Backups nach Zeitplan, Updates mit Rollback, falls das neue Image nicht hochkommt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, memoria, disco y tráfico en vivo, copias de seguridad programadas y actualizaciones con reversión si la nueva imagen no arranca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, mémoire, disque et trafic en direct, sauvegardes planifiées, mises à jour avec retour arrière si la nouvelle image ne démarre pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, memoria, disco e traffico in tempo reale, backup pianificati, aggiornamenti con rollback se la nuova immagine non si avvia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU・メモリ・ディスク・通信量のライブ表示、スケジュールされたバックアップ、新しいイメージが起動しなければ巻き戻す更新。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Живые CPU, память, диск и трафик, бэкапы по расписанию, обновления с откатом, если новый образ не поднялся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Живі CPU, пам’ять, диск і трафік, резервні копії за розкладом, оновлення з відкотом, якщо новий образ не піднявся."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时 CPU、内存、磁盘与流量，按计划备份，更新失败时自动回滚。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elävä CPU, muisti, levy ja liikenne, varmuuskopiot aikataulun mukaan, päivitykset palautuksella, jos uusi image ei käynnisty."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, памет, диск и трафик на живо, резервни копия по график, обновявания с връщане назад, ако новият образ не се вдигне."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live cpu, geheugen, schijf en verkeer, back-ups volgens een schema, updates met terugdraaien als de nieuwe image niet opstart."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live CPU, hukommelse, disk og trafik, sikkerhedskopier efter en tidsplan, opdateringer med tilbagerulning, hvis det nye image ikke starter op."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live processor, minne, disk och trafik, säkerhetskopior enligt schema, uppdateringar med återställning om den nya avbildningen inte startar."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uživo CPU, memorija, disk i promet, sigurnosne kopije po rasporedu, ažuriranja s vraćanjem ako se nova slika ne pokrene."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, pomnilnik, disk in promet v živo, varnostne kopije po urniku, posodobitve s povrnitvijo, če se nova slika ne zažene."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, memorie, disc și trafic live, backup-uri programate, actualizări cu revenire dacă noua imagine nu pornește."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Élő CPU, memória, lemez és forgalom, ütemezett biztonsági mentések, frissítések visszaállítással, ha az új image nem indul el."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bieżące CPU, pamięć, dysk i ruch, zaplanowane kopie zapasowe, aktualizacje z wycofaniem, jeśli nowy obraz się nie uruchomi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Živé CPU, paměť, disk a provoz, plánované zálohy, aktualizace s návratem zpět, pokud se nový obraz nespustí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reaalajas CPU, mälu, ketas ja liiklus, ajastatud varukoopiad, uuendused koos taastamisega, kui uus image ei käivitu."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, pamäť, disk a prevádzka naživo, plánované zálohy, aktualizácie s návratom späť, ak sa nový obraz nespustí."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, memória, disco e tráfego em direto, cópias de segurança agendadas, atualizações com reversão caso a nova imagem não arranque."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζωντανά CPU, μνήμη, δίσκος και κίνηση, αντίγραφα ασφαλείας σε πρόγραμμα, ενημερώσεις με επαναφορά αν η νέα εικόνα δεν ανέβει."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, atmiņa, disks un trafiks reāllaikā, dublējumi pēc grafika, atjauninājumi ar atgriešanos, ja jaunais attēls nepaceļas."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LAP, cuimhne, diosca agus trácht beo, cúltacaí ar sceideal, nuashonruithe le fillteán siar mura n-éiríonn leis an íomhá nua."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, memorja, diska u traffiku ħajjin, backups skedati, aġġornamenti b'rollback jekk l-immaġni l-ġdida ma titlax."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyvai rodomas procesorius, atmintis, diskas ir srautas, atsarginės kopijos pagal tvarkaraštį, atnaujinimai su grąžinimu atgal, jei naujas atvaizdas nepakyla."
          }
        }
