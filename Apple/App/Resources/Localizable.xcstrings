    "The server runs the search and downloads what you pick — this device never talks to the mod site." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server führt die Suche aus und lädt herunter, was du auswählst — dieses Gerät spricht nie mit der Mod-Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor hace la búsqueda y descarga lo que elija: este dispositivo nunca habla con el sitio de mods."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est le serveur qui effectue la recherche et télécharge ce que vous choisissez — cet appareil ne parle jamais au site de mods."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È il server a eseguire la ricerca e a scaricare ciò che scegli: questo dispositivo non parla mai con il sito delle mod."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索とダウンロードはサーバーが行います。この端末が Mod サイトと通信することはありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск выполняет сервер, он же скачивает выбранное — это устройство никогда не обращается к сайту модов."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пошук виконує сервер, він же завантажує вибране — цей пристрій ніколи не звертається до сайту модів."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索和下载都由服务器完成，本设备从不与模组网站通信。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin ajaa haun ja lataa sen, mitä valitset — tämä laite ei koskaan puhu modisivustolle."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сървърът изпълнява търсенето и изтегля избраното от вас — това устройство никога не говори със сайта за модове."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverul rulează căutarea și descarcă ce alegi — acest dispozitiv nu vorbește niciodată cu site-ul de mod-uri."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren kører søgningen og downloader det, du vælger — denne enhed taler aldrig med mod-sitet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server voert de zoekopdracht uit en downloadt wat je kiest — dit apparaat praat nooit met de modsite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern kör sökningen och laddar ner det du väljer — den här enheten pratar aldrig med modsajten."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj obavlja pretragu i preuzima ono što odaberete — ovaj uređaj nikad ne komunicira s web-mjestom modova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strežnik izvede iskanje in prenese, kar izberete — ta naprava nikoli ne komunicira s spletnim mestom modov."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver végzi a keresést, és letölti, amit kiválaszt — ez az eszköz soha nem kommunikál a mod oldallal."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server provádí vyhledávání a stahuje, co vyberete — toto zařízení nikdy nekomunikuje se stránkou modu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer uruchamia wyszukiwanie i pobiera to, co wybierzesz — to urządzenie nigdy nie rozmawia ze stroną modów."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server teostab otsingu ja laadib alla selle, mille valid — see seade ei suhtle kunagi modi saidiga."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor faz a pesquisa e transfere o que escolher — este dispositivo nunca fala com o site de mods."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server vykonáva vyhľadávanie a sťahuje, čo vyberiete — toto zariadenie nikdy nekomunikuje so stránkou modu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής εκτελεί την αναζήτηση και κατεβάζει ό,τι επιλέγετε — αυτή η συσκευή δεν επικοινωνεί ποτέ με τον ιστότοπο των mods."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveris veic meklēšanu un lejupielādē to, ko izvēlaties — šī ierīce nekad nesazinās ar modu vietni."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritheann an freastalaí an cuardach agus íoslódálann sé an méid a roghnaíonn tú — ní labhraíonn an gléas seo leis an suíomh mod riamh."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveris pats vykdo paiešką ir atsisiunčia tai, ką pasirenkate — šis įrenginys niekada nesikalba su modų svetaine."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is-server iħaddem it-tfittxija u jniżżel dak li tagħżel — dan l-apparat qatt ma jitkellem mas-sit tal-mod."
          }
        }
      }
    },
