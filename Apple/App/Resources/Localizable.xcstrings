          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra för att ändra ordning. Det här är ordningen panelerna visas i, och att svepa bort en tar bort den."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povucite za promjenu redoslijeda. Ovo je redoslijed pojavljivanja panela, a povlačenje jednog u stranu ga uklanja."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povlecite za spremembo vrstnega reda. To je vrstni red pojavljanja pultov, potegljaj enega stran pa ga odstrani."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage pentru a reordona. Aceasta este ordinea în care apar panourile, iar tragerea unuia deoparte îl elimină."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzd az átrendezéshez. Ez az a sorrend, amelyben a panelek megjelennek, és az egyik elhúzása eltávolítja azt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij, aby zmienić kolejność. To jest kolejność, w jakiej pojawiają się panele, a przesunięcie jednego usuwa go."
