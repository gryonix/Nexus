        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent tohto servera túto službu nepozná — agent na ňom je starší než táto aplikácia. Aktualizujte agenta na stránke Operácie a skúste to znova. (%@)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο agent αυτού του διακομιστή δεν γνωρίζει εκείνη την υπηρεσία — ο agent σε αυτόν είναι παλαιότερος από αυτή την εφαρμογή. Ενημερώστε τον agent στη σελίδα Λειτουργίες και δοκιμάστε ξανά. (%@)"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
