            "value" : "Presun zachová konfiguráciu každého zariadenia: rovnakú adresu, rovnaké kľúče."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premik ohrani konfiguracijo vsake naprave: isti naslov, isti ključi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytten behåller varje enhets konfiguration: samma adress, samma nycklar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час перенесення конфігурації пристроїв не змінюються: та сама адреса, ті самі ключі."
          }
        },
        "zh" : {
