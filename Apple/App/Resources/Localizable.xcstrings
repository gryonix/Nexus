        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他服务器要经由此服务器到达。请先移除它们。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muut palvelimet tavoitetaan tämän kautta. Poista ne ensin."
