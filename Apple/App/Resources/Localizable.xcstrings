        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това е голямо резервно копие. Може да отнеме дълго време и ще използва още толкова дисково пространство, докато трае."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesta este un backup mare. Poate dura mult timp și va folosi din nou tot atât spațiu pe disc cât timp rulează."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo je velika sigurnosna kopija. Može potrajati dugo i koristit će ponovno toliko diskovnog prostora dok traje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er en stor sikkerhedskopi. Det kan tage lang tid og vil bruge lige så meget diskplads igen, mens det kører."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
