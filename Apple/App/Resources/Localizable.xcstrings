          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ディスクが報告する温度、稼働時間、摩耗、不良セクター。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
