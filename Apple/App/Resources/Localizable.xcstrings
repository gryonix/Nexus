            "value" : "Lohista järjekorra muutmiseks. See on järjekord, milles paneelid kuvatakse, jaühe eemale pühkimine kustutab selle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε για αναδιάταξη. Αυτή είναι η σειρά εμφάνισης των πάνελ, και σύροντας ένα προς τα έξω το αφαιρεί."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presunutím zmeňte poradie. Toto je poradie, v akom sa panely zobrazujú, a potiahnutím niektorý z nich odstránite."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para reordenar. Esta é a ordem em que os painéis aparecem, e deslizar um remove-o."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velciet, lai mainītu secību. Šādā secībā parādās paneļi, un, pavelkot vienu prom, tas tiek noņemts."
          }
        },
        "ga" : {
          "stringUnit" : {
