            "value" : "Karta beží 30 sekúnd. Opustite aplikáciu alebo zamknite telefón a sledujte ju na ostrovčeku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartica teče 30 sekund. Zapustite aplikacijo ali zaklenite telefon, da jo vidite na otoku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kortet visas i 30 sekunder. Lämna appen eller lås telefonen för att se det på ön."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Картка триває 30 секунд. Згорніть застосунок або заблокуйте телефон, щоб побачити її на острові."
          }
        },
        "zh" : {
          "stringUnit" : {
