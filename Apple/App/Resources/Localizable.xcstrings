    "The server checks itself every quarter of an hour and tells you when something breaks or recovers, even while this app is closed." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сървърът се проверява на всеки петнадесет минути и ви уведомява, когато нещо се повреди или възстанови, дори при затворено приложение."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server se kontroluje každou čtvrthodinu a dá vědět, když se něco pokazí nebo obnoví, i když je aplikace zavřená."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren tjekker sig selv hvert kvarter og giver besked, når noget går i stykker eller kommer sig, selv når appen er lukket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server prüft sich jede Viertelstunde selbst und meldet, wenn etwas ausfällt oder wieder läuft – auch wenn diese App geschlossen ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής ελέγχει τον εαυτό του κάθε τέταρτο της ώρας και σας ειδοποιεί όταν κάτι χαλάει ή επανέρχεται, ακόμη και με κλειστή την εφαρμογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor se revisa cada cuarto de hora y te avisa cuando algo falla o se recupera, incluso con esta app cerrada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server kontrollib end iga veerand tunni järel ja annab teada, kui midagi läheb katki või taastub, isegi kui rakendus on suletud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin tarkistaa itsensä vartin välein ja kertoo, kun jokin rikkoutuu tai palautuu, vaikka sovellus olisi suljettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur se vérifie tous les quarts d'heure et vous prévient quand quelque chose tombe en panne ou se rétablit, même app fermée."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seiceálann an freastalaí é féin gach ceathrú uair an chloig agus cuireann sé in iúl duit nuair a bhriseann nó a thagann rud éigin chuige féin, fiú agus an aip dúnta."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj se provjerava svakih petnaest minuta i javlja kad se nešto pokvari ili oporavi, čak i kad je aplikacija zatvorena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver negyedóránként ellenőrzi magát, és szól, ha valami elromlik vagy helyreáll, akkor is, ha az alkalmazás be van zárva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server si controlla ogni quarto d'ora e ti avvisa quando qualcosa si guasta o torna a funzionare, anche con l'app chiusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーは15分ごとに自己チェックし、何かが故障したり回復したりするとアプリを閉じていても知らせます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveris kas ketvirtį valandos pasitikrina ir praneša, kai kas nors sugenda ar atsistato, net kai programėlė uždaryta."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveris ik pēc ceturtdaļstundas pārbauda sevi un paziņo, kad kaut kas sabojājas vai atjaunojas, pat ja lietotne ir aizvērta."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is-server jiċċekkja lilu nnifsu kull kwart ta' siegħa u javżak meta xi ħaġa tinkiser jew terġa' taħdem, anke meta l-app tkun magħluqa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server controleert zichzelf elk kwartier en laat het weten wanneer er iets stukgaat of herstelt, ook als deze app dicht is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer sprawdza się co kwadrans i informuje, gdy coś się psuje lub wraca do normy, nawet gdy aplikacja jest zamknięta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor verifica-se a cada quarto de hora e avisa quando algo avaria ou recupera, mesmo com a app fechada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverul se verifică la fiecare sfert de oră și te anunță când ceva se strică sau își revine, chiar și cu aplicația închisă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер проверяет себя каждые четверть часа и сообщает, когда что-то ломается или восстанавливается, даже если приложение закрыто."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server sa kontroluje každú štvrťhodinu a dá vedieť, keď sa niečo pokazí alebo obnoví, aj keď je aplikácia zatvorená."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strežnik se preveri vsakih petnajst minut in sporoči, ko se kaj pokvari ali popravi, tudi ko je aplikacija zaprta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern kontrollerar sig själv varje kvart och meddelar när något går sönder eller återhämtar sig, även när appen är stängd."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер перевіряє себе щочверть години й повідомляє, коли щось ламається чи відновлюється, навіть якщо застосунок закрито."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器每十五分钟自检一次，出现故障或恢复时都会通知你，即使本应用已关闭。"
          }
        }
      }
    },
    "These apply to every server, and each server picks them up the next time the app connects to it. Where the notifications go — gryonixPush or ntfy — is set on each server under Agent → Notifications." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Важи за всички сървъри; всеки сървър го прилага при следващото свързване на приложението. Къде отиват известията — gryonixPush или ntfy — се задава за всеки сървър в Агент → Известия."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí pro všechny servery; každý server to převezme při příštím připojení aplikace. Kam oznámení chodí — gryonixPush nebo ntfy — se nastavuje u každého serveru v Agent → Oznámení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gælder for alle servere; hver server får det næste gang appen forbinder til den. Hvor notifikationer sendes hen — gryonixPush eller ntfy — vælges på hver server under Agent → Notifikationer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für alle Server; jeder Server übernimmt es, sobald die App sich das nächste Mal mit ihm verbindet. Wohin Benachrichtigungen gehen – gryonixPush oder ntfy – wird pro Server unter Agent → Benachrichtigungen festgelegt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ισχύει για όλους τους διακομιστές· ο καθένας το εφαρμόζει στην επόμενη σύνδεση της εφαρμογής. Πού πηγαίνουν οι ειδοποιήσεις — gryonixPush ή ntfy — ορίζεται σε κάθε διακομιστή στο Πράκτορας → Ειδοποιήσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a todos los servidores; cada uno lo recoge la próxima vez que la app se conecte a él. Adónde van los avisos —gryonixPush o ntfy— se elige en cada servidor, en Agente → Notificaciones."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehtib kõigile serveritele; iga server võtab selle üle, kui rakendus järgmine kord ühendub. Kuhu teavitused lähevad — gryonixPush või ntfy — määratakse iga serveri juures: Agent → Teavitused."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koskee kaikkia palvelimia; kukin ottaa sen käyttöön, kun sovellus seuraavan kerran yhdistää siihen. Minne ilmoitukset menevät — gryonixPush tai ntfy — asetetaan kullekin palvelimelle kohdassa Agentti → Ilmoitukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'applique à tous les serveurs ; chacun le reprend à la prochaine connexion de l'app. La destination des notifications — gryonixPush ou ntfy — se règle sur chaque serveur, dans Agent → Notifications."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baineann siad seo le gach freastalaí; glacann gach ceann leo an chéad uair eile a nascann an aip. Socraítear cá dtéann fógraí — gryonixPush nó ntfy — ar gach freastalaí faoi Gníomhaire → Fógraí."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrijedi za sve poslužitelje; svaki ih preuzima kad se aplikacija sljedeći put spoji. Kamo idu obavijesti — gryonixPush ili ntfy — postavlja se na svakom poslužitelju pod Agent → Obavijesti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden szerverre érvényes; mindegyik a következő csatlakozáskor veszi át. Hogy hová mennek az értesítések — gryonixPush vagy ntfy —, szerverenként az Ügynök → Értesítések alatt állítható."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale per tutti i server; ognuno lo riprende alla prossima connessione dell'app. Dove vanno le notifiche — gryonixPush o ntfy — si imposta su ogni server, in Agente → Notifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのサーバーに適用され、各サーバーは次にアプリが接続したときに反映します。通知の送り先（gryonixPush または ntfy）はサーバーごとに「エージェント → 通知」で設定します。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taikoma visiems serveriams; kiekvienas pritaikys, kai programėlė kitą kartą prisijungs. Kur siunčiami pranešimai — gryonixPush ar ntfy — nustatoma kiekviename serveryje: Agentas → Pranešimai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiecas uz visiem serveriem; katrs to pārņems, kad lietotne nākamreiz pieslēgsies. Kur tiek sūtīti paziņojumi — gryonixPush vai ntfy — iestata katram serverim sadaļā Aģents → Paziņojumi."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Japplikaw għal kull server; kull wieħed jaqbadhom id-darba li jmiss li l-app tikkonnettja. Fejn imorru n-notifiki — gryonixPush jew ntfy — jiġi ssettjat fuq kull server taħt Aġent → Notifiki."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt voor alle servers; elke server neemt het over zodra de app opnieuw verbindt. Waar meldingen heen gaan — gryonixPush of ntfy — stel je per server in onder Agent → Meldingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy wszystkich serwerów; każdy przejmie to przy następnym połączeniu aplikacji. Dokąd trafiają powiadomienia — gryonixPush czy ntfy — ustawia się na każdym serwerze w Agent → Powiadomienia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se a todos os servidores; cada um adota-o na próxima vez que a app se ligar. Para onde vão as notificações — gryonixPush ou ntfy — define-se em cada servidor em Agente → Notificações."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplică tuturor serverelor; fiecare le preia la următoarea conectare a aplicației. Unde merg notificările — gryonixPush sau ntfy — se setează pe fiecare server la Agent → Notificări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует для всех серверов; каждый сервер применит это при следующем подключении приложения. Куда идут уведомления — gryonixPush или ntfy — задаётся на каждом сервере в разделе «Агент → Уведомления»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí pre všetky servery; každý to prevezme pri ďalšom pripojení aplikácie. Kam idú upozornenia — gryonixPush alebo ntfy — sa nastavuje na každom serveri v Agent → Upozornenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velja za vse strežnike; vsak jih prevzame ob naslednji povezavi aplikacije. Kam gredo obvestila — gryonixPush ali ntfy — se nastavi na vsakem strežniku pod Agent → Obvestila."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäller alla servrar; varje server tar över det nästa gång appen ansluter. Vart aviseringar skickas — gryonixPush eller ntfy — ställs in på varje server under Agent → Aviseringar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Діє для всіх серверів; кожен сервер застосує це під час наступного підключення застосунку. Куди йдуть сповіщення — gryonixPush чи ntfy — задається на кожному сервері в розділі «Агент → Сповіщення»."
          }
        },
        "zh" : {
          "stringUnit" : {
