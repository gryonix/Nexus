        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent tohoto serveru tuto službu nezná — agent na něm je starší než tato aplikace. Aktualizujte agenta na stránce Operace a zkuste to znovu. (%@)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent tego serwera nie zna tej usługi — agent na nim jest starszy niż ta aplikacja. Zaktualizuj agenta na stronie Operacje i spróbuj ponownie. (%@)"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O agente deste servidor não conhece esse serviço — o agente nele é mais antigo do que esta app. Atualize o agente na página Operações e tente novamente. (%@)"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle serveri agent ei tunne seda teenust — sellel olev agent on vanem kui see rakendus. Värskenda agenti lehel Operatsioonid ja proovi uuesti. (%@)"
