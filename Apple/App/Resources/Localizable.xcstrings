    "The connection dropped, but the server keeps updating. It shows in the strip below." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Връзката се прекъсна, но сервърът продължава да се актуализира. Показва се в лентата по-долу."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojení bylo přerušeno, ale server pokračuje v aktualizaci. Zobrazí se v pásu níže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen blev afbrudt, men serveren bliver ved med at opdatere. Det vises i linjen nedenfor."
