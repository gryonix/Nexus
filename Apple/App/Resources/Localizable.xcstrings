    "Temperature only appears for servers that report one, whether or not it is offered here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Temperatur erscheint nur bei Servern, die eine melden — unabhängig davon, ob sie hier angeboten wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura solo aparece en los servidores que la informan, se ofrezca o no aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La température n'apparaît que pour les serveurs qui en signalent une, qu'elle soit proposée ici ou non."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura compare solo per i server che ne riportano una, indipendentemente da ciò che è offerto qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温度は、値を報告するサーバーでのみ表示されます。ここで有効にしてあるかどうかは関係ありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Температура появляется только у серверов, которые её сообщают, — независимо от того, предложена ли она здесь."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Температура з’являється лише в серверів, які її повідомляють, — незалежно від того, чи запропонована вона тут."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温度只在会上报温度的服务器上出现，与此处是否提供无关。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lämpötila näkyy vain palvelimille, jotka raportoivat sen, tarjotaanko sitä täällä tai ei."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Температурата се показва само за сървъри, които я докладват, независимо дали е предложена тук."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura apare doar pentru serverele care o raportează, indiferent dacă este oferită aici."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatuur verschijnt alleen voor servers die er een rapporteren, ongeacht of die hier wordt aangeboden."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatur vises kun for servere, der rapporterer en, uanset om den tilbydes her."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatur visas bara för servrar som rapporterar en, oavsett om den erbjuds här."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura se prikazuje samo za poslužitelje koji je prijavljuju, bez obzira je li ovdje ponuđena."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura se prikaže samo za strežnike, ki jo javljajo, ne glede na to, ali je tukaj ponujena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hőmérséklet csak azoknál a szervereknél jelenik meg, amelyek jelentenek egyet, függetlenül attól, hogy itt fel van-e kínálva."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teplota se zobrazí jen u serverů, které ji hlásí, bez ohledu na to, zda je zde nabízena."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatuur kuvatakse ainult serverite puhul, mis seda edastavad, sõltumata sellest, kas seda siin pakutakse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η θερμοκρασία εμφανίζεται μόνο για διακομιστές που αναφέρουν μία, είτε προσφέρεται εδώ είτε όχι."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura pojawia się tylko dla serwerów, które ją zgłaszają, niezależnie od tego, czy jest tu oferowana."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A temperatura só aparece para servidores que reportam uma, quer seja ou não oferecida aqui."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teplota sa zobrazí iba pre servery, ktoré ju hlásia, bez ohľadu na to, či je tu ponúkaná."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní thaispeántar teocht ach do fhreastalaithe a thuairiscíonn ceann, cibé an dtairgtear anseo é nó nach dtairgtear."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatūra parādās tikai serveriem, kas to ziņo, neatkarīgi no tā, vai tā šeit tiek piedāvāta."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatūra rodoma tik serveriams, kurie ją praneša, nesvarbu, ar ji čia siūloma."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It-temperatura tidher biss għal servers li jirrapportaw waħda, kemm jekk tiġi offruta hawn kif ukoll jekk le."
          }
        }
      }
    },
