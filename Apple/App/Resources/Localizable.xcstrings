          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ läuft jetzt auf %2$@. Die alte Kopie ist gestoppt, ihre Daten bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %1$@ εκτελείται τώρα στο %2$@. Το παλιό αντίγραφο έχει σταματήσει και τα δεδομένα του διατηρούνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ahora se ejecuta en %2$@. La copia anterior está detenida y sus datos se conservan."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ töötab nüüd masinal %2$@. Vana koopia on peatatud ja selle andmed säilitatud."
