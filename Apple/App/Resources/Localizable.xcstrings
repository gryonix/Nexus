    "Runs over the connection this server was added with. An account other than root needs sudo without a password." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работи по свързаност, чрез която е добавен сервърът. Акаунт, различен от root, се нуждае от sudo без пароль."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Běží přes připojení, kterým byl server přidán. Účet jiný než root potřebuje sudo bez hesla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kører over den forbindelse, serveren blev tilføjet med. En konto, der ikke er root, har brug for sudo uden adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft über die Verbindung, mit der der Server hinzugefügt wurde. Ein anderes Konto als root braucht sudo ohne Passwort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτελείται μέσω της σύνδεσης με την οποία προστέθηκε ο διακομιστής. Ένας λογαριασμός διαφορετικός από τον root χρειάζεται sudo χωρίς κωδικό πρόσβασης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecuta sobre la conexión con la que se agregó el servidor. Una cuenta que no sea root necesita sudo sin contraseña."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käivitatakse ühenduse kaudu, millega server lisati. Root-i muule kontole on vaja sudot ilma parooliga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suoritetaan yhteyden kautta, jolla palvelin lisättiin. Muulle kuin root-tilille tarvitaan sudo ilman salasanaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'exécute via la connexion utilisée pour ajouter le serveur. Un compte autre que root doit disposer de sudo sans mot de passe."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritheann sé ar an gceangal ar cuireadh an freastalaí a bhreise. Teastaíonn sudo gan bhraistint ó chuntas nach bhfuil root ann."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biva preko veze s kojom je dodan server. Račun koji nije root trebat će sudo bez lozinke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver hozzáadásához használt kapcsolaton keresztül fut. A root-tól különböző fiók sudo-t igényel jelszó nélkül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona sulla connessione usata per aggiungere il server. Un account non root ha bisogno di sudo senza password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーが追加された接続を経由して実行されます。root 以外のアカウントはパスワードなしで sudo を使用する必要があります。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veikia per ryšį, kuriuo buvo pridėtas serveris. Sąskaita, kuri nėra root, reikalinga sudo be slaptažodžio."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darbojas pāri savienojumam, ar kuru tika pievienots serveris. Kontam, kas nav root, nepieciešams sudo bez paroles."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jiħdem fuq il-konnessjoni li gih ġie miżjud is-server. Kont li mhux root għandu bżonn sudo mingħajr password."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkt via de verbinding waarmee de server is toegevoegd. Een account die geen root is, heeft sudo zonder wachtwoord nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działa przez połączenie, za pomocą którego został dodany serwer. Konto inne niż root potrzebuje sudo bez hasła."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É executado pela conexão com a qual o servidor foi adicionado. Uma conta que não seja root precisa de sudo sem senha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rulează peste conexiunea prin care a fost adăugat serverul. Un cont care nu este root necesită sudo fără parolă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работает через подключение, с которым добавлен сервер. Учётной записи, кроме root, нужен sudo без пароля."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezi cez pripojenie, ktorým bol server pridaný. Konto, ktoré nie je root, potrebuje sudo bez hesla."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teče preko povezave, s katero je bil strežnik dodan. Račun, ki ni root, potrebuje sudo brez gesla."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Körs över anslutningen som servern lades till med. Ett konto som inte är root behöver sudo utan lösenord."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Працює через підключення, з яким додано сервер. Обліковому запису, крім root, потрібен sudo без пароля."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过添加服务器时使用的连接运行。非 root 帐户需要使用 sudo 不带密码。"
          }
        }
      }
    },
    "Runs the house from your own machine: lights, sensors, heating and cameras in one app, working even when the internet is down. Only on a machine at home." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steuert das Haus von Ihrem eigenen Rechner aus: Licht, Sensoren, Heizung und Kameras in einer App – auch wenn das Internet ausfällt. Nur auf einem Rechner zu Hause."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona la casa desde su propia máquina: luces, sensores, calefacción y cámaras en una sola app, incluso sin internet. Solo en una máquina de su casa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilote la maison depuis votre propre machine : lumières, capteurs, chauffage et caméras dans une seule app, même sans internet. Uniquement sur une machine chez vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestisce la casa dalla tua macchina: luci, sensori, riscaldamento e telecamere in un'unica app, anche senza internet. Solo su una macchina in casa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のマシンで家を動かします。照明、センサー、暖房、カメラを1つのアプリで、インターネットが止まっても動作します。自宅にあるマシン専用です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляет домом с вашей собственной машины: свет, датчики, отопление и камеры в одном приложении, даже когда пропал интернет. Только на машине дома."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Керує домом із вашої власної машини: світло, датчики, опалення й камери в одному застосунку, навіть коли зник інтернет. Лише на машині вдома."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用您自己的机器管理整个家：灯光、传感器、暖气和摄像头集中在一个应用中，即使断网也能工作。仅限家中的机器。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajaa kotia omalta koneeltasi: valot, anturit, lämmitys ja kamerat yhdessä sovelluksessa, toimien vaikka internet olisi poikki. Vain kotona olevalla koneella."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управлява дома от собствената ви машина: осветление, сензори, отопление и камери в едно приложение, работещо дори когато интернетът е прекъснат. Само на машина вкъщи."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravlja kućom s vlastitog stroja: svjetla, senzori, grijanje i kamere u jednoj aplikaciji, radi čak i kad je internet nedostupan. Samo na stroju kod kuće."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravlja dom z vašega lastnega stroja: luči, senzorji, ogrevanje in kamere v eni aplikaciji, deluje tudi, ko interneta ni. Samo na stroju doma."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styrer huset fra din egen maskine: lys, sensorer, varme og kameraer i én app, som virker selv når internettet er nede. Kun på en maskine derhjemme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestuurt het huis vanaf je eigen machine: lampen, sensoren, verwarming en camera's in één app, werkt zelfs als het internet uitvalt. Alleen op een machine thuis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styr hemmet från din egen maskin: lampor, sensorer, värme och kameror i en app, fungerar även när internet ligger nere. Bara på en maskin hemma."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritheann sé an teach ó do mheaisín féin: soilse, braiteoirí, téamh agus ceamaraí in aon aip amháin, ag obair fiú nuair atá an t-idirlíon síos. Ar mheaisín sa bhaile amháin."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imexxi d-dar mill-magna tiegħek stess: dwal, sensuri, tisħin u kameras f'app waħda, jaħdmu anke meta l-internet ikun down. Biss fuq magna d-dar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gere a casa a partir da sua própria máquina: luzes, sensores, aquecimento e câmaras numa só app, a funcionar mesmo quando a internet está em baixo. Só numa máquina em casa."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prowadzi dom z Twojej własnej maszyny: światła, czujniki, ogrzewanie i kamery w jednej aplikacji, działające nawet przy braku internetu. Tylko na maszynie w domu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řídí domácnost z vašeho vlastního stroje: světla, senzory, topení a kamery v jedné aplikaci, funguje i bez internetu. Pouze na stroji doma."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riadi domácnosť z vášho vlastného stroja: svetlá, senzory, kúrenie a kamery v jednej aplikácii, funguje aj bez internetu. Iba na stroji doma."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαχειρίζεται το σπίτι από το δικό σου μηχάνημα: φώτα, αισθητήρες, θέρμανση και κάμερες σε μία εφαρμογή, λειτουργώντας ακόμη και όταν το ίντερνετ είναι εκτός λειτουργίας. Μόνο σε μηχάνημα στο σπίτι."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az otthonodat a saját gépedről irányítja: lámpák, érzékelők, fűtés és kamerák egyetlen alkalmazásban, akkor is működik, ha az internet leáll. Csak egy otthoni gépen."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlează casa de pe propria ta mașină: lumini, senzori, încălzire și camere într-o singură aplicație, funcționând chiar și când internetul e picat. Doar pe o mașină de acasă."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juhib maja sinu enda masinast: valgustus, andurid, küte ja kaamerad ühes rakenduses, töötab ka siis, kui internet on maas. Ainult kodus asuval masinal."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vada māju no jūsu pašu mašīnas: apgaismojums, sensori, apkure un kameras vienā lietotnē, kas darbojas pat tad, kad internets nedarbojas. Tikai mašīnā mājās."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valdo namus iš jūsų pačios mašinos: apšvietimas, jutikliai, šildymas ir kameros vienoje programoje, veikiančioje net kai nėra interneto. Tik namų mašinoje."
          }
        }
      }
    },
