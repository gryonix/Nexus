    "%@ stops connecting immediately. Its configuration cannot be restored — a replacement gets new keys." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann sich sofort nicht mehr verbinden. Die Konfiguration lässt sich nicht wiederherstellen – ein Ersatz erhält neue Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dejará de conectarse de inmediato. Su configuración no se puede recuperar: un reemplazo recibe claves nuevas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne pourra plus se connecter immédiatement. Sa configuration est irrécupérable — un remplacement reçoit de nouvelles clés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ smette subito di connettersi. La sua configurazione non è recuperabile: un sostituto riceve nuove chiavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はただちに接続できなくなります。設定は復元できません。作り直すと新しい鍵になります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ перестанет подключаться сразу же. Его конфигурацию не восстановить — замена получит новые ключи."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ перестане підключатися негайно. Його конфігурацію не відновити — заміна отримає нові ключі."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将立即无法连接。其配置无法恢复——重新创建会得到新的密钥。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lakkaa yhdistämästä heti. Sen konfiguraatiota ei voi palauttaa — korvaaja saa uudet avaimet."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ спира да се свързва незабавно. Конфигурацията му не може да бъде възстановена — заместник получава нови ключове."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ odmah prestaje sa spajanjem. Njegova konfiguracija ne može se vratiti — zamjena dobiva nove ključeve."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ takoj neha vzpostavljati povezavo. Njegove konfiguracije ni mogoče obnoviti — nadomestek dobi nove ključe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stopper straks med at oprette forbindelse. Dens konfiguration kan ikke gendannes — en erstatning får nye nøgler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stopt onmiddellijk met verbinden. De configuratie kan niet worden hersteld — een vervanging krijgt nieuwe sleutels."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ slutar ansluta omedelbart. Dess konfiguration kan inte återställas — en ersättning får nya nycklar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ natychmiast przestaje się łączyć. Jego konfiguracji nie można przywrócić — zamiennik otrzymuje nowe klucze."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se okamžitě přestane připojovat. Jeho konfiguraci nelze obnovit — náhrada dostane nové klíče."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sa okamžite prestane pripájať. Jeho konfiguráciu nemožno obnoviť — náhrada dostane nové kľúče."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ σταματά αμέσως να συνδέεται. Η διαμόρφωσή του δεν μπορεί να επαναφερθεί — ένα αντικατάστατο λαμβάνει νέα κλειδιά."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ azonnal leáll a kapcsolódásban. A konfigurációja nem állítható vissza — a helyettesítő új kulcsokat kap."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ încetează imediat conectarea. Configurația sa nu poate fi restaurată — un înlocuitor primește chei noi."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deixa de se ligar imediatamente. A sua configuração não pode ser restaurada — um substituto recebe novas chaves."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lõpetab ühendumise kohe. Selle konfiguratsiooni ei saa taastada — asendus saab uued võtmed."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopann %@ ag ceangal láithreach. Ní féidir a chumraíocht a chur ar ais — faigheann ionadaí eochracha nua."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jieqaf jikkonnettja minnufih. Il-konfigurazzjoni tiegħu ma tistax terġa' tiġi rrestawrata — sostitut jieħu ċwievet ġodda."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nekavējoties pārtrauc savienošanos. Tā konfigurāciju nevar atjaunot — aizvietotājs saņem jaunas atslēgas."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nedelsiant nustoja jungtis. Jo konfigūracijos atkurti negalima — pakaitalas gauna naujus raktus."
          }
        }
      }
