    "The Raspberry Pi's power chip measures the board; disks and the power supply's losses are added from the machine's parts." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захранващият чип на Raspberry Pi измерва платката; дисковете и загубите на захранването се добавят по частите."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napájecí čip Raspberry Pi měří desku; disky a ztráty zdroje se doplní podle součástí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raspberry Pi'ens strømchip måler kortet; diske og strømforsyningens tab lægges til ud fra delene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Energiechip des Raspberry Pi misst die Platine; Laufwerke und die Verluste des Netzteils werden aus den Bauteilen ergänzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το τσιπ τροφοδοσίας του Raspberry Pi μετρά την πλακέτα· δίσκοι και απώλειες τροφοδοτικού προστίθενται από τα εξαρτήματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El chip de energía de la Raspberry Pi mide la placa; los discos y las pérdidas de la fuente se añaden a partir de las piezas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raspberry Pi toitekiip mõõdab plaati; kettad ja toiteploki kaod lisatakse osade põhjal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raspberry Pin virtapiiri mittaa levyn; levyt ja virtalähteen häviöt lisätään osien perusteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La puce d'alimentation du Raspberry Pi mesure la carte ; les disques et les pertes de l'alimentation sont ajoutés d'après les composants."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomhaiseann slis cumhachta an Raspberry Pi an clár; cuirtear na dioscaí agus caillteanais an tsoláthair leis ó na codanna."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čip napajanja Raspberry Pija mjeri ploču; diskovi i gubici napajanja dodaju se prema dijelovima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Raspberry Pi tápchipje a lapot méri; a lemezek és a tápegység vesztesége az alkatrészek alapján adódik hozzá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il chip di alimentazione del Raspberry Pi misura la scheda; dischi e perdite dell'alimentatore sono aggiunti in base ai componenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raspberry Pi の電源チップがボードを測定します。ディスクと電源の損失は部品から加算されます。"
