    "Ubuntu" : {
      "shouldTranslate" : false
    },
    "Unchecked services are removed from the server before the setup re-runs. Their data stays on disk." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivierte Dienste werden vom Server entfernt, bevor die Einrichtung erneut ausgeführt wird. Ihre Daten bleiben auf der Festplatte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servicios sin marcar se quitan del servidor antes de que se vuelva a ejecutar la instalación. Sus datos permanecen en el disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les services décochés sont supprimés du serveur avant que la configuration ne soit relancée. Leurs données restent sur le disque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I servizi deselezionati vengono rimossi dal server prima che la configurazione venga rieseguita. I loro dati restano sul disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックを外したサービスは、セットアップが再実行される前にサーバーから削除されます。データはディスクに残ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Службы, с которых снята отметка, удаляются с сервера перед повторным запуском установки. Их данные остаются на диске."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Служби, з яких знято позначку, видаляються із сервера перед повторним запуском встановлення. Їхні дані залишаються на диску."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消勾选的服务会在安装重新运行前从服务器中移除。它们的数据仍保留在磁盘上。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitsemattomat palvelut poistetaan palvelimelta ennen asennuksen uudelleenajoa. Niiden data jää levylle."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неотметнатите услуги се премахват от сървъра, преди настройката да се изпълни отново. Данните им остават на диска."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serviciile debifate sunt eliminate de pe server înainte ca configurarea să ruleze din nou. Datele lor rămân pe disc."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neodabrane usluge uklanjaju se s poslužitelja prije ponovnog izvršavanja postavljanja. Njihovi podaci ostaju na disku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umarkerede tjenester fjernes fra serveren, før opsætningen kører igen. Deres data forbliver på disken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitgevinkte diensten worden van de server verwijderd voordat de installatie opnieuw wordt uitgevoerd. Hun data blijft op schijf staan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avmarkerade tjänster tas bort från servern innan installationen körs om. Deras data finns kvar på disken."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neoznačene storitve se odstranijo s strežnika, preden se namestitev znova zažene. Njihovi podatki ostanejo na disku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nem bejelölt szolgáltatások eltávolításra kerülnek a szerverről, mielőtt a telepítés újra fut. Adataik a lemezen maradnak."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odškrtnuté služby se ze serveru odeberou, než instalace znovu proběhne. Jejich data zůstávají na disku."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odznaczone usługi są usuwane z serwera, zanim instalacja uruchomi się ponownie. Ich dane pozostają na dysku."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Märkimata teenused eemaldatakse serverist enne installimise uuesti käivitamist. Nende andmed jäävad kettale."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os serviços desmarcados são removidos do servidor antes de a configuração voltar a correr. Os seus dados permanecem em disco."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι μη επιλεγμένες υπηρεσίες αφαιρούνται από τον διακομιστή πριν εκτελεστεί ξανά η εγκατάσταση. Τα δεδομένα τους παραμένουν στον δίσκο."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odškrtnuté služby sa zo servera odstránia pred opätovným spustením nastavenia. Ich dáta zostávajú na disku."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neatzīmētie pakalpojumi tiek noņemti no servera, pirms iestatīšana tiek palaista atkārtoti. To dati paliek diskā."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baintear seirbhísí neamhrogha ón bhfreastalaí sula ritear an socrú arís. Fanann a sonraí ar an diosca."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepažymėtos paslaugos pašalinamos iš serverio prieš pakartotinį sąrankos vykdymą. Jų duomenys lieka diske."
          }
        },
        "mt" : {
