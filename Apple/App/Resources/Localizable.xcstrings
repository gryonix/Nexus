          "stringUnit" : {
            "state" : "translated",
            "value" : "Lozinka kojom je ova sigurnosna kopija šifrirana. Bez nje se arhiva ne može otvoriti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den adgangssætning, denne sikkerhedskopi blev krypteret med. Uden den kan arkivet ikke åbnes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De wachtzin waarmee deze back-up is versleuteld. Zonder deze kan het archief niet worden geopend."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösenfrasen som den här säkerhetskopian krypterades med. Utan den kan arkivet inte öppnas."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geselna fraza, s katero je bila ta varnostna kopija šifrirana. Brez nje arhiva ni mogoče odpreti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelmondat, amellyel ezt a biztonsági mentést titkosították. Nélküle az archívum nem nyitható meg."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heslová fráze, kterou byla tato záloha zašifrována. Bez ní nelze archiv otevřít."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salafraas, millega see varukoopia krüptiti. Ilma selleta ei saa arhiivi avada."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasło szyfrujące, którym ta kopia zapasowa została zaszyfrowana. Bez niego nie da się otworzyć archiwum."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frase-passe com que esta cópia de segurança foi encriptada. Sem ela o arquivo não pode ser aberto."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η φράση πρόσβασης με την οποία κρυπτογραφήθηκε αυτό το αντίγραφο ασφαλείας. Χωρίς αυτήν το αρχείο δεν μπορεί να ανοίξει."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heslová fráza, ktorou bola táto záloha zašifrovaná. Bez nej nemožno archív otvoriť."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paroles frāze, ar kuru šis dublējums tika šifrēts. Bez tās arhīvu nevar atvērt."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An pasfhrása lenar criptíodh an cúltaca seo. Gan é, ní féidir an cartlann a oscailt."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaptafrazė, kuria buvo užšifruota ši atsarginė kopija. Be jos archyvo atverti negalima."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-passphrase li biha ġie kkriptat dan il-backup. Mingħajrha l-arkivju ma jistax jinfetaħ."
          }
        }
      }
    },
