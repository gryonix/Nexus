        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostavljeno ranijom instalacijom: vraća se kako jeste, s bazama podataka na njemu — ništa se ne oblikuje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy korábbi telepítés által hagyott: visszakerül, ahogyan van, az adatbázisokkal rajta — semmi nincs formázva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasciato da un'installazione precedente: viene riportato com'è, con i database su di esso — nulla viene formattato."
          }
        },
        "ja" : {
          "stringUnit" : {
