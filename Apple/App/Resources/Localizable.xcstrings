    "Activate gryonixNexus on your Mac with this license? It takes one of your five devices." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да се активира ли gryonixNexus на вашия Mac с този лиценз? Това заема едно от петте устройства."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivovat gryonixNexus na vašem Macu touto licencí? Zabere jedno z pěti zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du aktivere gryonixNexus på din Mac med denne licens? Den optager en af dine fem enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gryonixNexus mit dieser Lizenz auf Ihrem Mac aktivieren? Das belegt eines Ihrer fünf Geräte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποίηση του gryonixNexus στο Mac σας με αυτή την άδεια; Καταλαμβάνει μία από τις πέντε συσκευές σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Activar gryonixNexus en tu Mac con esta licencia? Ocupa uno de tus cinco dispositivos."
