    "Generate the setup, then copy the one-line command onto your server or install it straight from this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generieren Sie die Einrichtung, kopieren Sie dann den Einzeiler-Befehl auf Ihren Server oder installieren Sie direkt von diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera la configuración y luego copia el comando de una línea en tu servidor, o instálalo directamente desde este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Générez l'installation, puis copiez la commande d'une ligne sur votre serveur ou installez-la directement depuis cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera la configurazione, poi copia il comando su una riga sul tuo server oppure installalo direttamente da questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セットアップを生成し、1行のコマンドをサーバーにコピーするか、このデバイスから直接インストールします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сгенерируйте настройку, затем скопируйте однострочную команду на сервер или установите прямо с этого устройства."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Згенеруйте налаштування, потім скопіюйте однорядкову команду на сервер або встановіть прямо з цього пристрою."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成设置，然后将单行命令复制到您的服务器，或直接从此设备安装。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo asetukset, kopioi sitten yksirivinen komento palvelimellesi tai asenna se suoraan tältä laitteelta."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Генерирайте настройката, после копирайте едноредовата команда на сървъра си или я инсталирайте направо от това устройство."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genereer de installatie, kopieer dan de eenregelige opdracht naar je server of installeer rechtstreeks vanaf dit apparaat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generér opsætningen, kopiér derefter enkeltlinjekommandoen til din server, eller installér direkte fra denne enhed."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generera installationen, kopiera sedan enradskommandot till din server eller installera direkt från den här enheten."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generirajte postavljanje, zatim kopirajte jednolinijsku naredbu na svoj poslužitelj ili instalirajte izravno s ovog uređaja."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustvarite namestitev, nato kopirajte enovrstični ukaz na svoj strežnik ali ga namestite neposredno s te naprave."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generează configurația, apoi copiază comanda de o linie pe serverul tău sau instaleaz-o direct de pe acest dispozitiv."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generáld a telepítést, majd másold az egysoros parancsot a szerveredre, vagy telepítsd közvetlenül erről az eszközről."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygeneruj konfigurację, a następnie skopiuj jednolinijkową komendę na swój serwer albo zainstaluj ją bezpośrednio z tego urządzenia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vygenerujte instalaci a poté zkopírujte jednořádkový příkaz na svůj server, nebo ho nainstalujte přímo z tohoto zařízení."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genereeri seadistus ja kopeeri seejärel üherealine käsk oma serverisse või paigalda see otse sellest seadmest."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vygenerujte inštaláciu a potom skopírujte jednoriadkový príkaz na svoj server, alebo ju nainštalujte priamo z tohto zariadenia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gere a instalação e depois copie o comando de uma linha para o seu servidor, ou instale-a diretamente a partir deste dispositivo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε τη ρύθμιση, έπειτα αντιγράψτε τη μονογραμμική εντολή στον διακομιστή σας ή εγκαταστήστε την απευθείας από αυτή τη συσκευή."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ģenerējiet iestatīšanu, tad nokopējiet vienrindas komandu uz sava servera vai instalējiet to tieši no šīs ierīces."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gin an socrú, ansin cóipeáil an t-ordú aon-líne go dtí do fhreastalaí nó suiteáil díreach ón ngléas seo é."
          }
        },
        "mt" : {
          "stringUnit" : {
