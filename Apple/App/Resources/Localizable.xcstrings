    "The card runs for 30 seconds. Leave the app or lock the phone to watch it on the island." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Картата работи 30 секунди. Излезте от приложението или заключете телефона, за да я видите на острова."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta běží 30 sekund. Opusťte aplikaci nebo zamkněte telefon a sledujte ji na ostrůvku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kortet kører i 30 sekunder. Forlad appen eller lås telefonen for at se det på øen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte läuft 30 Sekunden. Verlasse die App oder sperre das Telefon, um sie auf der Insel zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κάρτα τρέχει για 30 δευτερόλεπτα. Βγείτε από την εφαρμογή ή κλειδώστε το τηλέφωνο για να τη δείτε στο νησί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta dura 30 segundos. Sal de la app o bloquea el teléfono para verla en la isla."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaart töötab 30 sekundit. Lahku rakendusest või lukusta telefon, et seda saarel näha."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kortti on käynnissä 30 sekuntia. Poistu apista tai lukitse puhelin nähdäksesi sen saarekkeessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte dure 30 secondes. Quittez l’app ou verrouillez le téléphone pour la voir dans l’île."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritheann an cárta ar feadh 30 soicind. Fág an aip nó cuir glas ar an bhfón chun é a fheiceáil ar an oileán."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartica traje 30 sekundi. Izađite iz aplikacije ili zaključajte telefon da biste je vidjeli na otoku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kártya 30 másodpercig fut. Lépjen ki az alkalmazásból, vagy zárja le a telefont, hogy lássa a szigeten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scheda dura 30 secondi. Esci dall’app o blocca il telefono per vederla nell’isola."
