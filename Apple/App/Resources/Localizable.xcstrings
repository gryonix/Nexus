    },
    "Start, stop, update and back up each app, and read its logs. An update rolls back by itself if the new version does not come up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte, stoppe, aktualisiere und sichere jede App und lies ihre Protokolle. Ein Update wird automatisch zurückgerollt, wenn die neue Version nicht startet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia, detén, actualiza y respalda cada app, y lee sus registros. Una actualización se revierte sola si la nueva versión no arranca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarrez, arrêtez, mettez à jour et sauvegardez chaque app, et lisez ses journaux. Une mise à jour revient en arrière d'elle-même si la nouvelle version ne démarre pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia, ferma, aggiorna ed esegui il backup di ogni app, e leggi i suoi log. Un aggiornamento torna indietro da solo se la nuova versione non parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各アプリの起動・停止・更新・バックアップ、ログの確認ができます。新しいバージョンが起動しなければ、更新は自動で元に戻ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускайте, останавливайте, обновляйте и бэкапьте каждое приложение, читайте его логи. Если новая версия не поднимется, обновление само откатится."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускайте, зупиняйте, оновлюйте й бекапте кожен застосунок, читайте його логи. Якщо нова версія не підніметься, оновлення саме відкотиться."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动、停止、更新和备份每个应用，并查看其日志。如果新版本无法启动，更新会自动回滚。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käynnistä, pysäytä, päivitä ja varmuuskopioi jokainen sovellus, ja lue sen lokit. Päivitys palautuu itsestään, jos uusi versio ei käynnisty."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стартирайте, спирайте, обновявайте и архивирайте всяко приложение и четете логовете му. Обновяване се връща назад само, ако новата версия не се вдигне."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pornește, oprește, actualizează și fă backup fiecărei aplicații și citește-i jurnalele. O actualizare revine singură dacă noua versiune nu pornește."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokrenite, zaustavite, ažurirajte i izradite sigurnosnu kopiju svake aplikacije, te čitajte njezine zapisnike. Ažuriranje se samo vraća unatrag ako se nova verzija ne pokrene."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaženite, ustavite, posodobite in izdelajte varnostno kopijo vsake aplikacije ter berite njene dnevnike. Posodobitev se sama povrne, če se nova različica ne zažene."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start, stop, opdater og sikkerhedskopier hver app, og læs dens logs. En opdatering ruller selv tilbage, hvis den nye version ikke kommer op."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start, stop, werk elke app bij en maak er een back-up van, en lees de logs. Een update draait zichzelf terug als de nieuwe versie niet opstart."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starta, stoppa, uppdatera och säkerhetskopiera varje app, och läs dess loggar. En uppdatering rullas tillbaka av sig själv om den nya versionen inte kommer upp."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indítson, állítson le, frissítsen és mentsen minden alkalmazást, és olvassa a naplóit. Egy frissítés önmagát visszavonja, ha az új verzió nem indul el."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spouštějte, zastavujte, aktualizujte a zálohujte každou aplikaci a čtěte její protokoly. Aktualizace se sama vrátí zpět, pokud se nová verze nespustí."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamiaj, zatrzymuj, aktualizuj i twórz kopie zapasowe każdej aplikacji oraz czytaj jej dzienniki. Aktualizacja sama się wycofuje, jeśli nowa wersja się nie uruchomi."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie, pare, atualize e faça cópia de segurança de cada app, e leia os seus registos. Uma atualização reverte por si própria se a nova versão não arrancar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käivita, peata, värskenda ja tee igast rakendusest varukoopia ning loe selle logisid. Värskendus taastub ise, kui uus versioon ei käivitu."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spúšťajte, zastavujte, aktualizujte a zálohujte každú aplikáciu a čítajte jej protokoly. Aktualizácia sa sama vráti späť, ak sa nová verzia nespustí."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκκίνηση, διακοπή, ενημέρωση και δημιουργία αντιγράφου ασφαλείας κάθε εφαρμογής, και ανάγνωση των αρχείων καταγραφής της. Μια ενημέρωση επαναφέρεται μόνη της αν η νέα έκδοση δεν ανέβει."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sāciet, apturiet, atjauniniet un dublējiet katru lietotni, un lasiet tās žurnālus. Atjauninājums pats atgriežas atpakaļ, ja jaunā versija nesāk darboties."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paleiskite, sustabdykite, atnaujinkite ir darykite kiekvienos programėlės atsargines kopijas bei skaitykite jos žurnalus. Atnaujinimas pats grąžinamas atgal, jei nauja versija nepakyla."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tosaigh, stop, nuashonraigh agus cúltacaigh gach aip, agus léigh a logaí. Fillann nuashonrú ar ais leis féin mura dtagann an leagan nua suas."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibda, waqqaf, aġġorna u ħu backup ta' kull app, u aqra l-logs tagħha. Aġġornament jirriverti waħdu jekk il-verżjoni l-ġdida ma titlax."
          }
        }
      }
    },
