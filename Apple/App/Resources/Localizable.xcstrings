    "%@ already points at %@ and was left alone. Change it by hand if this service should answer there." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ вече сочи на %@ и остава непроменено. Сменете го ръчно, ако този сервис трябва да отговори там."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ už ukazuje na %@ a bylo ponecháno samo. Změňte jej ručně, pokud by měla tato služba odpovídat tam."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ peger allerede på %@ og blev overladt alene. Skift det manuelt, hvis denne tjeneste skal svare der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zeigt bereits auf %@ und wurde unverändert gelassen. Ändern Sie es manuell, wenn dieser Dienst dort antworten soll."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ήδη δείχνει σε %@ και αφέθηκε μόνη. Αλλάξτε την χειροκίνητα εάν αυτή η υπηρεσία πρέπει να απαντήσει εκεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya apunta a %@ y se dejó solo. Cámbialo manualmente si este servicio debe responder allí."
