          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-magna għadha ma rrappurtatx il-karta tan-netwerk tagħha. Iftaħ dan is-server darba waqt li jkun mixgħul."
          }
        },
        "nl" : {
