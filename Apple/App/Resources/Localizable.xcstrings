    "%lld connections point at machines your servers already manage. Merging keeps their saved logins and removes the duplicate rows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Verbindungen zeigen auf Maschinen, die Ihre Server bereits verwalten. Beim Zusammenführen bleiben die gespeicherten Anmeldungen erhalten und die doppelten Zeilen verschwinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld conexiones apuntan a máquinas que sus servidores ya gestionan. Al combinar se conservan sus inicios de sesión guardados y se eliminan las filas duplicadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld connexions pointent vers des machines que vos serveurs gèrent déjà. La fusion conserve leurs connexions enregistrées et supprime les lignes en double."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld connessioni puntano a macchine che i vostri server già gestiscono. L’unione conserva gli accessi salvati e rimuove le righe duplicate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件の接続が、すでにサーバーで管理しているマシンを指しています。統合すると保存済みのログインはそのままに、重複した行が取り除かれます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld подключений ведут к машинам, которыми уже управляют ваши серверы. Объединение сохранит записанные учётные записи и уберёт дубликаты."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld підключень ведуть до машин, якими вже керують ваші сервери. Об’єднання збереже записані облікові записи й прибере дублікати."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 个连接指向你的服务器已经在管理的机器。合并会保留已保存的登录方式并移除重复条目。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld yhteyttä osoittaa koneisiin, joita palvelimesi jo hallitsevat. Yhdistäminen säilyttää niiden tallennetut kirjautumiset ja poistaa kaksoisrivit."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld връзки сочат към машини, които вашите сървъри вече управляват. Сливането запазва записаните входове и премахва дублиращите се редове."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld veza pokazuje na strojeve kojima vaši poslužitelji već upravljaju. Spajanje zadržava njihove spremljene prijave i uklanja duple retke."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld povezav kaže na stroje, ki jih vaši strežniki že upravljajo. Združitev ohrani njihove shranjene prijave in odstrani podvojene vrstice."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld forbindelser peger på maskiner, dine servere allerede administrerer. Sammenlægning bevarer deres gemte logins og fjerner de dobbelte rækker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld verbindingen wijzen naar machines die je servers al beheren. Samenvoegen behoudt de opgeslagen logins en verwijdert de dubbele rijen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld anslutningar pekar på maskiner dina servrar redan hanterar. Sammanslagning behåller deras sparade inloggningar och tar bort de dubbla raderna."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld połączeń wskazuje na maszyny, którymi Twoje serwery już zarządzają. Scalenie zachowuje ich zapisane loginy i usuwa zduplikowane wiersze."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld připojení ukazuje na stroje, které vaše servery už spravují. Sloučení zachová jejich uložená přihlášení a odstraní duplicitní řádky."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld pripojení ukazuje na stroje, ktoré vaše servery už spravujú. Zlúčenie zachová ich uložené prihlásenia a odstráni duplicitné riadky."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld συνδέσεις δείχνουν σε μηχανήματα που οι διακομιστές σου διαχειρίζονται ήδη. Η συγχώνευση διατηρεί τις αποθηκευμένες συνδέσεις και αφαιρεί τις διπλότυπες γραμμές."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld kapcsolat olyan gépekre mutat, amelyeket a szervereid már kezelnek. Az egyesítés megtartja a mentett bejelentkezéseket, és eltávolítja a duplikált sorokat."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld conexiuni indică spre mașini pe care serverele tale le gestionează deja. Îmbinarea păstrează datele de autentificare salvate și elimină rândurile duplicate."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ligações apontam para máquinas que os seus servidores já gerem. Unir mantém os inícios de sessão guardados e remove as linhas duplicadas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ühendust osutavad masinatele, mida sinu serverid juba haldavad. Ühendamine säilitab nende salvestatud sisselogimised ja eemaldab duplikaatread."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Díríonn %lld nasc ar mheaisíní atá á mbainistiú cheana ag do chuid freastalaithe. Coinníonn an cumasc a síniú isteach sábháilte agus baintear na rónna dúblacha."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld konnessjoni jipponta lejn magni li s-servers tiegħek diġà jimmaniġġjaw. Il-fużjoni żżomm id-dħul salvat tagħhom u tneħħi r-ringieli duplikati."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld savienojumi norāda uz datoriem, kurus jūsu serveri jau pārvalda. Apvienošana saglabā to saglabātos pieteikšanās datus un noņem dublētās rindas."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ryšiai nurodo į kompiuterius, kuriuos jūsų serveriai jau valdo. Sujungus išsaugomi jų prisijungimai ir pašalinamos dubliuotos eilutės."
          }
        }
      }
    },
