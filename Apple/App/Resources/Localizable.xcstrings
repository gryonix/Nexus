    "The processor measures itself; memory, disks, the board and the power supply's losses are added from the machine's parts." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процесорът измерва само себе си; паметта, дисковете, платката и загубите на захранването се добавят по частите на машината."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesor měří jen sám sebe; paměť, disky, deska a ztráty zdroje se doplní podle součástí stroje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processoren måler kun sig selv; hukommelse, diske, bundkort og strømforsyningens tab lægges til ud fra maskinens dele."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Prozessor misst sich selbst; Speicher, Laufwerke, Mainboard und die Verluste des Netzteils werden aus den Bauteilen der Maschine ergänzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο επεξεργαστής μετρά μόνο τον εαυτό του· μνήμη, δίσκοι, μητρική και απώλειες τροφοδοτικού προστίθενται από τα εξαρτήματα του μηχανήματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El procesador se mide a sí mismo; la memoria, los discos, la placa y las pérdidas de la fuente se añaden a partir de las piezas del equipo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protsessor mõõdab ainult ennast; mälu, kettad, emaplaat ja toiteploki kaod lisatakse masina osade põhjal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suoritin mittaa vain itsensä; muisti, levyt, emolevy ja virtalähteen häviöt lisätään koneen osien perusteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le processeur se mesure lui-même ; la mémoire, les disques, la carte et les pertes de l'alimentation sont ajoutés d'après les composants de la machine."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomhaiseann an próiseálaí é féin; cuirtear an chuimhne, na dioscaí, an clár agus caillteanais an tsoláthair cumhachta leis ó chodanna an mheaisín."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesor mjeri samo sebe; memorija, diskovi, ploča i gubici napajanja dodaju se prema dijelovima stroja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A processzor csak önmagát méri; a memória, a lemezek, az alaplap és a tápegység vesztesége a gép alkatrészei alapján adódik hozzá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il processore misura se stesso; memoria, dischi, scheda e perdite dell'alimentatore sono aggiunti in base ai componenti della macchina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロセッサーは自身を測定します。メモリ、ディスク、ボード、電源の損失はマシンの部品から加算されます。"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesorius matuoja tik save; atmintis, diskai, plokštė ir maitinimo bloko nuostoliai pridedami pagal mašinos dalis."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesors mēra tikai sevi; atmiņa, diski, plate un barošanas bloka zudumi tiek pieskaitīti pēc mašīnas daļām."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-proċessur ikejjel lilu nnifsu biss; il-memorja, id-diski, il-bord u t-telf tal-provvista tal-enerġija jiżdiedu mill-partijiet tal-magna."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De processor meet alleen zichzelf; geheugen, schijven, moederbord en de verliezen van de voeding worden aangevuld uit de onderdelen van de machine."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesor mierzy tylko siebie; pamięć, dyski, płyta i straty zasilacza są doliczane na podstawie części maszyny."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O processador mede-se apenas a si próprio; a memória, os discos, a placa e as perdas da fonte são somados a partir das peças da máquina."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesorul se măsoară doar pe sine; memoria, discurile, placa și pierderile sursei se adaugă după componentele mașinii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процессор измеряет только себя; память, диски, плата и потери блока питания добавляются по деталям машины."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesor meria len sám seba; pamäť, disky, doska a straty zdroja sa doplnia podľa súčastí stroja."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesor meri samo sebe; pomnilnik, diski, plošča in izgube napajalnika se dodajo glede na dele stroja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processorn mäter bara sig själv; minne, diskar, moderkort och nätaggregatets förluster läggs till utifrån maskinens delar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процесор вимірює лише себе; пам'ять, диски, плата й втрати блока живлення додаються за деталями машини."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "处理器只测量自身；内存、磁盘、主板和电源损耗根据机器的部件补充计算。"
          }
        }
      }
    },
    "The public repository's line being tried out, fetched and built by the server itself." : {
      "localizations" : {
