    "The saved configuration for this server could not be read, so its records and ports can't be shown here. The installation is still running on the server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherte Konfiguration für diesen Server konnte nicht gelesen werden, daher können die Einträge und Ports hier nicht angezeigt werden. Die Installation läuft weiterhin auf dem Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer la configuración guardada de este servidor, por lo que sus registros y puertos no se pueden mostrar aquí. La instalación sigue ejecutándose en el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration enregistrée de ce serveur n'a pas pu être lue, ses enregistrements et ports ne peuvent donc pas être affichés ici. L'installation est toujours en cours sur le serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile leggere la configurazione salvata di questo server, quindi i suoi record e le sue porte non possono essere mostrati qui. L'installazione è ancora in corso sul server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーの保存された構成を読み取れなかったため、記録とポートをここに表示できません。インストールはサーバー上でまだ実行中です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать сохранённую конфигурацию этого сервера, поэтому его записи и порты здесь не показать. Установка всё ещё идёт на сервере."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося прочитати збережену конфігурацію цього сервера, тому його записи та порти тут не показати. Встановлення все ще триває на сервері."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取此服务器的已保存配置，因此无法在此显示其记录和端口。安装仍在服务器上运行。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän palvelimen tallennettua konfiguraatiota ei voitu lukea, joten sen tietueita ja portteja ei voida näyttää täällä. Asennus on yhä käynnissä palvelimella."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запазената конфигурация за този сървър не можа да бъде прочетена, затова записите и портовете му не могат да бъдат показани тук. Инсталацията все още се изпълнява на сървъра."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurația salvată pentru acest server nu a putut fi citită, așa că înregistrările și porturile lui nu pot fi afișate aici. Instalarea continuă să ruleze pe server."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den gemte konfiguration for denne server kunne ikke læses, så dens records og porte kan ikke vises her. Installationen kører stadig på serveren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opgeslagen configuratie voor deze server kon niet worden gelezen, dus de records en poorten kunnen hier niet worden getoond. De installatie draait nog steeds op de server."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den sparade konfigurationen för den här servern kunde inte läsas, så dess poster och portar kan inte visas här. Installationen körs fortfarande på servern."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremljena konfiguracija za ovaj poslužitelj nije se mogla pročitati, pa se njegovi zapisi i portovi ovdje ne mogu prikazati. Instalacija je i dalje u tijeku na poslužitelju."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shranjene konfiguracije za ta strežnik ni bilo mogoče prebrati, zato njegovih zapisov in vrat tukaj ni mogoče prikazati. Namestitev na strežniku še vedno poteka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennek a szervernek a mentett konfigurációja nem volt olvasható, így a rekordjai és portjai itt nem jeleníthetők meg. A telepítés még mindig fut a szerveren."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloženou konfiguraci tohoto serveru se nepodařilo přečíst, takže zde nelze zobrazit její záznamy a porty. Instalace na serveru stále běží."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać zapisanej konfiguracji tego serwera, więc jej rekordy i porty nie mogą się tutaj pokazać. Instalacja nadal działa na serwerze."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle serveri salvestatud seadistust ei õnnestunud lugeda, seega selle kirjeid ja porte ei saa siin näidata. Installimine töötab serveris endiselt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A configuração guardada para este servidor não pôde ser lida, por isso os seus registos e portas não podem ser mostrados aqui. A instalação ainda está a decorrer no servidor."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloženú konfiguráciu tohto servera sa nepodarilo prečítať, takže tu nemožno zobraziť jej záznamy a porty. Inštalácia na serveri stále beží."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αποθηκευμένη διαμόρφωση για αυτόν τον διακομιστή δεν μπόρεσε να διαβαστεί, οπότε οι εγγραφές και οι θύρες του δεν μπορούν να εμφανιστούν εδώ. Η εγκατάσταση εξακολουθεί να εκτελείται στον διακομιστή."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šī servera saglabāto konfigurāciju neizdevās nolasīt, tāpēc tā ierakstus un portus šeit nevar parādīt. Instalācija joprojām darbojas serverī."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níorbh fhéidir an chumraíocht shábháilte don fhreastalaí seo a léamh, mar sin ní féidir a thaifid agus a calafoirt a thaispeáint anseo. Tá an tsuiteáil fós ag rith ar an bhfreastalaí."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko nuskaityti išsaugotos šio serverio konfigūracijos, todėl jo įrašų ir prievadų čia parodyti negalima. Diegimas serveryje vis dar vyksta."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-konfigurazzjoni salvata għal dan is-server ma setgħetx tinqara, għalhekk ir-rekords u l-ports tiegħu ma jistgħux jintwerew hawn. L-installazzjoni għadha taħdem fuq is-server."
          }
        }
      }
    },
    "The rest of the install finished — these are non-fatal steps that did not, and can be fixed by re-running setup afterward." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Rest der Installation ist abgeschlossen — das hier sind nicht kritische Schritte, die es nicht geschafft haben, und die sich beheben lassen, indem die Einrichtung danach erneut ausgeführt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El resto de la instalación ha terminado — estos son pasos no críticos que no lo lograron, y se pueden corregir volviendo a ejecutar la configuración después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le reste de l'installation s'est terminé — voici des étapes non critiques qui, elles, ont échoué, et qui se corrigent en relançant la configuration ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il resto dell'installazione è terminato — questi sono passaggi non critici che non ce l'hanno fatta, e si possono correggere eseguendo di nuovo la configurazione in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストールの残りは完了しました — これらは致命的ではない、完了しなかった手順で、あとでセットアップを再実行すれば直せます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остальная часть установки завершилась — а вот эти некритичные шаги не завершились, и это можно исправить, запустив настройку заново позже."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Решта встановлення завершилася — а ці некритичні кроки не завершилися, і це можна виправити, запустивши налаштування знову пізніше."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装的其余部分已完成 — 这些是非致命的步骤，它们未能完成，之后重新运行设置即可修复。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loppu asennuksesta valmistui — nämä ovat ei-kriittisiä vaiheita, jotka eivät valmistuneet, ja jotka voi korjata ajamalla asennuksen uudelleen jälkikäteen."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останалата част от инсталацията приключи — това са нефатални стъпки, които не са, и могат да се поправят чрез повторно изпълнение на настройката след това."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restul instalării s-a încheiat — acestea sunt pași nefatali care nu s-au încheiat și pot fi remediați rulând din nou configurarea ulterior."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resten af installationen blev afsluttet — dette er ikke-kritiske trin, der ikke gjorde det, og som kan rettes ved at køre opsætningen igen bagefter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De rest van de installatie is voltooid — dit zijn niet-fatale stappen die dat niet deden, en die kunnen worden opgelost door de installatie later opnieuw uit te voeren."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resten av installationen slutfördes — det här är icke-kritiska steg som inte gjorde det, och som kan åtgärdas genom att köra installationen igen efteråt."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostatak instalacije je završen — ovo su nekritični koraci koji nisu uspjeli, a mogu se ispraviti naknadnim ponovnim pokretanjem postavljanja."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preostanek namestitve je končan — to so nekritični koraki, ki niso uspeli, in jih je mogoče popraviti s poznejšim ponovnim zagonom namestitve."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A telepítés többi része befejeződött — ezek nem végzetes lépések, amelyek nem sikerültek, és utólagos újratelepítéssel javíthatók."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbytek instalace se dokončil — toto jsou nekritické kroky, které se nepovedly a lze je opravit opětovným spuštěním nastavení."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reszta instalacji się zakończyła — to kroki niekrytyczne, które się nie powiodły i można je naprawić, uruchamiając potem instalację ponownie."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ülejäänud installimine lõppes — need on mittekriitilised sammud, mis ebaõnnestusid, ja neid saab hiljem parandada installimise uuesti käivitamisega."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O resto da instalação terminou — estes são passos não fatais que não terminaram, e podem ser corrigidos voltando a executar a configuração depois."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvyšok inštalácie sa dokončil — toto sú nekritické kroky, ktoré sa nepodarili a možno ich opraviť opätovným spustením nastavenia."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το υπόλοιπο της εγκατάστασης ολοκληρώθηκε — αυτά είναι μη μοιραία βήματα που δεν ολοκληρώθηκαν, και μπορούν να διορθωθούν εκτελώντας ξανά την εγκατάσταση αργότερα."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārējā instalācijas daļa pabeigta — šie ir nekritiski soļi, kas nepabeidzās, un tos var salabot, vēlāk palaižot iestatīšanu vēlreiz."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chríochnaigh an chuid eile den tsuiteáil — is céimeanna neamh-mharfacha iad seo nár chríochnaigh, agus is féidir iad a shocrú trí an socrú a rith arís ina dhiaidh sin."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Likusi diegimo dalis baigta — tai nefatalūs žingsniai, kurie nebaigti, ir juos galima ištaisyti vėliau paleidus sąranką iš naujo."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-bqija tal-installazzjoni spiċċat — dawn huma passi mhux fatali li ma spiċċawx, u jistgħu jissewwew billi terġa' tħaddem l-installazzjoni wara."
          }
        }
      }
    },
