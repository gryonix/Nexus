        <!-- Shadowsocks and Xray Reality: the Xray core plus an lwIP stack.
             A second VpnService beside the WireGuard backend's, which comes
             from its AAR — Android runs one VPN at a time, so only one of them
             is ever up, and keeping them apart means a bug in the new one
             cannot take the protocol that already works down with it. -->
        <receiver
            android:name=".app.notify.OperationRetryReceiver"
            android:exported="false" />
        <receiver
            android:name=".app.notify.OperationStopReceiver"
            android:exported="false" />
        <receiver
            android:name=".app.push.AlertActionReceiver"
            android:exported="false" />
        <service
            android:name=".vpn.XrayVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <service
            android:name=".push.GryonixMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
